---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import StickyBar from '../components/StickyBar.astro';
import { allMahindraKeywordPermutations } from '../data/mahindraKeywordsEcosystem';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  image?: string;
  customSchema?: any;
}

const {
  title = "Mahindra Mahalunge | Mahindra Lifespaces Mahalunge Pune - 2, 3 & 4 BHK Pre-Launch",
  description = "Official overview of Mahindra Mahalunge by Mahindra Lifespaces Mahalunge, Pune. Explore the 13.46-acre master development with luxury 2, 3 & 4 BHK residences, floor plans, price sheet, location map & PMRDA connectivity.",
  keywords,
  canonical,
  image,
  customSchema = null,
} = Astro.props;

const defaultImage = "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1600&q=80";
const metaImage = image || defaultImage;

const defaultKeywords = allMahindraKeywordPermutations.slice(0, 35).join(", ");
const metaKeywords = keywords || defaultKeywords;

// Ensure strictly normalized canonical URLs with trailing slashes matching Google Search Console sitemap standards
const siteOrigin = "https://mahindralifespaceshomes.in";
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = canonical 
  ? (canonical.endsWith("/") ? canonical : `${canonical}/`)
  : (path === "" ? `${siteOrigin}/` : `${siteOrigin}${path}/`);

// Construct Schema.org BreadcrumbList dynamically for every page
const segments = path.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${siteOrigin}/`
  }
];

let accumulatedPath = '';
segments.forEach((seg, idx) => {
  accumulatedPath += `/${seg}`;
  const formattedName = seg
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\bBhk\b/gi, 'BHK')
    .replace(/\bPmrda\b/gi, 'PMRDA')
    .replace(/\bFaq\b/gi, 'FAQ')
    .replace(/\bIt\b/g, 'IT');

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": formattedName,
    "item": `${siteOrigin}${accumulatedPath}/`
  });
});

const breadcrumbsSchema = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
} : null;

const hasCustomBreadcrumbs = customSchema && (
  customSchema["@type"] === "BreadcrumbList" || 
  (Array.isArray(customSchema["@graph"]) && customSchema["@graph"].some((s: any) => s["@type"] === "BreadcrumbList"))
);
const shouldRenderBreadcrumbs = breadcrumbsSchema && !hasCustomBreadcrumbs;

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://mahindralifespaceshomes.in/#organization",
      "name": "Mahindra Lifespace Developers Limited",
      "legalName": "Mahindra Lifespace Developers Limited",
      "alternateName": [
        "Mahindra Lifespaces",
        "Mahindra Lifespaces Developers Ltd.",
        "MLDL",
        "Mahindra Homes"
      ],
      "url": "https://www.mahindralifespaces.com/",
      "logo": "https://mahindralifespaceshomes.in/images/mahindra-lifespaces-logo.svg",
      "tickerSymbol": ["NSE:MAHLIFE", "BSE:532313"],
      "foundingDate": "1994",
      "identifier": "CIN: L45200MH1999PLC118949",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Mahindra_Lifespaces",
        "https://www.wikidata.org/wiki/Q6734139",
        "https://www.mahindra.com/",
        "https://www.bseindia.com/stock-share-price/mahindra-lifespace-developers-ltd/mahlife/532313/",
        "https://www.nseindia.com/get-quotes/equity?symbol=MAHLIFE"
      ],
      "parentOrganization": {
        "@type": "Organization",
        "name": "Mahindra Group",
        "url": "https://www.mahindra.com/",
        "sameAs": [
          "https://en.wikipedia.org/wiki/Mahindra_Group",
          "https://www.wikidata.org/wiki/Q1143899"
        ]
      }
    },
    {
      "@type": "ApartmentComplex",
      "@id": "https://mahindralifespaceshomes.in/#project",
      "name": "Mahindra Mahalunge",
      "alternateName": [
        "Mahindra Lifespaces Mahalunge",
        "Mahindra Lifespaces Mahalunge Pune",
        "Mahindra Mahalunge Pune",
        "Mahindra Mahalunge New Project Launch",
        "Mahindra Lifespaces Pune New Launch",
        "Mahindra Mahalunge Pre-Launch",
        "Mahindra New Launch Mahalunge",
        "Mahindra Nande Mahalunge",
        "Mahindra Lifespaces Nande",
        "Mahindra Homes Mahalunge",
        "Mahindra Properties Mahalunge",
        "Mahindra 13.46 Acres Mahalunge",
        "Mahindra Lifespaces Hinjewadi Baner",
        "Mahindra Lifespaces Pune Projects"
      ],
      "description": "Mahindra Mahalunge by Mahindra Lifespaces is a landmark 13.46-acre master-planned residential development in the Nande-Mahalunge growth corridor near Hinjewadi Phase 1 and Baner, West Pune.",
      "telephone": "+91-20-67000000",
      "url": "https://mahindralifespaceshomes.in/",
      "priceRange": "₹65 Lakhs - ₹3.2 Crore",
      "currenciesAccepted": "INR",
      "paymentAccepted": "Bank Transfer, Cheque, Home Loan",
      "hasMap": "https://maps.google.com/?q=18.5714,73.7432",
      "keywords": allMahindraKeywordPermutations.join(", "),
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Mahalunge-Nande Road, near Hinjewadi Phase 1",
        "addressLocality": "Mahalunge, Mulshi Taluka",
        "addressRegion": "Pune, Maharashtra",
        "postalCode": "411045",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.5714,
        "longitude": 73.7432
      },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Mahindra Mahalunge Residential Configurations",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "2 BHK Optima Suite",
            "description": "2 BHK Luxury Flats at Mahindra Mahalunge, 785 - 895 sq.ft. carpet area",
            "price": "6500000",
            "priceCurrency": "INR",
            "availability": "https://schema.org/PreOrder"
          },
          {
            "@type": "Offer",
            "name": "3 BHK Luxe Residence",
            "description": "3 BHK Premium Residences at Mahindra Mahalunge, 1,120 - 1,210 sq.ft. carpet area",
            "price": "10500000",
            "priceCurrency": "INR",
            "availability": "https://schema.org/PreOrder"
          },
          {
            "@type": "Offer",
            "name": "4 BHK Signature Estate",
            "description": "4 BHK Sky Estates at Mahindra Mahalunge, 1,650 - 1,820 sq.ft. carpet area",
            "price": "22000000",
            "priceCurrency": "INR",
            "availability": "https://schema.org/PreOrder"
          }
        ]
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "148"
      },
      "developer": {
        "@id": "https://mahindralifespaceshomes.in/#organization"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0c1017" />

    <!-- Favicons & Mobile Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="search" type="application/opensearchdescription+xml" title="Mahindra Mahalunge Search" href="/opensearch.xml" />
    <link rel="alternate" type="application/rss+xml" title="Mahindra Mahalunge Real Estate & Research Intelligence" href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mahindra Mahalunge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {shouldRenderBreadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
    )}
    {customSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(customSchema)} />
    )}

    <style is:global>
      :root {
        --font-serif: 'Cinzel', serif;
        --font-sans: 'Plus Jakarta Sans', sans-serif;
      }
      body {
        font-family: var(--font-sans);
        background-color: #0c1017;
        color: #f3efe6;
        overflow-x: hidden;
      }
      h1, h2, h3, .font-serif {
        font-family: var(--font-serif);
      }
      /* Custom Luxury Scrollbar */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #0e131c;
      }
      ::-webkit-scrollbar-thumb {
        background: #333e54;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #d4af66;
      }
      
      /* Luminous Glass Cards */
      .glass-card {
        background: linear-gradient(145deg, rgba(28, 35, 49, 0.75) 0%, rgba(16, 21, 31, 0.88) 100%);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .glass-card:hover {
        border-color: rgba(212, 175, 102, 0.45);
        transform: translateY(-4px);
        box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.65), 0 0 30px -4px rgba(212, 175, 102, 0.2), inset 0 1px 0 0 rgba(212, 175, 102, 0.3);
      }

      /* Luminous Champagne Highlight Card */
      .glass-card-glow {
        background: linear-gradient(145deg, rgba(34, 43, 62, 0.85) 0%, rgba(20, 26, 38, 0.92) 100%);
        backdrop-filter: blur(28px);
        border: 1px solid rgba(212, 175, 102, 0.3);
        box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.6), 0 0 40px -10px rgba(212, 175, 102, 0.25);
      }

      /* Radiant Warm Gold Gradients */
      .gold-gradient-text {
        background: linear-gradient(135deg, #ffffff 0%, #faecd7 25%, #d4af66 70%, #b88d3e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .gold-gradient-subtle {
        background: linear-gradient(135deg, #fdfbf7 0%, #e6d8bf 60%, #c0a377 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Button Glows & Shimmer */
      .red-glow-btn {
        background: linear-gradient(135deg, #e31837 0%, #c8102e 55%, #990f23 100%);
        box-shadow: 0 6px 24px -2px rgba(227, 24, 55, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.25);
        position: relative;
        overflow: hidden;
        transition: all 0.35s ease;
      }
      .red-glow-btn:hover {
        box-shadow: 0 10px 36px rgba(227, 24, 55, 0.7), inset 0 1px 0 0 rgba(255, 255, 255, 0.4);
        transform: translateY(-2px);
      }
      
      .gold-glow-btn {
        background: linear-gradient(135deg, #faecd7 0%, #d4af66 50%, #b89045 100%);
        box-shadow: 0 6px 24px -2px rgba(212, 175, 102, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.4);
        position: relative;
        overflow: hidden;
        transition: all 0.35s ease;
      }
      .gold-glow-btn:hover {
        box-shadow: 0 10px 36px rgba(212, 175, 102, 0.65), inset 0 1px 0 0 rgba(255, 255, 255, 0.6);
        transform: translateY(-2px);
      }

      /* Luxury Sweep Shimmer Animation on Buttons */
      .btn-shimmer::after {
        content: '';
        position: absolute;
        top: -60%;
        left: -60%;
        width: 220%;
        height: 220%;
        background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.4) 50%, transparent 60%);
        transform: rotate(25deg) translateX(-100%);
        transition: transform 0.75s ease-out;
        pointer-events: none;
      }
      .btn-shimmer:hover::after {
        transform: rotate(25deg) translateX(100%);
      }

      /* Scroll Reveal Animations */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .reveal-scale {
        opacity: 0;
        transform: scale(0.94) translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-scale.revealed {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      .delay-100 { transition-delay: 100ms; }
      .delay-200 { transition-delay: 200ms; }
      .delay-300 { transition-delay: 300ms; }
      .delay-400 { transition-delay: 400ms; }
    </style>
  </head>
  <body class="bg-[#0c1017] text-stone-100 antialiased selection:bg-brand-red/30 selection:text-white relative">
    
    <!-- Luminous Luxury Ambient Lighting Atmosphere -->
    <!-- Geometric Radial Grid Overlay -->
    <div class="fixed inset-0 bg-[radial-gradient(#d4af66_1px,transparent_1px)] [background-size:40px_40px] opacity-[0.035] pointer-events-none -z-10"></div>

    <!-- Radiant Ambient Lighting Orbs -->
    <div class="fixed -top-40 left-1/4 -translate-x-1/2 w-[800px] h-[600px] bg-gradient-to-br from-gold-500/[0.12] via-gold-600/[0.06] to-transparent rounded-full blur-[140px] pointer-events-none -z-10 animate-float"></div>
    <div class="fixed top-1/4 -right-40 w-[700px] h-[700px] bg-gradient-to-bl from-emerald-500/[0.08] via-teal-600/[0.04] to-transparent rounded-full blur-[150px] pointer-events-none -z-10 animate-pulse-slow"></div>
    <div class="fixed top-2/3 -left-40 w-[750px] h-[600px] bg-gradient-to-tr from-brand-red/[0.09] via-rose-700/[0.05] to-transparent rounded-full blur-[160px] pointer-events-none -z-10 animate-float-slow"></div>
    <div class="fixed bottom-0 right-1/4 w-[600px] h-[500px] bg-gradient-to-t from-gold-500/[0.08] to-transparent rounded-full blur-[130px] pointer-events-none -z-10"></div>

    <Navbar />
    
    <main class="min-h-screen">
      <slot />
    </main>

    <Footer />

    <!-- Interactive Components -->
    <LeadModal />
    <StickyBar />

    <!-- High-Performance Zero-Dependency Animation & Scroll Reveal Engine -->
    <script>
      // Scroll Reveal Observer
      function initScrollReveals() {
        const revealElements = document.querySelectorAll('.reveal, .reveal-scale');
        if (!revealElements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                // Optional: once revealed, unobserve to free GPU
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      }

      // Animated Numerical Counters
      function initCounters() {
        const counters = document.querySelectorAll('[data-counter]');
        if (!counters.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const target = parseFloat(el.getAttribute('data-counter') || '0');
                const suffix = el.getAttribute('data-suffix') || '';
                const prefix = el.getAttribute('data-prefix') || '';
                const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
                const duration = 1800; // ms
                const startTime = performance.now();

                function updateCounter(currentTime: number) {
                  const elapsed = currentTime - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  // Ease out cubic
                  const easeOut = 1 - Math.pow(1 - progress, 3);
                  const currentVal = target * easeOut;

                  el.textContent = `${prefix}${currentVal.toLocaleString('en-IN', {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals,
                  })}${suffix}`;

                  if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                  }
                }

                requestAnimationFrame(updateCounter);
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.2 }
        );

        counters.forEach((el) => observer.observe(el));
      }

      // Initialize on DOM ready and view transitions
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initScrollReveals();
          initCounters();
        });
      } else {
        initScrollReveals();
        initCounters();
      }

      // Connect Lead Modal Triggers
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-open-modal]');
        if (target) {
          const interest = target.getAttribute('data-interest') || 'General Enquiry';
          const unit = target.getAttribute('data-unit') || '';
          window.dispatchEvent(
            new CustomEvent('open-lead-modal', {
              detail: { interest, unit },
            })
          );
        }
      });
    </script>
  </body>
</html>
