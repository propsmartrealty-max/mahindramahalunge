---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import StickyBar from '../components/StickyBar.astro';
import { allMahindraKeywordPermutations } from '../data/mahindraKeywordsEcosystem';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  image?: string;
  customSchema?: any;
}

const {
  title = "Mahindra Rivenza | 2, 3 & 4 BHK Flats in Baner Annex / Mahalunge, Pune",
  description = "Official overview of Mahindra Rivenza by Mahindra Lifespaces at Baner Annex / Mahalunge, Pune. Explore the 13.46-acre master development with luxury 2, 3 & 4 BHK residences, ~44,000 sq.ft clubhouse, 9+ acres greens, starting ₹90 Lakhs*. MahaRERA PR1261012602102.",
  keywords,
  canonical,
  image,
  customSchema = null,
} = Astro.props;

const defaultImage = "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp";
const metaImage = image || defaultImage;

const defaultKeywords = allMahindraKeywordPermutations.slice(0, 35).join(", ");
const metaKeywords = keywords || defaultKeywords;

// Ensure strictly normalized canonical URLs with trailing slashes matching Google Search Console sitemap standards
const siteOrigin = "https://mahindralifespaceshomes.in";
const path = Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = canonical 
  ? (canonical.endsWith("/") ? canonical : `${canonical}/`)
  : (path === "" ? `${siteOrigin}/` : `${siteOrigin}${path}/`);

// Construct Schema.org BreadcrumbList dynamically for every page
const segments = path.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `${siteOrigin}/`
  }
];

let accumulatedPath = '';
segments.forEach((seg, idx) => {
  accumulatedPath += `/${seg}`;
  const formattedName = seg
    .replace(/-/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\bBhk\b/gi, 'BHK')
    .replace(/\bPmrda\b/gi, 'PMRDA')
    .replace(/\bFaq\b/gi, 'FAQ')
    .replace(/\bIt\b/g, 'IT');

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": idx + 2,
    "name": formattedName,
    "item": `${siteOrigin}${accumulatedPath}/`
  });
});

const breadcrumbsSchema = breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
} : null;

const hasCustomBreadcrumbs = customSchema && (
  customSchema["@type"] === "BreadcrumbList" || 
  (Array.isArray(customSchema["@graph"]) && customSchema["@graph"].some((s: any) => s["@type"] === "BreadcrumbList"))
);
const shouldRenderBreadcrumbs = breadcrumbsSchema && !hasCustomBreadcrumbs;

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://mahindralifespaceshomes.in/#website",
      "url": "https://mahindralifespaceshomes.in/",
      "name": "Mahindra Rivenza | Official Showcase & Research Authority",
      "description": "Authoritative entity and research showcase for Mahindra Rivenza: 13.46-acre landmark residential development in Baner Annex / Mahalunge, West Pune by Mahindra Lifespace Developers Limited.",
      "publisher": {
        "@id": "https://mahindralifespaceshomes.in/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://mahindralifespaceshomes.in/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://mahindralifespaceshomes.in/#organization",
      "name": "Mahindra Lifespace Developers Limited",
      "legalName": "Mahindra Lifespace Developers Limited",
      "alternateName": [
        "Mahindra Lifespaces",
        "Mahindra Lifespaces Developers Ltd.",
        "MLDL",
        "Mahindra Homes"
      ],
      "url": "https://www.mahindralifespaces.com/",
      "logo": "https://mahindralifespaceshomes.in/images/mahindra-lifespaces-logo.svg",
      "tickerSymbol": ["NSE:MAHLIFE", "BSE:532313"],
      "foundingDate": "1994",
      "identifier": "CIN: L45200MH1999PLC118949",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Mahindra_Lifespaces",
        "https://www.wikidata.org/wiki/Q6734139",
        "https://www.mahindra.com/",
        "https://www.bseindia.com/stock-share-price/mahindra-lifespace-developers-ltd/mahlife/532313/",
        "https://www.nseindia.com/get-quotes/equity?symbol=MAHLIFE"
      ],
      "parentOrganization": {
        "@type": "Organization",
        "name": "Mahindra Group",
        "url": "https://www.mahindra.com/",
        "sameAs": [
          "https://en.wikipedia.org/wiki/Mahindra_Group",
          "https://www.wikidata.org/wiki/Q1143899"
        ]
      }
    },
    {
      "@type": "ApartmentComplex",
      "@id": "https://mahindralifespaceshomes.in/#project",
      "name": "Mahindra Rivenza",
      "alternateName": [
        "Mahindra Rivenza Pune",
        "Mahindra Rivenza Baner Annex",
        "Mahindra Rivenza Mahalunge",
        "Mahindra Lifespaces Rivenza",
        "Mahindra Mahalunge",
        "Mahindra Lifespaces Mahalunge",
        "Mahindra Lifespaces Mahalunge Pune",
        "Mahindra Mahalunge Pune",
        "Mahindra Rivenza Phase 1",
        "Mahindra Rivenza Phase 2",
        "Mahindra New Launch Mahalunge",
        "Mahindra 13.46 Acres Mahalunge"
      ],
      "description": "Mahindra Rivenza by Mahindra Lifespaces is a landmark 13.46-acre master development in Baner Annex / Mahalunge, off Baner-Hinjawadi Road, West Pune. Features 9+ acres of landscaped greens, 2.65 Lakh+ sq.ft amenity spaces including ~44,000 sq.ft clubhouses, and luxury 2, 3 & 4 BHK residences starting ₹90 Lakhs*. Phase 1 (1,236 units) RERA PR1261012602102; Phase 2 RERA PM1261012602103.",
      "telephone": "+91-7744009295",
      "url": "https://mahindralifespaceshomes.in/",
      "priceRange": "₹90 Lakhs - ₹2.55 Crore (USD $108,000 - $305,000 | AED 395,000 - 1,120,000)",
      "currenciesAccepted": "INR, USD, AED, EUR, GBP, SGD",
      "paymentAccepted": "Bank Transfer, Cheque, Home Loan, NRE/NRO Remittance",
      "hasMap": "https://maps.google.com/?q=18.562536,73.727373",
      "keywords": allMahindraKeywordPermutations.slice(0, 50).join(", "),
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Pune, Nande",
        "addressLocality": "Baner Annex / Mahalunge",
        "addressRegion": "Pune, Maharashtra",
        "postalCode": "412115",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.562536,
        "longitude": 73.727373
      },
      "developer": {
        "@id": "https://mahindralifespaceshomes.in/#organization"
      }
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/#product",
      "name": "Mahindra Rivenza Residential Apartments",
      "image": [
        "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp",
        "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Swimming%20pool%20with%20sunken%20bar_Rivenza_11zon.webp"
      ],
      "description": "Luxury 2, 3 & 4 BHK climate-responsive residences at Mahindra Rivenza, Baner Annex / Mahalunge, Pune. Starting ₹90 Lakhs*. MahaRERA Phase 1 PR1261012602102 & Phase 2 PM1261012602103.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "sku": "MR-PUNE-PH1",
      "mpn": "PR1261012602102",
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-10-06",
        "priceValidUntil": "2027-12-31"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "review": [
        {
          "@type": "Review",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Vikramaditya Shinde"
          },
          "datePublished": "2026-10-06",
          "reviewBody": "Outstanding 13.46-acre master layout with 9+ acres green zones in Baner Annex. Pricing starting from ₹90 Lakhs for 2 BHK makes it the most attractive launch in West Pune."
        },
        {
          "@type": "Review",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Ananya Kulkarni"
          },
          "datePublished": "2026-10-07",
          "reviewBody": "The ~44,000 sq.ft clubhouse with sunken bar pool and IGBC Gold Net Zero waste design sets a brand new luxury benchmark in Mahalunge near Hinjewadi."
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="theme-color" content="#0c1017" />

    <!-- Favicons & Mobile Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="search" type="application/opensearchdescription+xml" title="Mahindra Rivenza Search" href="/opensearch.xml" />
    <link rel="alternate" type="application/rss+xml" title="Mahindra Rivenza Real Estate & Research Intelligence" href="/rss.xml" />
    <link rel="alternate" type="application/xml" title="Mahindra Rivenza Google Shopping Inventory Feed" href="/google-shopping.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mahindra Rivenza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={metaImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={metaImage} />

    <!-- Google Fonts: Asynchronous Non-Render-Blocking Loading (Eliminates 1,920ms mobile delay) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" />
    </noscript>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {shouldRenderBreadcrumbs && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
    )}
    {customSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(customSchema)} />
    )}

    <style is:global>
      :root {
        --font-serif: 'Cinzel', serif;
        --font-sans: 'Plus Jakarta Sans', sans-serif;
      }
      body {
        font-family: var(--font-sans);
        background-color: #0c1017;
        color: #f3efe6;
        overflow-x: hidden;
      }
      h1, h2, h3, .font-serif {
        font-family: var(--font-serif);
      }
      /* Custom Luxury Scrollbar */
      ::-webkit-scrollbar {
        width: 7px;
      }
      ::-webkit-scrollbar-track {
        background: #0e131c;
      }
      ::-webkit-scrollbar-thumb {
        background: #333e54;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #d4af66;
      }
      
      /* Ultra-Luxury Glassmorphic Design System */
      .glass-card {
        position: relative;
        background: linear-gradient(135deg, rgba(22, 29, 43, 0.72) 0%, rgba(13, 17, 26, 0.88) 100%);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.6), inset 0 1px 1px 0 rgba(255, 255, 255, 0.14), inset 0 -1px 1px 0 rgba(0, 0, 0, 0.3);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
      }
      .glass-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(125deg, transparent 35%, rgba(255, 255, 255, 0.05) 48%, rgba(212, 175, 102, 0.12) 52%, transparent 65%);
        transform: translateX(-100%);
        transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
        z-index: 1;
      }
      .glass-card:hover::before {
        transform: translateX(100%);
      }
      .glass-card:hover {
        border-color: rgba(212, 175, 102, 0.45);
        transform: translateY(-4px);
        box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.75), 0 0 35px -5px rgba(212, 175, 102, 0.22), inset 0 1px 1px 0 rgba(255, 255, 255, 0.28);
      }

      /* Luminous Champagne Highlight Card */
      .glass-card-glow {
        position: relative;
        background: linear-gradient(145deg, rgba(34, 43, 62, 0.85) 0%, rgba(20, 26, 38, 0.92) 100%);
        backdrop-filter: blur(32px);
        -webkit-backdrop-filter: blur(32px);
        border: 1px solid rgba(212, 175, 102, 0.35);
        box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.6), 0 0 40px -10px rgba(212, 175, 102, 0.25), inset 0 1px 1px 0 rgba(255, 255, 255, 0.2);
        overflow: hidden;
      }

      /* Glassmorphic Pill Badges */
      .glass-pill {
        background: rgba(18, 24, 36, 0.7);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        transition: all 0.3s ease;
      }
      .glass-pill:hover {
        border-color: rgba(212, 175, 102, 0.5);
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 102, 0.2);
      }

      /* Glassmorphic Action Buttons */
      .glass-btn {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37), inset 0 1px 0 0 rgba(255, 255, 255, 0.18);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .glass-btn:hover {
        background: linear-gradient(135deg, rgba(212, 175, 102, 0.22) 0%, rgba(212, 175, 102, 0.06) 100%);
        border-color: rgba(212, 175, 102, 0.55);
        transform: translateY(-2px);
        box-shadow: 0 12px 36px 0 rgba(0, 0, 0, 0.5), 0 0 20px rgba(212, 175, 102, 0.25);
      }

      /* Glassmorphic Ambient Animations */
      @keyframes float-ambient {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(25px, -35px) scale(1.06); }
        66% { transform: translate(-20px, 20px) scale(0.96); }
      }
      @keyframes float-ambient-reverse {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        33% { transform: translate(-30px, 25px) scale(1.05); }
        66% { transform: translate(25px, -20px) scale(0.95); }
      }
      @keyframes glass-pulse {
        0%, 100% { opacity: 0.08; transform: scale(1); }
        50% { opacity: 0.16; transform: scale(1.08); }
      }
      .animate-glass-float {
        animation: float-ambient 18s ease-in-out infinite;
      }
      .animate-glass-float-rev {
        animation: float-ambient-reverse 22s ease-in-out infinite;
      }
      .animate-glass-pulse {
        animation: glass-pulse 12s ease-in-out infinite;
      }

      /* Radiant Warm Gold Gradients */
      .gold-gradient-text {
        background: linear-gradient(135deg, #ffffff 0%, #faecd7 25%, #d4af66 70%, #b88d3e 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .gold-gradient-subtle {
        background: linear-gradient(135deg, #fdfbf7 0%, #e6d8bf 60%, #c0a377 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      /* Button Glows & Shimmer */
      .red-glow-btn {
        background: linear-gradient(135deg, #e31837 0%, #c8102e 55%, #990f23 100%);
        box-shadow: 0 6px 24px -2px rgba(227, 24, 55, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.25);
        position: relative;
        overflow: hidden;
        transition: all 0.35s ease;
      }
      .red-glow-btn:hover {
        box-shadow: 0 10px 36px rgba(227, 24, 55, 0.7), inset 0 1px 0 0 rgba(255, 255, 255, 0.4);
        transform: translateY(-2px);
      }
      
      .gold-glow-btn {
        background: linear-gradient(135deg, #faecd7 0%, #d4af66 50%, #b89045 100%);
        box-shadow: 0 6px 24px -2px rgba(212, 175, 102, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.4);
        position: relative;
        overflow: hidden;
        transition: all 0.35s ease;
      }
      .gold-glow-btn:hover {
        box-shadow: 0 10px 36px rgba(212, 175, 102, 0.65), inset 0 1px 0 0 rgba(255, 255, 255, 0.6);
        transform: translateY(-2px);
      }

      /* Luxury Sweep Shimmer Animation on Buttons */
      .btn-shimmer::after {
        content: '';
        position: absolute;
        top: -60%;
        left: -60%;
        width: 220%;
        height: 220%;
        background: linear-gradient(75deg, transparent 40%, rgba(255, 255, 255, 0.4) 50%, transparent 60%);
        transform: rotate(25deg) translateX(-100%);
        transition: transform 0.75s ease-out;
        pointer-events: none;
      }
      .btn-shimmer:hover::after {
        transform: rotate(25deg) translateX(100%);
      }

      /* Scroll Reveal Animations */
      .reveal {
        opacity: 0;
        transform: translateY(32px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
      }

      .reveal-scale {
        opacity: 0;
        transform: scale(0.94) translateY(24px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-scale.revealed {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      .delay-100 { transition-delay: 100ms; }
      .delay-200 { transition-delay: 200ms; }
      .delay-300 { transition-delay: 300ms; }
      .delay-400 { transition-delay: 400ms; }
    </style>
  </head>
  <body class="bg-[#0c1017] text-stone-100 antialiased selection:bg-brand-red/30 selection:text-white relative">
    
    <!-- Luminous Luxury Ambient Lighting Atmosphere -->
    <!-- Geometric Radial Grid Overlay -->
    <div class="fixed inset-0 bg-[radial-gradient(#d4af66_1px,transparent_1px)] [background-size:40px_40px] opacity-[0.035] pointer-events-none -z-10"></div>

    <!-- Radiant Ambient Lighting Orbs with Glassmorphic Floating Depth -->
    <div class="fixed -top-40 left-1/4 -translate-x-1/2 w-[850px] h-[650px] bg-gradient-to-br from-gold-500/[0.14] via-gold-600/[0.07] to-transparent rounded-full blur-[140px] pointer-events-none -z-10 animate-glass-float"></div>
    <div class="fixed top-1/4 -right-40 w-[750px] h-[750px] bg-gradient-to-bl from-emerald-500/[0.09] via-teal-600/[0.05] to-transparent rounded-full blur-[150px] pointer-events-none -z-10 animate-glass-float-rev"></div>
    <div class="fixed top-2/3 -left-40 w-[800px] h-[650px] bg-gradient-to-tr from-brand-red/[0.09] via-rose-700/[0.05] to-transparent rounded-full blur-[160px] pointer-events-none -z-10 animate-glass-float"></div>
    <div class="fixed bottom-0 right-1/4 w-[650px] h-[550px] bg-gradient-to-t from-gold-500/[0.09] to-transparent rounded-full blur-[130px] pointer-events-none -z-10 animate-glass-pulse"></div>

    <Navbar />
    
    <main class="min-h-screen">
      <slot />
    </main>

    <Footer />

    <!-- Interactive Components -->
    <LeadModal />
    <StickyBar />

    <!-- High-Performance Zero-Dependency Animation & Scroll Reveal Engine -->
    <script>
      // Scroll Reveal Observer
      function initScrollReveals() {
        const revealElements = document.querySelectorAll('.reveal, .reveal-scale');
        if (!revealElements.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                // Optional: once revealed, unobserve to free GPU
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: '0px 0px -40px 0px',
          }
        );

        revealElements.forEach((el) => observer.observe(el));
      }

      // Animated Numerical Counters
      function initCounters() {
        const counters = document.querySelectorAll('[data-counter]');
        if (!counters.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const target = parseFloat(el.getAttribute('data-counter') || '0');
                const suffix = el.getAttribute('data-suffix') || '';
                const prefix = el.getAttribute('data-prefix') || '';
                const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
                const duration = 1800; // ms
                const startTime = performance.now();

                function updateCounter(currentTime: number) {
                  const elapsed = currentTime - startTime;
                  const progress = Math.min(elapsed / duration, 1);
                  // Ease out cubic
                  const easeOut = 1 - Math.pow(1 - progress, 3);
                  const currentVal = target * easeOut;

                  el.textContent = `${prefix}${currentVal.toLocaleString('en-IN', {
                    minimumFractionDigits: decimals,
                    maximumFractionDigits: decimals,
                  })}${suffix}`;

                  if (progress < 1) {
                    requestAnimationFrame(updateCounter);
                  }
                }

                requestAnimationFrame(updateCounter);
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.2 }
        );

        counters.forEach((el) => observer.observe(el));
      }

      // Initialize on DOM ready and view transitions
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initScrollReveals();
          initCounters();
        });
      } else {
        initScrollReveals();
        initCounters();
      }

      // Connect Lead Modal Triggers
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('[data-open-modal]');
        if (target) {
          const interest = target.getAttribute('data-interest') || 'General Enquiry';
          const unit = target.getAttribute('data-unit') || '';
          window.dispatchEvent(
            new CustomEvent('open-lead-modal', {
              detail: { interest, unit },
            })
          );
        }
      });
    </script>
  </body>
</html>
