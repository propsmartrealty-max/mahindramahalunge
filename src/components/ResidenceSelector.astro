---
// ResidenceSelector.astro - Interactive Luxury Master Layout & Residence Explorer
---

<div class="w-full glass-card border border-white/10 rounded-2xl p-6 lg:p-10 shadow-2xl relative overflow-hidden">
  
  <!-- Top Selector Navigation -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6">
    <div>
      <span class="text-[11px] uppercase tracking-widest text-gold-400 font-bold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
        Curated Master Township &amp; Residences
      </span>
      <h3 class="font-serif text-2xl lg:text-3xl text-stone-100 font-bold">Interactive Plan &amp; Layout Explorer</h3>
    </div>

    <!-- Configuration Tabs -->
    <div class="flex items-center space-x-1.5 sm:space-x-2 bg-[#0e121a]/90 p-1.5 rounded-xl border border-white/10 backdrop-blur-md overflow-x-auto">
      <button
        id="tab-master"
        class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider text-stone-300 hover:text-white transition-all whitespace-nowrap"
      >
        Master Layout
      </button>
      <button
        id="tab-2bhk"
        class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider text-stone-300 hover:text-white transition-all whitespace-nowrap"
      >
        2 BHK
      </button>
      <button
        id="tab-3bhk"
        class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 shadow-md transition-all whitespace-nowrap"
      >
        3 BHK
      </button>
      <button
        id="tab-4bhk"
        class="tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider text-stone-300 hover:text-white transition-all whitespace-nowrap"
      >
        4 BHK
      </button>
    </div>
  </div>

  <!-- Main Residence Detail Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-8 items-start">
    
    <!-- Left Col: Interactive Blueprint Canvas -->
    <div class="lg:col-span-7 bg-[#0c1017]/95 rounded-xl border border-white/10 p-4 sm:p-5 relative overflow-hidden group shadow-inner">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs text-stone-300 border-b border-white/10 pb-2.5">
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="blueprint-mode-label" class="text-[11px] uppercase tracking-wider text-emerald-400 font-semibold">
            Official Architectural Layout Blueprint
          </span>
        </div>
        <div class="flex items-center space-x-2">
          <button 
            id="blueprint-toggle-btn"
            class="px-3 py-1.5 rounded-lg bg-gold-500/15 hover:bg-gold-500/25 border border-gold-400/40 text-gold-300 hover:text-white text-[10px] uppercase tracking-wider font-semibold transition-all"
          >
            Switch to Schematic
          </button>
          <button 
            id="zoom-toggle-btn"
            class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-gold-500/20 hover:border-gold-400/40 border border-white/10 text-stone-200 hover:text-gold-300 text-[10px] uppercase tracking-wider transition-all"
          >
            Zoom Blueprint
          </button>
        </div>
      </div>

      <!-- Blueprint Container -->
      <div id="blueprint-container" class="transition-transform duration-300 origin-center min-h-[320px] flex items-center justify-center">
        <!-- Official CAD Image Target (Used for 2 BHK) -->
        <div id="cad-target" class="w-full h-auto hidden">
          <div class="relative rounded-lg overflow-hidden border border-gold-500/20 bg-white p-2 sm:p-4 shadow-xl">
            <img 
              id="cad-img"
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/2BHK%2520Premium.webp" 
              alt="Official Mahindra Rivenza Architectural CAD Floor Plan" 
              class="w-full h-auto object-contain max-h-[380px] mx-auto filter contrast-[1.05]"
              loading="lazy"
              width="650"
              height="400"
            />
            <div class="absolute bottom-2 right-2 px-2.5 py-1 rounded bg-charcoal-950/80 backdrop-blur-md border border-gold-400/30 text-[9px] uppercase tracking-widest text-gold-400 font-bold">
              Official CAD Drawing • MLDL
            </div>
          </div>
        </div>
        <!-- High-Resolution Architectural SVG Blueprint Target -->
        <div id="svg-target" class="w-full h-auto"></div>
      </div>

      <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-stone-300">
        <span id="blueprint-footer-note">✦ Official Sanctioned Layout Blueprint</span>
        <span class="text-gold-400 font-medium">100% Vastu Compliant Orientation</span>
      </div>
    </div>

    <!-- Right Col: Specifications & Features -->
    <div class="lg:col-span-5 space-y-6">
      <div>
        <div id="unit-collection-label" class="text-xs uppercase tracking-widest text-gold-400 font-semibold">3 BHK Collection</div>
        <h4 id="unit-name" class="font-serif text-2xl text-stone-100 font-bold mt-1">3 BHK Luxe Residence</h4>
        <p id="unit-desc" class="text-xs text-stone-300 mt-2 leading-relaxed">
          Engineered with Mahindra Lifespaces' "Homes of Positive Energy" philosophy, prioritizing abundant cross-ventilation, deep daylight penetration, and generous panoramic outdoor decks.
        </p>
      </div>

      <!-- Key Specs Table -->
      <div class="bg-[#0c1017]/85 rounded-xl border border-white/10 divide-y divide-white/5 text-xs">
        <div class="p-3.5 flex justify-between">
          <span id="spec-carpet-label" class="text-stone-400">RERA Carpet Area</span>
          <span id="spec-carpet" class="font-semibold text-stone-100">882 – 1,065 sq.ft. (995 – 1,206 sq.ft. Agg.)</span>
        </div>
        <div class="p-3.5 flex justify-between">
          <span id="spec-balcony-label" class="text-stone-400">Exclusive EBVT / Balcony Deck</span>
          <span id="spec-balcony" class="font-semibold text-stone-100">113 – 141 sq.ft.*</span>
        </div>
        <div class="p-3.5 flex justify-between">
          <span class="text-stone-400">Primary Orientation</span>
          <span id="spec-orient" class="font-semibold text-stone-100">East - West Cross Breeze</span>
        </div>
        <div class="p-3.5 flex justify-between">
          <span class="text-stone-400">Facing &amp; Vista</span>
          <span id="spec-view" class="font-semibold text-stone-100">Central Landscaped Greens &amp; River</span>
        </div>
        <div class="p-3.5 flex justify-between">
          <span class="text-stone-400">Development Phase</span>
          <span id="spec-tower" class="font-semibold text-stone-100">Phase 1 &amp; Phase 2</span>
        </div>
      </div>

      <!-- Architectural Highlights -->
      <div>
        <h5 class="text-xs uppercase tracking-widest text-stone-200 font-semibold mb-3">Architectural Highlights</h5>
        <ul id="highlights-list" class="space-y-2 text-xs text-stone-300">
          <li class="flex items-start space-x-2">
            <span class="text-gold-400 mt-0.5">✦</span>
            <span>Triple-exposure cross ventilation maximising daylight and air flow</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400 mt-0.5">✦</span>
            <span>Separate guest bedroom flexible as a hybrid work studio / library</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400 mt-0.5">✦</span>
            <span>Large double-height balcony overlooking private organic groves</span>
          </li>
        </ul>
      </div>

      <!-- Action CTAs -->
      <div class="pt-2 flex flex-col sm:flex-row gap-3">
        <button
          id="enquire-layout-btn"
          data-open-modal
          data-interest="Residence Enquiry"
          class="btn-shimmer flex-1 py-3 px-4 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-widest hover:shadow-gold-500/20 hover:shadow-lg transition-all"
        >
          Enquire For This Layout
        </button>
        <button
          id="download-plan-btn"
          data-open-modal
          data-interest="Download Floor Plan"
          class="py-3 px-4 rounded-xl border border-white/20 hover:border-gold-400/60 bg-white/5 hover:bg-white/10 text-stone-200 hover:text-white text-xs uppercase tracking-wider transition-all flex items-center justify-center space-x-2"
        >
          <svg class="w-4 h-4 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span id="download-plan-label">Download Plan</span>
        </button>
      </div>

      <p class="text-[10px] text-stone-400 italic">
        *Final RERA carpet area, room configurations and structural columns are subject to MahaRERA and statutory sanctions.
      </p>
    </div>

  </div>

</div>

