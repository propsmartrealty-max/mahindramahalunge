  let currentKey = '3 BHK';
  let isZoomed = false;
  let isCadMode = false;

  function renderUnit(key: string) {
    currentKey = key;
    const item = data[key];
    if (!item) return;

    const label = document.getElementById('unit-collection-label');
    const name = document.getElementById('unit-name');
    const desc = document.getElementById('unit-desc');
    const carpetLabel = document.getElementById('spec-carpet-label');
    const carpet = document.getElementById('spec-carpet');
    const balconyLabel = document.getElementById('spec-balcony-label');
    const balcony = document.getElementById('spec-balcony');
    const orient = document.getElementById('spec-orient');
    const view = document.getElementById('spec-view');
    const tower = document.getElementById('spec-tower');
    const highlights = document.getElementById('highlights-list');
    const svgTarget = document.getElementById('svg-target');
    const cadTarget = document.getElementById('cad-target');
    const cadImg = document.getElementById('cad-img') as HTMLImageElement;
    const modeBtn = document.getElementById('blueprint-toggle-btn');
    const modeLabel = document.getElementById('blueprint-mode-label');
    const footerNote = document.getElementById('blueprint-footer-note');
    const downloadPlanLabel = document.getElementById('download-plan-label');

    if (label) label.textContent = item.label;
    if (name) name.textContent = item.name;
    if (desc) desc.textContent = item.desc;
    if (carpetLabel) carpetLabel.textContent = item.carpetLabel;
    if (carpet) carpet.textContent = item.carpet;
    if (balconyLabel) balconyLabel.textContent = item.balconyLabel;
    if (balcony) balcony.textContent = item.balcony;
    if (orient) orient.textContent = item.orient;
    if (view) view.textContent = item.view;
    if (tower) tower.textContent = item.tower;

    if (downloadPlanLabel) {
      downloadPlanLabel.textContent = key === 'Master Layout' ? 'Download Master Layout PDF' : `Download ${key} Plan PDF`;
    }

    if (highlights) {
      highlights.innerHTML = item.highlights
        .map((h: string) => `<li class="flex items-start space-x-2"><span class="text-gold-400 mt-0.5">✦</span><span>${h}</span></li>`)
        .join('');
    }

    if (svgTarget) {
      svgTarget.innerHTML = item.svg;
    }

    // Handle CAD view vs Schematic view
    if (item.cadImage && isCadMode) {
      if (cadTarget) cadTarget.classList.remove('hidden');
      if (svgTarget) svgTarget.classList.add('hidden');
      if (cadImg) cadImg.src = item.cadImage;
      if (modeBtn) {
        modeBtn.textContent = 'Switch to Blueprint';
        modeBtn.classList.remove('hidden');
      }
      if (modeLabel) modeLabel.textContent = 'Official Architectural CAD Blueprint';
      if (footerNote) footerNote.textContent = '✦ Verified MahaRERA Architectural CAD Drawing • MLDL';
    } else {
      if (cadTarget) cadTarget.classList.add('hidden');
      if (svgTarget) svgTarget.classList.remove('hidden');
      if (modeBtn) {
        if (item.cadImage) {
          modeBtn.textContent = 'Switch to CAD Drawing';
          modeBtn.classList.remove('hidden');
        } else {
          modeBtn.textContent = key === 'Master Layout' ? 'High-Res Layout' : 'Sanctioned Layout';
          modeBtn.classList.remove('hidden');
        }
      }
      if (modeLabel) {
        modeLabel.textContent = key === 'Master Layout' ? 'Official 13.46-Acre Master Blueprint' : 'Official Architectural Layout Blueprint';
      }
      if (footerNote) {
        footerNote.textContent = key === 'Master Layout' 
          ? '✦ Verified 13.46-Acre Township Master Plan • MahaRERA PR1261012602102' 
          : '✦ Official Launch Typology Layout • 100% Vastu Compliant';
      }
    }

    // Update tab styles
    ['Master Layout', '2 BHK', '3 BHK', '4 BHK'].forEach((t) => {
      const slug = t === 'Master Layout' ? 'master' : t.toLowerCase().replace(' ', '');
      const btnId = `tab-${slug}`;
      const btn = document.getElementById(btnId);
      if (btn) {
        if (t === key) {
          btn.className = 'tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 shadow-md transition-all whitespace-nowrap';
        } else {
          btn.className = 'tab-btn px-3.5 sm:px-4 py-2 rounded-lg text-xs font-semibold uppercase tracking-wider text-stone-300 hover:text-white transition-all whitespace-nowrap';
        }
      }
    });
  }

  // Event bindings
  document.getElementById('tab-master')?.addEventListener('click', () => {
    isCadMode = false;
    renderUnit('Master Layout');
  });
  document.getElementById('tab-2bhk')?.addEventListener('click', () => {
    isCadMode = true;
    renderUnit('2 BHK');
  });
  document.getElementById('tab-3bhk')?.addEventListener('click', () => {
    isCadMode = false;
    renderUnit('3 BHK');
  });
  document.getElementById('tab-4bhk')?.addEventListener('click', () => {
    isCadMode = false;
    renderUnit('4 BHK');
  });

  const toggleBtn = document.getElementById('blueprint-toggle-btn');
  toggleBtn?.addEventListener('click', () => {
    const item = data[currentKey];
    if (item?.cadImage) {
      isCadMode = !isCadMode;
      renderUnit(currentKey);
    } else {
      // Trigger modal for CAD blueprint / Master Layout download
      const modalTrigger = document.querySelector('[data-open-modal]') as HTMLElement;
      modalTrigger?.click();
    }
  });

  const zoomBtn = document.getElementById('zoom-toggle-btn');
  const container = document.getElementById('blueprint-container');
  zoomBtn?.addEventListener('click', () => {
    isZoomed = !isZoomed;
    if (container) {
      container.style.transform = isZoomed ? 'scale(1.2)' : 'scale(1)';
    }
    if (zoomBtn) {
      zoomBtn.textContent = isZoomed ? 'Reset View' : 'Zoom Blueprint';
    }
  });

  // Initial render: 3 BHK active with crisp high-res blueprint
  renderUnit('3 BHK');
</script>
