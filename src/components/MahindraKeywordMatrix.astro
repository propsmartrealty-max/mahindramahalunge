  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": naturalLanguageGeoQuestions.map(qa => ({
    "@type": "Question",
    "name": qa.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": qa.answer
    }
  }))
};

