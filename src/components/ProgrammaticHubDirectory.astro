---
import { techParkData } from '../data/pSeoTechParks';
import { comparisonData } from '../data/pSeoComparisons';
import { connectivityData } from '../data/pSeoConnectivity';
import { westPuneLocalityData } from '../data/pSeoWestPuneLocalities';
import { brandProjectData } from '../data/pSeoBrandProjects';
import { rievenzaCorridorData } from '../data/pSeoMahindraRivenzaCorridor';
---

<section class="py-20 bg-[#090c12] border-t border-gold-500/20 relative">
  <!-- Ambient glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 relative z-10">
    
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-white/10 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
          <span>Programmatic Locality Directory</span>
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl text-stone-50 font-bold">
          Mahalunge Real Estate & Transit Intelligence Network
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 max-w-2xl font-light leading-relaxed">
          Comprehensive commute studies, direct head-to-head project comparisons, and PMRDA infrastructure corridors around Mahindra Mahalunge.
        </p>
      </div>
      <div class="text-xs text-stone-400 font-mono">
        <span>{techParkData.length + comparisonData.length + connectivityData.length + westPuneLocalityData.length + brandProjectData.length} Verified Programmatic Dossiers</span>
      </div>
    </div>

    <!-- Pune Real Estate Market Dominance Portals Banner -->
    <div class="reveal p-6 rounded-2xl bg-gradient-to-r from-charcoal-900 via-charcoal-800 to-charcoal-900 border border-gold-500/30 shadow-2xl">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-4 border-b border-white/10">
        <div>
          <span class="text-[10px] font-mono uppercase text-gold-400 tracking-widest font-bold">Statewide Real Estate Authority</span>
          <h3 class="font-serif text-lg sm:text-xl font-bold text-white mt-0.5">Pune Real Estate Market Intelligence 2026</h3>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-300 text-[11px] font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            12 Google Web Stories Live
          </span>
          <a
            href="/pune-real-estate/"
            class="px-4 py-1.5 rounded-full bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs transition-all shadow"
          >
            Explore 44-Locality Index →
          </a>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-4 text-xs">
        <a href="/pune-real-estate/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-stone-200 group-hover:text-gold-300">Pune Real Estate</span>
          <span class="block text-[10px] text-stone-400 mt-0.5">44-Area Price Index</span>
        </a>
        <a href="/flats-in-pune/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-stone-200 group-hover:text-gold-300">Flats in Pune</span>
          <span class="block text-[10px] text-stone-400 mt-0.5">2, 3 &amp; 4 BHK Guide</span>
        </a>
        <a href="/new-projects-in-pune/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-stone-200 group-hover:text-gold-300">New Projects</span>
          <span class="block text-[10px] text-stone-400 mt-0.5">Upcoming Launches</span>
        </a>
        <a href="/luxury-apartments-in-pune/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-stone-200 group-hover:text-gold-300">Luxury Apartments</span>
          <span class="block text-[10px] text-stone-400 mt-0.5">3 &amp; 4 BHK Sky Villas</span>
        </a>
        <a href="/tools/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-stone-200 group-hover:text-gold-300">Decision Tools</span>
          <span class="block text-[10px] text-stone-400 mt-0.5">Stamp Duty &amp; EMI</span>
        </a>
        <a href="/web-stories/" class="p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 hover:border-gold-500/40 transition-all text-center group">
          <span class="block text-[11px] font-bold text-rose-300 group-hover:text-rose-200 flex items-center justify-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Web Stories
          </span>
          <span class="block text-[10px] text-stone-400 mt-0.5">Visual AMP Editions</span>
        </a>
      </div>
    </div>

    <!-- 5 Columns Programmatic Index Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 text-xs">
      
      <!-- Col 1: Tech Parks & Employer Hubs -->
      <div class="reveal glass-card p-6 rounded-2xl border border-white/10 space-y-4 hover:border-gold-500/30 transition-all">
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">Cluster 01</span>
          <h3 class="font-serif text-base text-stone-100 font-bold mt-1">IT Campuses & Tech Parks</h3>
          <p class="text-[11px] text-stone-400 font-light mt-0.5">Commute times & tailored residences</p>
        </div>
        <ul class="space-y-2.5">
          {techParkData.map((park) => (
            <li>
              <a
                href={`/near/${park.slug}/`}
                class="group flex items-center justify-between text-stone-300 hover:text-gold-300 transition-colors py-1"
              >
                <span class="truncate pr-2">{park.shortName}</span>
                <span class="text-[10px] font-mono text-gold-400/80 group-hover:translate-x-0.5 transition-transform flex-shrink-0">
                  {park.distanceKm} →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Project Comparisons -->
      <div class="reveal delay-100 glass-card p-6 rounded-2xl border border-white/10 space-y-4 hover:border-gold-500/30 transition-all">
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">Cluster 02</span>
          <h3 class="font-serif text-base text-stone-100 font-bold mt-1">Head-to-Head Comparisons</h3>
          <p class="text-[11px] text-stone-400 font-light mt-0.5">Density, RERA delivery & pricing</p>
        </div>
        <ul class="space-y-2.5">
          {comparisonData.map((comp) => (
            <li>
              <a
                href={`/compare/${comp.slug}/`}
                class="group flex items-center justify-between text-stone-300 hover:text-gold-300 transition-colors py-1"
              >
                <span class="truncate pr-2">vs {comp.competitorName}</span>
                <span class="text-[10px] font-mono text-gold-400/80 group-hover:translate-x-0.5 transition-transform flex-shrink-0">
                  Analysis →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Transit & Infrastructure -->
      <div class="reveal delay-200 glass-card p-6 rounded-2xl border border-white/10 space-y-4 hover:border-gold-500/30 transition-all">
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">Cluster 03</span>
          <h3 class="font-serif text-base text-stone-100 font-bold mt-1">Infrastructure Corridors</h3>
          <p class="text-[11px] text-stone-400 font-light mt-0.5">PMRDA DP roads, bridges & Metro 3</p>
        </div>
        <ul class="space-y-2.5">
          {connectivityData.map((conn) => (
            <li>
              <a
                href={`/connectivity/${conn.slug}/`}
                class="group flex items-center justify-between text-stone-300 hover:text-gold-300 transition-colors py-1"
              >
                <span class="truncate pr-2">{conn.shortName}</span>
                <span class="text-[10px] font-mono text-emerald-400/80 group-hover:translate-x-0.5 transition-transform flex-shrink-0">
                  Transit →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: West Pune Localities & Micro-Markets -->
      <div class="reveal delay-300 glass-card p-6 rounded-2xl border border-white/10 space-y-4 hover:border-gold-500/30 transition-all">
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">Cluster 04</span>
          <h3 class="font-serif text-base text-stone-100 font-bold mt-1">West Pune Micro-Markets</h3>
          <p class="text-[11px] text-stone-400 font-light mt-0.5">PMRDA growth zones & rates</p>
        </div>
        <ul class="space-y-2.5">
          {westPuneLocalityData.slice(0, 7).map((loc) => (
            <li>
              <a
                href={`/west-pune/${loc.slug}/`}
                class="group flex items-center justify-between text-stone-300 hover:text-gold-300 transition-colors py-1"
              >
                <span class="truncate pr-2">{loc.shortName}</span>
                <span class="text-[10px] font-mono text-gold-400/80 group-hover:translate-x-0.5 transition-transform flex-shrink-0">
                  {loc.avgPricePerSqFt.split(' - ')[0]} →
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/pune-real-estate/"
          class="inline-flex items-center text-[11px] text-gold-400 hover:text-gold-300 font-semibold pt-1 border-t border-white/5 w-full justify-between"
        >
          <span>Explore All 44 Micro-Markets</span>
          <span>→</span>
        </a>
      </div>

      <!-- Col 5: Brand Project Deep-Dives -->
      <div class="reveal delay-400 glass-card p-6 rounded-2xl border border-white/10 space-y-4 hover:border-gold-500/30 transition-all">
        <div class="border-b border-white/10 pb-3">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">Cluster 05</span>
          <h3 class="font-serif text-base text-stone-100 font-bold mt-1">Brand Project Deep-Dives</h3>
          <p class="text-[11px] text-stone-400 font-light mt-0.5">9 Mahindra Pune projects — RERA, pricing & amenities</p>
        </div>
        <ul class="space-y-2.5">
          {brandProjectData.map((proj) => (
            <li>
              <a
                href={`/brand/projects/${proj.slug}/`}
                class="group flex items-center justify-between text-stone-300 hover:text-gold-300 transition-colors py-1"
              >
                <span class="truncate pr-2">{proj.shortName}</span>
                <span class="text-[10px] font-mono text-cyan-400/80 group-hover:translate-x-0.5 transition-transform flex-shrink-0">
                  {proj.status === 'Pre-Launch' ? 'Pre-Launch' : proj.status === 'Under Construction' ? 'UC' : 'Delivered'} →
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/brand/"
          class="inline-flex items-center text-[11px] text-gold-400 hover:text-gold-300 font-semibold pt-1 border-t border-white/5 w-full justify-between"
        >
          <span>Full Brand Portfolio</span>
          <span>→</span>
        </a>
      </div>

    </div>

    <!-- Dynamic Mahindra Rivenza Baner Annexe Authority Dossiers Grid -->
    <div class="reveal p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-[#0d121c] via-[#101726] to-[#0d121c] border border-gold-500/30 space-y-6 shadow-2xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-4">
        <div>
          <div class="inline-flex items-center space-x-2 text-[10px] font-mono uppercase tracking-widest text-gold-400 font-bold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Mahindra Rivenza Baner Annexe Knowledge Hub</span>
          </div>
          <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mt-1">
            45 Dedicated Programmatic Deep-Dive Guides
          </h3>
          <p class="text-xs text-stone-300 font-light mt-0.5">
            Exact pricing, verified CAD floor plans, MahaRERA certificates, transit studies &amp; developer due diligence for Baner Annexe, Mahalunge.
          </p>
        </div>
        <a
          href="/mahindra-rivenza/"
          class="px-5 py-2 rounded-full bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-300 hover:to-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider transition-all shadow-lg whitespace-nowrap self-start md:self-auto"
        >
          Explore All Guides →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 text-xs">
        {rievenzaCorridorData.map((item) => (
          <a
            href={`/mahindra-rivenza/${item.slug}/`}
            class="p-3 rounded-xl bg-white/[0.03] hover:bg-gold-500/10 border border-white/10 hover:border-gold-400/50 transition-all flex flex-col justify-between group"
          >
            <div>
              <span class="text-[9px] font-mono text-gold-400 uppercase tracking-wider block font-semibold truncate">
                {item.badge.split('•')[0] || 'Baner Annexe'}
              </span>
              <h4 class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-200 transition-colors mt-1 line-clamp-1">
                {item.topic}
              </h4>
              <p class="text-[10px] text-stone-400 line-clamp-2 mt-1 leading-snug">
                {item.summary}
              </p>
            </div>
            <div class="pt-2 mt-2 border-t border-white/5 flex items-center justify-between text-[10px] text-gold-400/90 font-mono">
              <span>Read Guide</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>
