---
// LeadModal.astro - Multi-Step Lead Engine
---

<div id="lead-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 backdrop-blur-md">
  <div 
    id="lead-modal-card"
    class="relative w-full max-w-lg bg-[#0e121a] border border-white/10 rounded-2xl shadow-2xl overflow-hidden text-stone-200 glass-card"
  >
    <!-- Top Header Bar -->
    <div class="px-6 pt-6 pb-4 border-b border-white/10 flex items-center justify-between">
      <div>
        <span class="text-[10px] tracking-widest text-gold-400 uppercase font-bold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
          Mahindra Lifespaces Mahalunge
        </span>
        <h3 id="modal-title" class="font-serif text-lg font-bold text-stone-100">
          Priority Expression of Interest
        </h3>
      </div>
      <button 
        id="modal-close-btn"
        class="p-1 rounded-full text-stone-300 hover:text-white hover:bg-white/10 transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Progress Bar -->
    <div id="modal-progress" class="flex items-center justify-center space-x-2 py-3 bg-[#0c1017]/80 border-b border-white/5">
      <span id="dot-1" class="h-1.5 w-8 rounded-full bg-gold-400 transition-all duration-300"></span>
      <span id="dot-2" class="h-1.5 w-2 rounded-full bg-stone-700 transition-all duration-300"></span>
      <span id="dot-3" class="h-1.5 w-2 rounded-full bg-stone-700 transition-all duration-300"></span>
    </div>

    <!-- Form Content Container -->
    <div class="p-6">
      
      <!-- FORM -->
      <form id="lead-form" class="space-y-5">
        
        <!-- STEP 1 -->
        <div id="step-1" class="space-y-4">
          <label class="block text-xs font-semibold uppercase tracking-widest text-stone-300">
            Step 1 of 3: Preferred Residence Configuration
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" data-conf="2 BHK Luxe" class="conf-btn p-3.5 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500">
              <div class="font-serif text-sm text-stone-100">2 BHK Luxe</div>
              <span class="text-[10px] text-stone-400">785 - 895 sq.ft.*</span>
            </button>
            <button type="button" data-conf="3 BHK Premium" class="conf-btn p-3.5 text-left rounded-lg border border-gold-400 bg-gold-500/10 text-white font-semibold">
              <div class="font-serif text-sm text-stone-100">3 BHK Premium</div>
              <span class="text-[10px] text-stone-400">1,120 - 1,210 sq.ft.*</span>
            </button>
            <button type="button" data-conf="4 BHK Signature" class="conf-btn p-3.5 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500">
              <div class="font-serif text-sm text-stone-100">4 BHK Signature</div>
              <span class="text-[10px] text-stone-400">1,650 - 1,820 sq.ft.*</span>
            </button>
            <button type="button" data-conf="Signature Penthouse" class="conf-btn p-3.5 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500">
              <div class="font-serif text-sm text-stone-100">Penthouse</div>
              <span class="text-[10px] text-stone-400">Custom Duplex</span>
            </button>
          </div>

          <div class="pt-2">
            <label class="block text-xs font-semibold uppercase tracking-widest text-stone-300 mb-2">
              Purpose of Purchase
            </label>
            <div class="flex gap-2">
              <button type="button" data-purpose="Self Use" class="purpose-btn flex-1 py-2 text-xs rounded border border-gold-400 bg-gold-500/10 text-white font-medium">Self Use</button>
              <button type="button" data-purpose="Investment" class="purpose-btn flex-1 py-2 text-xs rounded border border-white/10 bg-charcoal-950/60 text-stone-400">Investment</button>
              <button type="button" data-purpose="Second Home" class="purpose-btn flex-1 py-2 text-xs rounded border border-white/10 bg-charcoal-950/60 text-stone-400">Second Home</button>
            </div>
          </div>
        </div>

        <!-- STEP 2 -->
        <div id="step-2" class="space-y-4 hidden">
          <label class="block text-xs font-semibold uppercase tracking-widest text-stone-300">
            Step 2 of 3: Primary Information Requested
          </label>
          <div class="space-y-2.5">
            <button type="button" data-service="Brochure & Floor Plans" class="service-btn w-full p-3 text-left rounded-lg border border-gold-400 bg-gold-500/10 text-white flex items-center justify-between">
              <div>
                <div class="text-xs font-semibold text-stone-100">Project Brochure & Master Layout</div>
                <div class="text-[10px] text-stone-400">Detailed architectural overview & site topography</div>
              </div>
              <span class="text-gold-400">✓</span>
            </button>
            <button type="button" data-service="Tentative Pricing & Payment" class="service-btn w-full p-3 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500 flex items-center justify-between">
              <div>
                <div class="text-xs font-semibold text-stone-100">Pre-Launch Cost Sheet & Payment Plan</div>
                <div class="text-[10px] text-stone-400">Pre-launch priority expressions & early incentives</div>
              </div>
            </button>
            <button type="button" data-service="VIP Site Visit" class="service-btn w-full p-3 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500 flex items-center justify-between">
              <div>
                <div class="text-xs font-semibold text-stone-100">Guided Site Visit & Corridor Walkthrough</div>
                <div class="text-[10px] text-stone-400">Experience the 13.46-acre Mahalunge corridor in person</div>
              </div>
            </button>
          </div>
        </div>

        <!-- STEP 3 -->
        <div id="step-3" class="space-y-4 hidden">
          <label class="block text-xs font-semibold uppercase tracking-widest text-stone-300">
            Step 3 of 3: Contact Verification
          </label>
          <div class="space-y-3">
            <input
              type="text"
              id="lead-name"
              required
              placeholder="Full Name *"
              class="w-full px-4 py-3 bg-[#0c1017] border border-white/20 rounded-xl text-xs text-white placeholder-stone-400 focus:outline-none focus:border-gold-400 focus:ring-1 focus:ring-gold-400/50 transition-all"
            />
            <input
              type="tel"
              id="lead-phone"
              required
              placeholder="Mobile Number (e.g. 9820123456) *"
              class="w-full px-4 py-3 bg-[#0c1017] border border-white/20 rounded-xl text-xs text-white placeholder-stone-400 focus:outline-none focus:border-gold-400 focus:ring-1 focus:ring-gold-400/50 transition-all"
            />
            <input
              type="email"
              id="lead-email"
              placeholder="Email Address (Optional)"
              class="w-full px-4 py-3 bg-[#0c1017] border border-white/20 rounded-xl text-xs text-white placeholder-stone-400 focus:outline-none focus:border-gold-400 focus:ring-1 focus:ring-gold-400/50 transition-all"
            />
            <div class="flex items-start space-x-2 pt-1">
              <input type="checkbox" id="lead-consent" checked class="mt-0.5 rounded border-stone-600 text-gold-500 focus:ring-0" />
              <label for="lead-consent" class="text-[10px] text-stone-300 leading-tight">
                I authorize Mahindra Lifespaces and its authorized representatives to contact me via Call, SMS or WhatsApp.
              </label>
            </div>
          </div>
        </div>

        <!-- Step Navigation Buttons -->
        <div class="pt-3 flex items-center justify-between border-t border-white/10">
          <button
            type="button"
            id="back-btn"
            class="text-xs text-stone-300 hover:text-white uppercase tracking-wider font-medium hidden"
          >
            ← Back
          </button>
          <span id="spacer-span"></span>

          <button
            type="button"
            id="next-btn"
            class="btn-shimmer px-6 py-3 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-gold-500/20 hover:shadow-lg transition-all"
          >
            Continue →
          </button>
        </div>

      </form>

      <!-- SUCCESS CONFIRMATION SCREEN -->
      <div id="success-screen" class="hidden text-center py-6 space-y-4">
        <div class="w-14 h-14 mx-auto rounded-full bg-gold-500/20 text-gold-400 flex items-center justify-center border border-gold-500/40">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h4 id="success-name" class="font-serif text-xl text-stone-100 font-semibold">Priority Pass Confirmed</h4>
        <p class="text-xs text-stone-300 max-w-sm mx-auto leading-relaxed">
          Your interest in the upcoming 13.46-acre Mahindra Mahalunge development has been registered. An official project advisor will contact you with the confidential project brief.
        </p>
        <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            id="whatsapp-chat-link"
            href="https://wa.me/912067000000?text=Hi%2C%20I%20registered%20for%20Mahindra%20Mahalunge%20project."
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-shimmer inline-flex items-center justify-center space-x-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold tracking-wider uppercase transition-all shadow-lg"
          >
            <span>Connect on WhatsApp</span>
          </a>
          <button
            id="close-success-btn"
            class="px-5 py-2.5 rounded border border-white/20 text-stone-300 hover:text-white text-xs uppercase tracking-wider"
          >
            Close Window
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  let currentStep = 1;
  let selectedConf = '3 BHK Premium';
  let selectedPurpose = 'Self Use';
  let selectedService = 'Brochure & Floor Plans';

  const modal = document.getElementById('lead-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const nextBtn = document.getElementById('next-btn');
  const backBtn = document.getElementById('back-btn');
  const spacerSpan = document.getElementById('spacer-span');
  const step1 = document.getElementById('step-1');
  const step2 = document.getElementById('step-2');
  const step3 = document.getElementById('step-3');
  const dot1 = document.getElementById('dot-1');
  const dot2 = document.getElementById('dot-2');
  const dot3 = document.getElementById('dot-3');
  const leadForm = document.getElementById('lead-form');
  const successScreen = document.getElementById('success-screen');
  const modalProgress = document.getElementById('modal-progress');
  const modalTitle = document.getElementById('modal-title');
  const closeSuccessBtn = document.getElementById('close-success-btn');

  function updateSteps() {
    step1?.classList.toggle('hidden', currentStep !== 1);
    step2?.classList.toggle('hidden', currentStep !== 2);
    step3?.classList.toggle('hidden', currentStep !== 3);

    if (backBtn && spacerSpan) {
      backBtn.classList.toggle('hidden', currentStep === 1);
      spacerSpan.classList.toggle('hidden', currentStep !== 1);
    }

    if (nextBtn) {
      nextBtn.textContent = currentStep === 3 ? 'Confirm Priority Pass' : 'Continue →';
    }

    // Dots
    if (dot1 && dot2 && dot3) {
      dot1.className = `h-1.5 rounded-full transition-all duration-300 ${currentStep === 1 ? 'w-8 bg-gold-400' : 'w-2 bg-stone-700'}`;
      dot2.className = `h-1.5 rounded-full transition-all duration-300 ${currentStep === 2 ? 'w-8 bg-gold-400' : 'w-2 bg-stone-700'}`;
      dot3.className = `h-1.5 rounded-full transition-all duration-300 ${currentStep === 3 ? 'w-8 bg-gold-400' : 'w-2 bg-stone-700'}`;
    }
  }

  // Open modal event listener
  window.addEventListener('open-lead-modal', (e: any) => {
    if (modal) {
      currentStep = 1;
      leadForm?.classList.remove('hidden');
      successScreen?.classList.add('hidden');
      modalProgress?.classList.remove('hidden');
      if (modalTitle) modalTitle.textContent = 'Priority Expression of Interest';
      updateSteps();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  });

  closeBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  closeSuccessBtn?.addEventListener('click', () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  // Config buttons
  document.querySelectorAll('.conf-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.conf-btn').forEach((b) => {
        b.className = 'conf-btn p-3.5 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500';
      });
      btn.className = 'conf-btn p-3.5 text-left rounded-lg border border-gold-400 bg-gold-500/10 text-white font-semibold';
      selectedConf = btn.getAttribute('data-conf') || '';
    });
  });

  // Purpose buttons
  document.querySelectorAll('.purpose-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.purpose-btn').forEach((b) => {
        b.className = 'purpose-btn flex-1 py-2 text-xs rounded border border-white/10 bg-charcoal-950/60 text-stone-400';
      });
      btn.className = 'purpose-btn flex-1 py-2 text-xs rounded border border-gold-400 bg-gold-500/10 text-white font-medium';
      selectedPurpose = btn.getAttribute('data-purpose') || '';
    });
  });

  // Service buttons
  document.querySelectorAll('.service-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.service-btn').forEach((b) => {
        b.className = 'service-btn w-full p-3 text-left rounded-lg border border-white/10 bg-charcoal-950/60 text-stone-400 hover:border-stone-500 flex items-center justify-between';
      });
      btn.className = 'service-btn w-full p-3 text-left rounded-lg border border-gold-400 bg-gold-500/10 text-white flex items-center justify-between';
      selectedService = btn.getAttribute('data-service') || '';
    });
  });

  backBtn?.addEventListener('click', () => {
    if (currentStep > 1) {
      currentStep--;
      updateSteps();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (currentStep < 3) {
      currentStep++;
      updateSteps();
    } else {
      // Step 3 submission
      const nameInput = document.getElementById('lead-name') as HTMLInputElement;
      const phoneInput = document.getElementById('lead-phone') as HTMLInputElement;
      const emailInput = document.getElementById('lead-email') as HTMLInputElement;

      if (!nameInput?.value || !phoneInput?.value) {
        alert('Please provide your name and contact phone number.');
        return;
      }

      // Store lead
      try {
        const leads = JSON.parse(localStorage.getItem('mahindra_mahalunge_leads') || '[]');
        leads.push({
          name: nameInput.value,
          phone: phoneInput.value,
          email: emailInput?.value || '',
          configuration: selectedConf,
          purpose: selectedPurpose,
          service: selectedService,
          createdAt: new Date().toISOString()
        });
        localStorage.setItem('mahindra_mahalunge_leads', JSON.stringify(leads));
      } catch (e) {
        console.error(e);
      }

      // Show success
      leadForm?.classList.add('hidden');
      modalProgress?.classList.add('hidden');
      successScreen?.classList.remove('hidden');
      if (modalTitle) modalTitle.textContent = 'Priority Pass Registered';
      const successName = document.getElementById('success-name');
      if (successName) successName.textContent = `Thank You, ${nameInput.value}`;
    }
  });
</script>
