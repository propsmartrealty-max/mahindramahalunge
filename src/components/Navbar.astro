---
// Navbar.astro - Optimized, Streamlined One-Liner Floating Pill Navigation
---

<header id="site-header" class="fixed top-3 sm:top-5 left-0 right-0 z-50 flex justify-center px-3 sm:px-6 transition-all duration-300">
  <div class="w-full max-w-5xl bg-charcoal-950/90 backdrop-blur-2xl border border-white/[0.12] rounded-full px-3.5 sm:px-5 py-2 sm:py-2.5 flex items-center justify-between shadow-[0_8px_32px_rgba(0,0,0,0.6)]">
    
    <!-- Left: Brand Logo & Mahalunge Badge -->
    <a href="/" class="flex items-center space-x-2.5 sm:space-x-3 group flex-shrink-0" aria-label="Mahindra Lifespaces Mahalunge Home">
      <!-- Official Vector Logo Scaled Elegantly -->
      <img 
        src="/images/mahindra-lifespaces-logo.svg" 
        alt="Mahindra Lifespaces" 
        class="h-3 sm:h-3.5 w-auto object-contain transition-transform group-hover:scale-105"
        width="160"
        height="12"
      />
      <!-- Subtle Separator -->
      <span class="h-3.5 w-[1px] bg-white/20 hidden xs:inline-block"></span>
      <!-- Project Tag -->
      <div class="flex items-center space-x-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-red animate-pulse"></span>
        <span class="font-serif text-[11px] sm:text-xs font-bold tracking-widest text-gold-400 group-hover:text-gold-300 uppercase">
          MAHALUNGE
        </span>
      </div>
    </a>

    <!-- Center: Streamlined Desktop Nav Links (5 Core Items) -->
    <nav class="hidden md:flex items-center space-x-1 text-[11px] font-medium tracking-wider uppercase text-stone-300">
      <a href="/#overview" class="px-3 py-1 rounded-full hover:bg-white/10 hover:text-white transition-all">Overview</a>
      <a href="/#residences" class="px-3 py-1 rounded-full hover:bg-white/10 hover:text-white transition-all">Residences</a>
      <a href="/#masterplan" class="px-3 py-1 rounded-full hover:bg-white/10 hover:text-white transition-all">Master Plan</a>
      <a href="/#location" class="px-3 py-1 rounded-full hover:bg-white/10 hover:text-white transition-all">Location</a>
      <a href="/articles" class="px-3 py-1 rounded-full hover:bg-white/10 hover:text-white transition-all">Research</a>
    </nav>

    <!-- Right: Quick Phone Icon & Book Visit CTA -->
    <div class="flex items-center space-x-2 flex-shrink-0">
      <!-- Sleek Phone Circle Icon Button -->
      <a 
        href="tel:+912067000000" 
        class="hidden sm:inline-flex w-8 h-8 rounded-full border border-white/10 hover:border-gold-500/40 hover:bg-white/5 items-center justify-center text-stone-300 hover:text-gold-400 transition-all"
        title="Call Official Desk: +91 20 6700 0000"
        aria-label="Call Official Desk"
      >
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
      </a>

      <!-- Compact CTA Pill -->
      <button
        type="button"
        data-open-modal
        data-interest="Book Site Visit"
        class="inline-flex items-center justify-center px-4 py-1.5 text-[11px] font-bold tracking-wider text-charcoal-950 uppercase transition-all duration-300 bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 rounded-full hover:shadow-md hover:shadow-gold-500/25 active:scale-95 cursor-pointer whitespace-nowrap"
      >
        Book Visit
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle Navigation Menu"
        class="md:hidden p-1.5 rounded-full text-stone-300 hover:text-white hover:bg-white/10 border border-white/10 focus:outline-none transition-colors"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Floating Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-16 left-4 right-4 bg-charcoal-950/95 backdrop-blur-2xl border border-white/15 rounded-2xl p-5 space-y-3 animate-fadeIn shadow-2xl">
    <div class="flex flex-col space-y-2 divide-y divide-white/5 text-xs">
      <a href="/#overview" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Project Overview</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/#residences" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Residences (2, 3 & 4 BHK)</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/#masterplan" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Interactive Master Plan</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/#amenities" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Curated Amenities</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/#location" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Location & Radial Connectivity</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/mahalunge-pune" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Why Mahalunge Hub</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/flats-near-hinjewadi" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Flats Near Hinjewadi</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/articles" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Research Articles Hub</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/faq" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Frequently Asked Questions</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/brand" class="pt-2 uppercase tracking-wider text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Mahindra Legacy</span>
        <span class="text-stone-600">→</span>
      </a>
    </div>

    <div class="pt-3 flex flex-col space-y-2 border-t border-white/10">
      <button
        data-open-modal
        data-interest="Priority Early Pass"
        class="w-full py-2.5 text-center text-xs font-bold tracking-wider uppercase bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 rounded-full shadow-lg active:scale-95 transition-all"
      >
        Request Priority Pass
      </button>

      <a 
        href="tel:+912067000000"
        class="w-full py-2 text-center text-xs tracking-wider uppercase border border-white/15 text-stone-300 rounded-full flex items-center justify-center space-x-2"
      >
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Call +91 20 6700 0000</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });

    menu.querySelectorAll('a, button').forEach(el => {
      el.addEventListener('click', () => {
        menu.classList.add('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }
</script>
