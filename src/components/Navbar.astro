---
// Navbar.astro - Refined, Clean & Minimal Luxury Navigation
---

<header id="site-header" class="fixed top-3 sm:top-5 left-0 right-0 z-50 flex justify-center px-3 sm:px-6 transition-all duration-300">
  <div class="w-full max-w-5xl bg-[#0c1017]/90 backdrop-blur-2xl border border-white/[0.14] hover:border-gold-500/40 rounded-full px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between shadow-[0_12px_40px_rgba(0,0,0,0.6),0_0_20px_rgba(212,175,102,0.08)] transition-all duration-300">
    
    <!-- Left: Pure & Clean Brand Logo -->
    <a href="/" class="flex items-center group flex-shrink-0" aria-label="Mahindra Lifespaces Home">
      <img 
        src="/images/mahindra-lifespaces-logo.svg" 
        alt="Mahindra Lifespaces" 
        class="h-4 sm:h-4.5 w-auto object-contain transition-transform group-hover:scale-105"
        width="168"
        height="18"
      />
    </a>

    <!-- Center: Refined Minimal Desktop Nav Links -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-[12px] font-medium tracking-wider uppercase text-stone-300">
      <a href="/residences/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Residences</a>
      <a href="/pricing/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Pricing</a>
      <a href="/floor-plans/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Floor Plans</a>
      <a href="/amenities/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Amenities</a>
      <a href="/location/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Location</a>
      <a href="/brochure/" class="px-3 py-1.5 rounded-full hover:text-white hover:bg-white/10 transition-all">Brochure</a>
    </nav>

    <!-- Right: Quick Phone & Schedule Visit CTA -->
    <div class="flex items-center space-x-2.5 flex-shrink-0">
      <!-- Minimalist Call Icon Button -->
      <a 
        href="tel:+917744009295" 
        class="hidden sm:inline-flex w-8 h-8 rounded-full border border-white/15 hover:border-gold-500/50 hover:bg-white/10 items-center justify-center text-stone-300 hover:text-gold-300 transition-all"
        title="Call Official Desk: +91 7744009295"
        aria-label="Call Official Desk"
      >
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
      </a>

      <!-- Clean Elegant CTA Pill -->
      <button
        type="button"
        data-open-modal
        data-interest="Book Site Visit"
        class="btn-shimmer inline-flex items-center justify-center px-4 sm:px-5 py-1.5 sm:py-2 text-[11px] sm:text-xs font-bold tracking-wider text-charcoal-950 uppercase transition-all duration-300 bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 rounded-full hover:shadow-lg hover:shadow-gold-500/30 active:scale-95 cursor-pointer whitespace-nowrap"
      >
        Schedule Visit
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Toggle Navigation Menu"
        class="md:hidden p-1.5 rounded-full text-stone-300 hover:text-white hover:bg-white/10 border border-white/10 focus:outline-none transition-colors"
      >
        <svg id="menu-icon-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Refined Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-16 left-4 right-4 bg-charcoal-950/95 backdrop-blur-2xl border border-white/15 rounded-2xl p-5 space-y-4 animate-fadeIn shadow-2xl">
    <div class="flex flex-col space-y-2.5 text-xs tracking-wider uppercase divide-y divide-white/5">
      <a href="/residences/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Residences (2, 3 & 4 BHK)</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/pricing/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Pricing & Inventory</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/floor-plans/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Floor Plans & Blueprints</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/amenities/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Lifestyle Amenities</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/location/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Location & Connectivity</span>
        <span class="text-stone-600">→</span>
      </a>
      <a href="/brochure/" class="pt-2 text-stone-200 hover:text-gold-400 flex items-center justify-between">
        <span>Download Brochure</span>
        <span class="text-stone-600">→</span>
      </a>
    </div>

    <div class="pt-2 flex flex-col space-y-2 border-t border-white/10">
      <button
        data-open-modal
        data-interest="Priority Early Pass"
        class="w-full py-2.5 text-center text-xs font-bold tracking-wider uppercase bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 rounded-full shadow-lg active:scale-95 transition-all cursor-pointer"
      >
        Schedule Show Home Visit
      </button>

      <a 
        href="tel:+917744009295"
        class="w-full py-2 text-center text-xs tracking-wider uppercase border border-white/15 text-stone-300 rounded-full flex items-center justify-center space-x-2 hover:bg-white/10 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span>Call +91 7744009295</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });

    menu.querySelectorAll('a, button').forEach(el => {
      el.addEventListener('click', () => {
        menu.classList.add('hidden');
        if (iconOpen && iconClose) {
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
      });
    });
  }
</script>
