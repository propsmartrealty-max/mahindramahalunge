<style>
  /* Running Progress Bar Animation (Scraped from ProjectBanner keyframes) */
  @keyframes heroFill {
    0% {
      width: 0%;
    }
    100% {
      width: 100%;
    }
  }

  .hero-page-btn .page-fill-progress {
    width: 0%;
  }

  .hero-page-btn.active .page-fill-progress {
    animation: heroFill 6.5s linear infinite;
  }

  .hero-page-btn.active .page-number {
    color: #f5d794;
    font-weight: 700;
  }

  /* Clip-Path Text Reveal Animations */
  .fake-before, .fake-after {
    clip-path: inset(0 0 0 0);
  }

  /* Thumb Active Classes */
  .hero-thumb.active {
    border-color: rgba(212, 175, 102, 0.6);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-thumb.active .thumb-bg-gradient {
    transform: translateY(0);
  }

  .hero-thumb.active .thumb-title {
    color: #ffffff;
    font-weight: 600;
  }

  .hero-thumb.active .thumb-cta {
    opacity: 1;
    color: #f5d794;
  }
</style>

<script>
  // Hero Video & Carousel Controller (Replicating Swiper + GSAP transitions)
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const pageBtns = document.querySelectorAll<HTMLElement>('.hero-page-btn');
    const thumbs = document.querySelectorAll<HTMLElement>('.hero-thumb');
    const titleText = document.getElementById('hero-title-text');
    const fakeBefore = document.querySelector<HTMLElement>('.fake-before');
    const fakeAfter = document.querySelector<HTMLElement>('.fake-after');
    const banner = document.getElementById('hero-banner');

    const titles = [
      "Tranquility, crafted just for you",
      "A place to pause and flow",
      "Scenic views that spark imagination"
    ];

    let currentIndex = 0;
    let autoplayTimer: any = null;
    const duration = 6500; // 6.5 seconds per slide

    // Attempt video playback safely
    function playSlideVideo(slideIndex: number) {
      const activeSlide = slides[slideIndex];
      if (!activeSlide) return;

      const isMobile = window.innerWidth < 768;
      const videos = activeSlide.querySelectorAll<HTMLVideoElement>('video');

      videos.forEach(vid => {
        const isDesktopVid = vid.classList.contains('desktop-video');
        const isMobileVid = vid.classList.contains('mobile-video');

        if ((isMobile && isMobileVid) || (!isMobile && isDesktopVid)) {
          vid.currentTime = 0;
          const playPromise = vid.play();
          if (playPromise !== undefined) {
            playPromise.catch(() => {
              // Video play blocked (power saving / autoplay policy), graceful fallback to high-res poster
            });
          }
        } else {
          vid.pause();
        }
      });

      // Pause other slides' videos to save CPU
      slides.forEach((otherSlide, idx) => {
        if (idx !== slideIndex) {
          otherSlide.querySelectorAll<HTMLVideoElement>('video').forEach(v => v.pause());
        }
      });
    }

    function goToSlide(index: number) {
      if (index === currentIndex && slides[index].classList.contains('active')) return;
      currentIndex = index;

      // 1. Update Slide Visibility
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('active', 'z-10');
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100');
        } else {
          slide.classList.remove('active', 'z-10', 'opacity-100');
          slide.classList.add('opacity-0', 'z-0');
        }
      });

      // 2. Play video
      playSlideVideo(index);

      // 3. Update Title with Clip-Path Reveal Animation
      if (titleText) {
        titleText.style.opacity = '0';
        titleText.style.transform = 'translateY(15px)';
        if (fakeBefore) fakeBefore.style.clipPath = 'inset(0 100% 0 0)';
        if (fakeAfter) fakeAfter.style.clipPath = 'inset(0 100% 0 0)';

        setTimeout(() => {
          titleText.textContent = titles[index];
          titleText.style.opacity = '1';
          titleText.style.transform = 'translateY(0)';
          if (fakeBefore) fakeBefore.style.clipPath = 'inset(0 0 0 0)';
          if (fakeAfter) fakeAfter.style.clipPath = 'inset(0 0 0 0)';
        }, 250);
      }

      // 4. Update Pagination Indicator
      pageBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
        const num = btn.querySelector<HTMLElement>('.page-number');
        if (num) {
          num.classList.toggle('text-gold-400', i === index);
          num.classList.toggle('text-stone-400', i !== index);
        }
      });

      // 5. Update Thumbs
      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
        const bg = thumb.querySelector<HTMLElement>('.thumb-bg-gradient');
        if (bg) {
          bg.style.transform = i === index ? 'translateY(0)' : 'translateY(100%)';
        }
      });

      // Restart Autoplay
      resetAutoplay();
    }

    function resetAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      autoplayTimer = setInterval(() => {
        const next = (currentIndex + 1) % slides.length;
        goToSlide(next);
      }, duration);
    }

    // Bind Pagination Buttons
    pageBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const slideIdx = parseInt(btn.getAttribute('data-slide') || '0', 10);
        goToSlide(slideIdx);
      });
    });

    // Bind Thumbs Clicks
    thumbs.forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        // If clicking Enquire Now specifically, open modal
        if (target.closest('.thumb-cta')) {
          const leadModalBtn = document.querySelector('[data-open-modal]') as HTMLButtonElement;
          if (leadModalBtn) {
            leadModalBtn.click();
            return;
          }
        }
        const slideIdx = parseInt(thumb.getAttribute('data-slide') || '0', 10);
        goToSlide(slideIdx);
      });
    });

    // Parallax Scrolling Effect
    if (banner) {
      window.addEventListener('scroll', () => {
        const scrollY = window.scrollY;
        if (scrollY < window.innerHeight) {
          const slidesWrapper = document.getElementById('hero-slides-wrapper');
          if (slidesWrapper) {
            slidesWrapper.style.transform = `translateY(${scrollY * 0.25}px)`;
          }
        }
      }, { passive: true });
    }

    // Start on first slide
    playSlideVideo(0);
    resetAutoplay();
  });
</script>
