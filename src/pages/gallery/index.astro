    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Resort Swimming Pool with Sunken Bar',
    subtitle: 'Temperature-Regulated Infinity Aqua Lounge',
    src: 'https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Swimming%20pool%20with%20sunken%20bar_Rivenza_11zon.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'interiors',
    title: '4 BHK Show Residence — Grand Living Room',
    subtitle: 'Expansive Horizons & Italian Marble Finishes',
    src: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=85',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Floodlit Championship Futsal Court',
    subtitle: 'FIFA-Grade Rebound Fenced Turf Arena',
    src: 'https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/image001_11zon%20%281%29.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Multipurpose Synthetic Sports Court',
    subtitle: 'Cushioned Basketball, Tennis & Volleyball Arena',
    src: 'https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Multi-purpose_Rivenza__11zon.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Open Sky Yoga Lawn & Zen Decks',
    subtitle: 'Reflexology Pathways & Aromatic Herbal Meadows',
    src: 'https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Yoga%20lawn_Rivenza_11zon.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'interiors',
    title: 'Master Bedroom Suite with Panoramic Balcony',
    subtitle: 'Mula River & Sahyadri Foothill Views',
    src: 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1200&q=85',
    width: 800,
    height: 500,
  },
  {
    category: 'interiors',
    title: 'Designer Modular Kitchen & Breakfast Bar',
    subtitle: 'Engineered Granite Countertops & Utility Deck',
    src: 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=85',
    width: 800,
    height: 500,
  },
  {
    category: 'architecture',
    title: 'Pre-Certified IGBC Gold & 9+ Acres Greens',
    subtitle: 'Net Zero Waste & Biophilic Urban Sanctuary',
    src: 'https://cms.mahindralifespaces.com/web/sites/default/files/2026-10/Mahindra%20Rivenza_IGBC%20GH%20pre-certification.jpg',
    width: 800,
