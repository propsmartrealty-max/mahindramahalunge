---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const galleryImages = [
  {
    category: 'architecture',
    title: 'Mahindra Rivenza Architectural Elevation',
    subtitle: '13.46-Acre Biophilic Landmark at Baner Annex',
    src: '/images/official/mahindra-rivenza-architectural-elevation.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Resort Swimming Pool with Sunken Bar',
    subtitle: 'Temperature-Regulated Infinity Aqua Lounge',
    src: '/images/official/swimming-pool-sunken-aqua-bar.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Biophilic Family Garden & Canopy Swings',
    subtitle: '9+ Acres Vehicular-Free Natural Landscape',
    src: '/images/official/biophilic-family-garden-swing.jpg',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Floodlit Championship Futsal Court',
    subtitle: 'FIFA-Grade Rebound Fenced Turf Arena',
    src: '/images/official/floodlit-futsal-football-turf.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Multipurpose Synthetic Sports Court',
    subtitle: 'Cushioned Basketball, Tennis & Volleyball Arena',
    src: '/images/official/multipurpose-sports-arena.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'amenities',
    title: 'Open Sky Yoga Lawn & Zen Decks',
    subtitle: 'Reflexology Pathways & Aromatic Herbal Meadows',
    src: '/images/official/yoga-lawn-biophilic-gardens.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'architecture',
    title: '4 BHK Luxury Sky Villa Sanctioned Blueprint',
    subtitle: '1,651 Sq.Ft Usable with 270° Panoramic Views',
    src: '/images/official/floor-plan-4bhk-luxury-a-1651sqft.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'architecture',
    title: '3 BHK Ultra Luxury Sanctioned Blueprint',
    subtitle: '1,206 Sq.Ft Usable with 24ft Living Salon',
    src: '/images/official/floor-plan-3bhk-ultra-luxury-b-1206sqft.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'architecture',
    title: 'Phase 1 Typical High-Rise Tower Plate',
    subtitle: '4 Units Per Floor with Maximum Privacy',
    src: '/images/official/tower-1-typical-floor-plan.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'sustainability',
    title: 'Pre-Certified IGBC Gold Rating',
    subtitle: 'Indian Green Building Council Platinum/Gold Standards',
    src: '/images/official/igbc-gold-pre-certification.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'sustainability',
    title: 'CII Net Zero Waste to Landfill Certification',
    subtitle: '100% Organic Waste Composting & Greywater Recycling',
    src: '/images/official/net-zero-waste-to-landfill-certification.webp',
    width: 800,
    height: 500,
  },
  {
    category: 'rera',
    title: 'Official MahaRERA Phase 1 Certificate',
    subtitle: 'Registration Number: PR1261012602102',
    src: '/images/official/maharera-certificate-phase-1-pr1261012602102.webp',
    width: 800,
    height: 500,
  }
];

const gallerySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ImageGallery",
      "@id": "https://mahindralifespaceshomes.in/gallery/#gallery",
      "url": "https://mahindralifespaceshomes.in/gallery/",
      "name": "Mahindra Rivenza Official Photo Gallery & 3D Renders",
      "description": "High-resolution photo gallery of Mahindra Rivenza at Baner Annex, Mahalunge, Pune. Architectural elevations, 4 BHK show home interiors, sunken bar pool, and ~44k sq.ft clubhouse.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Gallery", "item": "https://mahindralifespaceshomes.in/gallery/" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/gallery/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are the gallery images authentic renders of Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, all elevation renders and clubhouse visuals are sourced directly from Mahindra Lifespaces official architectural CAD submissions approved under MahaRERA PR1261012602102."
          }
        },
        {
          "@type": "Question",
          "name": "Can I visit the physical experience centre to view sample home interiors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, a physical experience centre with a fully furnished 4 BHK show home is open on site at Baner Annex, Mahalunge, Pune."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Photo Gallery [HD Renders & Show Flat Photos]"
  description="Explore high-resolution official photos, architectural renders, 4 BHK sample flat interiors, sunken bar pool & master plan for Mahindra Rivenza Pune."
  canonical="https://mahindralifespaceshomes.in/gallery/"
  customSchema={gallerySchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>High-Definition Architectural Showcase</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza Photo Gallery: <br />
        <span class="gold-gradient-text">Elevations, Interiors &amp; Resort Amenities</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Browse official architectural perspectives, 4 BHK furnished sample residences, ~44,000 sq.ft. clubhouse features, and the 9+ acres of landscaped biophilic greens at Baner Annex, Mahalunge.
      </p>
    </div>
  </section>

  <!-- Gallery Showcase Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {galleryImages.map((img) => (
          <div class="glass-card rounded-2xl overflow-hidden border border-white/15 group hover:border-gold-500/50 transition-all flex flex-col justify-between shadow-xl">
            <div class="h-60 overflow-hidden relative">
              <img
                src={img.src}
                alt={`${img.title} — ${img.subtitle}`}
                width={img.width}
                height={img.height}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-charcoal-950/80 backdrop-blur-md text-[10px] font-semibold text-gold-400 border border-white/10 uppercase tracking-wider">
                {img.category}
              </span>
            </div>
            <div class="p-5 space-y-1.5">
              <h3 class="font-serif text-base font-bold text-stone-100 group-hover:text-gold-300 transition-colors">
                {img.title}
              </h3>
              <p class="text-xs text-stone-400 font-light">
                {img.subtitle}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
        Experience These Spaces Live at the Sales Gallery
      </h2>
      <p class="text-xs sm:text-sm text-stone-300 max-w-xl mx-auto font-light leading-relaxed">
        The 4 BHK show home and sales experience lounge are open 7 days a week from 9:00 AM to 8:00 PM at Baner Annex, Mahalunge.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="/site-visit/"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
        >
          Book In-Person Site Visit
        </a>
        <button
          data-open-modal
          data-interest="HD Gallery Dossier Download"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-stone-100 text-xs font-bold uppercase tracking-widest border border-white/20 transition-all cursor-pointer"
        >
          Download HD Lookbook (PDF)
        </button>
      </div>
    </div>
  </section>
  <!-- Topical Keyword Grid & Search Intent Matrix -->
  <MahindraKeywordMatrix />
</Layout>
