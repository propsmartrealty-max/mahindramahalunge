  "description": "In-depth analysis of Mahindra Lifespaces 13.46-acre land acquisition in Nande-Mahalunge, ₹3,500 Cr GDV potential, and its transformative impact on West Pune property values.",
  "author": {
    "@type": "Organization",
    "name": "West Pune Real Estate Analytics"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Propsmart Realty Max"
  },
  "datePublished": "2025-11-10",
  "dateModified": "2026-09-21"
