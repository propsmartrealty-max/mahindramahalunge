---

<Layout
  title="Mahalunge Real Estate Guide & Research Hub | Insights, Trends & Analysis"
  description="Exhaustive research, price analysis, infrastructure reports, and expert buyer guides on Mahalunge Pune real estate and Mahindra Lifespaces upcoming development."
  canonical="https://www.mahindralifespaceshomes.in/articles"
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Knowledge Hub & Editorial Research</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahalunge Real Estate <br />
        <span class="gold-gradient-text">Research & Intelligence Hub</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Authoritative market studies, infrastructure timelines, price indexes, and comparative location analytics for discerning homeowners and real estate investors.
      </p>
    </div>
  </section>

  <!-- Topical Navigation Filters Strip -->
  <div class="bg-charcoal-900 border-b border-white/5 py-4 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap gap-3 items-center">
      <span class="text-stone-400 uppercase tracking-widest font-semibold text-[10px]">Filter Topics:</span>
      <span class="px-3 py-1 rounded-full bg-gold-500/20 text-gold-400 border border-gold-500/40 font-medium">All Research</span>
      <span class="px-3 py-1 rounded-full bg-white/5 text-stone-300 border border-white/10 hover:border-gold-500/40 cursor-pointer">PMRDA Planning</span>
      <span class="px-3 py-1 rounded-full bg-white/5 text-stone-300 border border-white/10 hover:border-gold-500/40 cursor-pointer">Price Trends & ROI</span>
      <span class="px-3 py-1 rounded-full bg-white/5 text-stone-300 border border-white/10 hover:border-gold-500/40 cursor-pointer">Location Comparisons</span>
      <span class="px-3 py-1 rounded-full bg-white/5 text-stone-300 border border-white/10 hover:border-gold-500/40 cursor-pointer">Mahindra Lifespaces Updates</span>
    </div>
  </div>

  <!-- Articles Grid -->
  <section class="py-16 bg-charcoal-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((art) => (
          <article class="glass-card rounded-xl overflow-hidden border border-white/10 flex flex-col group hover:border-gold-500/40 transition-all duration-300">
            <a href={`/articles/${art.slug}`} class="block h-52 overflow-hidden relative">
              <img 
                src={art.image} 
                alt={art.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 filter brightness-90"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-charcoal-950/80 backdrop-blur-md text-gold-400 text-[10px] uppercase font-bold tracking-widest border border-white/10">
                {art.category}
              </span>
            </a>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <div class="flex items-center space-x-2 text-[10px] text-stone-400 tracking-wider">
                  <span>{art.date}</span>
                  <span>•</span>
                  <span>{art.readTime}</span>
                </div>
                <h2 class="font-serif text-lg font-bold text-stone-100 group-hover:text-gold-400 transition-colors leading-snug">
                  <a href={`/articles/${art.slug}`}>{art.title}</a>
                </h2>
                <p class="text-xs text-stone-400 leading-relaxed line-clamp-3">
                  {art.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                <a 
                  href={`/articles/${art.slug}`} 
                  class="text-xs uppercase tracking-widest text-gold-400 hover:text-gold-300 font-semibold flex items-center space-x-1"
                >
                  <span>Read Full Article</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Editorial Lead Magnet Box -->
  <section class="py-16 bg-charcoal-900 border-t border-white/10 text-center">
    <div class="max-w-4xl mx-auto px-4 space-y-4">
      <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Complimentary Download</span>
      <h3 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
        Download the 2026 Mahalunge Real Estate Investment Dossier
      </h3>
      <p class="text-xs text-stone-400 max-w-lg mx-auto leading-relaxed">
        A 28-page institutional report covering PMRDA zoning maps, planned 36m road networks, Hinjewadi tech worker demographic statistics, and price projections.
      </p>
      <div class="pt-2">
        <button
          data-open-modal
          data-interest="2026 Investment Dossier"
          class="px-8 py-3.5 rounded bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
        >
          Download Investment Dossier (PDF)
        </button>
      </div>
    </div>
  </section>
</Layout>
