---
import Layout from '../../layouts/Layout.astro';
import RiverFlowingEmblem from '../../components/RiverFlowingEmblem.astro';
import { rievenzaCorridorData, type RivenzaDossierItem } from '../../data/pSeoMahindraRivenzaCorridor';

export async function getStaticPaths() {
  return rievenzaCorridorData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: RivenzaDossierItem;
}

const { item } = Astro.props;

// Schema.org JSON-LD for this specific Mahindra Rivenza Programmatic Page
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/#project`,
      "name": `Mahindra Rivenza - ${item.topic}`,
      "description": item.metaDescription,
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-10-06",
        "priceValidUntil": "2027-12-31"
      }
    },
    {
      "@type": "RealEstateAgent",
      "@id": `https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/#agent`,
      "name": "Mahindra Rivenza Advisory Desk",
      "legalName": "PropSmart Realty",
      "telephone": "+91 7744009295",
      "url": "https://mahindralifespaceshomes.in/",
      "areaServed": [
        { "@type": "City", "name": "Pune" },
        { "@type": "AdministrativeArea", "name": "Baner Annex" },
        { "@type": "AdministrativeArea", "name": "Mahalunge" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/#breadcrumbs`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://mahindralifespaceshomes.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Mahindra Rivenza",
          "item": "https://mahindralifespaceshomes.in/mahindra-rivenza/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": item.topic,
          "item": `https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/#faq`,
      "mainEntity": item.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<Layout
  title={item.metaTitle}
  description={item.metaDescription}
  keywords={`mahindra rivenza ${item.slug.replace(/-/g, ' ')}, mahindra rivenza baner annex, mahindra rivenza mahalunge, mahindra lifespaces baner annex, mahindra rivenza pune`}
  canonical={`https://mahindralifespaceshomes.in/mahindra-rivenza/${item.slug}/`}
  customSchema={pageSchema}
>
  <!-- Hero Section with Live Flowing River Emblem -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-7">
      
      <!-- Badges Row -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{item.badge}</span>
        </div>

        <div class="glass-floating inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-gold-500/30 backdrop-blur-md">
          <RiverFlowingEmblem size="xs" layout="horizontal" showSubtitle={false} />
          <span class="text-[11px] text-stone-200 font-medium border-l border-white/20 pl-2">Starts ₹90L*</span>
        </div>

        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-semibold border border-emerald-500/30">
          MahaRERA: PR1261012602102
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-50 max-w-4xl leading-tight">
        {item.h1}
      </h1>

      <p class="text-stone-300 text-sm sm:text-base max-w-3xl font-light leading-relaxed">
        {item.summary}
      </p>

      <!-- Key Vitals Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-2 max-w-3xl">
        {item.keyStats.map((stat) => (
          <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-gold-500/30 transition-all">
            <span class="text-[10px] uppercase tracking-wider text-stone-400 block">{stat.label}</span>
            <span class={`font-serif text-base font-bold ${stat.color || 'text-gold-400'}`}>{stat.value}</span>
          </div>
        ))}
      </div>

      <!-- High-Conversion CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <button
          data-open-modal
          data-interest={`Mahindra Rivenza - ${item.topic}`}
          class="btn-shimmer px-6 py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
        >
          {item.ctaText}
        </button>
        <button
          data-open-modal
          data-interest={`VIP Cab - via ${item.topic}`}
          class="px-6 py-3 rounded-full border border-gold-500/40 hover:border-gold-400 text-gold-300 hover:text-white font-semibold uppercase tracking-wider text-xs transition-all cursor-pointer bg-white/5"
        >
          Book VIP Site Cab (Free Pick & Drop)
        </button>
        <a
          href="tel:+917744009295"
          class="px-5 py-3 rounded-full border border-white/20 hover:border-white/40 text-stone-200 hover:text-white font-medium uppercase tracking-wider text-xs transition-all inline-flex items-center gap-2"
        >
          <span>Direct Advisory: +91 7744009295</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Deep Narrative & Technical Dossier -->
  <section class="py-16 bg-[#0e121a] border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left: Editorial Content -->
        <div class="lg:col-span-7 space-y-8">
          {item.contentSections.map((sec) => (
            <div class="space-y-4">
              <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
                {sec.title}
              </h2>
              {sec.paragraphs.map((p) => (
                <p class="text-stone-300 text-sm leading-relaxed font-light">
                  {p}
                </p>
              ))}

              {sec.highlights && sec.highlights.length > 0 && (
                <div class="p-6 rounded-2xl bg-charcoal-950 border border-white/10 space-y-3 mt-4">
                  <div class="text-xs uppercase tracking-widest text-gold-400 font-bold">
                    Key Highlights & Advantages
                  </div>
                  <ul class="space-y-2 text-xs text-stone-300">
                    {sec.highlights.map((h) => (
                      <li class="flex items-start gap-2.5">
                        <span class="text-emerald-400 font-bold">✓</span>
                        <span class="leading-relaxed">{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- Right: Official Community Badge & River Waves Showcase -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-2xl glass-card border border-gold-500/30 space-y-6 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-gold-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between border-b border-white/10 pb-3">
              <span class="px-2.5 py-1 rounded-full bg-brand-red/20 text-brand-red text-[10px] font-bold uppercase tracking-wider border border-brand-red/30">
                Mahindra Lifespaces
              </span>
              <span class="text-[10px] text-emerald-400 font-mono font-semibold">Priority Booking Open</span>
            </div>

            <!-- River Flowing Animated Emblem Card -->
            <div class="p-5 rounded-2xl bg-black/40 border border-gold-500/20 text-center space-y-3">
              <RiverFlowingEmblem size="md" layout="vertical" showSubtitle={true} />
              <p class="text-[11px] text-stone-400 font-light leading-relaxed pt-2">
                Sculpted around the biophilic rhythms of the Mula River and Western Ghats bio-reserves.
              </p>
            </div>

            <!-- Project Fast Facts -->
            <div class="p-4 rounded-xl bg-charcoal-900 border border-white/10 space-y-2 text-xs">
              <div class="text-gold-300 font-semibold border-b border-white/10 pb-1.5 flex justify-between">
                <span>Mahindra Rivenza Dossier</span>
                <span class="text-emerald-400 font-mono">Phase 1 Live</span>
              </div>
              <ul class="text-[11px] text-stone-300 space-y-1.5 pt-1">
                <li>• <strong>Master Development:</strong> 13.46 Acres in Baner Annex</li>
                <li>• <strong>Greens & Biodiversity:</strong> 9+ Acres (70%+ Open)</li>
                <li>• <strong>Grand Clubhouse:</strong> ~44,000 Sq.Ft. with Sunken Aqua Bar</li>
                <li>• <strong>Typologies:</strong> Luxury 2, 3 & 4 BHK Residences</li>
                <li>• <strong>MahaRERA Registration:</strong> PR1261012602102</li>
              </ul>
            </div>

            <!-- Action CTAs -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <button
                data-open-modal
                data-interest={`VIP Tour - ${item.topic}`}
                class="w-full py-2.5 rounded-xl bg-gold-500/20 hover:bg-gold-500 border border-gold-500/40 text-gold-300 hover:text-charcoal-950 font-bold uppercase tracking-wider text-[11px] transition-all cursor-pointer text-center"
              >
                Book VIP Site Tour
              </button>
              <button
                data-open-modal
                data-interest={`Cost Sheet - ${item.topic}`}
                class="w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/15 border border-white/20 text-stone-200 hover:text-white font-semibold uppercase tracking-wider text-[11px] transition-all cursor-pointer text-center"
              >
                Download Cost Sheet
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Localized FAQ Accordion -->
  <section class="py-16 bg-[#090c12] border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Buyer Intelligence</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Frequently Asked Questions: {item.topic}
        </h2>
      </div>

      <div class="space-y-4">
        {item.faqs.map((faq) => (
          <details class="group p-5 rounded-2xl glass-card border border-white/10 open:border-gold-500/30 transition-all">
            <summary class="flex justify-between items-center cursor-pointer font-serif text-sm font-semibold text-stone-200 group-open:text-gold-300 transition-colors">
              <span>{faq.q}</span>
              <span class="text-gold-400 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-xs text-stone-300 leading-relaxed font-light pl-1">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

      <!-- Quick Nav Cluster -->
      <div class="pt-8 text-center flex flex-wrap items-center justify-center gap-4">
        <a
          href="/mahindra-rivenza/"
          class="inline-flex items-center space-x-2 text-xs text-gold-400 hover:text-gold-300 transition-colors font-semibold uppercase tracking-wider"
        >
          <span>← Back to Mahindra Rivenza Hub</span>
        </a>
        <span class="text-stone-600">•</span>
        <a
          href="/baner-annex/"
          class="inline-flex items-center space-x-2 text-xs text-stone-300 hover:text-gold-300 transition-colors font-semibold uppercase tracking-wider"
        >
          <span>Baner Annex Guide →</span>
        </a>
        <span class="text-stone-600">•</span>
        <a
          href="/pune-real-estate/"
          class="inline-flex items-center space-x-2 text-xs text-stone-300 hover:text-gold-300 transition-colors font-semibold uppercase tracking-wider"
        >
          <span>Pune Real Estate Dominance →</span>
        </a>
      </div>

    </div>
  </section>
</Layout>
