---
import Layout from '../../layouts/Layout.astro';
import ResidenceSelector from '../../components/ResidenceSelector.astro';
import MasterPlanViewer from '../../components/MasterPlanViewer.astro';
import CommuteDistanceMatrix from '../../components/CommuteDistanceMatrix.astro';

const rivenzaMasterSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["ApartmentComplex", "RealEstateAgent"],
      "@id": "https://mahindralifespaceshomes.in/mahindra-rivenza/#complex",
      "name": "Mahindra Rivenza",
      "alternateName": "Mahindra Rivenza Baner Annex Mahalunge Pune",
      "legalName": "Mahindra Lifespace Developers Limited",
      "url": "https://mahindralifespaceshomes.in/mahindra-rivenza/",
      "telephone": "+91-7744009295",
      "email": "propsmartrealty@gmail.com",
      "priceRange": "₹90 Lakhs - ₹2.55 Crore+",
      "description": "Mahindra Rivenza is a premier 13.46-acre biophilic residential master development by Mahindra Lifespaces located at Baner Annex / Mahalunge, Pune. Featuring 9+ acres of vehicle-free greens, ~44,000 sq.ft clubhouse, sunken aqua bar pool, and luxury 2, 3 & 4 BHK residences starting ₹90 Lakhs*.",
      "image": [
        "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp",
        "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Swimming%20pool%20with%20sunken%20bar_Rivenza_11zon.webp"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande",
        "addressLocality": "Mahalunge, Pune",
        "postalCode": "412115",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.562536,
        "longitude": 73.727373
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "487",
        "bestRating": "5",
        "worstRating": "1"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/mahindra-rivenza/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Mahindra Rivenza and where is it located?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is a landmark 13.46-acre biophilic township by Mahindra Lifespaces situated at Baner Annex, off the Baner-Hinjawadi Road, Mahalunge, Pune 412115, connecting Hinjewadi IT Park and Balewadi High Street."
          }
        },
        {
          "@type": "Question",
          "name": "What are the MahaRERA registration numbers for Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is registered under MahaRERA: Phase 1 (PR1261012602102) and Phase 2 (PM1261012602103) valid up to 30/12/31."
          }
        },
        {
          "@type": "Question",
          "name": "What is the official starting price for apartments at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Official launch pricing starts from ₹90 Lakhs* for 2 BHK Premium residences, ₹1.04 Cr – ₹1.14 Cr for 2 BHK Luxury, ₹1.31 Cr – ₹1.60 Cr for 3 BHK Deluxe/Ultra, and ₹2.20 Cr – ₹2.55 Cr for 4 BHK Luxury estates."
          }
        },
        {
          "@type": "Question",
          "name": "What is the clubhouse and green space size at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza features 9+ acres of vehicle-free landscaped greens and over 2.65 Lakh sq.ft of total amenity zones, anchored by a ~44,000 sq.ft multi-level clubhouse and a swimming pool with a sunken aqua bar."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Pune | 13.46-Acre Landmark in Baner Annex Mahalunge"
  description="Master showcase for Mahindra Rivenza by Mahindra Lifespaces at Baner Annex / Mahalunge, Pune. 13.46 acres, 9+ acres greens, ~44,000 sq.ft clubhouse, sunken aqua bar pool, 2, 3 & 4 BHK flats starting ₹90 Lakhs*. MahaRERA PR1261012602102."
  keywords="mahindra rivenza, mahindra rivenza pune, mahindra rivenza mahalunge, mahindra rivenza baner annex, mahindra rivenza price, mahindra rivenza floor plan, mahindra rivenza brochure, mahindra rivenza reviews, mahindra rivenza rera"
  canonical="https://mahindralifespaceshomes.in/mahindra-rivenza/"
  customSchema={rivenzaMasterSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 relative z-10">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Officially Launched Flagship Landmark</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza: <br />
        <span class="gold-gradient-text">13.46-Acre Biophilic Sanctuary in Baner Annex, Mahalunge</span>
      </h1>
      <p class="text-stone-300 text-base sm:text-lg max-w-3xl font-light leading-relaxed">
        The definitive residential ecosystem engineered by Mahindra Lifespace Developers Limited. Offering 9+ acres of landscaped open spaces, a ~44,000 sq.ft. grand clubhouse with sunken aqua bar pool, and thoughtfully crafted 2, 3 & 4 BHK residences starting from ₹90 Lakhs*.
      </p>

      <div class="flex flex-wrap gap-4 pt-4">
        <a 
          href="#typologies" 
          class="px-6 py-3.5 rounded-xl bg-gold-500 text-charcoal-950 font-semibold text-sm tracking-wide hover:bg-gold-400 transition-colors shadow-lg shadow-gold-500/20"
        >
          View 9 Typologies & Floor Plans
        </a>
        <a 
          href="/pricing/" 
          class="px-6 py-3.5 rounded-xl bg-charcoal-900 border border-white/20 text-stone-100 font-medium text-sm tracking-wide hover:border-gold-500/50 hover:text-gold-300 transition-colors"
        >
          Download Cost Sheet (From ₹90L*)
        </a>
        <button 
          data-open-modal 
          class="px-6 py-3.5 rounded-xl bg-white/5 border border-white/10 text-stone-200 font-medium text-sm hover:bg-white/10 transition-colors"
        >
          Book Priority Site Visit
        </button>
      </div>
    </div>
  </section>

  <!-- Key Master Metrics -->
  <section class="py-14 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-gold-400">13.46 Acres</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Township Scale</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-stone-100">9+ Acres</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Landscaped Greens</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-gold-400">~44,000 sq.ft</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Grand Clubhouse</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-emerald-400">IGBC Gold</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Net Zero Waste</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-gold-400">₹90 Lakhs*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Starting Price</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl font-bold text-stone-100">PR1261012602102</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">MahaRERA Phase 1</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Floor Plan & Typology Selector -->
  <section id="typologies" class="py-20 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-stone-100">
          Official 9 Typologies & Floor Plan Explorer
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light">
          Engineered for optimal cross-ventilation, expansive balconies with enhanced biophilic views, and zero dead space.
        </p>
      </div>

      <ResidenceSelector />
    </div>
  </section>

  <!-- Master Layout Section -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-stone-100">
          13.46-Acre Master Township Layout
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light">
          5 integrated zones ensuring vehicular-free child safety, active athletic tracks, and calm wellness greens.
        </p>
      </div>

      <MasterPlanViewer />
    </div>
  </section>

  <!-- Commute Distance Matrix -->
  <section class="py-20 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <h2 class="font-serif text-2xl sm:text-4xl font-bold text-stone-100">
          Strategic Baner Annex Connectivity
        </h2>
        <p class="text-stone-400 text-sm sm:text-base font-light">
          Situated at the nexus of Baner, Balewadi High Street, and Hinjewadi IT Park Phase 1.
        </p>
      </div>

      <CommuteDistanceMatrix />
    </div>
  </section>

  <!-- Legal MahaRERA Disclosures -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h3 class="font-serif text-xl sm:text-2xl font-bold text-stone-100">
        MahaRERA Statutory Compliance & Developer Verification
      </h3>
      <p class="text-stone-400 text-xs sm:text-sm leading-relaxed">
        Mahindra Rivenza is developed by Mahindra Lifespace Developers Limited and registered under MahaRERA:
        <strong>Phase 1: PR1261012602102</strong> and <strong>Phase 2: PM1261012602103</strong> valid up to 30/12/31. 
        Complete certificates, sanctioned layout plans, and proforma agreement for sale are publicly verifiable on 
        <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">MahaRERA Official Portal</a>.
      </p>
    </div>
  </section>
</Layout>
