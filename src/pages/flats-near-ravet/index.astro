---
import Layout from '../../layouts/Layout.astro';
import ResidenceSelector from '../../components/ResidenceSelector.astro';

const ravetSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/flats-near-ravet/#place",
      "name": "Ravet & Baner Annex Residential Corridor",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ravet",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "18.5623125",
        "longitude": "73.7273125"
      }
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/flats-near-ravet/#product",
      "name": "Luxury Flats Near Ravet Pune - Mahindra Rivenza",
      "description": "Looking for flats near Ravet? Upgrade to Mahindra Rivenza in Baner Annex / Mahalunge. 13.46 acres, ~44,000 sq.ft clubhouse, 9+ acres greens starting ₹90 Lakhs*.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mahindralifespaceshomes.in/flats-near-ravet/#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "West Pune", "item": "https://mahindralifespaceshomes.in/west-pune/" },
        { "@type": "ListItem", "position": 3, "name": "Flats Near Ravet", "item": "https://mahindralifespaceshomes.in/flats-near-ravet/" }
      ]
    }
  ]
};
---

<Layout
  title="Flats Near Ravet Pune | Mahindra Rivenza Luxury Township ₹90L*"
  description="Seeking flats near Ravet PCMC? Discover Mahindra Rivenza at Baner Annex / Mahalunge. 13.46 acres, resort clubhouse & 7-min Hinjewadi access from ₹90L*."
  keywords="flats near ravet, flats in ravet pcmc, 2 bhk flats in ravet, 3 bhk flats in ravet, mahindra rivenza baner annex pune"
  canonical="https://mahindralifespaceshomes.in/flats-near-ravet/"
  customSchema={ravetSchema}
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest font-mono">
        <span>Gateway to Hinjewadi &amp; PCMC</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Flats Near Ravet: <br />
        <span class="gold-gradient-text">Choose Master-Planned Baner Annex Living</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Compare Ravet properties with Mahindra Rivenza in Baner Annex. Enjoy 9+ acres of vehicle-free greens, 4-lane river bridge access to Hinjewadi, and pre-launch pricing from ₹90 Lakhs*.
      </p>

      <div class="flex flex-wrap gap-4 pt-4">
        <button
          data-open-modal
          data-interest="Ravet Buyer Priority"
          class="btn-shimmer px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold tracking-widest uppercase hover:shadow-xl transition-all cursor-pointer"
        >
          Request Cost Sheet
        </button>
      </div>
    </div>
  </section>

  <ResidenceSelector />
</Layout>
