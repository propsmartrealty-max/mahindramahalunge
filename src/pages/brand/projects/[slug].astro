---
import Layout from '../../../layouts/Layout.astro';
import { brandProjectData, type BrandProjectItem } from '../../../data/pSeoBrandProjects';

export async function getStaticPaths() {
  return brandProjectData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: BrandProjectItem;
}

const { item } = Astro.props;

const statusColor = {
  'Pre-Launch': 'text-amber-400 bg-amber-500/10 border-amber-500/30',
  'Under Construction': 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30',
  'Delivered': 'text-cyan-400 bg-cyan-500/10 border-cyan-500/30',
}[item.status];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ApartmentComplex",
      "@id": `https://mahindralifespaceshomes.in/brand/projects/${item.slug}/#property`,
      "name": item.name,
      "description": item.metaDescription,
      "url": `https://mahindralifespaceshomes.in/brand/projects/${item.slug}/`,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": item.location,
        "addressLocality": "Pune",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "image": item.image,
      "numberOfRooms": item.typologies.join(", "),
      "floorSize": {
        "@type": "QuantitativeValue",
        "value": item.landArea,
        "unitText": "acres"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://mahindralifespaceshomes.in/brand/projects/${item.slug}/#faq`,
      "mainEntity": item.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "Brand Portfolio", "item": "https://mahindralifespaceshomes.in/brand/" },
        { "@type": "ListItem", "position": 3, "name": item.name, "item": `https://mahindralifespaceshomes.in/brand/projects/${item.slug}/` }
      ]
    }
  ]
};
---

<Layout
  title={item.metaTitle}
  description={item.metaDescription}
  keywords={`${item.name.toLowerCase()}, ${item.shortName.toLowerCase()} pune, ${item.shortName.toLowerCase()} price, ${item.shortName.toLowerCase()} floor plan, mahindra lifespaces ${item.microMarket.toLowerCase()}, ${item.typologies.map(t => t.toLowerCase()).join(', ')}`}
  canonical={`https://mahindralifespaceshomes.in/brand/projects/${item.slug}/`}
  image={item.image}
  customSchema={pageSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">

      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-[11px] text-stone-500">
        <a href="/" class="hover:text-gold-400 transition-colors">Home</a>
        <span>›</span>
        <a href="/brand/" class="hover:text-gold-400 transition-colors">Brand Portfolio</a>
        <span>›</span>
        <span class="text-stone-300">{item.name}</span>
      </nav>

      <div class={`inline-flex items-center space-x-2 px-3 py-1 rounded-full border text-xs font-semibold uppercase tracking-widest ${statusColor}`}>
        <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
        <span>{item.status} · {item.microMarket}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        {item.h1}
      </h1>

      <p class="text-stone-300 text-sm sm:text-base max-w-3xl font-light leading-relaxed">
        {item.heroTagline}
      </p>

      <!-- Quick Spec Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-2">
        {item.keySpecs.map((spec) => (
          <div class="p-3 rounded-xl bg-charcoal-900 border border-white/10 text-center">
            <div class="text-[10px] text-stone-500 uppercase tracking-wider mb-1">{spec.label}</div>
            <div class="text-xs text-stone-100 font-semibold leading-tight">{spec.value}</div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Hero Image & CTA -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">

      <!-- Project Image -->
      <div class="lg:col-span-7 rounded-2xl overflow-hidden border border-white/10 shadow-2xl aspect-video">
        <img
          src={item.image}
          alt={`${item.name} — ${item.microMarket} luxury residences`}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Primary CTA Box -->
      <div class="lg:col-span-5 glass-card rounded-2xl border border-gold-500/30 p-8 space-y-6 shadow-2xl text-center">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold block">
          {item.status === 'Pre-Launch' ? 'Register Your Interest' : item.status === 'Under Construction' ? 'Book Site Visit' : 'Resale & Rental Enquiry'}
        </span>
        <h3 class="font-serif text-xl text-stone-50 font-bold">
          {item.status === 'Pre-Launch'
            ? `Secure Pre-Launch EOI — ${item.name}`
            : item.status === 'Under Construction'
            ? `Schedule a Site Visit — ${item.name}`
            : `Explore Resale & Rental Options — ${item.name}`
          }
        </h3>
        <p class="text-xs text-stone-300 font-light leading-relaxed">
          {item.investmentCase}
        </p>
        {item.rentalYield && (
          <div class="flex items-center justify-center space-x-2 text-emerald-400 font-semibold text-sm">
            <span>📈</span>
            <span>Projected Rental Yield: {item.rentalYield}</span>
          </div>
        )}
        <button
          data-open-modal
          data-interest={`${item.name} — ${item.status} Enquiry`}
          class="btn-shimmer w-full py-3.5 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-md hover:shadow-gold-500/30 transition-all cursor-pointer"
        >
          {item.status === 'Pre-Launch' ? 'Register EOI Now' : item.status === 'Under Construction' ? 'Book Site Visit' : 'Get Resale Price'}
        </button>
      </div>

    </div>
  </section>

  <!-- Typologies & Configurations -->
  <section class="py-20 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Residence Configurations</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Available Typologies at {item.shortName}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {item.typologies.map((typology, i) => (
          <div class="p-6 rounded-2xl bg-charcoal-900 border border-white/10 hover:border-gold-500/40 transition-all space-y-3">
            <div class="w-8 h-8 rounded-full bg-gold-500/20 border border-gold-500/40 text-gold-300 font-bold flex items-center justify-center text-xs font-serif">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="font-serif text-base font-bold text-stone-100">{typology}</h3>
            <button
              data-open-modal
              data-interest={`${item.name} — ${typology} Floor Plan`}
              class="text-xs text-gold-400 hover:text-gold-300 font-semibold uppercase tracking-wider transition-colors cursor-pointer"
            >
              Get Floor Plan & Price →
            </button>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Amenity Highlights -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">

      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">World-Class Amenities</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          What Residents at {item.shortName} Enjoy
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {item.amenityHighlights.map((amenity) => (
          <div class="p-5 rounded-xl bg-charcoal-950 border border-white/10 flex items-start space-x-3">
            <span class="text-gold-400 font-bold flex-shrink-0">✦</span>
            <p class="text-xs text-stone-200 leading-relaxed font-light">{amenity}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Transit & Location -->
  <section class="py-20 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">

      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Location Intelligence</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Connectivity & Transit Advantage
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-charcoal-900 border border-gold-500/30 space-y-3">
          <h3 class="font-serif text-lg font-bold text-gold-300">📍 Exact Location</h3>
          <p class="text-xs text-stone-200 leading-relaxed">{item.location}</p>
          <p class="text-xs text-stone-400">Micro-Market: <span class="text-stone-200 font-semibold">{item.microMarket}</span></p>
        </div>
        <div class="p-6 rounded-2xl bg-charcoal-900 border border-emerald-500/30 space-y-3">
          <h3 class="font-serif text-lg font-bold text-emerald-300">🚇 Transit Highlight</h3>
          <p class="text-xs text-stone-200 leading-relaxed">{item.transitHighlight}</p>
          <p class="text-xs text-stone-400">From Mahalunge: <span class="text-stone-200 font-semibold">{item.distanceFromMahalunge}</span></p>
        </div>
      </div>

    </div>
  </section>

  <!-- FAQs -->
  <section class="py-20 bg-charcoal-900 border-t border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Project Q&A</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="space-y-4">
        {item.faqs.map((faq) => (
          <details class="glass-card group p-5 rounded-xl border border-white/15 hover:border-gold-500/50 cursor-pointer transition-all">
            <summary class="flex items-center justify-between font-serif text-sm sm:text-base text-stone-100 font-semibold list-none">
              <span class="group-hover:text-gold-300 transition-colors">{faq.q}</span>
              <span class="text-gold-400 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-stone-200 leading-relaxed pt-3 border-t border-white/10 font-light">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Cross-Link Other Projects -->
  <section class="py-16 bg-charcoal-950 border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h3 class="font-serif text-lg text-stone-100 font-bold">
        Explore Other Mahindra Lifespaces Pune Projects:
      </h3>
      <div class="flex flex-wrap gap-3">
        {brandProjectData
          .filter((p) => p.slug !== item.slug)
          .map((p) => (
            <a
              href={`/brand/projects/${p.slug}/`}
              class="px-4 py-2 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-500/50 text-xs text-stone-200 hover:text-gold-300 transition-all"
            >
              {p.shortName} →
            </a>
          ))}
      </div>
      <a href="/brand/" class="inline-block text-xs text-gold-400 hover:text-gold-300 font-semibold uppercase tracking-widest transition-colors">
        ← View Complete Mahindra Pune Portfolio
      </a>
    </div>
  </section>
</Layout>
