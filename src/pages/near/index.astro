---
import Layout from '../../layouts/Layout.astro';
import { techParkData } from '../../data/pSeoTechParks';

const nearIndexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/near/#collection",
      "url": "https://mahindralifespaceshomes.in/near/",
      "name": "Flats Near Hinjewadi IT Parks & Tech Hubs — Mahindra Rivenza",
      "description": "Comprehensive directory of luxury flats near Hinjewadi Phase 1, Phase 2, Phase 3, Baner, and Balewadi IT parks with transit times and distance matrices.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Tech Hub Proximity", "item": "https://mahindralifespaceshomes.in/near/" }
        ]
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://mahindralifespaceshomes.in/near/#itemlist",
      "name": "Tech Parks & Workplaces Near Mahindra Rivenza",
      "numberOfItems": techParkData.length,
      "itemListElement": techParkData.map((item, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": `Flats Near ${item.name}`,
        "url": `https://mahindralifespaceshomes.in/near/${item.slug}/`
      }))
    }
  ]
};
---

<Layout
  title="Flats Near Hinjewadi IT Parks [Starts ₹90L*] Mahindra Rivenza"
  description="Explore flats near Hinjewadi IT parks, Wipro Circle, Infosys, TCS & Balewadi High Street from Mahindra Rivenza. 4 to 12 mins transit via Mula River bridge."
  canonical="https://mahindralifespaceshomes.in/near/"
  customSchema={nearIndexSchema}
>
  <main class="pt-32 pb-24 bg-charcoal-950 text-stone-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>32 Tech Park Proximity Corridors</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100">
          Flats Near Hinjewadi &amp; West Pune IT Parks <br />
          <span class="gold-gradient-text">Zero-Traffic Living at Mahindra Rivenza</span>
        </h1>
        <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto leading-relaxed font-light">
          Experience walk-to-work or under-10-minute commutes to Pune's premier technology campuses. Located in Baner Annex / Mahalunge, Mahindra Rivenza connects seamlessly via the 4-lane Mula River Bridge.
        </p>
      </div>

      <!-- Quick Category Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a href="/near/schools/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Nearby International Schools (16) →
        </a>
        <a href="/near/hospitals/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Nearby Super-Specialty Hospitals (16) →
        </a>
        <a href="/near/metro/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Pune Metro Line 3 Stations (16) →
        </a>
        <a href="/commute/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Commute Time Matrix →
        </a>
      </div>

      <!-- Tech Parks Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {techParkData.map((item) => (
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 hover:border-gold-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded bg-gold-500/10 text-gold-400 border border-gold-500/20 text-[11px] font-semibold uppercase tracking-wider">
                  {item.category}
                </span>
                <span class="text-xs text-emerald-400 font-mono font-semibold">
                  {item.distanceKm} ({item.driveTime})
                </span>
              </div>

              <div>
                <h2 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">
                  {item.shortName || item.name}
                </h2>
                <div class="text-xs text-stone-400 mt-1 line-clamp-2">{item.heroHighlight}</div>
              </div>

              <div class="bg-charcoal-950/60 p-3.5 rounded-xl border border-white/5 space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-stone-400">Workforce:</span>
                  <span class="text-white font-medium">{item.workforceCount}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400">Rental Yield:</span>
                  <span class="text-gold-400 font-bold">{item.rentalYield}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400">Two-Wheeler:</span>
                  <span class="text-stone-300">{item.bikeTime}</span>
                </div>
              </div>

              <div class="flex flex-wrap gap-1.5 pt-1">
                {item.topCompanies.slice(0, 3).map((comp) => (
                  <span class="px-2 py-0.5 rounded bg-white/5 text-[10px] text-stone-300 border border-white/10">
                    {comp}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-6 border-t border-white/5 mt-6">
              <a
                href={`/near/${item.slug}/`}
                class="block w-full text-center py-2.5 px-4 bg-white/5 hover:bg-gold-500 hover:text-charcoal-950 text-stone-200 text-xs font-bold uppercase tracking-wider rounded-xl transition-all"
              >
                Inspect Proximity Dossier →
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Bottom Advisory Box -->
      <div class="bg-gradient-to-r from-gold-600/20 via-charcoal-900 to-gold-600/20 border border-gold-500/40 rounded-2xl p-6 sm:p-8 text-center space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
          Looking for Residences Near Your Office Campus?
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto leading-relaxed">
          Book a VIP experience tour of Mahindra Rivenza at Baner Annex and evaluate exact transit times from your office tower.
        </p>
        <div class="pt-2">
          <button
            data-open-modal
            data-interest="Tech Park Proximity Tour"
            class="btn-shimmer px-6 py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase text-xs tracking-wider shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
          >
            Schedule VIP Site Visit & Commute Test →
          </button>
        </div>
      </div>

    </div>
  </main>
</Layout>
