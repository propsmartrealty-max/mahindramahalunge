---
import Layout from '../../../layouts/Layout.astro';
import { schoolData } from '../../../data/pSeoSchools';

const schoolsIndexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/near/schools/#collection",
      "url": "https://mahindralifespaceshomes.in/near/schools/",
      "name": "Flats Near Top International Schools in West Pune — Mahindra Rivenza",
      "description": "Comprehensive guide to luxury 2, 3 & 4 BHK residences near leading CBSE, ICSE, and IB international schools in Baner, Balewadi, and Hinjewadi.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Tech Hub Proximity", "item": "https://mahindralifespaceshomes.in/near/" },
          { "@type": "ListItem", "position": 3, "name": "Schools", "item": "https://mahindralifespaceshomes.in/near/schools/" }
        ]
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://mahindralifespaceshomes.in/near/schools/#itemlist",
      "name": "Top Schools Near Mahindra Rivenza",
      "numberOfItems": schoolData.length,
      "itemListElement": schoolData.map((item, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": `Flats Near ${item.name}`,
        "url": `https://mahindralifespaceshomes.in/near/schools/${item.slug}/`
      }))
    }
  ]
};
---

<Layout
  title="Flats Near Top Schools in Baner & Balewadi [Starts ₹90L*] Rivenza"
  description="Find flats near top schools in Baner, Balewadi & Hinjewadi from Mahindra Rivenza. VIBGYOR, Orchid, Mercedes-Benz, Bharati Vidyapeeth with door-to-door buses."
  canonical="https://mahindralifespaceshomes.in/near/schools/"
  customSchema={schoolsIndexSchema}
>
  <main class="pt-32 pb-24 bg-charcoal-950 text-stone-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Education Corridor Directory • 16 Top Schools</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100">
          Residences Near Top International Schools <br />
          <span class="gold-gradient-text">Safe, Short Commutes for Your Children</span>
        </h1>
        <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto leading-relaxed font-light">
          Give your kids more time to play, learn, and grow. Mahindra Rivenza at Baner Annex / Mahalunge provides doorstep school bus access and 5 to 15 minute commutes to premier ICSE, CBSE, and Cambridge institutions.
        </p>
      </div>

      <!-- Quick Category Navigation -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a href="/near/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          ← All Tech Parks (32)
        </a>
        <a href="/near/hospitals/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Nearby Hospitals (16) →
        </a>
        <a href="/near/metro/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Metro Stations (16) →
        </a>
      </div>

      <!-- Schools Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {schoolData.map((item) => (
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 hover:border-gold-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 text-[11px] font-semibold uppercase tracking-wider">
                  {item.curriculum}
                </span>
                <span class="text-xs text-emerald-400 font-mono font-semibold">
                  {item.distanceKm} ({item.driveTime})
                </span>
              </div>

              <div>
                <h2 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">
                  {item.shortName || item.name}
                </h2>
                <div class="text-xs text-stone-400 mt-1 line-clamp-2">{item.heroHighlight}</div>
              </div>

              <div class="bg-charcoal-950/60 p-3.5 rounded-xl border border-white/5 space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-stone-400">Grades:</span>
                  <span class="text-white font-medium">{item.gradeLevels}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400">Bus Access:</span>
                  <span class="text-emerald-400 font-semibold">Doorstep Pick-up</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400">Recommended:</span>
                  <span class="text-gold-400 font-medium">3 BHK Family Suite</span>
                </div>
              </div>

              <p class="text-[11px] text-stone-400 line-clamp-2">
                {item.parentAdvantage}
              </p>
            </div>

            <div class="pt-6 border-t border-white/5 mt-6">
              <a
                href={`/near/schools/${item.slug}/`}
                class="block w-full text-center py-2.5 px-4 bg-white/5 hover:bg-gold-500 hover:text-charcoal-950 text-stone-200 text-xs font-bold uppercase tracking-wider rounded-xl transition-all"
              >
                Inspect School Commute Dossier →
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>
