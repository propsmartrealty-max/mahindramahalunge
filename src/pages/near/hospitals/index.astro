---
import Layout from '../../../layouts/Layout.astro';
import { hospitalData } from '../../../data/pSeoHospitals';

const hospitalsIndexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/near/hospitals/#collection",
      "url": "https://mahindralifespaceshomes.in/near/hospitals/",
      "name": "Flats Near Super-Specialty Hospitals in Baner & Hinjewadi — Mahindra Rivenza",
      "description": "Comprehensive guide to luxury residences near top multi-specialty and quaternary care hospitals in Baner, Balewadi, and Hinjewadi with emergency transit times.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Tech Hub Proximity", "item": "https://mahindralifespaceshomes.in/near/" },
          { "@type": "ListItem", "position": 3, "name": "Hospitals", "item": "https://mahindralifespaceshomes.in/near/hospitals/" }
        ]
      }
    },
    {
      "@type": "ItemList",
      "@id": "https://mahindralifespaceshomes.in/near/hospitals/#itemlist",
      "name": "Top Hospitals Near Mahindra Rivenza",
      "numberOfItems": hospitalData.length,
      "itemListElement": hospitalData.map((item, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": `Flats Near ${item.name}`,
        "url": `https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/`
      }))
    }
  ]
};
---

<Layout
  title="Flats Near Jupiter & Manipal Hospital Baner [Starts ₹90L*] Rivenza"
  description="Find flats near Jupiter Hospital, Manipal Hospital Baner & Ruby Hall Hinjewadi from Mahindra Rivenza. 6 to 12 mins emergency access with 24x7 medical security."
  canonical="https://mahindralifespaceshomes.in/near/hospitals/"
  customSchema={hospitalsIndexSchema}
>
  <main class="pt-32 pb-24 bg-charcoal-950 text-stone-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Healthcare Infrastructure Directory • 16 Hospitals</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100">
          Residences Near Premier Super-Specialty Hospitals <br />
          <span class="gold-gradient-text">24x7 Emergency Security for Your Family</span>
        </h1>
        <p class="text-xs sm:text-sm text-stone-300 max-w-2xl mx-auto leading-relaxed font-light">
          Medical peace of mind for parents and children. Mahindra Rivenza at Baner Annex / Mahalunge provides rapid 6 to 12 minute access to Pune's leading NABH-accredited tertiary care hospitals.
        </p>
      </div>

      <!-- Quick Category Navigation -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <a href="/near/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          ← All Tech Parks (32)
        </a>
        <a href="/near/schools/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Nearby Schools (16) →
        </a>
        <a href="/near/metro/" class="px-3.5 py-1.5 rounded-full bg-white/5 hover:bg-gold-500/20 border border-white/10 hover:border-gold-500/40 text-xs text-stone-300 hover:text-gold-300 transition-colors">
          Metro Stations (16) →
        </a>
      </div>

      <!-- Hospitals Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hospitalData.map((item) => (
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 hover:border-gold-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded bg-rose-500/10 text-rose-300 border border-rose-500/20 text-[11px] font-semibold uppercase tracking-wider">
                  {item.bedCount}
                </span>
                <span class="text-xs text-emerald-400 font-mono font-semibold">
                  {item.distanceKm} ({item.driveTime})
                </span>
              </div>

              <div>
                <h2 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">
                  {item.shortName || item.name}
                </h2>
                <div class="text-xs text-stone-400 mt-1 line-clamp-2">{item.specialties}</div>
              </div>

              <div class="bg-charcoal-950/60 p-3.5 rounded-xl border border-white/5 space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-stone-400">Emergency:</span>
                  <span class="text-emerald-400 font-semibold">24x7 Trauma Care</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400">Transit:</span>
                  <span class="text-white font-medium">{item.heroHighlight}</span>
                </div>
              </div>

              <p class="text-[11px] text-stone-400 line-clamp-2">
                {item.healthcareAdvantage}
              </p>
            </div>

            <div class="pt-6 border-t border-white/5 mt-6">
              <a
                href={`/near/hospitals/${item.slug}/`}
                class="block w-full text-center py-2.5 px-4 bg-white/5 hover:bg-gold-500 hover:text-charcoal-950 text-stone-200 text-xs font-bold uppercase tracking-wider rounded-xl transition-all"
              >
                Inspect Hospital Proximity Dossier →
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>
