---
import Layout from '../../../layouts/Layout.astro';
import { hospitalData, type HospitalItem } from '../../../data/pSeoHospitals';

export async function getStaticPaths() {
  return hospitalData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: HospitalItem;
}

const { item } = Astro.props;

// Construct Schema.org JSON-LD for this specific hospital proximity page
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Hospital",
      "@id": `https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/#hospital`,
      "name": item.name,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "West Pune / Baner / Wakad / PCMC",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      }
    },
    {
      "@type": "RealEstateListing",
      "@id": `https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/#listing`,
      "name": `Homes Near ${item.name} - Mahindra Rivenza`,
      "description": item.metaDescription,
      "url": `https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/`,
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "INR",
        "lowPrice": "9000000",
        "highPrice": "25500000"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/#faq`,
      "mainEntity": item.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};
---

<Layout
  title={item.metaTitle}
  description={item.metaDescription}
  keywords={`flats near ${item.name.toLowerCase()}, apartments near ${item.shortName.toLowerCase()}, residences near hospital baner, medical hub west pune, mahindra rivenza healthcare`}
  canonical={`https://mahindralifespaceshomes.in/near/hospitals/${item.slug}/`}
  customSchema={pageSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold uppercase tracking-widest">
        <span>Healthcare & Wellness Proximity Node</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight">
        {item.h1}
      </h1>

      <p class="text-lg text-stone-300 max-w-3xl leading-relaxed">
        {item.metaDescription}
      </p>

      <!-- Key Metrics Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Distance</div>
          <div class="text-2xl font-bold text-rose-300 mt-1">{item.distanceKm}</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Drive Time</div>
          <div class="text-2xl font-bold text-white mt-1">{item.driveTime}</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Capacity</div>
          <div class="text-sm font-semibold text-emerald-400 mt-1 line-clamp-1">{item.bedCount}</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Emergency</div>
          <div class="text-sm font-semibold text-sky-400 mt-1 line-clamp-1">24x7 Ready</div>
        </div>
      </div>

      <!-- CTA Action Bar -->
      <div class="pt-4 flex flex-wrap gap-4 items-center">
        <a
          href="/pricing/"
          class="px-6 py-3 rounded-lg bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-semibold text-sm transition-all shadow-lg shadow-gold-500/20"
        >
          View Residences & Pricing Sheet
        </a>
        <a
          href="tel:+917744009295"
          class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/15 border border-white/20 text-white font-medium text-sm transition-all"
        >
          Call Wellness Advisor: +91 7744009295
        </a>
      </div>

    </div>
  </section>

  <!-- Content Dossier Section -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Healthcare Advantage Card -->
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-4">
          <h2 class="font-serif text-2xl font-bold text-white">Emergency Peace of Mind</h2>
          <p class="text-stone-300 leading-relaxed text-sm">
            {item.healthcareAdvantage}
          </p>
          <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-xs text-rose-300">
            <strong>Emergency & Critical Care:</strong> {item.emergencyServices}
          </div>
          <div class="text-xs text-stone-400">
            <strong>Core Specialties:</strong> {item.specialties}
          </div>
        </div>

        <!-- Wellness Features Card -->
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-4">
          <h2 class="font-serif text-2xl font-bold text-white">Biophilic & Healthy Living at Rivenza</h2>
          <p class="text-stone-300 leading-relaxed text-sm">
            {item.wellnessFeaturesAtRivenza}
          </p>
          <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300">
            <strong>Recommended Typology:</strong> {item.recommendedConfig}
          </div>
          <div class="text-xs text-stone-400">
            <strong>Eco-Certification:</strong> IGBC Gold Pre-Certified with clean air microclimate and 80%+ cross-ventilation.
          </div>
        </div>

      </div>

      <!-- Route Overview -->
      <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-4">
        <h3 class="font-serif text-xl font-bold text-white">Transit Route to {item.shortName}</h3>
        <p class="text-stone-300 text-sm leading-relaxed">
          {item.routeOverview} From Mahindra Rivenza at Mahalunge / Baner Annex, wide access roads allow swift emergency transit without being trapped in highway congestion.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-6 pt-6">
        <h3 class="font-serif text-2xl font-bold text-white">Healthcare Proximity FAQs</h3>
        <div class="space-y-4">
          {item.faqs.map((faq) => (
            <div class="border border-white/10 rounded-xl p-5 bg-white/[0.02]">
              <h4 class="font-semibold text-rose-300 text-base">{faq.q}</h4>
              <p class="text-stone-300 text-sm mt-2 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
