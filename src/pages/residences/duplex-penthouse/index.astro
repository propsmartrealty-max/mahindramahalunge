---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge Duplex Penthouse | Sky Duplex Luxury Mahalunge Pune"
  description="Explore Duplex Sky Penthouse residences at Mahindra Mahalunge: double-storey luxury homes with private sky terraces, winding staircases, and panoramic biophilic views near Hinjewadi Pune."
  keywords="mahindra mahalunge duplex penthouse, mahindra mahalunge sky duplex, duplex flats near hinjewadi pune, mahindra lifespaces duplex mahalunge, sky duplex west pune"
  canonical="https://mahindralifespaceshomes.in/residences/duplex-penthouse/"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Duplex Sky Collection · Double-Storey Luxury</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Duplex Sky Penthouse: <br />
        <span class="gold-gradient-text">Two Floors of Biophilic Grandeur</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        The rarest offering at Mahindra Mahalunge — a double-storey duplex penthouse spanning two full floors with a private winding staircase, sky terrace garden, and 360° Sahyadri panorama.
      </p>
    </div>
  </section>

  <!-- Specs -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">2,500+ sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Duplex Carpet Area</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">Double Floor</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Private Staircase</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">Sky Terrace</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Rooftop Garden</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-emerald-400">Ultra-Exclusive</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Limited Availability</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-3xl text-stone-100 font-bold">Request Duplex Penthouse Private Dossier</h2>
      <p class="text-stone-300 text-sm font-light leading-relaxed max-w-2xl mx-auto">
        Duplex Sky Penthouses are ultra-limited. Request your private brochure, confidential floor plan, and early-mover pricing directly from our luxury residential concierge team.
      </p>
      <button
        data-open-modal
        data-unit="Duplex Penthouse"
        data-interest="Duplex Penthouse Exclusive EOI"
        class="btn-shimmer px-10 py-4 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
      >
        Request Duplex Penthouse Dossier
      </button>
    </div>
  </section>
</Layout>
