---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge 2 BHK Premium | Large Carpet Smart Homes Near Hinjewadi Pune"
  description="Mahindra Mahalunge 2 BHK Premium residences: larger carpet configurations from 895 – 1,050 sq.ft.*, home-office study alcoves, panoramic decks, and biophilic living 7 mins from Hinjewadi."
  keywords="mahindra mahalunge 2 bhk premium, mahindra mahalunge 2 bhk large, 2 bhk large flats near hinjewadi, mahindra lifespaces mahalunge 2 bhk premium, 2 bhk with study hinjewadi pune"
  canonical="https://mahindralifespaceshomes.in/residences/2-bhk-premium/"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Curated Configuration · Premium</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        2 BHK Premium Residences: <br />
        <span class="gold-gradient-text">Elevated Layouts with Study Alcoves</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        For senior IT professionals and dual-income couples who demand a dedicated work-from-home alcove, larger living zones, and expansive panoramic decks in a biophilic 13.46-acre sanctuary.
      </p>
    </div>
  </section>

  <!-- Specs Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">895 – 1,050 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Carpet Area Range</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">Study Alcove</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">WFH-Ready Design</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">80 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Panoramic Deck</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-emerald-400">EOI Open</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Early Privilege Pass</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-6">
        <h2 class="font-serif text-3xl text-stone-100 font-bold">Why Choose the 2 BHK Premium?</h2>
        <ul class="space-y-4 text-sm text-stone-300">
          <li class="flex items-start space-x-3"><span class="text-gold-400 font-bold">✦</span><span>Dedicated study/home-office alcove with ergonomic lighting design.</span></li>
          <li class="flex items-start space-x-3"><span class="text-gold-400 font-bold">✦</span><span>Larger master suite with walk-in wardrobe provision and attached bathroom.</span></li>
          <li class="flex items-start space-x-3"><span class="text-gold-400 font-bold">✦</span><span>Spacious 80 sq.ft. panoramic deck for evening relaxation with Sahyadri views.</span></li>
          <li class="flex items-start space-x-3"><span class="text-gold-400 font-bold">✦</span><span>Modular parallel chef kitchen with separate utility balcony and laundry provisions.</span></li>
        </ul>
        <div class="pt-4">
          <button
            data-open-modal
            data-unit="2 BHK Premium"
            data-interest="2 BHK Premium Cost Sheet Request"
            class="px-6 py-3 rounded bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
          >
            Get 2 BHK Premium Cost Sheet
          </button>
        </div>
      </div>
      <div class="p-6 rounded-2xl bg-charcoal-900 border border-gold-500/20 space-y-4">
        <h3 class="font-serif text-xl text-gold-300 font-bold">Premium Configuration Advantages</h3>
        <div class="space-y-3">
          {['Larger carpet area (895–1,050 sq.ft.*)', 'Dedicated study / WFH alcove', 'Master suite with wardrobe wall', '80 sq.ft. panoramic outdoor deck', 'Separate utility + chef kitchen', 'Cross-ventilated natural airflow'].map((f) => (
            <div class="flex items-center space-x-3 text-xs text-stone-200">
              <span class="w-5 h-5 rounded-full bg-gold-500/20 text-gold-400 flex items-center justify-center text-[10px]">✓</span>
              <span>{f}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
