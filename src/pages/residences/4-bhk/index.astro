---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge 4 BHK Signature Estates | Luxury Sky Decks in West Pune"
  description="Explore limited-edition 4 BHK luxury residences at Mahindra Lifespaces Mahalunge. 1,650 - 1,820 sq.ft.* carpet area with private elevator lobbies, panoramic sky decks & staff quarters."
  canonical="https://mahindra-mahalunge.com/residences/4-bhk"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>The Presidential Collection</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        4 BHK Signature Estates: <br />
        <span class="gold-gradient-text">Sky Deck Mansions at Mahindra Mahalunge</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        The pinnacle of West Pune luxury living. Crafted on upper signature levels with private elevator access, 28-foot living salons, and 270-degree horizon views.
      </p>
    </div>
  </section>

  <!-- Specs Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">1,650 - 1,820 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Carpet Area Range</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">145 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Panoramic Sky Deck</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">270° Vistas</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Riverbed & Valley View</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-emerald-400">Exclusive Release</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Invitation Allocations</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blueprint & Highlights -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <div class="lg:col-span-7 bg-charcoal-900 rounded-2xl border border-white/10 p-6 shadow-2xl">
        <div class="text-xs uppercase tracking-widest text-gold-400 font-bold mb-3">Blueprint Concept Representation</div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <svg viewBox="0 0 600 420" class="w-full h-auto text-stone-300">
            <rect x="20" y="20" width="560" height="380" fill="#12151a" stroke="#c5a368" stroke-width="2" rx="4"/>
            <rect x="40" y="40" width="340" height="180" fill="#1b2028" stroke="#333d4b"/>
            <text x="210" y="120" fill="#e5e3dc" font-family="Cinzel" font-size="15" text-anchor="middle">GRAND SALON & DINING</text>
            <text x="210" y="145" fill="#9ca3af" font-size="12" text-anchor="middle">28'0" × 16'0"</text>
            <rect x="390" y="40" width="160" height="140" fill="#1f2732" stroke="#c5a368" stroke-width="2"/>
            <text x="470" y="105" fill="#c5a368" font-size="12" font-weight="bold" text-anchor="middle">PANORAMIC SKY DECK</text>
            <rect x="40" y="230" width="180" height="150" fill="#1b2028" stroke="#333d4b"/>
            <text x="130" y="300" fill="#e5e3dc" font-family="Cinzel" font-size="13" text-anchor="middle">PRESIDENTIAL SUITE</text>
            <rect x="230" y="230" width="150" height="150" fill="#1b2028" stroke="#333d4b"/>
            <text x="305" y="300" fill="#e5e3dc" font-family="Cinzel" font-size="12" text-anchor="middle">SUITE 02</text>
            <rect x="390" y="190" width="160" height="90" fill="#1b2028" stroke="#333d4b"/>
            <text x="470" y="235" fill="#e5e3dc" font-family="Cinzel" font-size="11" text-anchor="middle">SUITE 03</text>
            <circle cx="80" cy="80" r="20" fill="#111317" stroke="#c5a368"/>
            <text x="80" y="75" fill="#c5a368" font-size="11" font-weight="bold" text-anchor="middle">▲</text>
            <text x="80" y="90" fill="#c5a368" font-size="9" font-weight="bold" text-anchor="middle">N</text>
          </svg>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <h3 class="font-serif text-2xl text-stone-100 font-bold">Key Architectural Advantages</h3>
        <ul class="space-y-3 text-xs sm:text-sm text-stone-300">
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Private elevator access with dedicated access card vestibule.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>28-foot living salon opening onto an unobstructed sky deck.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Dual master suites with luxury five-fixture soaking bathrooms.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Dedicated house-help quarters with separated service entrance.</span>
          </li>
        </ul>

        <div class="pt-4 flex flex-col sm:flex-row gap-3">
          <button
            data-open-modal
            data-unit="4 BHK Signature"
            data-interest="4 BHK Cost Sheet Request"
            class="px-6 py-3 rounded bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
          >
            Get 4 BHK Cost Sheet
          </button>
        </div>
      </div>

    </div>
  </section>
</Layout>
