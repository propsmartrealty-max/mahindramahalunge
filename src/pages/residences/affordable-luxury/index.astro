---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Affordable Luxury Flats Near Hinjewadi Under 1 Crore | Mahindra Mahalunge"
  description="Discover affordable luxury flats near Hinjewadi under ₹1 Crore at Mahindra Mahalunge. Pre-launch 2 BHK starting from ₹75 Lakh*. EOI open — register now for early-bird pricing."
  keywords="affordable luxury flats near hinjewadi, flats under 1 crore near hinjewadi, mahindra mahalunge affordable 2 bhk, budget flats mahalunge pune, 2 bhk under 1 crore hinjewadi pune, affordable homes west pune"
  canonical="https://mahindralifespaceshomes.in/residences/affordable-luxury/"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-widest">
        <span>Early-Bird Pricing · Best Value Entry</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Affordable Luxury at Mahindra Mahalunge: <br />
        <span class="gold-gradient-text">Best-Value Entry Near Hinjewadi</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Mahindra Mahalunge's pre-launch EOI stage offers the most competitive entry pricing in West Pune for a Mahindra Group branded biophilic development — 2 BHK Optima Suites from ₹75 Lakh* (all-inclusive), making luxury accessible for first-time homebuyers and young IT professionals.
      </p>
    </div>
  </section>

  <!-- Value Proposition -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Pre-Launch Value Case</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">Why Mahindra Mahalunge is West Pune's Best Value Luxury</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { stat: '₹75 L*', label: 'Starting Price (2 BHK)', desc: 'Pre-launch EOI pricing for 2 BHK Optima Suites — the most affordable Mahindra Lifespaces branded luxury entry in West Pune.' },
          { stat: '₹7,200*', label: 'Per Sq.Ft. (Pre-Launch)', desc: 'Approximately 40%–55% below established Baner and Balewadi pricing for comparable Mahindra quality.' },
          { stat: '35–60%', label: 'Projected Appreciation', desc: 'Based on incoming PMRDA ring road, Metro Line 3, and bridge infrastructure driving steep post-launch value escalation.' }
        ].map((v) => (
          <div class="p-8 rounded-2xl bg-charcoal-950 border border-gold-500/30 text-center space-y-3">
            <div class="font-serif text-4xl font-bold text-gold-400">{v.stat}</div>
            <div class="text-xs uppercase tracking-widest text-stone-400 font-semibold">{v.label}</div>
            <p class="text-xs text-stone-300 leading-relaxed font-light">{v.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-[10px] text-stone-500">*Indicative pre-launch pricing. Official pricing subject to MahaRERA registration. All areas are approximate carpet area.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-3xl text-stone-100 font-bold">Lock In Early-Bird Pricing</h2>
      <p class="text-stone-300 text-sm font-light leading-relaxed max-w-2xl mx-auto">
        Pre-launch EOI pricing is available for a limited window. Register now to secure the lowest available entry pricing before the official RERA launch announcement.
      </p>
      <button
        data-open-modal
        data-unit="Affordable Luxury"
        data-interest="Affordable Luxury Flat Enquiry"
        class="btn-shimmer px-10 py-4 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
      >
        Register EOI — Early-Bird Pricing
      </button>
    </div>
  </section>
</Layout>
