---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="NRI Investment Flats at Mahindra Mahalunge Pune | Dollar-Priced ROI Near Hinjewadi"
  description="Mahindra Mahalunge NRI investment guide: dollar-priced returns, Mahindra Group governance, FEMA-compliant NRI home loan, and 4.8%–5.4% rental yield near Hinjewadi IT Park Pune."
  keywords="nri investment flats mahindra mahalunge, nri property near hinjewadi pune, mahindra lifespaces nri homes pune, nri flats mahalunge pune, dollar investment flat pune, nri 2 bhk mahindra mahalunge"
  canonical="https://mahindralifespaceshomes.in/residences/nri-investment/"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold uppercase tracking-widest">
        <span>NRI Investment Collection · Dollar-Priced Returns</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        NRI Investment at Mahindra Mahalunge: <br />
        <span class="gold-gradient-text">Institutional Returns in Hinjewadi's Orbit</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Mahindra Mahalunge presents NRIs from the US, UK, UAE, Singapore, and Canada with a rare pre-launch investment opportunity — Mahindra Group branded biophilic luxury in West Pune's highest-appreciation corridor, backed by institutional governance, transparent MahaRERA compliance, and FEMA-aligned NRI home loan facilities.
      </p>
    </div>
  </section>

  <!-- NRI Value Matrix -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">NRI Investment Case</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">Why NRIs Choose Mahindra Mahalunge</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          { title: '🏦 Mahindra Group Governance', desc: 'NSE-listed (MAHLIFE), publicly audited financials, and institutional construction governance — zero counterparty risk for NRI investors.' },
          { title: '📈 4.8%–5.4% Rental Yield', desc: 'Projected rental yields driven by 45,000+ IT workforce catchment in Hinjewadi — among the highest USD-denominated rental yield plays in India.' },
          { title: '🔗 FEMA-Compliant Purchase', desc: 'Fully compliant with FEMA 1999 NRI property regulations. Resident Indian (RI) RERA accounts and NRI home loans from SBI, HDFC, and ICICI available.' },
          { title: '💰 Dollar-Priced Capital Entry', desc: 'INR weakness versus USD, GBP, AED creates compounding value on entry. 1 USD currently buys 83+ INR — making Indian real estate extremely attractive at current exchange rates.' },
          { title: '🌿 80%+ Green Open Spaces', desc: 'Biophilic design with Miyawaki afforestation — creating a genuine wellness home base for NRIs returning to Pune on home visits.' },
          { title: '✈ Mumbai Expressway 8 Mins', desc: 'For NRIs transiting via Mumbai International Airport, Mahalunge\'s 8-minute expressway access allows weekend visits without Pune city traffic.' }
        ].map((v) => (
          <div class="p-6 rounded-2xl bg-charcoal-950 border border-gold-500/20 space-y-3 hover:border-gold-500/40 transition-all">
            <h3 class="font-serif text-base font-bold text-gold-300">{v.title}</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-3xl text-stone-100 font-bold">NRI Investment Concierge</h2>
      <p class="text-stone-300 text-sm font-light leading-relaxed max-w-2xl mx-auto">
        Our dedicated NRI investment desk will assist you with virtual site tours, FEMA compliance documentation, NRI home loan coordination, and Power of Attorney (POA) execution for overseas buyers.
      </p>
      <button
        data-open-modal
        data-unit="NRI Investment"
        data-interest="NRI Investment Enquiry"
        class="btn-shimmer px-10 py-4 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
      >
        Connect with NRI Concierge Team
      </button>
    </div>
  </section>
</Layout>
