---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge 3 BHK Flats | Luxury Residences Near Hinjewadi"
  description="Explore 3 BHK premium apartments at Mahindra Lifespaces Mahalunge. 1,120 - 1,210 sq.ft.* carpet area with island kitchens, work-from-home study alcoves & double balconies."
  canonical="https://www.mahindralifespaceshomes.in/residences/3-bhk"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Signature Family Haven</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        3 BHK Luxe Residences: <br />
        <span class="gold-gradient-text">Expansive Modern Living at Mahindra Mahalunge</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Engineered for growing families seeking spacious banquet living rooms, dedicated work-from-home study alcoves, and double-height panoramic balconies.
      </p>
    </div>
  </section>

  <!-- Specs Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">1,120 - 1,210 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Carpet Area Range</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">92 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Double Viewing Deck</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">Triple Exposure</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Cross Ventilation</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-emerald-400">Priority Release</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Pre-Launch Expressions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blueprint & Highlights -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <div class="lg:col-span-7 bg-charcoal-900 rounded-2xl border border-white/10 p-6 shadow-2xl">
        <div class="text-xs uppercase tracking-widest text-gold-400 font-bold mb-3">Blueprint Concept Representation</div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <svg viewBox="0 0 600 420" class="w-full h-auto text-stone-300">
            <rect x="20" y="20" width="560" height="380" fill="#12151a" stroke="#c5a368" stroke-width="2" rx="4"/>
            <rect x="40" y="40" width="310" height="180" fill="#1b2028" stroke="#333d4b"/>
            <text x="195" y="120" fill="#e5e3dc" font-family="Cinzel" font-size="14" text-anchor="middle">EXPANSIVE LIVING & DINING</text>
            <text x="195" y="140" fill="#9ca3af" font-size="11" text-anchor="middle">24'0" × 13'0"</text>
            <rect x="360" y="40" width="180" height="110" fill="#1b2028" stroke="#333d4b"/>
            <text x="450" y="90" fill="#e5e3dc" font-family="Cinzel" font-size="12" text-anchor="middle">ISLAND KITCHEN</text>
            <rect x="40" y="230" width="200" height="150" fill="#1b2028" stroke="#333d4b"/>
            <text x="140" y="305" fill="#e5e3dc" font-family="Cinzel" font-size="13" text-anchor="middle">MASTER SUITE</text>
            <rect x="250" y="230" width="160" height="150" fill="#1b2028" stroke="#333d4b"/>
            <text x="330" y="305" fill="#e5e3dc" font-family="Cinzel" font-size="12" text-anchor="middle">BEDROOM 02</text>
            <rect x="420" y="160" width="140" height="140" fill="#1b2028" stroke="#333d4b"/>
            <text x="490" y="225" fill="#e5e3dc" font-family="Cinzel" font-size="12" text-anchor="middle">GUEST / STUDY</text>
            <circle cx="530" cy="350" r="20" fill="#111317" stroke="#c5a368"/>
            <text x="530" y="345" fill="#c5a368" font-size="11" font-weight="bold" text-anchor="middle">▲</text>
            <text x="530" y="360" fill="#c5a368" font-size="9" font-weight="bold" text-anchor="middle">N</text>
          </svg>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-6">
        <h3 class="font-serif text-2xl text-stone-100 font-bold">Key Architectural Advantages</h3>
        <ul class="space-y-3 text-xs sm:text-sm text-stone-300">
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>24-foot wide living and banquet dining salon.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Master bedroom with dedicated walk-in wardrobe and en-suite bath.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Flexible third bedroom ideal as a hybrid work office or library.</span>
          </li>
          <li class="flex items-start space-x-2">
            <span class="text-gold-400">✦</span>
            <span>Uninterrupted dual vistas overlooking central 4-acre bio-reserve.</span>
          </li>
        </ul>

        <div class="pt-4 flex flex-col sm:flex-row gap-3">
          <button
            data-open-modal
            data-unit="3 BHK Luxe"
            data-interest="3 BHK Cost Sheet Request"
            class="px-6 py-3 rounded bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
          >
            Get 3 BHK Cost Sheet
          </button>
        </div>
      </div>

    </div>
  </section>
</Layout>
