---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge 1 BHK Fusion | Mahindra Lifespaces Mahalunge Compact Smart Homes"
  description="Explore 1 BHK Fusion Homes at Mahindra Mahalunge. Smart compact floor plans from ~620 sq.ft.*, ideal for young IT professionals seeking a low-maintenance luxury pad 7 mins from Hinjewadi."
  keywords="mahindra mahalunge 1 bhk, mahindra mahalunge 1 bhk price, mahindra mahalunge 1 bhk floor plan, 1 bhk near hinjewadi mahindra, mahindra lifespaces mahalunge 1 bhk, 1 bhk flats mahalunge pune"
  canonical="https://mahindralifespaceshomes.in/residences/1-bhk-fusion/"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Smart Configuration · Compact Luxury</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        1 BHK Fusion Homes: <br />
        <span class="gold-gradient-text">Agile Luxury for Young Professionals</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Designed for ambitious IT professionals and solo executives seeking a zero-compromise luxury pad with smart space engineering, 7-minute Hinjewadi access, and Mahindra Group governance.
      </p>
    </div>
  </section>

  <!-- Specs Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">~620 sq.ft.*</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Carpet Area</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">7 Mins</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">To Hinjewadi Phase 1</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">Smart Design</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Zero Dead Space</div>
        </div>
        <div class="p-4 bg-charcoal-950 rounded-xl border border-white/10">
          <div class="font-serif text-2xl sm:text-3xl font-bold text-emerald-400">EOI Open</div>
          <div class="text-[11px] text-stone-400 uppercase tracking-wider mt-1">Pre-Launch Privilege</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-3xl text-stone-100 font-bold">Unlock 1 BHK Fusion Pricing</h2>
      <p class="text-stone-300 text-sm font-light leading-relaxed max-w-2xl mx-auto">
        Register your Expression of Interest (EOI) to access confidential pre-launch pricing, smart floor plan blueprints, and early allocation priority for 1 BHK Fusion Homes at Mahindra Mahalunge.
      </p>
      <button
        data-open-modal
        data-unit="1 BHK Fusion"
        data-interest="1 BHK Fusion Cost Sheet Request"
        class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
      >
        Get 1 BHK Fusion Cost Sheet
      </button>
    </div>
  </section>
</Layout>
