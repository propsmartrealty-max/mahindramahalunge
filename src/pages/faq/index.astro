---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';
import { naturalLanguageGeoQuestions } from '../../data/mahindraKeywordsEcosystem';

const faqCategories = [
  {
    category: '1. Mahindra Rivenza: Flagship 13.46-Acre Development',
    questions: [
      {
        q: 'What is Mahindra Rivenza and when was it officially launched?',
        a: 'Mahindra Rivenza is the flagship 13.46-acre luxury residential community developed by Mahindra Lifespace Developers Limited (Mahindra Group) in Baner Annex / Mahalunge, Pune. Officially launched on October 6, 2026, Phase 1 introduces 1,236 residences across 2, 3, and 4 BHK configurations with an estimated Gross Development Value (GDV) of approximately ₹3,500 Crore.'
      },
      {
        q: 'What are the official MahaRERA registration numbers for Mahindra Rivenza?',
        a: 'Mahindra Rivenza is registered under MahaRERA in phases: Mahindra Rivenza Phase 1 holds Registration No. PR1261012602102, and Mahindra Rivenza Phase 2 holds Registration No. PM1261012602103 (both valid upto 30/12/2031). Sanctioned plans and certificates are verifiable at https://maharera.maharashtra.gov.in.'
      },
      {
        q: 'What are the price brackets for 2, 3 and 4 BHK residences at Mahindra Rivenza?',
        a: 'Pricing starts at ₹90 Lakhs* for 2 BHK residences, ₹1.31 Crore* for 3 BHK luxury residences, and ₹2.20 Crore* for 4 BHK signature residences. Complete cost sheets detail base agreement values, 7% Maharashtra stamp duty and registration, 5% GST, and floor rise.'
      },
      {
        q: 'What is the exact location and site address of Mahindra Rivenza?',
        a: 'Mahindra Rivenza is located at Plus Code HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, PMRDA Town Planning Scheme 1, Mahalunge (Nande), Pune, Maharashtra 412115, India (Coordinates: 18.562536 N, 73.727373 E).'
      }
    ]
  },
  {
    category: '2. Mahindra Mahalunge: Micro-Market & Infrastructure',
    questions: [
      {
        q: 'Why is Mahindra Mahalunge considered a prime real estate investment?',
        a: 'Mahindra Mahalunge is situated within PMRDA Town Planning Scheme 1, benefiting from planned 36-meter wide ring roads, underground utilities, dedicated cycle corridors, and civic garden reservations. It offers an entry price arbitrage over land-starved central Baner with projected 14-18% annual capital appreciation.'
      },
      {
        q: 'How does the 4-lane Mula River Bridge impact commute from Mahindra Mahalunge to Hinjewadi?',
        a: 'The sanctioned 4-lane Mula River Bridge provides direct vehicular bypass connecting Mahalunge to Hinjewadi Phase 1 in just 7 minutes, completely avoiding traffic bottlenecks at Wakad bridge, Bhumkar Chowk, and Shivaji Chowk.'
      },
      {
        q: 'What social infrastructure surrounds Mahindra Mahalunge?',
        a: 'The micro-market is surrounded by top international schools (The Orchid School, VIBGYOR High, Banyan Tree World School), multi-specialty hospitals (Manipal Hospital Baner, Jupiter Hospital), and high-street retail centres.'
      }
    ]
  },
  {
    category: '3. Mahindra Baner Annexe: Luxury Corridor & Balewadi Connectivity',
    questions: [
      {
        q: 'What is Mahindra Baner Annexe and how far is it from Balewadi High Street?',
        a: 'Mahindra Baner Annexe represents the high-end luxury expansion corridor of West Pune. Mahindra Rivenza is positioned just 7 to 8 minutes (3.8 km) from Balewadi High Street via the Baner-Balewadi link road, giving residents direct access to gourmet dining, nightlife, and corporate headquarters.'
      },
      {
        q: 'How does Mahindra Baner Annexe pricing compare to Central Baner?',
        a: 'While central Baner commands ₹13,500 to ₹16,500 per sq.ft. for older or congested standalone buildings, Mahindra Baner Annexe offers expansive 13.46-acre gated community living with 9+ acres of greens starting at ₹90 Lakhs*, representing a 35-42% capital value arbitrage.'
      }
    ]
  },
  {
    category: '4. Mahindra Pune: Developer Track Record & Corporate Legacy',
    questions: [
      {
        q: 'What is Mahindra Lifespaces’ track record in the Pune real estate market?',
        a: 'Mahindra Lifespace Developers Limited (Mahindra Group) has delivered over 14 million sq.ft. of residential communities across Pune over 25+ years. Key delivered and ongoing Pune projects include Mahindra Antheia (Pimpri), Mahindra Centralis (Pimpri Chowk), Mahindra Citadel (Sant Tukaram Nagar Metro), Mahindra IvyLush (Kharadi Annex), and Mahindra Happinest Tathawade.'
      },
      {
        q: 'Why do homebuyers and NRIs trust Mahindra Pune residential developments?',
        a: 'Mahindra Lifespaces provides zero-debt balance sheet governance, 100% MahaRERA transparency, strict escrow account funding (70% deposits safeguarded for construction), IGBC Gold pre-certified green construction, and timely delivery backed by the ₹1.5+ Lakh Crore Mahindra Group.'
      }
    ]
  },
  {
    category: '5. Price List, Cost Sheet & Construction-Linked Payment Plans',
    questions: [
      {
        q: 'What payment plans are available for Mahindra Rivenza?',
        a: 'Mahindra Rivenza offers standard Construction-Linked Payment (CLP) milestone plans, structured pre-launch developer schedules (such as 10:90 / 20:80 schemes subject to banking approval), and pre-approved home loan disbursements from SBI, HDFC Bank, ICICI Bank, and Axis Bank.'
      },
      {
        q: 'What additional government charges apply to the base flat price?',
        a: 'All-inclusive cost sheets calculate 7% Maharashtra Stamp Duty and Registration charges, 5% GST on under-construction property, society formation fees, and advance maintenance deposits.'
      }
    ]
  },
  {
    category: '6. Sanctioned Floor Plans, Carpet Areas & Specifications',
    questions: [
      {
        q: 'What are the sanctioned RERA carpet areas for Mahindra Rivenza?',
        a: '2 BHK Optima & Luxury suites range from 635 to 747 sq.ft. carpet area; 3 BHK Deluxe & Ultra Luxury residences range from 882 to 1,065 sq.ft. carpet area; and 4 BHK Presidential Sky Villas offer 1,438 to 1,465 sq.ft. carpet area with zero corridor wastage.'
      },
      {
        q: 'Are the residences at Mahindra Rivenza Vastu-compliant?',
        a: 'Yes, floor plans incorporate Vastu principles with east-facing and north-east entrance options, master bedrooms in the south-west zone, and kitchens oriented towards the agni (south-east) quadrant.'
      }
    ]
  },
  {
    category: '7. Curated Amenities & ~44,000 Sq.Ft Clubhouses',
    questions: [
      {
        q: 'What lifestyle amenities are offered at Mahindra Rivenza?',
        a: 'The project features 2.65 Lakh+ sq.ft. of curated amenities and a ~44,000 sq.ft. multi-level clubhouse. Highlights include a temperature-regulated swimming pool with a sunken aqua bar, 9+ acres of vehicle-free biophilic greens, gymnasium, badminton, squash and pickleball courts, jogging and cycling tracks, glass-roof library, and floodlit FIFA futsal turf.'
      },
      {
        q: 'Is Mahindra Rivenza an IGBC certified green development?',
        a: 'Yes, Mahindra Rivenza is pre-certified IGBC Gold and is planned as a Net Zero Waste to Landfill community, integrating on-site solar energy generation, rainwater harvesting, sewage treatment plants (STP), and organic waste composting.'
      }
    ]
  },
  {
    category: '8. Authorized Strategic Channel Partner & Site Visit Booking',
    questions: [
      {
        q: 'Who is the authorized channel partner for Mahindra Rivenza sales and advisory?',
        a: 'PropSmart Realty (MahaRERA Registration No: A031262401295) is the authorized strategic channel partner providing end-to-end customer advisory, official brochure dispatch, pricing cost sheets, and VIP site visits for Mahindra Rivenza.'
      },
      {
        q: 'How can I book a VIP show residence walkthrough at Mahindra Rivenza?',
        a: 'You can book a VIP site visit to inspect the fully furnished show residences by calling +91 7744009295 or submitting the booking form at https://mahindralifespaceshomes.in/site-visit/.'
      }
    ]
  }
];

// Build flat list for JSON-LD schema (Including all 25 Natural Language GEO questions)
const geoFaqsMapped = naturalLanguageGeoQuestions.map(g => ({ q: g.question, a: g.answer }));
const allFaqs = [...geoFaqsMapped, ...faqCategories.flatMap(c => c.questions)];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Mahindra Rivenza FAQ [Official Answers] Price, Plans & MahaRERA PR1261012602102"
  description="Get instant verified answers for Mahindra Rivenza Baner Annex: 2, 3 & 4 BHK prices from ₹90L*, MahaRERA PR1261012602102, 4-lane Mula Bridge, and possession timeline."
  canonical="https://mahindralifespaceshomes.in/faq/"
  customSchema={faqSchema}
>

  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-center">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Google &amp; AI Search Intelligence • 25 Verified Master Q&amp;As</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 leading-tight">
        Mahindra Rivenza &amp; West Pune: <br />
        <span class="gold-gradient-text">Complete Buyer FAQ &amp; Search Knowledge Base</span>
      </h1>
      <p class="text-stone-300 text-xs sm:text-sm max-w-2xl mx-auto font-light leading-relaxed">
        Direct, verified answers covering the official October 2026 launch of Mahindra Rivenza (~13.46 acres, Phase 1 MahaRERA PR1261012602102), sanctioned 2, 3 &amp; 4 BHK floor plans, ~44,000 sq.ft clubhouse, and West Pune real estate connectivity.
      </p>
    </div>
  </section>

  <!-- Section 1: The 25 Natural Language & AI Overviews Master Q&A -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold font-mono">Google SGE &amp; Voice Search Direct Answers</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          25 Master Questions Homebuyers Ask About Mahindra Rivenza
        </h2>
        <p class="text-xs text-stone-400 max-w-xl mx-auto">
          Fact-checked against official MahaRERA disclosures (PR1261012602102) and Mahindra Lifespaces corporate announcements.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {naturalLanguageGeoQuestions.map((item, idx) => (
          <details class="group p-5 rounded-xl bg-charcoal-900/90 border border-white/10 hover:border-gold-500/40 transition-all flex flex-col justify-between">
            <summary class="flex items-start justify-between cursor-pointer list-none gap-3">
              <div class="space-y-1">
                <span class="text-[10px] font-mono text-gold-400 uppercase tracking-wider font-semibold">
                  Q{idx + 1 < 10 ? `0${idx + 1}` : idx + 1} • {item.badge}
                </span>
                <h3 class="font-serif text-sm font-semibold text-stone-100 group-open:text-gold-300 transition-colors leading-snug">
                  {item.question}
                </h3>
              </div>
              <span class="text-gold-400 text-xs transition-transform group-open:rotate-180 flex-shrink-0 pt-1">▼</span>
            </summary>
            <div class="pt-3 mt-3 border-t border-white/5 space-y-2">
              <p class="text-xs text-stone-300 leading-relaxed font-light">
                {item.answer}
              </p>
              <div class="pt-1">
                <a href={item.url} class="inline-flex items-center text-[11px] text-gold-400 hover:text-gold-300 font-medium">
                  <span>Explore related page</span>
                  <span class="ml-1">→</span>
                </a>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 2: In-Depth Categorized Real Estate Pillar FAQs -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      {faqCategories.map((cat, idx) => (
        <div class="space-y-6">
          <div class="border-b border-gold-500/20 pb-3 flex items-center justify-between">
            <h2 class="font-serif text-lg sm:text-xl font-bold text-gold-400">
              {cat.category}
            </h2>
            <span class="text-stone-500 font-mono text-xs">Pillar 0{idx + 1}</span>
          </div>

          <div class="space-y-4">
            {cat.questions.map((faq) => (
              <details class="group p-5 rounded-2xl glass-card border border-white/10 open:border-gold-500/30 transition-all">
                <summary class="flex justify-between items-center cursor-pointer font-serif text-sm font-semibold text-stone-200 group-open:text-gold-300 transition-colors">
                  <span>{faq.q}</span>
                  <span class="text-gold-400 transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-stone-400 leading-relaxed font-light pl-1">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </div>
      ))}

    </div>
  </section>

  <!-- Keyword Matrix Integration -->
  <MahindraKeywordMatrix />
</Layout>
