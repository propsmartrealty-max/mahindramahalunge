---
import Layout from '../../layouts/Layout.astro';
import ResidenceSelector from '../../components/ResidenceSelector.astro';
import RiverFlowingEmblem from '../../components/RiverFlowingEmblem.astro';

const balewadiSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/flats-near-balewadi/#place",
      "name": "Balewadi High Street & Baner Annex Residential Corridor",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Balewadi",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "18.5623125",
        "longitude": "73.7273125"
      }
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/flats-near-balewadi/#product",
      "name": "Luxury Flats Near Balewadi High Street Pune - Mahindra Rivenza",
      "description": "Looking for luxury flats near Balewadi High Street? Discover Mahindra Rivenza in Baner Annex / Mahalunge. 8 mins to High Street, 13.46 acres, ~44,000 sq.ft clubhouse with sunken aqua bar, 9+ acres greens from ₹90 Lakhs*.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mahindralifespaceshomes.in/flats-near-balewadi/#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "West Pune", "item": "https://mahindralifespaceshomes.in/west-pune/" },
        { "@type": "ListItem", "position": 3, "name": "Flats Near Balewadi", "item": "https://mahindralifespaceshomes.in/flats-near-balewadi/" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/flats-near-balewadi/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How far is Mahindra Rivenza from Balewadi High Street?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is located just 4.6 km (8 minutes drive) from Balewadi High Street via the planned 36m wide PMRDA Town Planning Scheme 1 arterial road."
          }
        },
        {
          "@type": "Question",
          "name": "What is the price comparison between Balewadi flats and Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Apartments around Balewadi High Street command ₹12,000 to ₹16,000 per sq.ft., pushing 2 BHKs beyond ₹1.60 Cr. At Mahindra Rivenza Baner Annex, pre-launch 2 BHK units start at ₹90 Lakhs* (approx. ₹7,800/sq.ft. base) with over 80% open greens and a ~44,000 sq.ft. clubhouse."
          }
        },
        {
          "@type": "Question",
          "name": "What amenities are offered at Mahindra Rivenza near Balewadi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza offers a ~44,000 sq.ft clubhouse with a temperature-controlled swimming pool, sunken aqua bar, rooftop stargazing observatory, full futsal turf, badminton courts, squash, and IGBC Gold biophilic landscaping."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Flats Near Balewadi High Street [Starts ₹90L*] Mahindra Rivenza"
  description="Seeking luxury flats near Balewadi High Street Pune? Explore Mahindra Rivenza in Baner Annex: 8-min drive, 13.46 acres, ~44k sq.ft clubhouse from ₹90L*."
  keywords="flats near balewadi high street, luxury flats in balewadi pune, apartments near balewadi stadium, 2 bhk flats near balewadi, 3 bhk flats near balewadi, mahindra rivenza balewadi, balewadi real estate"
  canonical="https://mahindralifespaceshomes.in/flats-near-balewadi/"
  customSchema={balewadiSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Badges Row -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Balewadi High Street Belt • 8 Mins Drive</span>
        </div>
        <div class="glass-floating inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-gold-500/30 backdrop-blur-md">
          <RiverFlowingEmblem size="xs" layout="horizontal" showSubtitle={false} />
          <span class="text-[11px] text-stone-300 font-medium border-l border-white/20 pl-2">Baner Annex • Starts ₹90L*</span>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-semibold border border-emerald-500/30">
          MahaRERA: PR1261012602102
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Flats Near Balewadi High Street: <br />
        <span class="gold-gradient-text">World-Class Luxury at Mahindra Rivenza</span>
      </h1>

      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Enjoy fine dining, cafes, and nightlife on Balewadi High Street just 8 minutes from home. Return daily to a peaceful 13.46-acre riverfront retreat with 9+ acres of greens and a ~44,000 sq.ft resort clubhouse.
      </p>

      <!-- Market Stats Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 max-w-3xl">
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-gold-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Starting Rate</span>
          <span class="font-serif text-base font-bold text-gold-400">Starts ₹90L*</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Price Arbitrage</span>
          <span class="font-serif text-base font-bold text-emerald-400">Save Up To 45%</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-white/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Balewadi Drive</span>
          <span class="font-serif text-base font-bold text-white">8 Minutes</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-amber-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Clubhouse Scale</span>
          <span class="font-serif text-base font-bold text-amber-300">~44,000 Sq.Ft</span>
        </div>
      </div>
      
      <!-- Quick Action Buttons -->
      <div class="pt-4 flex flex-wrap gap-4">
        <button
          data-open-modal
          data-interest="Balewadi Corridor Buyer EOI - Cost Sheet"
          class="btn-shimmer px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer"
        >
          Download Balewadi vs Rivenza Cost Sheet
        </button>
        <button
          data-open-modal
          data-interest="VIP Cab Tour from Balewadi"
          class="px-8 py-3.5 rounded-full border border-gold-500/40 text-gold-300 hover:text-white text-xs font-semibold uppercase tracking-widest text-center hover:bg-white/5 transition-colors cursor-pointer"
        >
          Book VIP Site Visit from Balewadi
        </button>
        <a
          href="tel:+917744009295"
          class="px-5 py-3.5 rounded-full border border-white/20 hover:border-white/40 text-stone-300 hover:text-white text-xs font-medium uppercase tracking-wider inline-flex items-center gap-2"
        >
          <span>Direct Advisory: +91 7744009295</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Head-to-Head Comparison Table -->
  <section class="py-16 bg-[#0c1017] border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3">
        <span class="text-xs font-mono uppercase text-gold-400 tracking-wider font-bold">Market Intelligence</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
          Balewadi Central vs Mahindra Rivenza (Baner Annex): Head-to-Head
        </h2>
        <p class="text-stone-300 text-sm font-light leading-relaxed max-w-3xl">
          Why homebuyers are choosing Mahindra Rivenza over congested Balewadi high-rises.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 glass-card">
        <table class="w-full text-xs text-left">
          <thead class="bg-white/5 text-stone-300 font-serif uppercase tracking-wider text-[10px]">
            <tr>
              <th class="p-4">Feature / Metric</th>
              <th class="p-4">Balewadi High Street Core</th>
              <th class="p-4 text-gold-400 font-bold">Mahindra Rivenza (Baner Annex)</th>
              <th class="p-4 text-emerald-400">Buyer Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-stone-300 font-light">
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Avg Capital Rate</td>
              <td class="p-4 font-mono text-stone-400">₹12,000 – ₹16,000 / sq.ft</td>
              <td class="p-4 font-mono text-gold-300 font-bold">₹7,500 – ₹8,800 / sq.ft</td>
              <td class="p-4 text-emerald-400 font-semibold font-mono">Massive Capital Growth Potential</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">2 BHK Entry Price</td>
              <td class="p-4 font-mono text-stone-400">₹1.60 Cr – ₹2.10 Cr</td>
              <td class="p-4 font-mono text-gold-300 font-bold">Starts ₹90 Lakhs*</td>
              <td class="p-4 text-emerald-400 font-semibold font-mono">Save ₹70L+ on Similar Grade</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Land Parcel & Greens</td>
              <td class="p-4 text-stone-400">2 to 5 Acres (Mixed Commercial)</td>
              <td class="p-4 text-stone-200 font-semibold">13.46 Acres (9+ Acres Biophilic Greens)</td>
              <td class="p-4 text-emerald-400 font-semibold">Resort Living with Riverfront Views</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Clubhouse & Amenities</td>
              <td class="p-4 text-stone-400">12,000 – 20,000 sq.ft</td>
              <td class="p-4 text-stone-200 font-semibold">~44,000 sq.ft with Sunken Aqua Bar</td>
              <td class="p-4 text-emerald-400 font-semibold">2.5x More Lifestyle Space</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Hinjewadi Commute</td>
              <td class="p-4 text-stone-400">18 – 25 mins (Highway Jams)</td>
              <td class="p-4 text-stone-200 font-semibold">7 mins (Mula River Bridge Bypass)</td>
              <td class="p-4 text-emerald-400 font-semibold">Direct Tech Park Transit</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Interactive Residence Selector Section -->
  <section id="explore-residences" class="py-20 bg-charcoal-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Floor Plans & Configurations</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">Explore Residences Near Balewadi</h2>
        <p class="text-xs text-stone-400 leading-relaxed">
          Sanctioned MahaRERA CAD floor plans with zero corridor wastage and sprawling sundecks.
        </p>
      </div>

      <ResidenceSelector />
    </div>
  </section>

  <!-- CTA Priority Box -->
  <section class="py-16 bg-charcoal-950 text-center border-t border-white/10">
    <div class="max-w-3xl mx-auto px-4 space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-mono font-semibold">
        <span>MahaRERA: PR1261012602102 &amp; PM1261012602103</span>
      </div>
      <h3 class="font-serif text-2xl sm:text-4xl text-stone-100 font-bold">Experience Baner Annex Lifestyle</h3>
      <p class="text-xs sm:text-sm text-stone-400 max-w-xl mx-auto leading-relaxed">
        Register now to receive early access cost sheets, personalized payment schedules, and a complimentary VIP chauffeured site visit from Balewadi.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <button
          data-open-modal
          data-interest="Balewadi Corridor Priority Booking"
          class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer"
        >
          Download Cost Sheet & Floor Plans
        </button>
        <a
          href="https://wa.me/917744009295?text=Hello%20Mahindra%20Rivenza%2C%20I%20am%20interested%20in%20flats%20near%20Balewadi%20and%20would%20like%20the%20cost%20sheet."
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full border border-emerald-500/40 text-emerald-400 hover:text-white hover:bg-emerald-500/10 text-xs font-bold uppercase tracking-wider transition-all inline-flex items-center gap-2"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
