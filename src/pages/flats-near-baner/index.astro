---
import Layout from '../../layouts/Layout.astro';
import ResidenceSelector from '../../components/ResidenceSelector.astro';
import RiverFlowingEmblem from '../../components/RiverFlowingEmblem.astro';

const banerSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/flats-near-baner/#place",
      "name": "Baner & Baner Annex Residential Corridor",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Baner",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "18.5623125",
        "longitude": "73.7273125"
      }
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/flats-near-baner/#product",
      "name": "Luxury Flats Near Baner & Balewadi Pune - Mahindra Rivenza",
      "description": "Premium 2, 3 & 4 BHK residences at Mahindra Rivenza in Baner Annex / Mahalunge, Pune. 8-10 mins from Balewadi High Street, ~44,000 sq.ft clubhouse with sunken aqua bar, 9+ acres biophilic greens starting ₹90 Lakhs*.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "review": [
        {
          "@type": "Review",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Ananya Kulkarni"
          },
          "reviewBody": "We looked at multiple projects in Baner central, but the density and congestion were unbearable. Mahindra Rivenza in Baner Annex offers 13.46 acres of space, an Olympic-length pool, and takes just 8 minutes to reach Balewadi High Street."
        }
      ],
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://mahindralifespaceshomes.in/flats-near-baner/#breadcrumbs",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "West Pune", "item": "https://mahindralifespaceshomes.in/west-pune/" },
        { "@type": "ListItem", "position": 3, "name": "Flats Near Baner", "item": "https://mahindralifespaceshomes.in/flats-near-baner/" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/flats-near-baner/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How far is Mahindra Rivenza from Baner and Balewadi High Street?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is located just 4.6 km (8 to 10 minutes drive) from Balewadi High Street and Baner via wide 36m PMRDA Town Planning roads, bypassing congested local traffic corridors."
          }
        },
        {
          "@type": "Question",
          "name": "What is the price comparison between Baner central flats and Mahindra Rivenza Baner Annex?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "While Baner central flats range between ₹11,500 to ₹15,000 per sq.ft. in high-density 1-2 acre standalone plots, Mahindra Rivenza in Baner Annex offers ground-floor launch rates starting at ₹90 Lakhs* (approx. ₹7,800/sq.ft. base) with 13.46 acres master planning, 9+ acres of greens, and a ~44,000 sq.ft. clubhouse."
          }
        },
        {
          "@type": "Question",
          "name": "What configurations are available near Baner at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza features luxury 2 BHK (687–785 sq.ft carpet), premium 3 BHK (950–1,150 sq.ft carpet), and exclusive 4 BHK sky villas (1,400–1,820 sq.ft carpet) with sprawling double-height balconies and IGBC Gold sustainability."
          }
        },
        {
          "@type": "Question",
          "name": "What is the MahaRERA registration number for Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is registered under MahaRERA: Phase 1 (PR1261012602102) and Phase 2 (PM1261012602103) with possession scheduled for December 2031."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Flats Near Baner Pune [Starts ₹90L*] Mahindra Rivenza Annex"
  description="Seeking luxury flats near Baner & Balewadi High Street? Discover Mahindra Rivenza Baner Annex: 13.46 acres, 8-min drive, ~44,000 sq.ft clubhouse from ₹90L*."
  keywords="flats near baner, flats near balewadi high street, mahindra rivenza baner annex, mahindra lifespaces baner, luxury flats in baner pune, 2 bhk flats near baner, 3 bhk flats near baner, baner annexe properties"
  canonical="https://mahindralifespaceshomes.in/flats-near-baner/"
  customSchema={banerSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Badges Row -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>West Pune Lifestyle Corridor • 8 Mins to Balewadi High Street</span>
        </div>
        <div class="glass-floating inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-gold-500/30 backdrop-blur-md">
          <RiverFlowingEmblem size="xs" layout="horizontal" showSubtitle={false} />
          <span class="text-[11px] text-stone-300 font-medium border-l border-white/20 pl-2">Baner Annex • Starts ₹90L*</span>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-semibold border border-emerald-500/30">
          MahaRERA: PR1261012602102
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Luxury Flats Near Baner: <br />
        <span class="gold-gradient-text">Expansive 13.46-Acre Sanctuary at Mahindra Rivenza</span>
      </h1>

      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Experience the vibrant social lifestyle of Balewadi High Street and Baner just 8-10 minutes away, combined with the spacious serenity, 9+ acres of greens, and ~44,000 sq.ft clubhouse of Mahindra Rivenza in Baner Annex.
      </p>

      <!-- Market Stats Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 max-w-3xl">
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-gold-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Starting Ticket</span>
          <span class="font-serif text-base font-bold text-gold-400">Starts ₹90L*</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Price Arbitrage</span>
          <span class="font-serif text-base font-bold text-emerald-400">~42% vs Baner</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-white/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">High Street Drive</span>
          <span class="font-serif text-base font-bold text-white">8 Minutes</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-amber-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Clubhouse Scale</span>
          <span class="font-serif text-base font-bold text-amber-300">~44,000 Sq.Ft</span>
        </div>
      </div>
      
      <!-- Quick Action Buttons -->
      <div class="pt-4 flex flex-wrap gap-4">
        <button
          data-open-modal
          data-interest="Baner Lifestyle Buyer EOI - Cost Sheet"
          class="btn-shimmer px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer"
        >
          Request Baner Corridor Cost Sheet
        </button>
        <button
          data-open-modal
          data-interest="VIP Cab Tour from Baner"
          class="px-8 py-3.5 rounded-full border border-gold-500/40 text-gold-300 hover:text-white text-xs font-semibold uppercase tracking-widest text-center hover:bg-white/5 transition-colors cursor-pointer"
        >
          Book Free VIP Cab from Baner
        </button>
        <a
          href="tel:+917744009295"
          class="px-5 py-3.5 rounded-full border border-white/20 hover:border-white/40 text-stone-300 hover:text-white text-xs font-medium uppercase tracking-wider inline-flex items-center gap-2"
        >
          <span>Direct Advisory: +91 7744009295</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Commute Velocity Strip -->
  <section class="py-14 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Transit Efficiency</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-100 font-bold">Transit Times from Mahindra Rivenza Baner Annex</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-xl bg-charcoal-950 border border-white/10 text-center space-y-2">
          <div class="font-serif text-3xl font-bold text-gold-400">8 Mins</div>
          <h3 class="font-semibold text-stone-100 text-sm">Balewadi High Street</h3>
          <p class="text-[11px] text-stone-400">Starbucks, fine dining restaurants, gourmet retail & sports arena</p>
        </div>

        <div class="p-6 rounded-xl bg-charcoal-950 border border-white/10 text-center space-y-2">
          <div class="font-serif text-3xl font-bold text-gold-400">10 Mins</div>
          <h3 class="font-semibold text-stone-100 text-sm">Baner Main Road</h3>
          <p class="text-[11px] text-stone-400">Panchshil Business Park, Jupiter Hospital & Orchid Hotel</p>
        </div>

        <div class="p-6 rounded-xl bg-charcoal-950 border border-white/10 text-center space-y-2">
          <div class="font-serif text-3xl font-bold text-emerald-400">7 Mins</div>
          <h3 class="font-semibold text-stone-100 text-sm">Hinjewadi Phase 1</h3>
          <p class="text-[11px] text-stone-400">Direct 4-lane Mula River Bridge to Infosys, Wipro & Cognizant</p>
        </div>

        <div class="p-6 rounded-xl bg-charcoal-950 border border-white/10 text-center space-y-2">
          <div class="font-serif text-3xl font-bold text-amber-300">12 Mins</div>
          <h3 class="font-semibold text-stone-100 text-sm">Pashan & Sus Road</h3>
          <p class="text-[11px] text-stone-400">Direct PMRDA arterial route to Pashan Lake & Pune University</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Head-to-Head Comparison Table -->
  <section class="py-16 bg-[#0c1017] border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="space-y-3">
        <span class="text-xs font-mono uppercase text-gold-400 tracking-wider font-bold">Comprehensive Evaluation</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white">
          Baner Central vs Mahindra Rivenza Baner Annex: The Real Estate Audit
        </h2>
        <p class="text-stone-300 text-sm font-light leading-relaxed max-w-3xl">
          Why luxury homebuyers and smart investors are moving from congested Baner high-rises to Mahindra Rivenza’s 13.46-acre biophilic sanctuary in Baner Annex (Mahalunge).
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 glass-card">
        <table class="w-full text-xs text-left">
          <thead class="bg-white/5 text-stone-300 font-serif uppercase tracking-wider text-[10px]">
            <tr>
              <th class="p-4">Feature / Metric</th>
              <th class="p-4">Baner Central High-Rises</th>
              <th class="p-4 text-gold-400 font-bold">Mahindra Rivenza (Baner Annex)</th>
              <th class="p-4 text-emerald-400">Buyer Advantage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-stone-300 font-light">
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Base Capital Rate</td>
              <td class="p-4 font-mono text-stone-400">₹12,000 – ₹15,500 / sq.ft</td>
              <td class="p-4 font-mono text-gold-300 font-bold">₹7,500 – ₹8,800 / sq.ft</td>
              <td class="p-4 text-emerald-400 font-semibold font-mono">~42% Lower Entry Valuations</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">2 BHK Entry Ticket</td>
              <td class="p-4 font-mono text-stone-400">₹1.45 Cr – ₹1.85 Cr</td>
              <td class="p-4 font-mono text-gold-300 font-bold">Starts ₹90 Lakhs*</td>
              <td class="p-4 text-emerald-400 font-semibold font-mono">₹55L - ₹95L Capital Savings</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Master Parcel & Greens</td>
              <td class="p-4 text-stone-400">1 to 2 Acres (Concrete Clutter)</td>
              <td class="p-4 text-stone-200 font-semibold">13.46 Acres (9+ Acres Biophilic Greens)</td>
              <td class="p-4 text-emerald-400 font-semibold">Resort Living with Miyawaki Forests</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Clubhouse & Amenities</td>
              <td class="p-4 text-stone-400">8,000 – 12,000 sq.ft basement halls</td>
              <td class="p-4 text-stone-200 font-semibold">~44,000 sq.ft Grand Clubhouse with Sunken Aqua Bar</td>
              <td class="p-4 text-emerald-400 font-semibold">3.5x Larger Lifestyle Infrastructure</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Road Width & Access</td>
              <td class="p-4 text-stone-400">12m – 15m congested residential lanes</td>
              <td class="p-4 text-stone-200 font-semibold">Planned 36m wide PMRDA dual boulevards</td>
              <td class="p-4 text-emerald-400 font-semibold">Zero Rush-Hour Bottlenecks</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Hinjewadi IT Commute</td>
              <td class="p-4 text-stone-400">25 – 40 mins via choked highway</td>
              <td class="p-4 text-stone-200 font-semibold">7 mins via operational Mula River Bridge</td>
              <td class="p-4 text-emerald-400 font-semibold">Save 45+ minutes daily commute</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Developer Governance</td>
              <td class="p-4 text-stone-400">Varied local regional builders</td>
              <td class="p-4 text-stone-200 font-semibold">Mahindra Lifespaces (Mahindra Group)</td>
              <td class="p-4 text-emerald-400 font-semibold">100% Transparency & Balance Sheet Safety</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Interactive Residence Selector Section -->
  <section id="explore-residences" class="py-20 bg-charcoal-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Sanctioned CAD Floor Plans</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">Explore Residences Near Baner</h2>
        <p class="text-xs text-stone-400 leading-relaxed">
          Zero-corridor floor plans with cross-ventilation, panoramic Mula river vistas, and high-speed home automation provisions.
        </p>
      </div>

      <ResidenceSelector />
    </div>
  </section>

  <!-- Surrounding West Pune Corridors Mesh -->
  <section class="py-16 bg-[#0a0d14] border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Interconnected West Pune Corridors</span>
        <h3 class="font-serif text-2xl sm:text-3xl text-stone-100 font-bold">Explore Adjoining Real Estate Hubs</h3>
        <p class="text-xs text-stone-400">
          Compare Baner and Baner Annex with neighboring micro-markets across West Pune:
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 pt-2">
        <a href="/flats-near-hinjewadi/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Hinjewadi</div>
          <div class="text-[10px] text-stone-400 mt-1">7 Mins Bypass</div>
        </a>
        <a href="/west-pune/mahindra-rivenza-balewadi-real-estate-guide/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Balewadi</div>
          <div class="text-[10px] text-stone-400 mt-1">8 Mins Drive</div>
        </a>
        <a href="/west-pune/mahindra-rivenza-luxury-flats-in-wakad/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Wakad</div>
          <div class="text-[10px] text-stone-400 mt-1">10 Mins Access</div>
        </a>
        <a href="/west-pune/mahindra-rivenza-residences-near-pashan/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Pashan</div>
          <div class="text-[10px] text-stone-400 mt-1">12 Mins Direct</div>
        </a>
        <a href="/west-pune/mahindra-rivenza-residences-near-tathawade/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Tathawade</div>
          <div class="text-[10px] text-stone-400 mt-1">12 Mins Expressway</div>
        </a>
        <a href="/west-pune/mahindra-rivenza-bavdhan-connectivity-hub/" class="p-3.5 rounded-xl bg-charcoal-900 border border-white/10 hover:border-gold-400 text-center transition-all group">
          <div class="text-xs font-semibold text-stone-200 group-hover:text-gold-300">Bavdhan</div>
          <div class="text-[10px] text-stone-400 mt-1">15 Mins Ring Road</div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Priority Box -->
  <section class="py-16 bg-charcoal-950 text-center border-t border-white/10">
    <div class="max-w-3xl mx-auto px-4 space-y-5">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-mono font-semibold">
        <span>MahaRERA: PR1261012602102 &amp; PM1261012602103</span>
      </div>
      <h3 class="font-serif text-2xl sm:text-4xl text-stone-100 font-bold">Claim Your Baner Annex Priority Advantage</h3>
      <p class="text-xs sm:text-sm text-stone-400 max-w-xl mx-auto leading-relaxed">
        Register your Expression of Interest to secure launch pricing starting from ₹90 Lakhs*, customized payment plans, and a chauffeured VIP cab site tour.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-2">
        <button
          data-open-modal
          data-interest="Baner Corridor Priority Booking"
          class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer"
        >
          Download Cost Sheet & Floor Plans
        </button>
        <a
          href="https://wa.me/917744009295?text=Hello%20Mahindra%20Rivenza%2C%20I%20am%20interested%20in%20flats%20near%20Baner%20and%20would%20like%20the%20cost%20sheet."
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full border border-emerald-500/40 text-emerald-400 hover:text-white hover:bg-emerald-500/10 text-xs font-bold uppercase tracking-wider transition-all inline-flex items-center gap-2"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
