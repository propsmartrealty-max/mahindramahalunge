---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Flats Near Baner & Balewadi | Mahindra Mahalunge by Mahindra Lifespaces"
  description="Seeking luxury flats near Baner and Balewadi High Street? Discover Mahindra Mahalunge by Mahindra Lifespaces: 13.46-acre master community, 10-min drive, 80% open greens."
  canonical="https://mahindralifespaceshomes.in/flats-near-baner"
>
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>West Pune Lifestyle Corridor</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Flats Near Baner & Balewadi: <br />
        <span class="gold-gradient-text">Expansive Luxury at Mahindra Mahalunge</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Experience the vibrant social lifestyle of Balewadi High Street and Baner just 8-10 minutes away, combined with the spacious serenity of a 13.46-acre master bio-reserve.
      </p>
    </div>
  </section>

  <!-- Comparison Highlight -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="p-6 rounded-xl bg-charcoal-950 border border-white/10 space-y-3">
        <span class="text-xs uppercase tracking-widest text-stone-400 font-bold">Baner Central Suburb</span>
        <h3 class="font-serif text-xl font-bold text-stone-200">Congested 1-Acre High-Rises</h3>
        <p class="text-xs text-stone-400 leading-relaxed">
          High traffic density, limited internal open grounds, premium rates exceeding ₹12,000 to ₹15,000/sq.ft., and small balconies facing adjoining concrete walls.
        </p>
      </div>

      <div class="p-6 rounded-xl bg-charcoal-950 border border-gold-500/40 space-y-3 relative shadow-2xl">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Mahindra Mahalunge (10 Mins Away)</span>
        <h3 class="font-serif text-xl font-bold text-white">13.46-Acre Master Sanctuary</h3>
        <p class="text-xs text-stone-300 leading-relaxed">
          Over 80% open greens, planned 36m wide PMRDA boulevards, 35,000+ sq.ft. clubhouse, river vistas, and ground-floor pre-launch capital values.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 bg-charcoal-950 text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-4">
      <h3 class="font-serif text-2xl sm:text-3xl text-stone-100 font-bold">Experience the Baner-Mahalunge Corridor</h3>
      <p class="text-xs text-stone-400 max-w-md mx-auto">
        Register your Expression of Interest to receive early access cost sheets and arrange a guided site walkthrough.
      </p>
      <button
        data-open-modal
        data-interest="Baner Lifestyle Buyer EOI"
        class="px-8 py-3.5 rounded bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all"
      >
        Request Corridor Priority Pass
      </button>
    </div>
  </section>
</Layout>
