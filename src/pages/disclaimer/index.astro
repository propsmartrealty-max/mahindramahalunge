---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const disclaimerSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://mahindralifespaceshomes.in/disclaimer/#webpage",
  "url": "https://mahindralifespaceshomes.in/disclaimer/",
  "name": "Statutory Disclaimer & Disclosure | PropSmart Realty",
  "description": "Official Statutory Disclaimer, MahaRERA Compliance Notice, and Channel Partner Disclosure for Mahindra Rivenza at Baner Annex, Mahalunge, Pune.",
  "publisher": {
    "@type": "RealEstateAgent",
    "name": "PropSmart Realty",
    "legalName": "PropSmart Realty",
    "telephone": "+91 7744009295",
    "url": "https://mahindralifespaceshomes.in/"
  }
};
---

<Layout
  title="Statutory Disclaimer & MahaRERA Disclosure | PropSmart Realty"
  description="Official MahaRERA Compliance Notice, Channel Partner Disclosure (PropSmart Realty RERA: A031262401295), and Legal Disclaimer for Mahindra Rivenza Baner Annex."
  canonical="https://mahindralifespaceshomes.in/disclaimer/"
  customSchema={disclaimerSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Statutory RERA &amp; Advertising Compliance Notice</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight">
        Disclaimer &amp; Statutory Disclosure
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Transparency, accountability, and regulatory adherence.<br />
        Managed by <strong>PropSmart Realty</strong> (MahaRERA: A031262401295), Authorized Strategic Channel Partner.
      </p>
    </div>
  </section>

  <!-- Main Disclaimer Body -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 text-stone-300 text-sm leading-relaxed">

      <!-- 1. Channel Partner Authorization -->
      <div class="p-6 sm:p-8 rounded-2xl bg-charcoal-900/90 border border-gold-500/40 space-y-4 shadow-xl">
        <div class="flex items-center space-x-2 text-gold-400">
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <h2 class="text-base font-bold text-white uppercase tracking-wider font-serif">Authorized Strategic Channel Partner Status</h2>
        </div>
        <p>
          This website (<strong class="text-white">mahindralifespaceshomes.in</strong>) is an authentic marketing and customer consultation portal operated and maintained exclusively by <strong class="text-white">PropSmart Realty</strong> (<strong class="text-gold-300">MahaRERA Agent Registration No. A031262401295</strong>).
        </p>
        <p>
          PropSmart Realty operates as an <strong class="text-white">Authorized Strategic Channel Partner</strong> for marketing, brand presentation, and transaction facilitation of residential developments by <strong class="text-white">Mahindra Lifespace Developers Limited</strong>.
        </p>
        <p class="text-xs text-stone-400">
          This portal is not the corporate website of the developer. The official developer corporate portal is accessible at <a href="https://www.mahindralifespaces.com" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">mahindralifespaces.com</a>.
        </p>
      </div>

      <!-- 2. MahaRERA Certifications with QR Codes -->
      <div class="space-y-6">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">MahaRERA Project Registrations &amp; Authenticity</h2>
        <p>
          "Mahindra Rivenza" is planned across 13.46 acres in Baner Annex (Mahalunge), Pune, developed by Mahindra Lifespace Developers Limited in phases. The development holds active, verified registrations under the Real Estate (Regulation and Development) Act:
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center space-x-4">
            <img src="/images/rera-qr-phase1.jpeg" alt="MahaRERA Phase 1 QR" class="w-24 h-24 object-contain bg-white p-1 rounded-xl shadow-md" width="96" height="96" />
            <div class="space-y-1">
              <span class="text-xs uppercase text-stone-400 font-mono">Phase 1</span>
              <div class="text-base font-bold text-gold-300 font-mono">PR1261012602102</div>
              <p class="text-[11px] text-stone-400">Statutory Validity upto: <strong class="text-white">30/12/2031</strong></p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center space-x-4">
            <img src="/images/rera-qr-phase2.jpeg" alt="MahaRERA Phase 2 QR" class="w-24 h-24 object-contain bg-white p-1 rounded-xl shadow-md" width="96" height="96" />
            <div class="space-y-1">
              <span class="text-xs uppercase text-stone-400 font-mono">Phase 2</span>
              <div class="text-base font-bold text-gold-300 font-mono">PM1261012602103</div>
              <p class="text-[11px] text-stone-400">Statutory Validity upto: <strong class="text-white">30/12/2031</strong></p>
            </div>
          </div>
        </div>

        <p class="text-xs text-stone-400">
          All statutory approvals, sanctioned building layouts, environmental clearances, and title reports are publicly verifiable on the official MahaRERA website: <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">https://maharera.maharashtra.gov.in</a>.
        </p>
      </div>

      <!-- 3. Non-Offer & Artist Impressions Notice -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">Representational Imagery &amp; Artistic Impressions</h2>
        <p>
          All visuals, renderings, simulated 3D views, interior design ideas, elevations, and landscape illustrations shown on this website are artist impressions designed to convey the design intent of the development. They may not represent the exact finished specifications or dimensions.
        </p>
        <p>
          Furniture, fixtures, electronic gadgets, decorative artefacts, and modular fittings shown in showcase images or sample apartments are for illustration only and do not form part of the standard sale agreement unless expressly specified in the written schedule of amenities.
        </p>
      </div>

      <!-- 4. Pricing Disclaimers -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">Pricing, Quotations &amp; Escalation Conditions</h2>
        <p>
          Base price ranges published across this website (starting ₹90 Lakhs* for 2 BHK, ₹1.31 Cr* for 3 BHK, and ₹2.20 Cr* for 4 BHK) are indicative starting ticket sizes as of pre-launch/launch notifications. Prices are subject to revision without prior notice at the sole discretion of the developer.
        </p>
        <p>
          Taxes, government levies, stamp duty (7%), registration charges, Goods &amp; Services Tax (GST 5%), maintenance deposits, floor rise charges, and car parking allocation are additional as per actual statutory invoices.
        </p>
      </div>

      <!-- 5. Intellectual Property & Trademark Protection -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">Intellectual Property &amp; Trademarks</h2>
        <p>
          All corporate trademarks, product names, logos, elevations, and design blueprints belong exclusively to <strong class="text-white">Mahindra Lifespace Developers Limited</strong>. PropSmart Realty utilizes these assets under legitimate channel marketing authorization. No unauthorized third party may scrape, frame, or reuse these visual assets without written permission.
        </p>
      </div>

      <!-- Contact Info -->
      <div class="p-6 rounded-2xl bg-charcoal-900 border border-white/10 space-y-2 text-xs font-mono">
        <div class="text-sm font-serif font-bold text-white pb-1">Statutory Compliance Advisory Desk</div>
        <div><strong>Channel Partner:</strong> PropSmart Realty</div>
        <div><strong>MahaRERA Agent Reg No:</strong> A031262401295</div>
        <div><strong>Location:</strong> Baner Annex / Mahalunge, off Baner-Hinjawadi Road, Pune 412115</div>
        <div><strong>Phone:</strong> +91 7744009295</div>
        <div><strong>Email:</strong> compliance@mahindralifespaceshomes.in</div>
      </div>

    </div>
  </section>

  <MahindraKeywordMatrix />
</Layout>
