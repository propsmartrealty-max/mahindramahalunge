---
import { webStoriesData, type WebStoryItem } from '../../data/pSeoWebStories';

export async function getStaticPaths() {
  return webStoriesData.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

interface Props {
  story: WebStoryItem;
}

const { story } = Astro.props;
const canonicalUrl = `https://mahindralifespaceshomes.in/web-stories/${story.slug}/`;

const storySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "headline": story.title,
  "description": story.metaDescription,
  "image": [
    story.posterPortrait,
    story.posterSquare,
    story.posterLandscape
  ],
  "datePublished": story.datePublished,
  "dateModified": story.dateModified,
  "author": {
    "@type": "Organization",
    "name": "Mahindra Rivenza",
    "url": "https://mahindralifespaceshomes.in/"
  },
  "publisher": {
    "@type": "Organization",
    "name": story.publisher,
    "logo": {
      "@type": "ImageObject",
      "url": story.publisherLogo
    }
  }
};
---
<!doctype html>
<html amp lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1" />
    <title>{story.metaTitle}</title>
    <meta name="description" content={story.metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Google Web Stories AMP Scripts -->
    <script async src="https://cdn.ampproject.org/v0.js"></script>
    <script async custom-element="amp-story" src="https://cdn.ampproject.org/v0/amp-story-1.0.js"></script>

    <!-- AMP Boilerplate -->
    <style amp-boilerplate is:inline>body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-moz-animation:-amp-start 8s steps(1,end) 0s 1 normal both;-ms-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-moz-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-ms-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@-o-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}</style>
    <noscript><style amp-boilerplate is:inline>body{-webkit-animation:none;-moz-animation:none;-ms-animation:none;animation:none}</style></noscript>

    <!-- Custom Story Typography & Glassmorphic Scrims -->
    <style amp-custom is:inline>
      amp-story {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #ffffff;
      }
      .scrim-gradient {
        background: linear-gradient(
          180deg,
          rgba(12, 16, 23, 0.4) 0%,
          rgba(12, 16, 23, 0.1) 40%,
          rgba(12, 16, 23, 0.85) 75%,
          rgba(12, 16, 23, 0.98) 100%
        );
      }
      .content-box {
        align-self: flex-end;
        padding: 24px;
        box-sizing: border-box;
        width: 100%;
      }
      .badge-pill {
        display: inline-block;
        padding: 5px 12px;
        background: rgba(212, 175, 102, 0.2);
        border: 1px solid rgba(212, 175, 102, 0.6);
        border-radius: 9999px;
        color: #e6ca85;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 12px;
      }
      .story-subtitle {
        color: #d4af66;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0 0 6px 0;
      }
      .story-title {
        font-size: 26px;
        line-height: 1.25;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 10px 0;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
      }
      .story-desc {
        font-size: 14px;
        line-height: 1.5;
        color: #e2e8f0;
        margin: 0 0 16px 0;
        font-weight: 400;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
      }
      .brand-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: rgba(12, 16, 23, 0.5);
        backdrop-filter: blur(10px);
      }
      .brand-tag {
        font-size: 11px;
        letter-spacing: 1px;
        color: #a0aec0;
        text-transform: uppercase;
        font-weight: 600;
      }
    </style>

    <!-- Schema.org Article Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(storySchema)} />
  </head>
  <body>
    <amp-story
      standalone
      title={story.title}
      publisher={story.publisher}
      publisher-logo-src={story.publisherLogo}
      poster-portrait-src={story.posterPortrait}
      poster-square-src={story.posterSquare}
      poster-landscape-src={story.posterLandscape}
    >
      {story.pages.map((page, idx) => (
        <amp-story-page id={page.id} auto-advance-after="7s">
          <!-- Background Image Layer -->
          <amp-story-grid-layer template="fill">
            <amp-img
              src={page.image}
              width="720"
              height="1280"
              layout="responsive"
              alt={page.title}
            />
          </amp-story-grid-layer>

          <!-- Top Brand Header Layer -->
          <amp-story-grid-layer template="vertical">
            <div class="brand-bar" animate-in="fade-in">
              <span class="brand-tag">Mahindra Rivenza • Baner Annex</span>
              <span class="brand-tag">{story.category}</span>
            </div>
          </amp-story-grid-layer>

          <!-- Dark Scrim Gradient for Readability -->
          <amp-story-grid-layer template="fill" class="scrim-gradient" />

          <!-- Story Text Content Layer -->
          <amp-story-grid-layer template="vertical" class="content-box">
            {page.badge && (
              <div>
                <span class="badge-pill" animate-in="fly-in-bottom" animate-in-delay="0.1s">
                  {page.badge}
                </span>
              </div>
            )}
            <p class="story-subtitle" animate-in="fly-in-bottom" animate-in-delay="0.2s">
              {page.subtitle}
            </p>
            <h2 class="story-title" animate-in="fly-in-bottom" animate-in-delay="0.3s">
              {page.title}
            </h2>
            <p class="story-desc" animate-in="fly-in-bottom" animate-in-delay="0.4s">
              {page.description}
            </p>
          </amp-story-grid-layer>

          <!-- Page Outlink for CTA (if specified) -->
          {page.ctaUrl && (
            <amp-story-page-outlink layout="nodisplay">
              <a href={page.ctaUrl}>{page.ctaText || 'Learn More'}</a>
            </amp-story-page-outlink>
          )}
        </amp-story-page>
      ))}
    </amp-story>
  </body>
</html>
