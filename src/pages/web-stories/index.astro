---
import Layout from '../../layouts/Layout.astro';
import { webStoriesData } from '../../data/pSeoWebStories';

const webStoriesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/web-stories/#webpage",
      "url": "https://mahindralifespaceshomes.in/web-stories/",
      "name": "Google Web Stories: Mahindra Rivenza Baner Annex & Pune Real Estate Buyers Guide",
      "description": "Watch full-screen visual Google Web Stories on Mahindra Rivenza Baner Annex, 2 & 3 BHK luxury residences, 40+ resort amenities, and Pune real estate market investment intelligence.",
      "publisher": {
        "@type": "Organization",
        "name": "Mahindra Rivenza",
        "url": "https://mahindralifespaceshomes.in/"
      }
    }
  ]
};
---

<Layout
  title="Google Web Stories | Mahindra Rivenza Baner Annex & Pune Real Estate"
  description="Explore full-screen visual Google Web Stories covering Mahindra Rivenza 13.46-acre master development, 2 & 3 BHK residences, 40+ amenities, and Pune real estate market insights."
  canonical="https://mahindralifespaceshomes.in/web-stories/"
  customSchema={webStoriesSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
        <span>Visual Stories • Tap &amp; Experience Fullscreen</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
        Mahindra Rivenza Baner Annex <br />
        <span class="gold-gradient-text">Pune Real Estate Buyers Market</span>
      </h1>
      
      <p class="text-stone-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Experience immersive, bite-sized visual web stories on Mahindra Rivenza’s 13.46-acre master community at Baner Annex, Mahalunge, Pune. Explore 2 &amp; 3 BHK floor plans, 40+ resort amenities, pricing breakdowns, and strategic Pune real estate investment intelligence.
      </p>

      <!-- Stats Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Stories</div>
          <div class="text-2xl font-bold text-gold-300 mt-1">{webStoriesData.length} Visual Editions</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Format</div>
          <div class="text-2xl font-bold text-emerald-400 mt-1">AMP Stories 1.0</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Flagship Estate</div>
          <div class="text-sm font-semibold text-white mt-1">13.46 Acres • Mahalunge</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Pricing</div>
          <div class="text-sm font-semibold text-sky-400 mt-1">From ₹90 Lakhs*</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Web Stories Grid -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div>
          <span class="text-xs font-mono uppercase text-gold-400 tracking-wider font-bold">Featured Visual Editions</span>
          <h2 class="font-serif text-2xl font-bold text-white mt-1">Tap Any Story to Play Fullscreen</h2>
        </div>
        <span class="text-xs text-stone-400 hidden sm:inline-block">Indexed for Google Discover &amp; Mobile SERP</span>
      </div>

      <!-- Story Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {webStoriesData.map((story) => (
          <a
            href={`/web-stories/${story.slug}/`}
            class="group relative rounded-2xl overflow-hidden aspect-[9/16] border border-white/10 hover:border-gold-400/60 shadow-xl transition-all duration-300 block transform hover:-translate-y-1"
          >
            <!-- Background Poster -->
            <img
              src={story.posterPortrait}
              alt={story.title}
              class="absolute inset-0 w-full h-full object-cover filter brightness-[0.75] group-hover:scale-105 group-hover:brightness-[0.85] transition-all duration-700"
              loading="lazy"
            />

            <!-- Dark Gradient Scrim -->
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-charcoal-950/40 to-transparent"></div>

            <!-- Top Tag -->
            <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full bg-gold-500/20 backdrop-blur-md border border-gold-500/40 text-[10px] font-bold text-gold-300 uppercase tracking-wider">
                {story.category}
              </span>
              <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center text-white group-hover:bg-gold-500 group-hover:text-charcoal-950 transition-colors">
                <svg class="w-4 h-4 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>

            <!-- Bottom Content -->
            <div class="absolute bottom-4 left-4 right-4 space-y-2">
              <div class="text-[11px] font-mono text-gold-400 tracking-wider uppercase font-semibold">
                {story.publisher}
              </div>
              <h3 class="font-serif text-lg font-bold text-white leading-snug group-hover:text-gold-200 transition-colors line-clamp-3">
                {story.title}
              </h3>
              <p class="text-xs text-stone-300 line-clamp-2 leading-relaxed">
                {story.metaDescription}
              </p>
              <div class="pt-2 flex items-center text-xs font-semibold text-gold-400 space-x-1 group-hover:translate-x-1 transition-transform">
                <span>View Web Story</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Real Estate Buyer Callout Banner -->
      <div class="bg-gradient-to-r from-charcoal-900 via-charcoal-800 to-charcoal-900 border border-gold-400/30 rounded-2xl p-8 sm:p-10 flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs font-mono uppercase text-gold-400 tracking-widest font-bold">Mahindra Rivenza • Baner Annex</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">Looking to Buy a Home in West Pune?</h3>
          <p class="text-stone-300 text-sm max-w-xl leading-relaxed">
            Experience 13.46 acres of biophilic resort luxury at Baner Annex, Mahalunge. Connect with our dedicated sales desk for verified floor plans, unit availability, and exclusive buyer pricing.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="tel:+917744009295"
            class="px-6 py-3.5 rounded-lg bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-sm transition-all shadow-lg text-center"
          >
            Call Desk: +91 7744009295
          </a>
          <a
            href="/pricing/"
            class="px-6 py-3.5 rounded-lg bg-white/10 hover:bg-white/15 border border-white/20 text-white font-medium text-sm transition-all text-center"
          >
            Check Floor Plans &amp; Pricing
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>
