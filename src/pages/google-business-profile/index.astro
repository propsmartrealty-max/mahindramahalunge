---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const title = "Mahindra Rivenza Google Business Profile & Sales Gallery Map | Pune 412115";
const description = "Verified Google Business Profile, site office address, driving directions, operating hours, and Google Maps location for Mahindra Rivenza by Mahindra Lifespaces in Baner Annex / Mahalunge, Pune.";
const canonical = "https://mahindralifespaceshomes.in/google-business-profile/";

const gbpSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "RealEstateAgent",
      "@id": "https://mahindralifespaceshomes.in/google-business-profile/#agent",
      "name": "Mahindra Rivenza Partner Advisory Desk — PropSmart Realty",
      "image": "https://mahindralifespaceshomes.in/images/official/mahindra-rivenza-architectural-elevation.webp",
      "telephone": "+91-7744009295",
      "url": "https://mahindralifespaceshomes.in/",
      "priceRange": "₹₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, Off Baner-Hinjawadi Road, PMRDA TP Scheme 1, Mahalunge (Nande)",
        "addressLocality": "Pune",
        "addressRegion": "Maharashtra",
        "postalCode": "412115",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.5623125,
        "longitude": 73.7273125
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "opens": "09:00",
          "closes": "19:30"
        }
      ],
      "sameAs": [
        "https://maps.google.com/?cid=944743224796015013",
        "https://maharera.maharashtra.gov.in"
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "Google Business Profile", "item": "https://mahindralifespaceshomes.in/google-business-profile/" }
      ]
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  customSchema={gbpSchema}
>
  <main class="min-h-screen bg-charcoal-950 text-stone-200 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-12">

      <!-- Breadcrumbs -->
      <nav class="flex items-center space-x-2 text-xs text-stone-400">
        <a href="/" class="hover:text-gold-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-300 font-medium">Google Business Profile &amp; Location</span>
      </nav>

      <!-- Header -->
      <header class="space-y-4 border-b border-white/10 pb-8 text-center sm:text-left">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Verified Local Google Business Profile Listing</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
          Mahindra Rivenza: Google Business Profile &amp; Sales Gallery
        </h1>
        <p class="text-stone-300 text-sm sm:text-base leading-relaxed max-w-3xl">
          Official Google Maps verified location, site office coordinates, operational timings, and VIP show residence visiting guidelines for <strong class="text-white">Mahindra Rivenza</strong> in Baner Annex, Mahalunge, Pune.
        </p>
      </header>

      <!-- Key Details Card -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Address & Contact -->
        <div class="p-8 rounded-2xl bg-charcoal-900 border border-gold-500/30 space-y-6 shadow-2xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <h2 class="font-serif text-xl font-bold text-white">Sales &amp; Experience Centre</h2>
            <span class="text-xs font-mono px-2.5 py-1 rounded bg-emerald-950 text-emerald-300 border border-emerald-500/30">Open Today</span>
          </div>

          <div class="space-y-4 text-xs text-stone-300">
            <div>
              <span class="text-stone-400 font-mono block mb-1">Site Address:</span>
              <p class="text-sm font-medium text-white leading-relaxed">
                Mahindra Rivenza Sales Experience Gallery, PMRDA Town Planning Scheme 1, Baner Annex, off Baner-Hinjawadi Road, Mahalunge (Nande), Pune, Maharashtra 412115, India.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-4 pt-2">
              <div>
                <span class="text-stone-400 font-mono block mb-1">Google Plus Code:</span>
                <span class="text-gold-400 font-mono font-bold">HP6G+WWF Pune</span>
              </div>
              <div>
                <span class="text-stone-400 font-mono block mb-1">GPS Coordinates:</span>
                <span class="text-gold-400 font-mono font-bold">18.5623° N, 73.7273° E</span>
              </div>
            </div>

            <div class="pt-2">
              <span class="text-stone-400 font-mono block mb-1">Operating Hours:</span>
              <p class="text-white font-medium">Monday to Sunday: 09:00 AM – 07:30 PM IST</p>
            </div>

            <div class="pt-2">
              <span class="text-stone-400 font-mono block mb-1">Direct Advisory Desk:</span>
              <a href="tel:+917744009295" class="text-base text-gold-400 hover:underline font-bold block">
                +91 7744009295
              </a>
            </div>

            <div class="pt-2">
              <span class="text-stone-400 font-mono block mb-1">MahaRERA Registration:</span>
              <p class="text-stone-200">
                Phase 1: <strong class="text-gold-300 font-mono">PR1261012602102</strong> | Phase 2: <strong class="text-gold-300 font-mono">PM1261012602103</strong>
              </p>
              <p class="text-[11px] text-stone-400 mt-1">
                Authorized Channel Partner: <strong class="text-white">PropSmart Realty</strong> (MahaRERA Agent: <span class="text-gold-300 font-mono">A031262401295</span>)
              </p>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap gap-3">
            <a
              href="https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider transition-all text-center inline-flex items-center justify-center gap-2"
            >
              <span>🗺️</span>
              <span>Open in Google Maps</span>
            </a>
            <a
              href="tel:+917744009295"
              class="w-full sm:w-auto px-6 py-3 rounded-xl border border-white/20 hover:border-gold-400 text-stone-200 hover:text-gold-400 font-bold text-xs uppercase tracking-wider transition-all text-center"
            >
              Call Advisory Desk
            </a>
          </div>
        </div>

        <!-- Driving Directions Matrix -->
        <div class="p-8 rounded-2xl bg-charcoal-900 border border-white/10 space-y-6 shadow-2xl">
          <div class="border-b border-white/10 pb-4">
            <h2 class="font-serif text-xl font-bold text-white">Driving Routes &amp; Commute Times</h2>
            <p class="text-xs text-stone-400 mt-1">Direct accessibility to major commercial hubs</p>
          </div>

          <div class="space-y-4 text-xs text-stone-300">
            <div class="p-4 rounded-xl bg-charcoal-950/60 border border-white/5 space-y-1">
              <div class="flex items-center justify-between font-semibold text-white">
                <span>From Hinjewadi IT Park (Phase 1)</span>
                <span class="text-emerald-400 font-mono">7 Mins (3.2 km)</span>
              </div>
              <p class="text-stone-400 leading-relaxed text-[11px]">
                Drive across the 4-lane Mula River Bridge connecting Mahalunge directly to Infosys Phase 1 Circle, avoiding Wakad bridge traffic.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-charcoal-950/60 border border-white/5 space-y-1">
              <div class="flex items-center justify-between font-semibold text-white">
                <span>From Balewadi High Street</span>
                <span class="text-emerald-400 font-mono">8 Mins (3.8 km)</span>
              </div>
              <p class="text-stone-400 leading-relaxed text-[11px]">
                Take the Baner-Balewadi arterial road straight into PMRDA Town Planning Scheme 1 boulevard.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-charcoal-950/60 border border-white/5 space-y-1">
              <div class="flex items-center justify-between font-semibold text-white">
                <span>From Mumbai-Pune Expressway (Wakad Exit)</span>
                <span class="text-emerald-400 font-mono">12 Mins (6.1 km)</span>
              </div>
              <p class="text-stone-400 leading-relaxed text-[11px]">
                Exit NH 48 at Wakad bypass and follow the newly widened 36m DP road through Mahalunge.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-charcoal-950/60 border border-white/5 space-y-1">
              <div class="flex items-center justify-between font-semibold text-white">
                <span>From Pune International Airport (PNQ)</span>
                <span class="text-emerald-400 font-mono">35 Mins (21 km)</span>
              </div>
              <p class="text-stone-400 leading-relaxed text-[11px]">
                Via Pune Inner Ring Road and Airport Road through Aundh-Baner corridor.
              </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Quick Links Strip -->
      <div class="pt-6 border-t border-white/10 flex flex-wrap gap-4 text-xs text-stone-300 justify-between items-center">
        <a href="/location/" class="hover:text-gold-400 font-medium">← View Macro Location Map</a>
        <a href="/site-visit/" class="text-gold-400 hover:underline font-semibold">Book VIP Show Flat Walkthrough →</a>
      </div>

    </div>
  </main>

  <!-- Comprehensive Programmatic Keyword Matrix & Search Graph -->
  <MahindraKeywordMatrix />
</Layout>
