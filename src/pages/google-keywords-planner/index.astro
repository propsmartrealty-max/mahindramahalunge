---
import Layout from '../../layouts/Layout.astro';
import { googleKeywordPlannerResearchMatrix, fourSupremePillars } from '../../data/mahindraKeywordsEcosystem';

const title = "Google Keyword Planner Research & Search Intelligence | Mahindra Rivenza Pune";
const description = "Comprehensive Google Keyword Planner research, search volume metrics, CPC benchmarks, and programmatic topical injection taxonomy for Mahindra Rivenza, Mahindra Mahalunge, and Mahindra Baner Annexe.";
const canonical = "https://mahindralifespaceshomes.in/google-keywords-planner/";

const plannerSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mahindralifespaceshomes.in/google-keywords-planner/#webpage",
      "url": "https://mahindralifespaceshomes.in/google-keywords-planner/",
      "name": title,
      "description": description,
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://mahindralifespaceshomes.in/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Google Keyword Planner Intelligence",
            "item": "https://mahindralifespaceshomes.in/google-keywords-planner/"
          }
        ]
      }
    },
    {
      "@type": "Dataset",
      "name": "Mahindra Rivenza Google Keyword Planner Search Intelligence Matrix",
      "description": "Granular search query volume, CPC ranges, competition index, and topical clustering dataset for Mahindra Lifespaces Rivenza Pune development in Baner Annex / Mahalunge.",
      "url": "https://mahindralifespaceshomes.in/google-keywords-planner/",
      "creator": {
        "@type": "Organization",
        "name": "PropSmart Realty",
        "url": "https://mahindralifespaceshomes.in/"
      },
      "license": "https://creativecommons.org/licenses/by-nd/4.0/",
      "keywords": [
        "Mahindra Rivenza",
        "Mahindra Mahalunge",
        "Mahindra Baner Annexe",
        "Mahindra Pune",
        "Google Keyword Planner Pune Real Estate"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the highest-volume search queries for Mahindra Rivenza on Google?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Based on Google Keyword Planner data, the highest-volume queries are 'Mahindra Rivenza' (10,000–50,000 monthly searches during peak launch cycle), 'Mahindra Pune' (10,000–50,000), 'Mahindra Mahalunge' (5,000–20,000), and 'Mahindra Baner Annexe' (5,000–15,000)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the commercial CPC value for Mahindra Rivenza transactional keywords?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Top-of-page Google Search bids for high purchase-intent keywords such as 'Mahindra Rivenza price' and 'Mahindra Rivenza booking' range between ₹42.50 to ₹240.00 INR, reflecting high competition among homebuyers and real estate investors."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Mahindra Rivenza officially located in Pune?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is situated at PMRDA Town Planning Scheme 1, Baner Annex, Mahalunge, off Baner-Hinjawadi Road, Pune 412115, connecting directly to Hinjewadi Phase 1 via the 4-lane Mula River bridge and 7 minutes from Balewadi High Street."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  customSchema={plannerSchema}
>
  <main class="min-h-screen bg-charcoal-950 text-stone-200 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">

      <!-- Breadcrumbs -->
      <nav class="flex items-center space-x-2 text-xs text-stone-400">
        <a href="/" class="hover:text-gold-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gold-300 font-medium">Google Keyword Planner Intelligence</span>
      </nav>

      <!-- Hero Header -->
      <header class="space-y-4 border-b border-white/10 pb-8">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-300 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Google Keyword Planner Audit &amp; Master Search Taxonomy</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
          Mahindra Rivenza: Google Keyword Planner Research &amp; Topical Injection Engine
        </h1>
        <p class="text-stone-300 text-sm sm:text-base leading-relaxed max-w-4xl">
          An enterprise-grade analysis of search queries, monthly impression volumes, commercial CPC benchmarks, and buyer-intent clustering for <strong class="text-white">Mahindra Rivenza</strong>, <strong class="text-white">Mahindra Mahalunge</strong>, <strong class="text-white">Mahindra Baner Annexe</strong>, and <strong class="text-white">Mahindra Pune</strong>.
        </p>
      </header>

      <!-- The 4 Supreme Head Pillars Section -->
      <section class="space-y-6">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span class="text-gold-400">01.</span> The 4 Supreme Head Pillars (Rank #1 Targets)
          </h2>
          <span class="text-xs font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2.5 py-1 rounded-md">
            P0 Maximum Weightage
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {fourSupremePillars.map((pillar) => (
            <div class="p-6 rounded-2xl bg-charcoal-900/60 border border-gold-500/20 backdrop-blur-md space-y-3 hover:border-gold-500/50 transition-all shadow-lg">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-gold-400 uppercase tracking-widest">{pillar.category}</span>
                <span class="text-[11px] font-mono bg-white/5 px-2 py-0.5 rounded text-stone-300">{pillar.intent}</span>
              </div>
              <h3 class="font-serif text-xl font-bold text-white">
                <a href={pillar.canonicalHub} class="hover:text-gold-300 transition-colors flex items-center gap-2">
                  {pillar.keyword}
                  <span class="text-xs text-gold-400">→</span>
                </a>
              </h3>
              <p class="text-xs text-stone-300 leading-relaxed">
                {pillar.metaSnippet}
              </p>
              <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                <span class="text-stone-400">Target Rank: <strong class="text-emerald-400 font-mono">{pillar.targetRank}</strong></span>
                <a href={pillar.canonicalHub} class="text-gold-400 hover:underline font-semibold">
                  Read Dedicated Authority Guide →
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Complete Google Keyword Planner Research Table -->
      <section class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/10 pb-3">
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span class="text-gold-400">02.</span> Master Keyword Planner Intelligence Matrix
          </h2>
          <span class="text-xs font-mono text-stone-400">
            {googleKeywordPlannerResearchMatrix.length} Verified High-Impact Clusters
          </span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-white/10 shadow-2xl bg-charcoal-900/40">
          <table class="w-full text-left text-xs text-stone-300">
            <thead class="bg-charcoal-900/90 text-stone-200 border-b border-white/10 uppercase font-mono text-[11px]">
              <tr>
                <th class="py-3.5 px-4 font-semibold">Target Search Query</th>
                <th class="py-3.5 px-3 font-semibold">Monthly Volume</th>
                <th class="py-3.5 px-3 font-semibold">Growth (3M / YoY)</th>
                <th class="py-3.5 px-3 font-semibold">Competition</th>
                <th class="py-3.5 px-3 font-semibold">Top Bid (Low - High)</th>
                <th class="py-3.5 px-3 font-semibold">Intent</th>
                <th class="py-3.5 px-4 font-semibold">Direct Destination Hub</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 font-sans">
              {googleKeywordPlannerResearchMatrix.map((item) => (
                <tr class="hover:bg-white/[0.03] transition-colors">
                  <td class="py-3.5 px-4 font-medium text-white">
                    <span class="block">{item.keyword}</span>
                    <span class="text-[10px] font-mono text-gold-400/80">{item.category}</span>
                  </td>
                  <td class="py-3.5 px-3 font-mono text-emerald-400 font-semibold whitespace-nowrap">
                    {item.avgMonthlySearches}
                  </td>
                  <td class="py-3.5 px-3 font-mono text-stone-300 whitespace-nowrap">
                    <span class="text-emerald-400">{item.threeMonthChange}</span> / {item.yoyChange}
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap">
                    <span class={`inline-block px-2 py-0.5 rounded text-[10px] font-mono ${
                      item.competition === 'High' ? 'bg-rose-950/60 text-rose-300 border border-rose-500/30' :
                      item.competition === 'Medium' ? 'bg-amber-950/60 text-amber-300 border border-amber-500/30' :
                      'bg-emerald-950/60 text-emerald-300 border border-emerald-500/30'
                    }`}>
                      {item.competition} ({item.competitionIndex})
                    </span>
                  </td>
                  <td class="py-3.5 px-3 font-mono text-stone-200 whitespace-nowrap">
                    ₹{item.lowTopPageBidInr} - ₹{item.highTopPageBidInr}
                  </td>
                  <td class="py-3.5 px-3 whitespace-nowrap font-mono text-stone-400">
                    {item.intent}
                  </td>
                  <td class="py-3.5 px-4 whitespace-nowrap">
                    <a
                      href={item.targetUrl}
                      class="text-gold-400 hover:text-gold-300 hover:underline font-medium flex items-center gap-1"
                    >
                      <span>Explore Hub</span>
                      <span class="text-[10px]">→</span>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Search Intent Architecture & Injection Blueprint -->
      <section class="space-y-6">
        <div class="border-b border-white/10 pb-3">
          <h2 class="font-serif text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
            <span class="text-gold-400">03.</span> Strategic Multi-Layer Injection Architecture
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-stone-300">
          <div class="p-5 rounded-xl bg-charcoal-900/60 border border-white/10 space-y-3">
            <div class="text-base font-serif font-bold text-white flex items-center gap-2">
              <span class="text-gold-400">Layer 1:</span> Document Head Meta Injection
            </div>
            <p class="leading-relaxed">
              Every critical route carries strict, non-stuffed Title tags combining the core entity name, primary location, and purchase configuration (e.g., <em>Mahindra Rivenza Pune | Mahindra Mahalunge &amp; Baner Annexe [Starts ₹90L*]</em>).
            </p>
          </div>

          <div class="p-5 rounded-xl bg-charcoal-900/60 border border-white/10 space-y-3">
            <div class="text-base font-serif font-bold text-white flex items-center gap-2">
              <span class="text-gold-400">Layer 2:</span> Semantic Schema.org Graph
            </div>
            <p class="leading-relaxed">
              Syntactically verified JSON-LD graphs embed <code class="text-gold-300">ApartmentComplex</code>, <code class="text-gold-300">RealEstateListing</code>, <code class="text-gold-300">FAQPage</code>, and <code class="text-gold-300">Product</code> schemas matching official MahaRERA parameters (Phase 1: PR1261012602102).
            </p>
          </div>

          <div class="p-5 rounded-xl bg-charcoal-900/60 border border-white/10 space-y-3">
            <div class="text-base font-serif font-bold text-white flex items-center gap-2">
              <span class="text-gold-400">Layer 3:</span> Closed-Loop Topical Siloing
            </div>
            <p class="leading-relaxed">
              Internal link equity circulates across 370+ static HTML documents using contextual DoFollow anchor text, ensuring Googlebot traverses between price, floor plans, RERA status, and commute hubs without dead ends.
            </p>
          </div>
        </div>
      </section>

      <!-- Statutory Disclosure -->
      <footer class="pt-8 border-t border-white/10 text-[11px] text-stone-400 space-y-3">
        <p>
          <strong class="text-white">Authorized Real Estate Strategic Partner Disclosure:</strong> This portal (<span class="text-gold-300 font-mono">mahindralifespaceshomes.in</span>) is maintained by <strong class="text-white">PropSmart Realty</strong> (MahaRERA Agent Registration No: <span class="text-gold-300 font-mono font-semibold">A031262401295</span>), an authorized channel partner for marketing and sales facilitation of Mahindra Lifespaces developments in Pune.
        </p>
        <p>
          <strong class="text-white">MahaRERA Project Registration:</strong> Mahindra Rivenza is officially registered under MahaRERA: Phase 1 (Registration No. <span class="text-gold-300 font-mono">PR1261012602102</span>) and Phase 2 (Registration No. <span class="text-gold-300 font-mono">PM1261012602103</span>). Verified project details can be reviewed at <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">https://maharera.maharashtra.gov.in</a>.
        </p>
      </footer>

    </div>
  </main>
</Layout>
