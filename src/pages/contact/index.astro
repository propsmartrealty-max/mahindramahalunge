---
import Layout from '../../layouts/Layout.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://mahindralifespaceshomes.in/contact/#contactpage",
      "url": "https://mahindralifespaceshomes.in/contact/",
      "name": "Mahindra Rivenza Partner Advisory Desk & Sales Gallery",
      "description": "Contact details, advisory desk phone number, location address, and visiting hours for Mahindra Rivenza at Baner Annex, Mahalunge, Pune.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://mahindralifespaceshomes.in/contact/" }
        ]
      }
    },
    {
      "@type": "RealEstateAgent",
      "@id": "https://mahindralifespaceshomes.in/#agent",
      "name": "Mahindra Rivenza Partner Advisory Desk & Sales Gallery",
      "legalName": "PropSmart Realty",
      "image": "https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp",
      "telephone": "+91 7744009295",
      "url": "https://mahindralifespaceshomes.in/",
      "priceRange": "₹90 Lakhs - ₹2.55 Cr*",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande",
        "addressLocality": "Mahalunge, Pune",
        "postalCode": "412115",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.562536,
        "longitude": 73.727373
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "09:00",
          "closes": "20:00"
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Contact [Site Office & Phone] Book Visit"
  description="Contact Mahindra Rivenza partner advisory desk at Baner Annex, Mahalunge, Pune. Call +91 7744009295, get driving directions & book priority site tour."
  canonical="https://mahindralifespaceshomes.in/contact/"
  customSchema={contactSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Official Sales & Site Experience Gallery</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 max-w-4xl leading-tight">
        Contact Mahindra Rivenza: <br />
        <span class="gold-gradient-text">Baner Annex, Mahalunge, Pune</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Connect directly with our authorized sales advisors for verified cost sheets, sanctioned CAD blueprints, site visit slots, and MahaRERA registration certificates.
      </p>
    </div>
  </section>

  <!-- Core Contact Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1: Phone -->
        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4 hover:border-gold-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-2xl">📞</span>
            <h3 class="font-serif text-lg font-bold text-stone-100">Sales Hotline</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Direct line to priority booking desk for 2, 3 &amp; 4 BHK inventory inquiries.
            </p>
          </div>
          <div>
            <a
              href="tel:+917744009295"
              class="inline-block text-gold-400 font-bold text-base hover:text-gold-300 transition-colors"
            >
              +91 7744009295
            </a>
            <span class="block text-[10px] text-stone-400 mt-1">Available 9:00 AM – 8:00 PM Daily</span>
          </div>
        </div>

        <!-- Card 2: WhatsApp -->
        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4 hover:border-emerald-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-2xl">💬</span>
            <h3 class="font-serif text-lg font-bold text-stone-100">WhatsApp Desk</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Instant delivery of PDF brochures, CAD floor plans &amp; payment milestones.
            </p>
          </div>
          <div>
            <a
              href="https://wa.me/917744009295?text=Hi%20Mahindra%20Rivenza%20Team%2C%20please%20share%20the%20official%20brochure%2C%20cost%20sheet%20and%20schedule%20a%20site%20visit."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1.5 text-emerald-400 font-bold text-sm hover:text-emerald-300 transition-colors"
            >
              <span>Chat on WhatsApp</span>
              <span>→</span>
            </a>
            <span class="block text-[10px] text-stone-400 mt-1">Average response: &lt; 5 mins</span>
          </div>
        </div>

        <!-- Card 3: Site Address -->
        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4 hover:border-gold-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-2xl">📍</span>
            <h3 class="font-serif text-lg font-bold text-stone-100">Site Experience Gallery</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande, Mahalunge, Pune, Maharashtra 412115.
            </p>
          </div>
          <div>
            <a
              href="https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1 text-gold-400 font-bold text-xs hover:underline"
            >
              <span>Get Driving Directions</span>
              <span>↗</span>
            </a>
            <span class="block text-[10px] text-stone-400 mt-1">Free visitor valet parking</span>
          </div>
        </div>

        <!-- Card 4: MahaRERA -->
        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4 hover:border-gold-500/50 transition-all flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-2xl">🏛️</span>
            <h3 class="font-serif text-lg font-bold text-stone-100">MahaRERA Certificates</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Registered with Maharashtra Real Estate Regulatory Authority.
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-[11px] text-stone-200">Phase 1: <span class="font-mono text-gold-400 font-bold">PR1261012602102</span></p>
            <p class="text-[11px] text-stone-200">Phase 2: <span class="font-mono text-emerald-400 font-bold">PM1261012602103</span></p>
            <a href="/rera/" class="inline-block text-[10px] text-stone-400 hover:text-white underline mt-1">
              Verify RERA documents →
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Location Map & Directions -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Location &amp; Access</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
          How to Reach Mahindra Rivenza Sales Gallery
        </h2>
        <p class="text-xs sm:text-sm text-stone-400 max-w-xl mx-auto font-light">
          Strategically located between Baner, Balewadi, and Hinjewadi Phase 1 along the Mula River corridor.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Driving Directions Cards -->
        <div class="space-y-4">
          <div class="glass-card p-5 rounded-xl border border-white/10 space-y-2">
            <h4 class="font-serif text-sm font-bold text-gold-300">🚗 From Hinjewadi Phase 1 (5–7 Mins)</h4>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Take the newly opened Mahalunge-Hinjewadi bridge across the Mula River directly onto the 36m DP road connecting to the sales gallery entrance.
            </p>
          </div>

          <div class="glass-card p-5 rounded-xl border border-white/10 space-y-2">
            <h4 class="font-serif text-sm font-bold text-emerald-300">🚗 From Baner &amp; Balewadi High Street (8–10 Mins)</h4>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Drive past Balewadi Stadium on the Mumbai-Bengaluru Highway bypass, turn left toward Mahalunge town planning scheme road.
            </p>
          </div>

          <div class="glass-card p-5 rounded-xl border border-white/10 space-y-2">
            <h4 class="font-serif text-sm font-bold text-amber-300">🚗 From Mumbai-Pune Expressway (15 Mins)</h4>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Exit at Dehu Road / Wakad junction, merge toward Hinjewadi flyover, and take the riverside connector directly to Nande-Mahalunge.
            </p>
          </div>
        </div>

        <!-- VIP Site Visit Pass Box -->
        <div class="lg:col-span-2 glass-card rounded-2xl border border-gold-500/30 p-8 space-y-6 flex flex-col justify-between shadow-2xl">
          <div class="space-y-4">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
              <span>Schedule an In-Person Walkthrough</span>
            </div>
            <h3 class="font-serif text-2xl font-bold text-stone-100">
              Book a Guided VIP Experience at the 4 BHK Show Residence
            </h3>
            <p class="text-xs sm:text-sm text-stone-300 leading-relaxed font-light">
              Walk through the actual sample home, explore architectural blueprints with senior developer advisors, and receive an all-inclusive cost sheet with tailored CLP payment schedules.
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs text-stone-300 pt-2">
              <div class="flex items-center space-x-2">
                <span class="text-emerald-400">✓</span>
                <span>Dedicated Relationship Manager</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-emerald-400">✓</span>
                <span>Complimentary Cab Pickup Available</span>
              </div>
              <div class="flex items-center space-x-2">
                <span class="text-emerald-400">✓</span>
                <span>Sanctioned CAD Floor Plans</span>
              </div>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <button
              data-open-modal
              data-interest="VIP Site Visit Appointment"
              class="px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer text-center"
            >
              Book Site Visit Slot
            </button>
            <a
              href="tel:+917744009295"
              class="px-8 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-stone-100 text-xs font-bold uppercase tracking-widest border border-white/20 transition-all text-center"
            >
              Call +91 7744009295
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>
