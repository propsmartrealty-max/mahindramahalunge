---
import Layout from '../../layouts/Layout.astro';

const amenitiesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/amenities/#place",
      "name": "Mahindra Rivenza Lifestyle Amenities & ~44,000 Sq.Ft. Clubhouse",
      "description": "Over 2.65 Lakh sq.ft. of curated lifestyle and athletic amenities at Mahindra Rivenza by Mahindra Lifespaces in Baner Annex / Mahalunge, Pune. Features grand clubhouse, sunken aqua bar pool, and futsal arena.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande",
        "addressLocality": "Mahalunge, Pune",
        "postalCode": "412115",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/amenities/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the primary clubhouse and pool amenities at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza features a ~44,000 sq.ft multi-level designer clubhouse with a temperature-regulated swimming pool featuring Pune's first sunken aqua bar, private cabanas, and indoor wellness spas."
          }
        },
        {
          "@type": "Question",
          "name": "How much green landscape space is allocated at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Over 70% of the 13.46-acre master layout (9+ acres) is dedicated to vehicle-free biophilic greens, nature trails, sensory gardens, and mindful yoga decks."
          }
        },
        {
          "@type": "Question",
          "name": "What sports facilities are included in the township?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The sports infrastructure includes a floodlit FIFA-dimension futsal court, multi-purpose basketball and tennis arena, squash courts, cricket simulator, and outdoor jogging tracks."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Amenities & Master Plan [~44k Sq.Ft Clubhouse & Sunken Pool]"
  description="Explore 50+ resort lifestyle amenities at Mahindra Rivenza Baner Annex: ~44,000 sq.ft grand clubhouse, temperature-regulated pool with sunken bar, futsal turf & 9+ acres greens."
  keywords="mahindra rivenza amenities, mahindra rivenza clubhouse, swimming pool with sunken bar, amenities mahindra mahalunge, luxury amenities baner annex pune"
  canonical="https://mahindralifespaceshomes.in/amenities/"
  customSchema={amenitiesSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2.65 Lakh+ Sq.Ft. Amenity Enclaves • 50+ Curated Features</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza Amenities: <br />
        <span class="gold-gradient-text">~44,000 Sq.Ft. Clubhouse & Sunken Bar Pool</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Curated across 5 lifestyle pillars — wellness, athletics, entertainment, biophilic nature, and family leisure — delivering five-star resort living every single day.
      </p>
    </div>
  </section>

  <!-- Amenities Grid -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Sunken Bar Pool -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Swimming%20pool%20with%20sunken%20bar_Rivenza_11zon.webp" 
              alt="Mahindra Rivenza Swimming Pool with Sunken Aqua Bar - Official 3D Render" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 p-2 rounded-xl bg-charcoal-950/80 border border-gold-400/30 backdrop-blur-md">
              <img src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-02/Swimming%20pool_0.png" alt="Pool Icon" class="w-6 h-6 object-contain" width="24" height="24" />
            </div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-gold-400 font-bold uppercase tracking-wider">Aqua Resort Living</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Swimming Pool with Sunken Bar</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                Resort-inspired temperature-regulated swimming pool featuring an integrated sunken aqua bar, dedicated kids' shallow splash pool, underwater LED illuminations, and cabana sun lounger decks.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-gold-400 font-medium">
              ✦ Sunken Aqua Seating • Cabana Decks
            </div>
          </div>
        </div>

        <!-- Feature 2: Multipurpose Court -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Multi-purpose_Rivenza__11zon.webp" 
              alt="Mahindra Rivenza Multipurpose Sports Arena - Official 3D Render" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 p-2 rounded-xl bg-charcoal-950/80 border border-gold-400/30 backdrop-blur-md">
              <img src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-01/multipurpose-court.png" alt="Multipurpose Court Icon" class="w-6 h-6 object-contain" width="24" height="24" />
            </div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-emerald-400 font-bold uppercase tracking-wider">Athletic Excellence</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Multipurpose Sports Court</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                All-weather synthetic surfaced court engineered for basketball, tennis, and volleyball with perimeter spectator seating and Olympic-grade non-glare floodlighting.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-emerald-400 font-medium">
              ✦ International Cushion Flooring • Night Play
            </div>
          </div>
        </div>

        <!-- Feature 3: Yoga Lawn -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Yoga%20lawn_Rivenza_11zon.webp" 
              alt="Mahindra Rivenza Biophilic Yoga Lawn - Official 3D Render" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 p-2 rounded-xl bg-charcoal-950/80 border border-gold-400/30 backdrop-blur-md">
              <img src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-06/yoga_room.png" alt="Yoga Icon" class="w-6 h-6 object-contain" width="24" height="24" />
            </div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-emerald-400 font-bold uppercase tracking-wider">Mindfulness & Wellness</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Biophilic Yoga & Reflexology Lawn</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                Lush open-air meditation green nestled within indigenous flowering groves. Designed for sunrise Surya Namaskar, outdoor Pilates, and barefoot reflexology pathways.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-emerald-400 font-medium">
              ✦ Sunrise Orientation • Aromatherapy Flora
            </div>
          </div>
        </div>

        <!-- Feature 4: Floodlit Futsal Arena -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/image001_11zon%20%281%29.webp" 
              alt="Mahindra Rivenza Championship Futsal Court - Official 3D Render" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 p-2 rounded-xl bg-charcoal-950/80 border border-gold-400/30 backdrop-blur-md">
              <img src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-03/Half-basketball-court.png" alt="Sports Icon" class="w-6 h-6 object-contain" width="24" height="24" />
            </div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-amber-300 font-bold uppercase tracking-wider">Championship Athletics</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Floodlit Futsal Arena</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                Enclosed turf football cage featuring high-impact rebound fencing, FIFA-grade artificial turf, and automated evening LED lighting towers for late-night tournaments.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-amber-300 font-medium">
              ✦ Rebound Netting • FIFA-Grade Artificial Turf
            </div>
          </div>
        </div>

        <!-- Feature 5: Multi-Level Grand Clubhouse -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative bg-gradient-to-br from-[#131a28] to-[#0c1017] flex items-center justify-center p-6">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-04/Clubhouse.png" 
              alt="Mahindra Rivenza Grand Clubhouse Icon" 
              class="w-24 h-24 object-contain group-hover:scale-110 transition-transform duration-500 filter drop-shadow-[0_10px_20px_rgba(212,175,102,0.3)]"
              loading="lazy"
              width="96"
              height="96"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-gold-400 font-bold uppercase tracking-wider">~44,000+ Sq.Ft. Landmark</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Multi-Level Grand Clubhouse</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                Architectural centerpiece with state-of-the-art TechnoGym fitness center, indoor squash courts, badminton hall, co-working business lounge, and private celebratory banqueting suites.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-gold-400 font-medium">
              ✦ TechnoGym • Co-Working Lounge • Squash Court
            </div>
          </div>
        </div>

        <!-- Feature 6: 9+ Acres Central Greens -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all flex flex-col">
          <div class="h-60 overflow-hidden relative bg-gradient-to-br from-[#12221b] to-[#0c1017] flex items-center justify-center p-6">
            <img 
              src="https://cms.mahindralifespaces.com/web/sites/default/files/styles/web_thumb_webp/public/2026-04/9%20acres%20of%20devolpment.png" 
              alt="Mahindra Rivenza 9+ Acres Greens Icon" 
              class="w-24 h-24 object-contain group-hover:scale-110 transition-transform duration-500 filter drop-shadow-[0_10px_20px_rgba(16,185,129,0.3)]"
              loading="lazy"
              width="96"
              height="96"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-emerald-400 font-bold uppercase tracking-wider">Biophilic Sanctuary</span>
          </div>
          <div class="p-6 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">9+ Acres Bio-Park & Nature Trails</h3>
              <p class="text-xs text-stone-300 leading-relaxed font-light mt-2">
                100% vehicular-free ground-level landscape featuring 1.2 km jogging tracks, sensory butterfly parks, native evergreen canopies, and organic fruit orchards.
              </p>
            </div>
            <div class="pt-3 border-t border-white/10 text-[11px] text-emerald-400 font-medium">
              ✦ 1.2 Km Jogging Loop • Vehicular-Free Ground
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 50+ Curated Amenities Master Directory (6 Lifestyle Zones) -->
  <section class="py-20 bg-charcoal-950 border-b border-white/10 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold flex items-center justify-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Complete Master Specification
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">
          The 50+ Curated Amenities Master Directory <br />
          <span class="gold-gradient-text">6 Immersive Lifestyle Zones</span>
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 leading-relaxed font-light">
          Every dimension of health, leisure, athletic vigor, and biophilic nature curated across 13.46 acres in Baner Annex, Mahalunge.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Zone 1: Aquatic Wellness -->
        <div class="bg-charcoal-900/90 border border-white/10 rounded-2xl p-6 space-y-4 hover:border-gold-500/40 transition-all shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="font-serif text-lg font-bold text-stone-100 flex items-center gap-2">
              <span class="text-gold-400">🏊</span> Aquatic Wellness Oasis
            </h3>
            <span class="text-[10px] text-gold-400 font-mono bg-gold-500/10 px-2 py-0.5 rounded border border-gold-500/20">8 Features</span>
          </div>
          <ul class="space-y-2 text-xs text-stone-300">
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Resort pool with sunken aqua bar</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Temperature-regulated adult lap pool</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Dedicated shallow splash pool for toddlers</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Heated indoor hydrotherapy jacuzzi</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Cabana sun lounger pool deck</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Stepping stone water cascades</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Reflective lily ponds & biophilic streams</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Outdoor rain showers & luxury changing suites</span></li>
          </ul>
        </div>

        <!-- Zone 2: Championship Sports -->
        <div class="bg-charcoal-900/90 border border-white/10 rounded-2xl p-6 space-y-4 hover:border-emerald-500/40 transition-all shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="font-serif text-lg font-bold text-stone-100 flex items-center gap-2">
              <span class="text-emerald-400">⚽</span> Championship Athletics
            </h3>
            <span class="text-[10px] text-emerald-400 font-mono bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">10 Features</span>
          </div>
          <ul class="space-y-2 text-xs text-stone-300">
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Floodlit futsal turf arena (FIFA-grade turf)</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Synthetic-cushion tennis court</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>2 indoor wooden badminton courts</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Glass-back air-conditioned squash court</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Dedicated pickleball championship court</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Half basketball court with shock absorption</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Cricket net practice pitch with bowling turf</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Outdoor table tennis game terrace</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>1.2 km synthetic jogging track loop</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Dedicated peripheral cycling trail</span></li>
          </ul>
        </div>

        <!-- Zone 3: Biophilic Nature & Forest -->
        <div class="bg-charcoal-900/90 border border-white/10 rounded-2xl p-6 space-y-4 hover:border-emerald-500/40 transition-all shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="font-serif text-lg font-bold text-stone-100 flex items-center gap-2">
              <span class="text-emerald-400">🌿</span> Biophilic Nature & Forest
            </h3>
            <span class="text-[10px] text-emerald-400 font-mono bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">10 Features</span>
          </div>
          <ul class="space-y-2 text-xs text-stone-300">
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>9+ acres contiguous central parkland</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Stargazing lawn with open-sky hammocks</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Giant tree-canopy swings for adults & kids</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Miyawaki dense native afforestation grove</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Organic aroma & sensory butterfly sanctuary</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Barefoot acupressure reflexology path</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Sunrise yoga deck with river breeze exposure</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Shaded pergola senior citizen alcoves</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Outdoor giant chess & lawn games terrace</span></li>
            <li class="flex items-start gap-2"><span class="text-emerald-400">✦</span><span>Dedicated pet park with agility trail</span></li>
          </ul>
        </div>

        <!-- Zone 4: The Grand Clubhouse -->
        <div class="bg-charcoal-900/90 border border-white/10 rounded-2xl p-6 space-y-4 hover:border-gold-500/40 transition-all shadow-xl">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <h3 class="font-serif text-lg font-bold text-stone-100 flex items-center gap-2">
              <span class="text-gold-400">🏛️</span> Grand Clubhouse (~44k Sq.Ft.)
            </h3>
            <span class="text-[10px] text-gold-400 font-mono bg-gold-500/10 px-2 py-0.5 rounded border border-gold-500/20">10 Features</span>
          </div>
          <ul class="space-y-2 text-xs text-stone-300">
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Double-height designer arrival lobby</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>TechnoGym-equipped cardio & strength gym</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Executive co-working lounge & private zoom pods</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Private 24-seater Dolby Atmos mini-cineplex</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Grand celebration banquet hall (250+ capacity)</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Open-sky party terrace & barbecue deck</span></li>
            <li class="flex items-start gap-2"><span class="text-gold-400">✦</span><span>Indoor snooker, billiards & foosball lounge</span></li>
