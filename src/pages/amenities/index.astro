---
import Layout from '../../layouts/Layout.astro';

const amenitiesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/amenities/#place",
      "name": "Mahindra Rivenza Lifestyle Amenities & ~44,000 Sq.Ft. Clubhouse",
      "description": "Over 2.65 Lakh sq.ft. of curated lifestyle and athletic amenities at Mahindra Rivenza by Mahindra Lifespaces in Baner Annex / Mahalunge, Pune. Features grand clubhouse, sunken aqua bar pool, and futsal arena.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande",
        "addressLocality": "Mahalunge, Pune",
        "postalCode": "412115",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      }
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Amenities | 44,000 Sq.Ft Clubhouse & Sunken Bar Pool"
  description="Discover 50+ world-class amenities across 2.65 Lakh+ sq.ft at Mahindra Rivenza, Baner Annex, Mahalunge, Pune. Featuring ~44,000 sq.ft grand clubhouse, resort swimming pool with sunken bar, futsal court, and 9+ acres greens."
  keywords="mahindra rivenza amenities, mahindra rivenza clubhouse, swimming pool with sunken bar, amenities mahindra mahalunge, luxury amenities baner annex pune"
  canonical="https://mahindralifespaceshomes.in/amenities/"
  customSchema={amenitiesSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>2.65 Lakh+ Sq.Ft. Amenity Enclaves • 50+ Curated Features</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza Amenities: <br />
        <span class="gold-gradient-text">~44,000 Sq.Ft. Clubhouse & Sunken Bar Pool</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Curated across 5 lifestyle pillars — wellness, athletics, entertainment, biophilic nature, and family leisure — delivering five-star resort living every single day.
      </p>
    </div>
  </section>

  <!-- Amenities Grid -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Sunken Bar Pool -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-52 overflow-hidden relative">
            <img 
              src="http://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/Swimming%20pool%20with%20sunken%20bar_Rivenza_11zon.webp" 
              alt="Mahindra Rivenza Swimming Pool with Sunken Aqua Bar" 
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              width="600"
              height="400"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif text-gold-400 font-bold uppercase tracking-wider">Aqua Resort</span>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Swimming Pool with Sunken Bar</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Resort-style temperature-regulated swimming pool featuring an integrated sunken aqua bar, dedicated kids' wading pool, and sun lounger decks.
            </p>
          </div>
        </div>

        <!-- Feature 2: Grand Clubhouse -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-52 overflow-hidden relative bg-charcoal-950 flex items-center justify-center p-6">
            <div class="text-center space-y-2">
              <span class="text-4xl text-gold-400">🏛️</span>
              <div class="font-serif text-xl font-bold text-stone-100">~44,000+ Sq.Ft.</div>
              <div class="text-[10px] uppercase tracking-widest text-gold-400 font-semibold">Grand Lifestyle Hub</div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Multi-Level Grand Clubhouse</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              Houses state-of-the-art fitness gym, yoga & pilates studio, indoor badminton courts, squash court, luxury spa salons, and private banquet hall.
            </p>
          </div>
        </div>

        <!-- Feature 3: Athletic Courts -->
        <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-52 overflow-hidden relative bg-charcoal-950 flex items-center justify-center p-6">
            <div class="text-center space-y-2">
              <span class="text-4xl text-emerald-400">⚽</span>
              <div class="font-serif text-xl font-bold text-stone-100">Sports & Athletics</div>
              <div class="text-[10px] uppercase tracking-widest text-emerald-400 font-semibold">Floodlit Arena</div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Futsal & Multipurpose Sports Courts</h3>
            <p class="text-xs text-stone-300 leading-relaxed font-light">
              International standard sports surfaces including floodlit futsal court, box cricket practice nets with bowling machine, and championship tennis court.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-charcoal-950 text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-4">
      <h3 class="font-serif text-2xl text-stone-100 font-bold">Experience the Amenities First-Hand</h3>
      <p class="text-xs sm:text-sm text-stone-300">Book an on-site visit to the sales gallery at Baner Annex and tour the live 4 BHK model residence.</p>
      <button
        data-open-modal
        data-interest="Amenities Site Tour"
        class="btn-shimmer px-8 py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold uppercase tracking-widest shadow-xl cursor-pointer"
      >
        Book Show Residence Tour
      </button>
    </div>
  </section>
</Layout>
