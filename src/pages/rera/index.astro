---
import Layout from '../../layouts/Layout.astro';

const reraSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "GovernmentPermit",
      "name": "MahaRERA Registration - Mahindra Rivenza Phase 1",
      "identifier": "PR1261012602102",
      "validUntil": "2031-12-30",
      "issuedBy": {
        "@type": "GovernmentOrganization",
        "name": "Maharashtra Real Estate Regulatory Authority (MahaRERA)",
        "url": "https://maharera.maharashtra.gov.in"
      }
    },
    {
      "@type": "GovernmentPermit",
      "name": "MahaRERA Registration - Mahindra Rivenza Phase 2",
      "identifier": "PM1261012602103",
      "validUntil": "2031-12-30",
      "issuedBy": {
        "@type": "GovernmentOrganization",
        "name": "Maharashtra Real Estate Regulatory Authority (MahaRERA)",
        "url": "https://maharera.maharashtra.gov.in"
      }
    },
    {
      "@type": "HowTo",
      "name": "How to Verify Mahindra Rivenza MahaRERA Registration Online",
      "description": "Step-by-step official guide to verify the sanctioned layouts, title deed, commencement certificate, and escrow account of Mahindra Rivenza on the government MahaRERA portal.",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Visit Official MahaRERA Portal",
          "text": "Navigate to the official Maharashtra Real Estate Regulatory Authority portal at https://maharera.maharashtra.gov.in and click on 'Registration > Registered Projects'."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Enter Project Registration Number",
          "text": "Select 'Project Name / RERA Number' and input Phase 1 RERA: PR1261012602102 or Phase 2 RERA: PM1261012602103."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Inspect Sanctioned Documents & Escrow Account",
          "text": "Download the verified Commencement Certificate (CC), sanctioned floor plans, architect certificates, and 70% project escrow bank account details registered under Mahindra Lifespace Developers Limited."
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "MahaRERA Compliance", "item": "https://mahindralifespaceshomes.in/rera/" }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza MahaRERA Approved [PR1261012602102] Certificates"
  description="Verify official MahaRERA compliance, approved building plans & escrow account for Mahindra Rivenza Baner Annex. Phase 1: PR1261012602102, Phase 2: PM1261012602103."
  canonical="https://mahindralifespaceshomes.in/rera/"
  customSchema={reraSchema}
>
  <section class="pt-32 pb-24 bg-charcoal-950 min-h-screen relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Header -->
      <div class="text-center space-y-4">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Statutory Regulatory Disclosure</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 leading-tight">
          Mahindra Rivenza MahaRERA Disclosures <br />
          <span class="gold-gradient-text">Phase 1 & Phase 2 Official Registration</span>
        </h1>
        <p class="text-stone-300 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed font-light">
          In strict compliance with the Real Estate (Regulation and Development) Act, 2016 and Maharashtra Real Estate Regulatory Authority regulations, here are the authenticated statutory certificates for Mahindra Rivenza at Baner Annex, Mahalunge, Pune.
        </p>
      </div>

      <!-- Registration Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Phase 1 Card -->
        <div class="glass-card rounded-2xl p-8 border border-gold-500/30 space-y-6 shadow-2xl relative">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-mono font-bold uppercase">
              Phase 1 Registration
            </span>
            <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Active & Valid
            </span>
          </div>

          <div class="space-y-2">
            <h2 class="font-serif text-2xl font-bold text-white">Mahindra Rivenza Phase 1</h2>
            <div class="text-xs text-stone-400 font-mono">Certificate: PR1261012602102</div>
          </div>

          <div class="divide-y divide-white/10 text-xs text-stone-300 space-y-3 pt-2">
            <div class="flex justify-between pt-2">
              <span class="text-stone-400">Project Type:</span>
              <span class="font-semibold text-white">Residential Landmark</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Phase 1 Units:</span>
              <span class="font-semibold text-white">1,236 Residences</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Configurations:</span>
              <span class="font-semibold text-gold-400">2, 3 & 4 BHK Luxury</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Total Land Parcel:</span>
              <span class="font-semibold text-white">13.46 Acres</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Validity Up To:</span>
              <span class="font-semibold text-emerald-400">30/12/2031</span>
            </div>
          </div>

          <div class="pt-2 flex justify-center">
            <div class="p-3 bg-white rounded-xl shadow-lg border border-gold-500/30 text-center max-w-[170px]">
              <img 
                src="https://cms.mahindralifespaces.com/web/sites/default/files/2026-10/RERA%20full%20url_PR1261012602102.jpeg" 
                alt="MahaRERA QR Code PR1261012602102"
                class="w-36 h-36 object-contain mx-auto"
                width="144"
                height="144"
                loading="lazy"
              />
              <span class="block text-[10px] text-charcoal-950 font-mono font-bold mt-1">Scan to Verify Phase 1</span>
            </div>
          </div>

          <div class="pt-4">
            <a
              href="https://maharera.maharashtra.gov.in"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-shimmer block text-center w-full py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase text-xs tracking-wider shadow-lg hover:shadow-gold-500/30 transition-all"
            >
              Verify on MahaRERA Portal →
            </a>
          </div>
        </div>

        <!-- Phase 2 Card -->
        <div class="glass-card rounded-2xl p-8 border border-white/15 space-y-6 shadow-2xl relative">
          <div class="flex items-center justify-between">
            <span class="px-3 py-1 rounded bg-white/10 border border-white/20 text-stone-300 text-xs font-mono font-bold uppercase">
              Phase 2 Registration
            </span>
            <span class="text-xs text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Active & Valid
            </span>
          </div>

          <div class="space-y-2">
            <h2 class="font-serif text-2xl font-bold text-white">Mahindra Rivenza Phase 2</h2>
            <div class="text-xs text-stone-400 font-mono">Certificate: PM1261012602103</div>
          </div>

          <div class="divide-y divide-white/10 text-xs text-stone-300 space-y-3 pt-2">
            <div class="flex justify-between pt-2">
              <span class="text-stone-400">Project Type:</span>
              <span class="font-semibold text-white">Residential Master Development</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Developer Entity:</span>
              <span class="font-semibold text-white">Mahindra Lifespaces Developers Ltd.</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Parent Group:</span>
              <span class="font-semibold text-gold-400">Mahindra Group (75+ Yrs)</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Location:</span>
              <span class="font-semibold text-white">Baner Annex, Mahalunge, Pune 412115</span>
            </div>
            <div class="flex justify-between pt-3">
              <span class="text-stone-400">Validity Up To:</span>
              <span class="font-semibold text-emerald-400">30/12/2031</span>
            </div>
          </div>

          <div class="pt-2 flex justify-center">
            <div class="p-3 bg-white rounded-xl shadow-lg border border-gold-500/30 text-center max-w-[170px]">
              <img 
                src="https://cms.mahindralifespaces.com/web/sites/default/files/2026-10/RERA%20full%20url_PM1261012602103.jpeg" 
                alt="MahaRERA QR Code PM1261012602103"
                class="w-36 h-36 object-contain mx-auto"
                width="144"
                height="144"
                loading="lazy"
              />
              <span class="block text-[10px] text-charcoal-950 font-mono font-bold mt-1">Scan to Verify Phase 2</span>
            </div>
          </div>

          <div class="pt-4">
            <a
              href="https://maharera.maharashtra.gov.in"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-shimmer block text-center w-full py-3 rounded-full border border-white/30 text-stone-100 hover:text-white hover:border-gold-400 text-xs font-bold uppercase tracking-wider transition-all"
            >
              Verify on MahaRERA Portal →
            </a>
          </div>
        </div>

      </div>

      <!-- Statutory Disclaimer -->
      <div class="glass-card rounded-2xl p-6 border border-white/10 text-stone-300 text-xs leading-relaxed space-y-3 font-light">
        <h3 class="font-serif text-sm font-bold text-gold-400 uppercase tracking-wider">Statutory Disclaimer & Compliance Transparency</h3>
        <p>
          The project has been registered via MahaRERA registration number: <strong>PR1261012602102</strong> (Phase 1) and <strong>PM1261012602103</strong> (Phase 2), both valid up to <strong>30/12/31</strong> and is available on the website <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline hover:text-gold-300">maharera.maharashtra.gov.in</a> under registered projects.
        </p>
        <p>
          This website is an authorized information and showcase portal. All floor plans, layout illustrations, and dimensions are strictly compliant with approved MahaRERA sanction files. Prospective buyers are advised to review statutory agreements, title deeds, and sanctioned plans prior to executing purchase agreements.
        </p>
      </div>

    </div>
  </section>
</Layout>
