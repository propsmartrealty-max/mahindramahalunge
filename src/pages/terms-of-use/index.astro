---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://mahindralifespaceshomes.in/terms-of-use/#webpage",
  "url": "https://mahindralifespaceshomes.in/terms-of-use/",
  "name": "Terms of Use | PropSmart Realty & Mahindra Rivenza Showcase",
  "description": "Terms of Use and Legal Conditions for accessing mahindralifespaceshomes.in, operated by PropSmart Realty (MahaRERA: A031262401295), Authorized Strategic Channel Partner.",
  "publisher": {
    "@type": "RealEstateAgent",
    "name": "PropSmart Realty",
    "legalName": "PropSmart Realty",
    "telephone": "+91 7744009295",
    "url": "https://mahindralifespaceshomes.in/"
  }
};
---

<Layout
  title="Terms of Use | PropSmart Realty & Mahindra Rivenza Showcase"
  description="Terms of Use for mahindralifespaceshomes.in. Governing conditions, intellectual property, pricing disclaimers, and statutory MahaRERA compliance disclosures."
  canonical="https://mahindralifespaceshomes.in/terms-of-use/"
  customSchema={termsSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Legal Terms &amp; Conditions of Service</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight">
        Terms of Use
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Effective Date: October 6, 2026 • Last Reviewed: November 2026<br />
        Platform operated by <strong>PropSmart Realty</strong> (MahaRERA: A031262401295).
      </p>
    </div>
  </section>

  <!-- Main Terms Content -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 text-stone-300 text-sm leading-relaxed">

      <!-- 1. Acceptance of Terms -->
      <div class="p-6 rounded-2xl bg-charcoal-900/80 border border-white/10 space-y-3">
        <h2 class="text-base font-bold text-white uppercase tracking-wider font-serif">1. Acceptance of Terms</h2>
        <p>
          By accessing, browsing, or utilizing the information, floor plan CADs, pricing calculators, or contact mechanisms on this website (<strong class="text-white">mahindralifespaceshomes.in</strong>), you agree to be bound by these Terms of Use and our <a href="/privacy-policy/" class="text-gold-400 underline">Privacy Policy</a>. If you do not accept these terms, you must discontinue use of this website immediately.
        </p>
      </div>

      <!-- 2. Nature of Platform & Entity Representation -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">2. Nature of Platform &amp; Strategic Channel Partnership</h2>
        <p>
          This website is conceptualized, created, and operated exclusively by <strong class="text-white">PropSmart Realty</strong> (<strong class="text-gold-300">MahaRERA Registration No. A031262401295</strong>) in its capacity as an <strong class="text-white">Authorized Strategic Channel Partner</strong> for marketing and client acquisition on behalf of <strong class="text-white">Mahindra Lifespace Developers Limited</strong>.
        </p>
        <p>
          This website is not the corporate website of Mahindra Lifespaces Developers Limited. The corporate website of the developer is accessible at <span class="text-gold-300 font-mono">mahindralifespaces.com</span>. PropSmart Realty provides marketing, consulting, and customer concierge services to facilitate real estate transactions under MahaRERA guidelines.
        </p>
      </div>

      <!-- 3. Non-Offer & Informational Content Clause -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">3. Non-Contractual Nature of Information</h2>
        <p>
          The content on this website—including but not limited to 3D architectural renderings, virtual tours, room dimensions, floor plans, amenity descriptions, landscape visuals, price quotes, and construction milestones—is provided for preliminary informational purposes only.
        </p>
        <p>
          Nothing on this website constitutes an offer, solicitation, warranty, or binding legal contract. All transactions, allotment terms, payment schedules, and possession timelines are strictly governed by the registered Agreement for Sale executed between the buyer and Mahindra Lifespace Developers Limited in accordance with the Real Estate (Regulation and Development) Act, 2016 (RERA).
        </p>
      </div>

      <!-- 4. Intellectual Property Rights -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">4. Intellectual Property Rights</h2>
        <p>
          All corporate trademarks, brand names, logos, elevations, project names ("Mahindra Rivenza", "Mahindra Lifespaces", "Rise"), and architectural copyright materials displayed on this website belong exclusively to <strong class="text-white">Mahindra Lifespace Developers Limited</strong> or the Mahindra Group.
        </p>
        <p>
          PropSmart Realty uses these brand assets under authorized partner channel marketing rights. Users may not copy, reproduce, scrape, republish, distribute, or modify any materials, CAD diagrams, or editorial content from this website without prior written authorization.
        </p>
      </div>

      <!-- 5. Pricing, Taxes & Availability Disclaimers -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">5. Pricing, Availability &amp; Statutory Charges</h2>
        <p>
          All stated prices (e.g. "Starts ₹90 Lakhs*") are indicative base ticket sizes subject to change without prior notice. Final on-road property costs vary according to:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Specific tower selection, floor rise, and directional orientation (e.g., river view or amenity facing).</li>
          <li>Applicable government taxes and levies, including Maharashtra Stamp Duty (currently 7%), Registration fees, and Goods and Services Tax (GST at 5%).</li>
          <li>Society maintenance deposits, infrastructure charges, and clubhouse development fees as per the official developer cost sheet.</li>
          <li>Unit availability is dynamic and subject to confirmation at the time of booking.</li>
        </ul>
      </div>

      <!-- 6. MahaRERA Statutory Registrations -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">6. MahaRERA Statutory Governance</h2>
        <p>The project is developed in a phased manner under statutory approvals from MahaRERA:</p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Mahindra Rivenza Phase 1:</strong> MahaRERA Registration No. <span class="text-gold-300 font-mono font-bold">PR1261012602102</span> (Valid upto 30/12/2031).</li>
          <li><strong>Mahindra Rivenza Phase 2:</strong> MahaRERA Registration No. <span class="text-gold-300 font-mono font-bold">PM1261012602103</span> (Valid upto 30/12/2031).</li>
          <li><strong>Channel Partner Registration:</strong> PropSmart Realty MahaRERA Agent No. <span class="text-gold-300 font-mono font-bold">A031262401295</span>.</li>
          <li>All official filings can be reviewed on the official portal: <a href="https://maharera.maharashtra.gov.in" target="_blank" rel="noopener noreferrer" class="text-gold-400 underline">https://maharera.maharashtra.gov.in</a>.</li>
        </ul>
      </div>

      <!-- 7. Limitation of Liability & Dispute Resolution -->
      <div class="p-6 rounded-2xl bg-charcoal-900 border border-white/10 space-y-3">
        <h2 class="text-base font-bold text-white uppercase tracking-wider font-serif">7. Limitation of Liability &amp; Jurisdiction</h2>
        <p>
          In no event shall PropSmart Realty, its proprietors, partners, employees, or marketing consultants be liable for any direct, indirect, incidental, or consequential damages resulting from the use or inability to use this website, or any reliance placed on the information contained herein.
        </p>
        <p>
          These Terms of Use are governed by the laws of India. Any disputes arising out of or related to the use of this website shall be subject to the exclusive jurisdiction of the competent courts in <strong class="text-white">Pune, Maharashtra</strong>.
        </p>
        <div class="pt-2 text-xs font-mono text-stone-400">
          For inquiries regarding these terms, please contact: <strong class="text-white">compliance@mahindralifespaceshomes.in</strong> or phone <strong class="text-white">+91 7744009295</strong>.
        </div>
      </div>

    </div>
  </section>

  <MahindraKeywordMatrix />
</Layout>
