---
import Layout from '../../layouts/Layout.astro';
import { westPuneLocalityData, type WestPuneLocalityItem } from '../../data/pSeoWestPuneLocalities';
import RiverFlowingEmblem from '../../components/RiverFlowingEmblem.astro';

export async function getStaticPaths() {
  return westPuneLocalityData.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: WestPuneLocalityItem;
}

const { item } = Astro.props;

// Construct Schema.org JSON-LD for this specific West Pune locality page
const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/#place`,
      "name": `${item.name}, Pune`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": item.shortName,
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      }
    },
    {
      "@type": "Product",
      "@id": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/#project`,
      "name": `Mahindra Rivenza - Premium Residences near ${item.shortName}`,
      "description": `13.46-acre landmark residential development in Baner Annex / Mahalunge, offering luxury 2, 3 & 4 BHK apartments with ~44,000 sq.ft clubhouse and 9+ acres greens near ${item.shortName}, Pune. Starting ₹90 Lakhs*.`,
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "RealEstateAgent",
      "@id": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/#agent`,
      "name": `Mahindra Rivenza Advisory Desk for ${item.shortName}`,
      "legalName": "PropSmart Realty",
      "telephone": "+91 7744009295",
      "url": "https://mahindralifespaceshomes.in/",
      "areaServed": [
        { "@type": "City", "name": "Pune" },
        { "@type": "AdministrativeArea", "name": item.shortName }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/#breadcrumbs`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://mahindralifespaceshomes.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "West Pune Real Estate",
          "item": "https://mahindralifespaceshomes.in/west-pune/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${item.shortName} Real Estate`,
          "item": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": `https://mahindralifespaceshomes.in/west-pune/${item.slug}/#faq`,
      "mainEntity": item.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.a
        }
      }))
    }
  ]
};

function buildLocalityTitle(shortName: string): string {
  const c1 = `${shortName} Real Estate Pune [Starts ₹90L*] Mahindra Rivenza`;
  if (c1.length <= 64) return c1;

  const c2 = `${shortName} Real Estate [Starts ₹90L*] Mahindra Rivenza`;
  if (c2.length <= 64) return c2;

  const c3 = `${shortName} Property Rates [Starts ₹90L*] Rivenza`;
  if (c3.length <= 64) return c3;

  return `${shortName} Flats [Starts ₹90L*] Rivenza`.slice(0, 62);
}

const adaptiveTitle = buildLocalityTitle(item.shortName);
---

<Layout
  title={adaptiveTitle}
  description={item.metaDescription}
  keywords={`${item.shortName.toLowerCase()} real estate, flats in ${item.shortName.toLowerCase()}, apartments in ${item.shortName.toLowerCase()}, new projects ${item.shortName.toLowerCase()}, mahindra ${item.shortName.toLowerCase()}, mahindra lifespaces west pune, mahindra mahalunge`}
  canonical={`https://mahindralifespaceshomes.in/west-pune/${item.slug}/`}
  customSchema={pageSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Badges Row with Official Rivenza Insignia -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{item.category} • West Pune Corridor</span>
        </div>

        <div class="glass-floating inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-gold-500/30 backdrop-blur-md">
          <RiverFlowingEmblem size="xs" layout="horizontal" showSubtitle={false} />
          <span class="text-[11px] text-stone-300 font-medium border-l border-white/20 pl-2">Baner Annex • Starts ₹90L*</span>
        </div>

        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[10px] font-mono font-semibold border border-emerald-500/30">
          MahaRERA: PR1261012602102
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        {item.h1}
      </h1>

      <p class="text-stone-300 text-sm sm:text-base max-w-3xl font-light leading-relaxed">
        {item.heroHighlight}. Discover comprehensive micro-market trends, infrastructure milestones, and how the Mahindra Lifespaces Pune ecosystem connects to {item.shortName}.
      </p>

      <!-- Market Vital Badges -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 max-w-3xl">
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-gold-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Avg Rate / Sq.Ft.</span>
          <span class="font-serif text-base font-bold text-gold-400">{item.avgPricePerSqFt}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-emerald-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">5-Yr Appreciation</span>
          <span class="font-serif text-base font-bold text-emerald-400">{item.fiveYearAppreciation}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-white/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Rental Yield</span>
          <span class="font-serif text-base font-bold text-white">{item.rentalYield}</span>
        </div>
        <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-amber-500/30 transition-all">
          <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Hinjewadi Commute</span>
          <span class="font-serif text-base font-bold text-amber-300">{item.distanceToHinjewadi}</span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 pt-4">
        <button
          data-open-modal
          data-interest={`Market Report - ${item.shortName}`}
          class="btn-shimmer px-6 py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all cursor-pointer"
        >
          Download {item.shortName} Market Report & Cost Sheet
        </button>
        <button
          data-open-modal
          data-interest={`VIP Cab Tour - from ${item.shortName}`}
          class="px-6 py-3 rounded-full border border-gold-500/40 hover:border-gold-400 text-gold-300 hover:text-white font-semibold uppercase tracking-wider text-xs transition-all cursor-pointer bg-white/5"
        >
          Book VIP Cab from {item.shortName}
        </button>
        <a
          href="tel:+917744009295"
          class="px-5 py-3 rounded-full border border-white/20 hover:border-white/40 text-stone-300 hover:text-white font-medium uppercase tracking-wider text-xs transition-all inline-flex items-center gap-2"
        >
          <span>Direct: +91 7744009295</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Micro-Market Overview & Narrative -->
  <section class="py-16 bg-[#0e121a] border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Micro-Market Analysis</span>
            <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
              {item.name}: Real Estate Dynamics & Growth Drivers
            </h2>
          </div>
          
          <p class="text-stone-300 text-sm leading-relaxed font-light">
            {item.microMarketOverview}
          </p>

          <!-- Infrastructure Drivers Checklist -->
          <div class="p-6 rounded-2xl bg-charcoal-950 border border-white/10 space-y-4">
            <h3 class="font-serif text-base text-gold-300 font-bold">
              Infrastructure Catalysts Driving {item.shortName}
            </h3>
            <ul class="space-y-2.5 text-xs text-stone-300">
              {item.infrastructureCatalysts.map((catalyst) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold text-sm">✓</span>
                  <span class="leading-relaxed">{catalyst}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Mahindra Lifespaces Connection Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-2xl glass-card border border-gold-500/30 space-y-5 shadow-2xl relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-gold-500/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full bg-brand-red/20 text-brand-red text-[10px] font-bold uppercase tracking-wider border border-brand-red/30">
                Institutional Developer Impact
              </span>
              <span class="text-[10px] text-emerald-400 font-mono font-semibold">Active Bookings Live</span>
            </div>

            <!-- Official Rivenza Logo & Live River Waves in Card -->
            <div class="pt-1 flex items-center justify-between gap-4 border-b border-white/10 pb-3">
              <RiverFlowingEmblem size="sm" layout="horizontal" showSubtitle={true} />
              <span class="text-xs font-serif font-bold text-gold-400 bg-gold-500/10 px-2.5 py-1 rounded-full border border-gold-500/30 whitespace-nowrap">Starts ₹90L*</span>
            </div>

            <h3 class="font-serif text-lg text-white font-bold">
              Mahindra Rivenza: Landmark Community for {item.shortName} Buyers
            </h3>

            <p class="text-stone-300 text-xs leading-relaxed font-light">
              {item.mahindraConnection}
            </p>

            <div class="p-4 rounded-xl bg-black/40 border border-white/10 space-y-2.5 text-xs">
              <div class="flex items-center justify-between text-gold-300 font-semibold border-b border-white/10 pb-1.5">
                <span>Flagship Specifications</span>
                <span class="text-[10px] text-stone-400 font-mono">2, 3 & 4 BHK Luxury</span>
              </div>
              <ul class="text-[11px] text-stone-300 space-y-1.5">
                <li class="flex items-center gap-2">
                  <span class="text-gold-400 font-bold">•</span>
                  <span><strong>13.46-Acre Master Development</strong> in Baner Annex / Mahalunge</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-gold-400 font-bold">•</span>
                  <span><strong>9+ Acres Green Open Spaces</strong> with biophilic Miyawaki groves</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-gold-400 font-bold">•</span>
                  <span><strong>~44,000 Sq.Ft. Luxury Clubhouse</strong> with sunken bar pool & sports</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-gold-400 font-bold">•</span>
                  <span><strong>MahaRERA Registered:</strong> PR1261012602102 & PM1261012602103</span>
                </li>
              </ul>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <button
                data-open-modal
                data-interest={`VIP Site Tour - via ${item.shortName}`}
                class="w-full py-2.5 rounded-xl bg-gold-500/20 hover:bg-gold-500 border border-gold-500/40 text-gold-300 hover:text-charcoal-950 font-bold uppercase tracking-wider text-[11px] transition-all cursor-pointer text-center"
              >
                Book VIP Cab from {item.shortName}
              </button>
              <button
                data-open-modal
                data-interest={`Floor Plans & Cost - via ${item.shortName}`}
                class="w-full py-2.5 rounded-xl bg-white/5 hover:bg-white/15 border border-white/20 text-stone-200 hover:text-white font-semibold uppercase tracking-wider text-[11px] transition-all cursor-pointer text-center"
              >
                Cost Sheet & CAD Plans
              </button>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Comparative Matrix: Locality vs Mahindra Rivenza -->
  <section class="py-16 bg-[#090c12] border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Comparative Advantage</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          {item.shortName} Real Estate vs. Mahindra Rivenza Baner Annex
        </h2>
        <p class="text-xs sm:text-sm text-stone-400 font-light">
          Why discerning homeowners and investors in {item.shortName} are upgrading to Mahindra Rivenza's 13.46-acre master community.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/10 glass-card">
        <table class="w-full text-xs text-left">
          <thead class="bg-white/5 text-stone-300 font-serif uppercase tracking-wider text-[10px]">
            <tr>
              <th class="p-4 w-1/4">Evaluation Benchmark</th>
              <th class="p-4 w-3/8 text-stone-400">Typical {item.shortName} Project</th>
              <th class="p-4 w-3/8 text-gold-400 font-bold bg-gold-500/10 border-l border-gold-500/20">Mahindra Rivenza Baner Annex</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-stone-300 font-light">
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Pricing & Entry Ticket</td>
              <td class="p-4 font-mono text-stone-400">{item.avgPricePerSqFt} avg</td>
              <td class="p-4 font-mono text-gold-400 font-bold bg-gold-500/5 border-l border-gold-500/20">Starts ₹90 Lakhs* (High ROI Phase 1 Entry)</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Open Greens & Land Parcel</td>
              <td class="p-4 text-stone-400">1 to 3 acres standalone plot, 20-30% open space</td>
              <td class="p-4 text-emerald-400 font-medium bg-gold-500/5 border-l border-gold-500/20">13.46 Acres with 9+ Acres Landscaped Greens (70%+ Open)</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Clubhouse & Amenities</td>
              <td class="p-4 text-stone-400">Standard 4,000 – 10,000 sq.ft clubhouse</td>
              <td class="p-4 text-white font-medium bg-gold-500/5 border-l border-gold-500/20">~44,000 Sq.Ft. Grand Club with Sunken Bar Pool & Futsal</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Commute to IT & Metro</td>
              <td class="p-4 text-stone-400">{item.distanceToHinjewadi}</td>
              <td class="p-4 text-amber-300 font-medium bg-gold-500/5 border-l border-gold-500/20">7 mins to Hinjewadi Phase 1 via upcoming 4-lane link</td>
            </tr>
            <tr class="hover:bg-white/[0.02] transition-colors">
              <td class="p-4 font-semibold text-stone-100">Developer Pedigree</td>
              <td class="p-4 text-stone-400">Local or regional builder</td>
              <td class="p-4 text-gold-300 font-bold bg-gold-500/5 border-l border-gold-500/20">Mahindra Lifespaces (US $20+ Billion Mahindra Group)</td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- Key Advantages Grid -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Buyer Advantage</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Why Homebuyers & Investors Choose {item.shortName}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {item.keyAdvantages.map((adv, idx) => (
          <div class="p-6 rounded-2xl glass-card border border-white/10 hover:border-gold-500/30 transition-all space-y-3">
            <div class="w-8 h-8 rounded-full bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400 font-mono text-xs font-bold">
              0{idx + 1}
            </div>
            <h3 class="font-serif text-base text-stone-100 font-bold">{adv.title}</h3>
            <p class="text-xs text-stone-400 font-light leading-relaxed">{adv.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Localized FAQ Accordion -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Buyer Intelligence</span>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-50 font-bold">
          Frequently Asked Questions: {item.shortName} Real Estate
        </h2>
      </div>

      <div class="space-y-4">
        {item.faqs.map((faq) => (
          <details class="group p-5 rounded-2xl glass-card border border-white/10 open:border-gold-500/30 transition-all">
            <summary class="flex justify-between items-center cursor-pointer font-serif text-sm font-semibold text-stone-200 group-open:text-gold-300 transition-colors">
              <span>{faq.q}</span>
              <span class="text-gold-400 transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-xs text-stone-400 leading-relaxed font-light pl-1">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

      <!-- Bottom Nav -->
      <div class="pt-8 text-center flex flex-wrap items-center justify-center gap-4">
        <a
          href="/west-pune/"
          class="inline-flex items-center space-x-2 text-xs text-gold-400 hover:text-gold-300 transition-colors font-semibold uppercase tracking-wider"
        >
          <span>← Back to All West Pune Micro-Markets</span>
        </a>
        <span class="text-stone-600">•</span>
        <a
          href="/pune-real-estate/"
          class="inline-flex items-center space-x-2 text-xs text-stone-400 hover:text-gold-300 transition-colors font-semibold uppercase tracking-wider"
        >
          <span>Pune Real Estate Dominance Hub →</span>
        </a>
      </div>

    </div>
  </section>
</Layout>
