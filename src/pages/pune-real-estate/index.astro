---
import Layout from '../../layouts/Layout.astro';
import { westPuneLocalityData } from '../../data/pSeoWestPuneLocalities';
import ProgrammaticHubDirectory from '../../components/ProgrammaticHubDirectory.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const marketSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/pune-real-estate/#webpage",
      "url": "https://mahindralifespaceshomes.in/pune-real-estate/",
      "name": "Pune Real Estate Market 2026: Property Prices, Micro-Markets & Investment Guide",
      "description": "Comprehensive authority guide to Pune real estate in 2026. Explore property price trends across 44 micro-markets, rental yields, PMRDA infrastructure, and Mahindra Rivenza Baner Annex.",
      "publisher": {
        "@type": "Organization",
        "name": "Mahindra Rivenza",
        "url": "https://mahindralifespaceshomes.in/"
      },
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["h1", "h2", "p"]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
        { "@type": "ListItem", "position": 2, "name": "Pune Real Estate", "item": "https://mahindralifespaceshomes.in/pune-real-estate/" }
      ]
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/pune-real-estate/#residential-market",
      "name": "Pune Real Estate Residential Property Index 2026",
      "description": "Comprehensive market valuation and price trends for luxury apartments and gated communities across Pune. Benchmark project: Mahindra Rivenza Baner Annex starting ₹90 Lakhs*.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "review": [
        {
          "@type": "Review",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5"
          },
          "author": {
            "@type": "Person",
            "name": "Rohan Deshmukh"
          },
          "reviewBody": "Mahindra Rivenza is hands down the best investment in West Pune. 9+ acres of greens and just 7 minutes to Hinjewadi Phase 1 via the Mula river bridge."
        }
      ],
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock"
      }
    },
    {
      "@type": "Table",
      "about": "Pune Real Estate Micro-Market Price Index 2026"
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/pune-real-estate/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which area in Pune offers the highest real estate capital appreciation in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahalunge (Baner Annex) and the Nande corridor lead Pune with 12% to 15% annualized capital appreciation, driven by PMRDA Town Planning Scheme 1, the Hinjewadi-Mahalunge river bridge, and 36m wide DP road infrastructure."
          }
        },
        {
          "@type": "Question",
          "name": "What is the average residential property price per sq.ft. in Pune in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Property prices in Pune range from ₹6,800 - ₹8,500/sq.ft. in high-growth tech corridors (Mahalunge, Tathawade, Ravet), ₹9,500 - ₹13,500/sq.ft. in established hubs (Baner, Wakad, Balewadi), and ₹15,000 - ₹22,000+/sq.ft. in central luxury enclaves (Model Colony, Kothrud, Senapati Bapat Road)."
          }
        },
        {
          "@type": "Question",
          "name": "Why is West Pune the most preferred real estate investment destination in Maharashtra?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "West Pune houses Rajiv Gandhi Infotech Park in Hinjewadi (employing over 400,000 tech professionals), direct access to Mumbai-Pune Expressway, Pune Metro Line 3, and top international schools, generating consistent 4.5% to 5.4% rental yields and rapid capital gains."
          }
        }
      ]
    }
  ]
};

const corridors = [
  { name: "All Corridors", cat: "all" },
  { name: "West Pune IT Hub", cat: "High-Growth Flagship Corridor" },
  { name: "Tech Fringe & Expressway", cat: "High-Growth Tech Corridor" },
  { name: "Expressway Gateway", cat: "Expressway Gateway Corridor" },
  { name: "Central Elite Enclaves", cat: "Central Elite Enclave" },
  { name: "East Pune Tech Mega-Hub", cat: "East Pune IT Mega-Hub" }
];
---

<Layout
  title="Pune Real Estate 2026 [Property Rates & Investment Guide]"
  description="Definitive 2026 guide to Pune real estate market. Property rates across 44 micro-markets, PMRDA infrastructure & Mahindra Rivenza Baner Annex from ₹90L*."
  canonical="https://mahindralifespaceshomes.in/pune-real-estate/"
  customSchema={marketSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Market Intelligence • 2026 Comprehensive Evaluation</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
        Pune Real Estate Market: <br />
        <span class="gold-gradient-text">Micro-Market Price Index &amp; Growth Guide</span>
      </h1>
      
      <p class="text-stone-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Authoritative evaluation of real estate valuations, rental yields, and infrastructure catalysts across 44 micro-markets in Pune, PCMC, and West Pune. Discover why Baner Annex (Mahalunge) is the epicenter of capital growth.
      </p>

      <!-- Key Market Macro Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4">
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Micro-Markets</div>
          <div class="text-2xl font-bold text-gold-300 mt-1">{westPuneLocalityData.length} Analyzed</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Avg Tech Yield</div>
          <div class="text-2xl font-bold text-emerald-400 mt-1">4.5% - 5.4%</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Hinjewadi Techies</div>
          <div class="text-2xl font-bold text-sky-400 mt-1">400,000+</div>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-mono">Top Growth Corridor</div>
          <div class="text-sm font-semibold text-white mt-1">Mahalunge Baner Annex</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Locality Directory Section -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6">
        <div>
          <span class="text-xs font-mono uppercase text-gold-400 tracking-wider font-bold">Pune Property Price Index</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-white mt-1">Explore 44 Pune &amp; PCMC Localities</h2>
        </div>
        <!-- Search Filter Input -->
        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="locality-search"
            placeholder="Search locality (e.g. Baner, Wakad)..."
            class="w-full px-4 py-2.5 rounded-xl bg-charcoal-900 border border-white/10 text-xs text-stone-200 placeholder-stone-500 focus:outline-none focus:border-gold-400 transition-colors"
          />
          <svg class="w-4 h-4 text-stone-400 absolute right-3.5 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>

      <!-- Localities Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="localities-grid">
        {westPuneLocalityData.map((item) => (
          <a
            href={`/west-pune/${item.slug}/`}
            class="locality-card bg-charcoal-900/80 border border-white/10 hover:border-gold-400/50 rounded-2xl p-6 backdrop-blur-sm transition-all duration-300 flex flex-col justify-between group shadow-xl hover:-translate-y-1"
            data-name={item.name.toLowerCase()}
            data-short={item.shortName.toLowerCase()}
            data-cat={item.category.toLowerCase()}
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-300 text-[10px] font-bold font-mono uppercase tracking-wider">
                  {item.shortName}
                </span>
                <span class="text-xs text-emerald-400 font-mono font-semibold">
                  {item.fiveYearAppreciation}
                </span>
              </div>

              <h3 class="font-serif text-lg font-bold text-white group-hover:text-gold-200 transition-colors line-clamp-1">
                {item.name}
              </h3>

              <p class="text-stone-300 text-xs line-clamp-2 leading-relaxed">
                {item.microMarketOverview}
              </p>

              <div class="grid grid-cols-2 gap-2 pt-2 text-[11px] font-mono border-t border-white/5">
                <div>
                  <span class="text-stone-500 block">Avg Rate:</span>
                  <span class="text-stone-200 font-semibold">{item.avgPricePerSqFt}</span>
                </div>
                <div>
                  <span class="text-stone-500 block">Rental Yield:</span>
                  <span class="text-stone-200 font-semibold">{item.rentalYield}</span>
                </div>
              </div>
            </div>

            <div class="pt-4 mt-4 border-t border-white/10 flex items-center justify-between text-xs text-gold-400 font-semibold group-hover:translate-x-1 duration-200">
              <span>View Property Dossier</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Comprehensive Pune Micro-Market Comparative Dominance Matrix -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 border border-gold-500/30 space-y-6 shadow-2xl">
        <div class="space-y-2">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest font-mono">
            <span>2026 Head-to-Head Micro-Market Benchmark</span>
          </div>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">
            Pune Real Estate Price & Lifestyle Comparison Matrix
          </h3>
          <p class="text-stone-300 text-xs sm:text-sm font-light leading-relaxed">
            Directly benchmarking Mahindra Rivenza at Baner Annex against established West & East Pune investment hubs. Discover why Baner Annex delivers superior capital growth and resort lifestyle.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs">
            <thead>
              <tr class="border-b border-white/10 text-stone-400 uppercase tracking-wider font-mono text-[10px]">
                <th class="py-3.5 px-4 font-semibold">Micro-Market</th>
                <th class="py-3.5 px-4 font-semibold">Avg Rate / Sq.Ft</th>
                <th class="py-3.5 px-4 font-semibold">2 BHK Entry</th>
                <th class="py-3.5 px-4 font-semibold">Master Parcel & Greens</th>
                <th class="py-3.5 px-4 font-semibold">Clubhouse Scale</th>
                <th class="py-3.5 px-4 font-semibold">Hinjewadi Commute</th>
                <th class="py-3.5 px-4 font-semibold">Investment Verdict</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 font-light">
              <!-- #1 BENCHMARK: Mahindra Rivenza -->
              <tr class="bg-gold-500/10 border-l-4 border-l-gold-400 font-medium">
                <td class="py-4 px-4 font-bold text-gold-300 whitespace-nowrap">
                  <a href="/mahindra-rivenza/" class="hover:underline">Mahindra Rivenza</a>
                  <span class="block text-[10px] text-emerald-400 font-mono">★ #1 Ranked Flagship 2026</span>
                </td>
                <td class="py-4 px-4 text-stone-100 font-mono font-semibold">₹7,200 – ₹8,500</td>
                <td class="py-4 px-4 text-gold-300 font-mono font-bold">Starts ₹90L*</td>
                <td class="py-4 px-4 text-stone-200">13.46 Acres (9+ Acres Biophilic Greens)</td>
                <td class="py-4 px-4 text-stone-200 font-semibold">~44,000 Sq.Ft (Sunken Aqua Bar)</td>
                <td class="py-4 px-4 text-emerald-300 font-mono">4 – 7 Mins (River Bridge)</td>
                <td class="py-4 px-4">
                  <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[10px] font-bold">Strong Buy (12-15% CAGR)</span>
                </td>
              </tr>
              <!-- Baner Core -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-baner/" class="hover:text-gold-300 hover:underline">Baner (Core)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Balewadi High St Belt</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹11,500 – ₹14,500</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹1.45 Cr – ₹1.85 Cr</td>
                <td class="py-3.5 px-4 text-stone-400">1 – 3 Acres (High Density)</td>
                <td class="py-3.5 px-4 text-stone-400">8,000 – 15,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-amber-300 font-mono">25 – 35 Mins (Peak Traffic)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-white/5 text-stone-400 font-mono text-[10px]">Saturated (4-6% CAGR)</span></td>
              </tr>
              <!-- Hinjewadi Phase 1 -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-hinjewadi/" class="hover:text-gold-300 hover:underline">Hinjewadi Phase 1</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Infosys / Wipro Circle</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹7,800 – ₹9,200</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹85L – ₹1.05 Cr</td>
                <td class="py-3.5 px-4 text-stone-400">2 – 5 Acres (Commercial Enclave)</td>
                <td class="py-3.5 px-4 text-stone-400">10,000 – 18,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-emerald-300 font-mono">0 – 5 Mins (Walking Distance)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-sky-500/10 text-sky-300 font-mono text-[10px]">High Rental Yield (5.2%)</span></td>
              </tr>
              <!-- Mahalunge -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/mahalunge-pune/" class="hover:text-gold-300 hover:underline">Mahalunge (PMRDA TP 1)</a>
                  <span class="block text-[10px] text-emerald-400 font-mono">Model Town Planning Scheme</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹7,500 – ₹8,800</td>
                <td class="py-3.5 px-4 text-gold-300 font-mono font-bold">Starts ₹90L*</td>
                <td class="py-3.5 px-4 text-stone-400">13.46 Acres (Institutional Master Plan)</td>
                <td class="py-3.5 px-4 text-stone-400">~44,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-emerald-300 font-mono">4 – 7 Mins (Direct River Bridge)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono text-[10px]">High Appreciation (12-15%)</span></td>
              </tr>
              <!-- Balewadi -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-balewadi/" class="hover:text-gold-300 hover:underline">Balewadi (High Street)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Sports City & Lifestyle</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹12,000 – ₹16,000</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹1.60 Cr – ₹2.10 Cr</td>
                <td class="py-3.5 px-4 text-stone-400">2 – 6 Acres (Mixed Entertainment)</td>
                <td class="py-3.5 px-4 text-stone-400">15,000 – 25,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-amber-300 font-mono">18 – 25 Mins (via Balewadi Link)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-white/5 text-stone-400 font-mono text-[10px]">Premium Lifestyle (5-7% CAGR)</span></td>
              </tr>
              <!-- Wakad -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-wakad/" class="hover:text-gold-300 hover:underline">Wakad (Datta Mandir)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Bhumkar Chowk Hub</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹8,800 – ₹11,000</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹1.10 Cr – ₹1.35 Cr</td>
                <td class="py-3.5 px-4 text-stone-400">1 – 4 Acres (Urban Clutter)</td>
                <td class="py-3.5 px-4 text-stone-400">12,000 – 20,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-amber-300 font-mono">15 – 22 Mins (Highway Bottleneck)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-white/5 text-stone-400 font-mono text-[10px]">Moderate Hold (6-8% CAGR)</span></td>
              </tr>
              <!-- Pashan -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-pashan/" class="hover:text-gold-300 hover:underline">Pashan (Sus Road / Lake)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Green Residential Enclave</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹9,200 – ₹12,000</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹1.20 Cr – ₹1.55 Cr</td>
                <td class="py-3.5 px-4 text-stone-400">1 – 3 Acres (Narrow Access)</td>
                <td class="py-3.5 px-4 text-stone-400">6,000 – 12,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-amber-300 font-mono">20 – 30 Mins (Pashan-Bavdhan Jam)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-white/5 text-stone-400 font-mono text-[10px]">Steady Demand (6-7% CAGR)</span></td>
              </tr>
              <!-- Tathawade -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/flats-near-tathawade/" class="hover:text-gold-300 hover:underline">Tathawade (Expressway)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">JSPM / Indira Education Belt</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹7,200 – ₹8,800</td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹78L – ₹98L</td>
                <td class="py-3.5 px-4 text-stone-400">2 – 5 Acres (Mixed Residential)</td>
                <td class="py-3.5 px-4 text-stone-400">8,000 – 15,000 Sq.Ft</td>
                <td class="py-3.5 px-4 text-amber-300 font-mono">15 – 25 Mins (Expressway Traffic)</td>
                <td class="py-3.5 px-4"><span class="px-2 py-0.5 rounded bg-white/5 text-stone-400 font-mono text-[10px]">Moderate Growth (7-9% CAGR)</span></td>
              </tr>
              <!-- Bavdhan -->
              <tr class="hover:bg-white/[0.02] transition-colors">
                <td class="py-3.5 px-4 font-semibold text-stone-200 whitespace-nowrap">
                  <a href="/west-pune/mahindra-rivenza-bavdhan-connectivity-hub/" class="hover:text-gold-300 hover:underline">Bavdhan (Chandani Chowk)</a>
                  <span class="block text-[10px] text-stone-500 font-mono">Kothrud Gateway Belt</span>
                </td>
                <td class="py-3.5 px-4 text-stone-300 font-mono">₹9,000 – ₹11,500</td>
