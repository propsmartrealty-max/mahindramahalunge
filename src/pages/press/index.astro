---
import Layout from '../../layouts/Layout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://mahindralifespaceshomes.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Press Room",
      "item": "https://mahindralifespaceshomes.in/press/"
    }
  ]
};

const pressRoomSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "Mahindra Rivenza Press Room & Digital Media Kit: Baner Annex Flagship Community",
  "image": [
    "https://mahindralifespaceshomes.in/images/official/mahindra-rivenza-architectural-elevation.webp"
  ],
  "datePublished": "2026-10-20T09:00:00+05:30",
  "dateModified": new Date().toISOString(),
  "author": {
    "@type": "Organization",
    "name": "PropSmart Realty Partner Advisory Desk",
    "url": "https://mahindralifespaceshomes.in/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Mahindra Rivenza Authorized Showcase",
    "logo": {
      "@type": "ImageObject",
      "url": "https://mahindralifespaceshomes.in/apple-touch-icon.png"
    }
  },
  "description": "Official press kit, high-resolution media assets, statutory MahaRERA certificates, and press releases for Mahindra Rivenza at Baner Annex, Mahalunge, Pune."
};
---

<Layout
  title="Mahindra Rivenza Press Room & Media Kit | Baner Annex Pune"
  description="Official press room, syndicated media assets, MahaRERA certificates (PR1261012602102), and brand guidelines for Mahindra Rivenza Baner Annex."
  canonicalUrl="https://mahindralifespaceshomes.in/press/"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(pressRoomSchema)} />

  <main class="min-h-screen bg-slate-950 text-slate-100 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-12">
      
      <!-- Header -->
      <header class="text-center space-y-4">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Official Digital Press Center & Media Kit
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight">
          Mahindra Rivenza <span class="text-emerald-400">Press Room</span>
        </h1>
        <p class="max-w-3xl mx-auto text-base sm:text-lg text-slate-300">
          Curated editorial assets, verified MahaRERA documentation, architectural elevation renderings, and syndication resources for journalists, media editors, and real estate researchers.
        </p>
      </header>

      <!-- Quick Entity Citation Box -->
      <section class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-xl">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Verified NAP & Editorial Citation Standard
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-300">
          <div class="space-y-2">
            <p><strong class="text-white">Project Name:</strong> Mahindra Rivenza</p>
            <p><strong class="text-white">Developer:</strong> Mahindra Lifespace Developers Limited</p>
            <p><strong class="text-white">Advisory Partner:</strong> PropSmart Realty (Authorized Channel Partner)</p>
            <p><strong class="text-white">Location:</strong> Baner Annex, Mahalunge, Off Baner-Hinjawadi Road, Pune 412115</p>
            <p><strong class="text-white">Coordinates:</strong> 18.562313° N, 73.727313° E</p>
          </div>
          <div class="space-y-2">
            <p><strong class="text-white">MahaRERA Phase 1:</strong> PR1261012602102</p>
            <p><strong class="text-white">MahaRERA Phase 2:</strong> PM1261012602103</p>
            <p><strong class="text-white">Official Partner Helpline:</strong> <a href="tel:+917744009295" class="text-emerald-400 hover:underline">+91 7744009295</a></p>
            <p><strong class="text-white">Canonical Showcase:</strong> <a href="https://mahindralifespaceshomes.in/" class="text-emerald-400 hover:underline">https://mahindralifespaceshomes.in/</a></p>
            <p><strong class="text-white">Machine Media Kit:</strong> <a href="/syndication/mahindra-rivenza-baner-annex-media-kit.json" class="text-amber-400 hover:underline">Download JSON Kit</a></p>
          </div>
        </div>
      </section>

      <!-- Global Off-Page SEO & Programmatic Syndication Package -->
      <section class="bg-gradient-to-r from-emerald-950/30 via-slate-900 to-slate-900 border border-emerald-500/30 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl">
        <div class="space-y-2">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Automated Off-Page Ingestion Kit
          </span>
          <h2 class="text-2xl font-bold text-white">Global PR, Directory &amp; Syndication Ingestion Packages</h2>
          <p class="text-slate-300 text-sm max-w-3xl leading-relaxed">
            Standardized distribution packages formatted for automated ingestion into global PR wires (AP News, PR Newswire, Bloomberg), real estate directories (BrightLocal, Yext), Web 2.0 syndication networks (Medium, Substack, LinkedIn), and real estate forums.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
          <a href="/syndication/global-injection/global-press-release-wire.md" download class="p-4 rounded-xl bg-slate-950/80 border border-emerald-500/20 hover:border-emerald-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-bold">Newswire Standard</div>
              <div class="text-sm font-bold text-white mt-1 group-hover:text-emerald-300 transition-colors">Global Press Release</div>
              <p class="text-xs text-slate-400 mt-1">AP/Bloomberg-ready wire release with pre-embedded backlinks.</p>
            </div>
            <span class="text-xs font-semibold text-emerald-400 mt-4 inline-flex items-center gap-1">Download .MD &rarr;</span>
          </a>

          <a href="/syndication/global-injection/global-directory-citations.csv" download class="p-4 rounded-xl bg-slate-950/80 border border-emerald-500/20 hover:border-emerald-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-xs font-mono text-amber-400 uppercase tracking-wider font-bold">Bulk Directory CSV</div>
              <div class="text-sm font-bold text-white mt-1 group-hover:text-amber-300 transition-colors">Directory Citations</div>
              <p class="text-xs text-slate-400 mt-1">60+ platform NAP entries for BrightLocal, Yext &amp; Whitespark.</p>
            </div>
            <span class="text-xs font-semibold text-amber-400 mt-4 inline-flex items-center gap-1">Download .CSV &rarr;</span>
          </a>

          <a href="/syndication/global-injection/global-syndication-blogs.json" download class="p-4 rounded-xl bg-slate-950/80 border border-emerald-500/20 hover:border-emerald-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-xs font-mono text-sky-400 uppercase tracking-wider font-bold">Web 2.0 Articles</div>
              <div class="text-sm font-bold text-white mt-1 group-hover:text-sky-300 transition-colors">5 Deep-Dive Blogs</div>
              <p class="text-xs text-slate-400 mt-1">1,200+ word publication-ready articles for Medium &amp; Substack.</p>
            </div>
            <span class="text-xs font-semibold text-sky-400 mt-4 inline-flex items-center gap-1">Download .JSON &rarr;</span>
          </a>

          <a href="/syndication/global-injection/global-forum-qa-injections.json" download class="p-4 rounded-xl bg-slate-950/80 border border-emerald-500/20 hover:border-emerald-500/50 transition-all flex flex-col justify-between group">
            <div>
              <div class="text-xs font-mono text-purple-400 uppercase tracking-wider font-bold">Community Q&amp;A</div>
              <div class="text-sm font-bold text-white mt-1 group-hover:text-purple-300 transition-colors">Forum Injections</div>
              <p class="text-xs text-slate-400 mt-1">Authority answers for Quora, Reddit, IREF &amp; SkyscraperCity.</p>
            </div>
            <span class="text-xs font-semibold text-purple-400 mt-4 inline-flex items-center gap-1">Download .JSON &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Press Releases -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-white">Press Releases & Editorial Wire</h2>
        
        <article class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sm:p-8 space-y-4 hover:border-slate-700 transition">
          <div class="flex items-center justify-between text-xs text-slate-400 border-b border-slate-800 pb-3">
            <span class="text-emerald-400 font-semibold uppercase tracking-wider">Official Wire Release</span>
            <span>Published: October 2026 • Pune, India</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white">
            Mahindra Lifespaces Commences Priority Allotments for 13.46-Acre Landmark 'Mahindra Rivenza' at Baner Annex
          </h3>
          <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
            <strong>PUNE, MAHARASHTRA</strong> — Marking a major urban expansion in West Pune’s golden growth triangle, Mahindra Lifespaces has officially launched priority allotments for its ₹3,500 Cr GDV master community, <a href="https://mahindralifespaceshomes.in/mahindra-rivenza/baner-annex/" class="text-emerald-400 hover:underline">Mahindra Rivenza at Baner Annex</a>. Spanning 13.46 acres with over 70% biophilic open greens, the project introduces 1,236 residences in Phase 1 with prices starting from ₹90 Lakhs*.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="https://mahindralifespaceshomes.in/pricing/" class="inline-flex items-center text-xs font-semibold px-4 py-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 transition">
              View Price Breakdown &rarr;
            </a>
            <a href="https://mahindralifespaceshomes.in/floor-plans/" class="inline-flex items-center text-xs font-semibold px-4 py-2 rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700 transition">
              Sanctioned Floor Plans &rarr;
            </a>
            <a href="https://mahindralifespaceshomes.in/amenities/" class="inline-flex items-center text-xs font-semibold px-4 py-2 rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700 transition">
              50+ Amenities Directory &rarr;
            </a>
          </div>
        </article>
      </section>

      <!-- Media Assets Gallery -->
      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-white">High-Resolution Media Assets</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden group">
            <img 
              src="https://mahindralifespaceshomes.in/images/official/mahindra-rivenza-architectural-elevation.webp" 
              alt="Mahindra Rivenza Architectural Elevation" 
              class="w-full h-48 object-cover group-hover:scale-105 transition duration-300"
              loading="lazy"
            />
            <div class="p-4 space-y-2">
              <h4 class="font-semibold text-white text-sm">13.46-Acre Landmark Elevation</h4>
              <p class="text-xs text-slate-400">High-res WebP • Official biophilic architectural render</p>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden group">
            <img 
              src="https://mahindralifespaceshomes.in/images/official/swimming-pool-sunken-aqua-bar.webp" 
              alt="Mahindra Rivenza Resort Pool & Sunken Bar" 
              class="w-full h-48 object-cover group-hover:scale-105 transition duration-300"
              loading="lazy"
            />
            <div class="p-4 space-y-2">
              <h4 class="font-semibold text-white text-sm">Resort Pool & Sunken Aqua Bar</h4>
              <p class="text-xs text-slate-400">High-res WebP • Aquatics zone highlight</p>
            </div>
          </div>

          <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden group">
            <img 
              src="https://mahindralifespaceshomes.in/images/official/multipurpose-sports-arena.webp" 
              alt="Mahindra Rivenza Sports Court" 
              class="w-full h-48 object-cover group-hover:scale-105 transition duration-300"
              loading="lazy"
            />
            <div class="p-4 space-y-2">
              <h4 class="font-semibold text-white text-sm">Multipurpose Sports Championship Court</h4>
              <p class="text-xs text-slate-400">High-res WebP • Athletics amenities</p>
            </div>
          </div>

        </div>
      </section>

      <!-- Media Contact CTA -->
      <section class="bg-gradient-to-r from-emerald-950/40 via-slate-900 to-slate-900 border border-emerald-500/20 rounded-2xl p-8 text-center space-y-4">
        <h3 class="text-2xl font-bold text-white">Media Inquiries & Site Visit Accreditations</h3>
        <p class="text-slate-300 max-w-2xl mx-auto text-sm sm:text-base">
          For interview requests, architectural dossiers, or high-resolution CAD layout packages, contact the partner advisory desk.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="tel:+917744009295" class="inline-flex items-center px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold transition">
            Call +91 7744009295
          </a>
          <a href="https://wa.me/917744009295?text=Hello%2C%20requesting%20the%20official%20media%20kit%20and%20press%20release%20for%20Project%3A%20Mahindra%20Rivenza%20(Mahalunge%20%2F%20Baner%20Annexe%2C%20Pune)." class="inline-flex items-center px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold transition">
            WhatsApp Media Desk
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
