---
import Layout from '../../layouts/Layout.astro';

const luxurySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://mahindralifespaceshomes.in/luxury-apartments-in-pune/#webpage",
      "url": "https://mahindralifespaceshomes.in/luxury-apartments-in-pune/",
      "name": "Luxury Apartments in Pune: 3 & 4 BHK Sky Villas & Resort Living",
      "description": "Explore ultra-luxury residential apartments in Pune. 3 & 4 BHK sky villas with 270° river and hill panoramas, resort swimming pool with sunken bar, and ~44,000 sq.ft clubhouse at Mahindra Rivenza.",
      "publisher": {
        "@type": "Organization",
        "name": "Mahindra Rivenza",
        "url": "https://mahindralifespaceshomes.in/"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/luxury-apartments-in-pune/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What defines true luxury real estate in Pune in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "True luxury is defined by low-density master land parcels (13.46 acres with over 80% open biophilic greens), extensive resort amenities (~44,000 sq.ft clubhouse, temperature-regulated pool with sunken aqua bar, championship sports courts), expansive wrap-around sundeck balconies, and IGBC Gold Net Zero sustainability."
          }
        },
        {
          "@type": "Question",
          "name": "What is the price of 3 and 4 BHK luxury apartments at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "At Mahindra Rivenza Baner Annex (Mahalunge), 3 BHK Deluxe and Ultra Luxury residences range from ₹1.31 Cr to ₹1.60 Cr*, while palatial 4 BHK Sky Villas range from ₹2.20 Cr to ₹2.55 Cr*."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Luxury Apartments in Pune | 3 & 4 BHK Sky Residences"
  description="Ultra-luxury apartments in Pune. Discover 3 & 4 BHK sky residences at Mahindra Rivenza Baner Annex. Sunken aqua bar, 40+ resort amenities, river & hill views from ₹1.31 Cr*."
  canonical="https://mahindralifespaceshomes.in/luxury-apartments-in-pune/"
  customSchema={luxurySchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Signature Living • 13.46-Acre Sanctuary</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
        Luxury Apartments in Pune: <br />
        <span class="gold-gradient-text">3 &amp; 4 BHK Sky Residences &amp; Penthouses</span>
      </h1>
      
      <p class="text-stone-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Elevate your lifestyle with uncompromised architectural grandeur. Featuring double-height living salons, panoramic sundecks overlooking the Mula River, and a 44,000 sq.ft clubhouse at Mahindra Rivenza Baner Annex.
      </p>
    </div>
  </section>

  <!-- Luxury Hallmarks Grid -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-8 backdrop-blur-sm space-y-4">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-white">80% Biophilic Open Greens</h3>
          <p class="text-stone-300 text-sm leading-relaxed">
            Over 9 acres of dedicated botanical gardens, vehicle-free walking boulevards, and reflexology trails designed to lower ambient temperatures naturally.
          </p>
        </div>

        <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-8 backdrop-blur-sm space-y-4">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-white">Sunken Aqua Bar Pool</h3>
          <p class="text-stone-300 text-sm leading-relaxed">
            Pune’s signature residential swimming pool with submerged sun loungers, sunken aqua bar, temperature regulation, and dedicated kids splash lagoons.
          </p>
        </div>

        <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-8 backdrop-blur-sm space-y-4">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-gold-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2z" />
            </svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-white">Net Zero Waste IGBC Gold</h3>
          <p class="text-stone-300 text-sm leading-relaxed">
            Constructed with 100% rainwater harvesting, rooftop solar power generation, non-toxic low-VOC paints, and advanced sewage treatment plants.
          </p>
        </div>
      </div>

      <!-- Action Banner -->
      <div class="bg-gradient-to-r from-charcoal-900 via-charcoal-800 to-charcoal-900 border border-gold-400/30 rounded-2xl p-8 sm:p-10 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-xs font-mono uppercase text-gold-400 tracking-widest font-bold">Luxury Show Residence Experience</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">Walk Through the 4 BHK Show Residence</h3>
          <p class="text-stone-300 text-sm max-w-xl leading-relaxed">
            Visit our on-site sales gallery at Baner Annex (Mahalunge) to experience the finishes, natural light, and ceiling clearances firsthand.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="tel:+917744009295"
            class="px-6 py-3.5 rounded-lg bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-sm transition-all shadow-lg text-center"
          >
            VIP Site Tour: +91 7744009295
          </a>
          <a
            href="/residences/4-bhk/"
            class="px-6 py-3.5 rounded-lg bg-white/10 hover:bg-white/15 border border-white/20 text-white font-medium text-sm transition-all text-center"
          >
            View 4 BHK Sky Villas
          </a>
        </div>
      </div>

      <!-- Visible FAQ Section matching FAQPage Schema -->
      <div class="pt-8 border-t border-white/10 space-y-6">
        <div class="space-y-1">
          <span class="text-xs font-mono uppercase text-gold-400 tracking-widest font-bold">Frequently Asked Questions</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">Luxury Apartments in Pune FAQs</h3>
        </div>

        <div class="space-y-4">
          <details class="group bg-charcoal-900/90 border border-white/10 rounded-xl p-5 open:border-gold-500/40 transition-all cursor-pointer">
            <summary class="font-serif text-base font-semibold text-stone-100 flex items-center justify-between group-hover:text-gold-300">
              <span>What defines true luxury real estate in Pune in 2026?</span>
              <span class="text-gold-400 group-open:rotate-180 transition-transform ml-2">▼</span>
            </summary>
            <p class="text-stone-300 text-sm leading-relaxed mt-3 pt-3 border-t border-white/5 font-light">
              True luxury is defined by low-density master land parcels (13.46 acres with over 80% open biophilic greens), extensive resort amenities (~44,000 sq.ft clubhouse, temperature-regulated pool with sunken aqua bar, championship sports courts), expansive wrap-around sundeck balconies, and IGBC Gold Net Zero sustainability.
            </p>
          </details>

          <details class="group bg-charcoal-900/90 border border-white/10 rounded-xl p-5 open:border-gold-500/40 transition-all cursor-pointer">
            <summary class="font-serif text-base font-semibold text-stone-100 flex items-center justify-between group-hover:text-gold-300">
              <span>What is the price of 3 and 4 BHK luxury apartments at Mahindra Rivenza?</span>
              <span class="text-gold-400 group-open:rotate-180 transition-transform ml-2">▼</span>
            </summary>
            <p class="text-stone-300 text-sm leading-relaxed mt-3 pt-3 border-t border-white/5 font-light">
              At Mahindra Rivenza Baner Annex (Mahalunge), 3 BHK Deluxe and Ultra Luxury residences range from ₹1.31 Cr to ₹1.60 Cr*, while palatial 4 BHK Sky Villas range from ₹2.20 Cr to ₹2.55 Cr*.
            </p>
          </details>
        </div>
      </div>

    </div>
  </section>
</Layout>
