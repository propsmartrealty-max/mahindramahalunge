---
import Layout from '../layouts/Layout.astro';
import ResidenceSelector from '../components/ResidenceSelector.astro';
import MasterPlanViewer from '../components/MasterPlanViewer.astro';
import RoiEmiCalculator from '../components/RoiEmiCalculator.astro';
import CommuteDistanceMatrix from '../components/CommuteDistanceMatrix.astro';

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Mahindra Mahalunge by Mahindra Lifespaces?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mahindra Mahalunge is an upcoming 13.46-acre landmark residential master development by Mahindra Lifespaces Developers Ltd., announced in October 2025 with an estimated GDV potential of ~₹3,500 Crore. Located in the Nande–Mahalunge corridor near Hinjewadi and Baner, it offers future-ready sustainable 2, 3 & 4 BHK residences."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Mahindra Lifespaces Mahalunge located in Pune?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mahindra Lifespaces Mahalunge is strategically located on Nande-Mahalunge Road, Mulshi Taluka, Pune, Maharashtra (Pin Code 411045), directly connected to Hinjewadi Phase 1 IT Park (7-10 mins) and Balewadi High Street (8-12 mins) via the proposed 36-meter wide PMRDA DP road."
      }
    },
    {
      "@type": "Question",
      "name": "Is Mahindra Mahalunge currently registered with MahaRERA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The project is in its statutory planning and approval phase following land acquisition in October 2025. Official MahaRERA registration will be secured prior to any commercial bookings or launch in complete compliance with Real Estate Regulatory Authority standards."
      }
    },
    {
      "@type": "Question",
      "name": "What flat configurations are available at Mahindra Lifespaces Mahalunge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mahindra Lifespaces Mahalunge offers thoughtfully designed 2 BHK Optima Suites (785-895 sq.ft.), 3 BHK Luxe Residences (1,120-1,210 sq.ft.), and 4 BHK Signature Estates (1,650-1,820 sq.ft.) built to IGBC green building standards."
      }
    },
    {
      "@type": "Question",
      "name": "What is the expected price range for flats at Mahindra Mahalunge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Indicative pre-launch pricing at Mahindra Mahalunge starts from approximately ₹65 Lakhs for 2 BHK, ₹1.05 - ₹1.4 Crore for 3 BHK, and ₹2.2 - ₹3.2 Crore for 4 BHK luxury residences. Official pricing will be released upon statutory sanctions."
      }
    },
    {
      "@type": "Question",
      "name": "How close is Mahindra Lifespaces Mahalunge to Hinjewadi IT Park and Baner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mahindra Mahalunge is just 3.2 km (7-10 minutes) from Hinjewadi Phase 1 IT Park (Wipro, Infosys, Cognizant) and approximately 4.6 km (8-12 minutes) from Balewadi High Street and Baner."
      }
    },
    {
      "@type": "Question",
      "name": "How can I download the Mahindra Mahalunge brochure and floor plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can request the comprehensive project brochure, concept floor plans, and cost sheet for Mahindra Lifespaces Mahalunge by registering an Expression of Interest (EOI) on this official showcase."
      }
    }
  ]
};
---

<Layout
  title="Mahindra Mahalunge | Mahindra Lifespaces Mahalunge Pune - 2, 3 & 4 BHK Official Overview"
  description="Official overview of Mahindra Mahalunge by Mahindra Lifespaces Mahalunge, Pune. Explore the 13.46-acre master development with luxury 2, 3 & 4 BHK residences, floor plans, pre-launch price sheet, location map & PMRDA connectivity."
  canonical="https://mahindralifespaceshomes.in/"
  customSchema={homepageFaqSchema}
>
  <!-- 01 CINEMATIC HERO SECTION (Luminous & Vibrant) -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24 pb-20">
    <!-- Cinematic Radiant Background with Multi-Layer Glow -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=88"
        alt="Mahindra Mahalunge - Mahindra Lifespaces Mahalunge Architecture"
        class="w-full h-full object-cover object-center filter brightness-[0.78] contrast-[1.08] saturate-[1.12] scale-105 transform animate-float-slow duration-1000"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Radiant Gradient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0c1017] via-[#0c1017]/45 to-black/25"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,175,102,0.14)_0%,transparent_75%)]"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-8">
      <!-- Tagline & Brand Badge with Luminous Shimmer -->
      <div class="reveal inline-flex items-center space-x-3 px-4 py-1.5 rounded-full bg-charcoal-900/80 border border-gold-400/40 backdrop-blur-xl shadow-[0_0_30px_rgba(212,175,102,0.25)]">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-red animate-ping"></span>
        <span class="text-[11px] tracking-widest text-amber-100 uppercase font-semibold">
          Mahindra Lifespaces • Landmark 13.46-Acre Acquisition
        </span>
      </div>

      <!-- Main Headline (Optimized for Primary Search Queries) -->
      <div class="space-y-3 reveal delay-100">
        <h2 class="text-xs sm:text-sm font-sans tracking-widest uppercase text-gold-400 font-bold">
          MAHINDRA MAHALUNGE • MAHINDRA LIFESPACES LANDMARK PRE-LAUNCH
        </h2>
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight drop-shadow-lg">
          Mahindra Mahalunge
          <span class="block text-2xl sm:text-3xl lg:text-4xl font-serif text-stone-200 mt-2 font-normal">
            by <span class="gold-gradient-text font-bold">Mahindra Lifespaces Mahalunge</span>
          </span>
        </h1>
      </div>

      <!-- Subtitle -->
      <p class="reveal delay-200 text-sm sm:text-lg text-stone-100/90 max-w-2xl mx-auto font-light leading-relaxed">
        A thoughtfully planned 13.46-acre residential destination in Pune's fastest emerging growth corridor — uniting Mahindra's legacy of trust with future-ready sustainable 2, 3 & 4 BHK living at Mahindra Mahalunge by Mahindra Lifespaces.
      </p>

      <!-- Clean Minimal Action CTAs with Shimmer Animation -->
      <div class="reveal delay-300 pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#overview"
          class="btn-shimmer w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold tracking-widest uppercase hover:shadow-xl hover:shadow-gold-500/35 transition-all active:scale-95"
        >
          Explore Project
        </a>
        <button
          type="button"
          data-open-modal
          data-interest="Request Details Brochure"
          class="btn-shimmer w-full sm:w-auto px-8 py-3.5 rounded-full border border-white/30 hover:border-gold-400 text-stone-100 hover:text-white text-xs font-semibold tracking-widest uppercase transition-all backdrop-blur-md hover:bg-white/10"
        >
          Request Details
        </button>
      </div>

      <!-- Live Animated Numerical Stat Bar -->
      <div class="reveal delay-400 pt-6 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl mx-auto">
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-gold-400" data-counter="13.46" data-decimals="2" data-suffix=" ACRES">13.46 ACRES</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Master Land Parcel</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-white" data-counter="3500" data-prefix="₹" data-suffix=" CR">₹3,500 CR</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Est. GDV Potential</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-gold-400" data-counter="7" data-suffix=" MINS">7 MINS</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">To Hinjewadi Phase 1</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-emerald-400">2, 3 & 4 BHK</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Future-Ready Homes</div>
        </div>
      </div>

      <!-- Floating Site Visit Invitation Note -->
      <div class="pt-2">
        <button
          data-open-modal
          data-interest="Private Site Visit"
          class="inline-flex items-center space-x-2 text-xs text-stone-300 hover:text-gold-300 transition-colors group cursor-pointer"
        >
          <span class="w-2 h-2 rounded-full bg-gold-400 group-hover:scale-150 transition-transform shadow-[0_0_10px_#d4af66]"></span>
          <span class="border-b border-stone-500 group-hover:border-gold-300 pb-0.5">Book Exclusive Site Visit & Corridor Walkthrough</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- Scroll Down Indicator -->
    <a href="#overview" class="absolute bottom-6 left-1/2 transform -translate-x-1/2 text-stone-300 hover:text-white transition-colors flex flex-col items-center space-y-1">
      <span class="text-[10px] tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 animate-bounce text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </section>

  <!-- LUXURY INFINITE MARQUEE TICKER RIBBON -->
  <div class="py-3.5 bg-gradient-to-r from-charcoal-950 via-[#151c2a] to-charcoal-950 border-y border-gold-500/30 overflow-hidden relative shadow-lg">
    <div class="flex whitespace-nowrap animate-marquee space-x-8 text-xs font-semibold uppercase tracking-wider text-stone-200">
      <span class="flex items-center space-x-2"><span class="text-gold-400">★</span><span>Mahindra Mahalunge Official Overview</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏛️</span><span>Mahindra Lifespaces Mahalunge, Pune</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🌿</span><span>13.46-Acre Sustainable Master Community</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">💎</span><span>₹3,500 Cr Est. Development Potential</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-brand-red">⚡</span><span>7 Mins to Hinjewadi Phase 1</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🛍️</span><span>8 Mins to Balewadi High Street</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🚇</span><span>PMRDA 36M DP Road & Metro Line 3</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏡</span><span>2, 3 & 4 BHK Pre-Launch Residences</span></span>
      <span class="text-gold-500/40">•</span>
      <!-- Repeated for seamless loop -->
      <span class="flex items-center space-x-2"><span class="text-gold-400">★</span><span>Mahindra Mahalunge Official Overview</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏛️</span><span>Mahindra Lifespaces Mahalunge, Pune</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🌿</span><span>13.46-Acre Sustainable Master Community</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">💎</span><span>₹3,500 Cr Est. Development Potential</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-brand-red">⚡</span><span>7 Mins to Hinjewadi Phase 1</span></span>
    </div>
  </div>


  <!-- 02 THE MAHINDRA DIFFERENCE (Luminous Overview) -->
  <section id="overview" class="py-24 bg-gradient-to-b from-[#0e121a] via-[#141924] to-[#0e121a] border-t border-gold-500/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Pillars of Distinction</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-bold mt-2">The Mahindra Difference</h2>
        </div>
        <p class="text-xs sm:text-sm text-stone-200 max-w-md leading-relaxed">
          Grounding every development in the pioneering ethos of the Mahindra Group, crafting environments of positive energy, longevity, and generational value.
        </p>
      </div>

      <!-- 4 Pillars Grid with Staggered Scroll Reveals -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Pillar 01 -->
        <div class="reveal delay-100 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">01</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Trust & Credibility</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Backed by the 75+ year legacy of the Mahindra Group. Built on uncompromising governance, transparent dealings, and on-schedule delivery milestones.
          </p>
        </div>

        <!-- Pillar 02 -->
        <div class="reveal delay-200 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">02</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Thoughtful Design</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Homes intuitively sculpted around modern lifestyle rhythms — intelligent space utilization, abundant natural breezes, and biophilic living integration.
          </p>
        </div>

        <!-- Pillar 03 -->
        <div class="reveal delay-300 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">03</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Homes of Positive Energy</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Mahindra Lifespaces' pioneering green philosophy: Net-Zero water strategies, solar harvest micro-grids, and IGBC Platinum-certified sustainable construction.
          </p>
        </div>

        <!-- Pillar 04 -->
        <div class="reveal delay-400 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">04</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Future Ready Corridor</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Strategically located at Nande–Mahalunge, seamlessly woven into the Baner–Balewadi lifestyle ecosystem and Hinjewadi’s vast economic power engine.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 PROJECT STORY: Where Pune's Future Is Taking Shape -->
  <section class="py-24 bg-[#0c1017] border-t border-white/[0.08] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="reveal lg:col-span-6 space-y-6">
          <div class="inline-block px-3 py-1 rounded-full bg-gold-500/15 border border-gold-500/40 text-gold-300 text-xs font-semibold uppercase tracking-widest shadow-[0_0_20px_rgba(212,175,102,0.15)]">
            Western Pune Growth Epicenter
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-bold leading-tight">
            Where Pune's Future <br /><span class="gold-gradient-text">Is Taking Shape</span>
          </h2>
          <p class="text-xs sm:text-sm text-stone-200 leading-relaxed">
            In October 2025, Mahindra Lifespaces officially announced its strategic acquisition of 13.46 acres in the Nande–Mahalunge corridor with an estimated development potential of approximately ₹3,500 Crore.
          </p>
          <p class="text-xs text-stone-300 leading-relaxed">
            Nestled between the booming IT employment capital of Hinjewadi and the upscale urban fabric of Baner–Balewadi, this upcoming landmark will create a balanced sanctuary of green tranquility and high-tech connectivity.
          </p>

          <!-- 3-Column Story with Elevated Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">Mahalunge</h4>
              <p class="text-[11px] text-stone-300 mt-1">An emerging residential destination primed by planned urban infrastructure.</p>
            </div>
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">Nande–Maan</h4>
              <p class="text-[11px] text-stone-300 mt-1">Rapidly evolving western belt benefiting from PMRDA Ring Road access.</p>
            </div>
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">Hinjewadi–Baner</h4>
              <p class="text-[11px] text-stone-300 mt-1">Minutes away from 400,000+ IT professionals & premium social life.</p>
            </div>
          </div>
        </div>

        <div class="reveal delay-200 lg:col-span-6 relative">
          <div class="rounded-2xl overflow-hidden border border-gold-500/30 shadow-[0_20px_60px_rgba(0,0,0,0.7)] relative group">
            <img
              src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=85"
              alt="Mahindra Lifespaces Mahalunge Concept"
              class="w-full h-[460px] object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0c1017] via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-charcoal-900/90 backdrop-blur-xl border border-gold-500/30 shadow-2xl">
              <span class="text-[10px] uppercase tracking-widest text-gold-400 font-bold flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Planned Master Community</span>
              </span>
              <p class="text-xs text-stone-100 mt-1 font-light">
                Conceived as an integrated green township celebrating bio-diversity and modern wellness.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- 04 PROJECT SNAPSHOT DATA STRIP (Animated Counters & Luminous) -->
  <section class="py-14 bg-gradient-to-r from-[#121722] via-[#1a2232] to-[#121722] border-y border-gold-500/30 shadow-2xl relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
        
        <div class="reveal p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-4xl font-bold text-gold-400" data-counter="13.46" data-decimals="2" data-suffix=" ACRES*">13.46 ACRES*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-300 font-medium">Acquired Land Parcel</div>
        </div>

        <div class="reveal delay-100 p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-4xl font-bold text-white" data-counter="3500" data-prefix="₹" data-suffix=" CR*">₹3,500 CR*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-300 font-medium">Est. Development Potential</div>
        </div>

        <div class="reveal delay-200 p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-4xl font-bold text-gold-400">2, 3 & 4 BHK*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-300 font-medium">Proposed Configurations</div>
        </div>

        <div class="reveal delay-300 p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-4xl font-bold text-emerald-400" data-counter="80" data-suffix="%+ GREENS*">80%+ GREENS*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-300 font-medium">Open Bio-Reserve</div>
        </div>

        <div class="reveal delay-400 col-span-2 md:col-span-1 p-4 space-y-1">
          <div class="font-serif text-xl lg:text-2xl font-bold text-amber-300 flex items-center justify-center space-x-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            <span>UPCOMING*</span>
          </div>
          <div class="text-[11px] uppercase tracking-widest text-stone-300 font-medium">MahaRERA Registration Stage</div>
        </div>

      </div>
      
      <p class="text-[10px] text-center text-stone-400 mt-5">
        *13.46 acres reflects the land acquisition announced by Mahindra Lifespaces in Oct 2025. Configurations, area breakdowns and pricing are indicative concepts pending MahaRERA approvals.
      </p>
    </div>
  </section>


  <!-- 05 RESIDENCES SECTION (Interactive Selector) -->
  <section id="residences" class="py-24 bg-[#0e121a] border-t border-white/[0.08] relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="reveal text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Unmatched Craftsmanship</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-bold">Master-Planned Residences</h2>
        <p class="text-xs sm:text-sm text-stone-200 leading-relaxed">
          Designed with zero dead-space corridors, optimal solar aspect ratios, and expansive panoramic viewing decks.
        </p>
      </div>

      <!-- Interactive Residence Selector -->
      <ResidenceSelector />
    </div>
  </section>


  <!-- 06 MASTER PLAN SECTION (Luminous Blueprint) -->
  <section id="masterplan" class="py-24 bg-gradient-to-b from-[#10141e] via-[#151c2a] to-[#10141e] border-t border-gold-500/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="reveal text-center max-w-2xl mx-auto space-y-3">
