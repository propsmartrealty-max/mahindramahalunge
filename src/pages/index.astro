---
import Layout from '../layouts/Layout.astro';
import ResidenceSelector from '../components/ResidenceSelector.astro';
import MasterPlanViewer from '../components/MasterPlanViewer.astro';
import RoiEmiCalculator from '../components/RoiEmiCalculator.astro';
import CommuteDistanceMatrix from '../components/CommuteDistanceMatrix.astro';
import ProgrammaticHubDirectory from '../components/ProgrammaticHubDirectory.astro';
import MahindraKeywordMatrix from '../components/MahindraKeywordMatrix.astro';

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Mahindra Rivenza by Mahindra Lifespaces?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is an officially launched landmark residential development by Mahindra Lifespaces Developers Ltd. (Mahindra Group) spanning 13.46 acres in Baner Annex, Mahalunge, Pune. Phase 1 offers 1,236 units across 2, 3 and 4 BHK configurations with an estimated GDV of approximately ₹3,500 Crore, 9+ acres of greens, and ~44,000+ sq.ft. clubhouse."
          }
        },
        {
          "@type": "Question",
          "name": "What is the exact location and address of Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is located at Plus Code HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Pune, Nande, Maharashtra 412115, India (Coordinates: 18.562536 N, 73.727373 E). It is positioned directly between Hinjewadi Phase 1 (7-10 mins) and Balewadi High Street / Baner (8-12 mins)."
          }
        },
        {
          "@type": "Question",
          "name": "What are the official MahaRERA registration numbers for Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is registered with Maharashtra Real Estate Regulatory Authority (MahaRERA) under Registration Numbers: Phase 1: PR1261012602102 and Phase 2: PM1261012602103, both valid up to 30/12/31. Details are verified on the official MahaRERA portal (maharera.maharashtra.gov.in)."
          }
        },
        {
          "@type": "Question",
          "name": "What configurations and carpet areas are offered at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza offers 9 typologies: 2 BHK Premium (635 sq.ft. carpet / 688 sq.ft. aggregate), 2 BHK Luxury B (705 sq.ft. carpet / 785 sq.ft. aggregate), 2 BHK Luxury A (711 sq.ft. carpet / 824 sq.ft. aggregate), 2 BHK Ultra Luxury E (747 sq.ft. carpet / 855 sq.ft. aggregate), 3 BHK Deluxe C (882 sq.ft. carpet / 995 sq.ft. aggregate), 3 BHK Deluxe B (894 sq.ft. carpet / 1,007 sq.ft. aggregate), 3 BHK Ultra Luxury B (1,065 sq.ft. carpet / 1,206 sq.ft. aggregate), 4 BHK Luxury B (1,438 sq.ft. carpet / 1,615 sq.ft. aggregate), and 4 BHK Luxury A (1,465 sq.ft. carpet / 1,651 sq.ft. aggregate)."
          }
        },
        {
          "@type": "Question",
          "name": "What is the price of flats at Mahindra Rivenza Baner Annex Mahalunge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Official launch pricing at Mahindra Rivenza starts from ₹90 Lakhs* for 2 BHK Premium residences, ₹1.04 Cr - ₹1.14 Cr* for 2 BHK Luxury residences, ₹1.31 Cr - ₹1.60 Cr* for 3 BHK Deluxe & Ultra Luxury homes, and ₹2.20 Cr - ₹2.55 Cr* for 4 BHK Luxury sky estates. Flexible milestone-linked payment schedules are available."
          }
        },
        {
          "@type": "Question",
          "name": "What sustainability certifications does Mahindra Rivenza hold?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is pre-certified IGBC Gold by the Indian Green Building Council and is engineered as a Net Zero Waste to Landfill development, featuring solar power micro-grids, high-efficiency rainwater harvesting, and biophilic landscaped environments."
          }
        },
        {
          "@type": "Question",
          "name": "Is there an on-site show residence available at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, a fully furnished 4 BHK show residence is live and available for private walkthroughs at the on-site sales gallery at Baner Annex, Mahalunge, Pune."
          }
        },
        {
          "@type": "Question",
          "name": "What are the key clubhouse and sports amenities at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza features a ~44,000+ sq.ft. grand clubhouse, 2.65 Lakh+ sq.ft. of amenity space, a swimming pool with sunken bar, yoga lawn, floodlit futsal court, multi-purpose sports court, indoor games zone, co-working lounge, and 9+ acres of landscaped gardens."
          }
        },
        {
          "@type": "Question",
          "name": "How can NRI buyers from Gulf, UAE, USA, and Singapore invest in Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NRI investors can access dedicated international NRI advisory desks, virtual 3D show residence walkthroughs, transparent digital booking portals, and NRE/NRO banking assistance with multi-currency guidance (USD, AED, EUR, SGD)."
          }
        }
      ]
    },
    {
      "@type": "VideoObject",
      "name": "Mahindra Rivenza 4 BHK Show Residence & Master Walkthrough | Baner Annex, Mahalunge, Pune",
      "description": "Architectural showcase and master walkthrough of Mahindra Rivenza, a 13.46-acre officially launched residential landmark by Mahindra Lifespaces at Baner Annex, Mahalunge, Pune.",
      "thumbnailUrl": [
        "http://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp"
      ],
      "uploadDate": "2026-10-06T09:00:00+05:30",
      "duration": "PT3M15S",
      "contentUrl": "https://mahindralifespaceshomes.in/",
      "embedUrl": "https://www.youtube-nocookie.com/embed/dQw4w9WgXcQ"
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Mahalunge | Baner Annex Pune - 2, 3 & 4 BHK Official Launch"
  description="Official showcase for Mahindra Rivenza by Mahindra Lifespaces at Baner Annex, Mahalunge, Pune. 13.46 acres, Net Zero Waste, IGBC Gold Pre-Certified, 2/3/4 BHK starting ₹1.85 Cr*. MahaRERA PR1261012602102 & PM1261012602103."
  canonical="https://mahindralifespaceshomes.in/"
  customSchema={homepageSchema}
>
  <!-- 01 CINEMATIC HERO SECTION (Luminous & Vibrant) -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24 pb-20">
    <!-- Cinematic Radiant Background with Multi-Layer Glow -->
    <div class="absolute inset-0 z-0">
      <img
        src="http://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp"
        alt="Mahindra Rivenza - Mahindra Lifespaces Baner Annex Mahalunge Pune Architecture Elevation"
        class="w-full h-full object-cover object-center filter brightness-[0.78] contrast-[1.08] saturate-[1.12] scale-105 transform animate-float-slow duration-1000"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Radiant Gradient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#0c1017] via-[#0c1017]/45 to-black/25"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(212,175,102,0.14)_0%,transparent_75%)]"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-8">
      <!-- Tagline & Brand Badge with Luminous Shimmer -->
      <div class="reveal inline-flex items-center space-x-3 px-4 py-1.5 rounded-full bg-charcoal-900/80 border border-gold-400/40 backdrop-blur-xl shadow-[0_0_30px_rgba(212,175,102,0.25)]">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-[11px] tracking-widest text-amber-100 uppercase font-semibold">
          Mahindra Lifespaces • Officially Launched • Baner Annex, Mahalunge
        </span>
      </div>

      <!-- Main Headline (Optimized for Primary Search Queries) -->
      <div class="space-y-3 reveal delay-100">
        <h2 class="text-xs sm:text-sm font-sans tracking-widest uppercase text-gold-400 font-bold">
          MAHINDRA RIVENZA • BANER ANNEX, MAHALUNGE, PUNE • MAHARERA PR1261012602102 & PM1261012602103
        </h2>
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight drop-shadow-lg">
          Mahindra Rivenza
          <span class="block text-2xl sm:text-3xl lg:text-4xl font-serif text-stone-200 mt-2 font-normal">
            by <span class="gold-gradient-text font-bold">Mahindra Lifespaces Developers Ltd.</span>
          </span>
        </h1>
      </div>

      <!-- Subtitle -->
      <p class="reveal delay-200 text-sm sm:text-lg text-stone-100/90 max-w-2xl mx-auto font-light leading-relaxed">
        Officially launched across 13.46 acres in Baner Annex, Mahalunge, Pune. Offering 1,236 residences in Phase 1 with 9+ acres of open greens, ~44,000+ sq.ft. clubhouse, Net Zero Waste to Landfill design, and pre-certified IGBC Gold rating starting from ₹90 Lakhs*.
      </p>

      <!-- Clean Minimal Action CTAs with Shimmer Animation -->
      <div class="reveal delay-300 pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#pricing"
          class="btn-shimmer w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 text-xs font-bold tracking-widest uppercase hover:shadow-xl hover:shadow-gold-500/35 transition-all active:scale-95"
        >
          Explore Pricing & Inventory
        </a>
        <button
          type="button"
          data-open-modal
          data-interest="Official Launch Brochure & Cost Sheet"
          class="btn-shimmer w-full sm:w-auto px-8 py-3.5 rounded-full border border-white/30 hover:border-gold-400 text-stone-100 hover:text-white text-xs font-semibold tracking-widest uppercase transition-all backdrop-blur-md hover:bg-white/10"
        >
          Download Master Brochure
        </button>
      </div>

      <!-- Live Animated Numerical Stat Bar -->
      <div class="reveal delay-400 pt-6 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl mx-auto">
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-gold-400" data-counter="13.46" data-decimals="2" data-suffix=" ACRES">13.46 ACRES</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Master Land Parcel</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-white" data-counter="3500" data-prefix="₹" data-suffix=" CR">₹3,500 CR</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Development Potential</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-gold-400" data-counter="1236" data-suffix=" UNITS">1,236 UNITS</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">Phase 1 Launch</div>
        </div>
        <div class="glass-card p-3.5 rounded-xl border border-white/15 hover:border-gold-500/50 transition-all">
          <div class="font-serif text-xl sm:text-2xl font-bold text-emerald-400">FROM ₹90 LAKHS*</div>
          <div class="text-[10px] uppercase tracking-wider text-stone-300 mt-0.5">2, 3 & 4 BHK Luxury</div>
        </div>
      </div>

      <!-- Floating Site Visit Invitation Note -->
      <div class="pt-2">
        <button
          data-open-modal
          data-interest="4 BHK Show Residence Site Visit"
          class="inline-flex items-center space-x-2 text-xs text-stone-300 hover:text-gold-300 transition-colors group cursor-pointer"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 group-hover:scale-150 transition-transform shadow-[0_0_10px_#10b981]"></span>
          <span class="border-b border-stone-500 group-hover:border-gold-300 pb-0.5">Book 4 BHK Show Residence Tour at On-Site Sales Gallery (Baner Annex)</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- Scroll Down Indicator -->
    <a href="#overview" class="absolute bottom-6 left-1/2 transform -translate-x-1/2 text-stone-300 hover:text-white transition-colors flex flex-col items-center space-y-1">
      <span class="text-[10px] tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 animate-bounce text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </section>

  <!-- LUXURY INFINITE MARQUEE TICKER RIBBON -->
  <div class="py-3.5 bg-gradient-to-r from-charcoal-950 via-[#151c2a] to-charcoal-950 border-y border-gold-500/30 overflow-hidden relative shadow-lg">
    <div class="flex whitespace-nowrap animate-marquee space-x-8 text-xs font-semibold uppercase tracking-wider text-stone-200">
      <span class="flex items-center space-x-2"><span class="text-gold-400">★</span><span>Mahindra Rivenza Officially Launched</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏛️</span><span>Baner Annex, Mahalunge, Pune</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🌿</span><span>Net Zero Waste to Landfill • IGBC Gold Pre-Certified</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">💎</span><span>1,236 Units • ₹3,500 Cr GDV Potential</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-brand-red">⚡</span><span>MahaRERA: PR1261012602102 & PM1261012602103</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏊</span><span>~44,000+ Sq.Ft. Clubhouse • Sunken Bar Pool</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🏡</span><span>4 BHK Show Residence Open at Sales Gallery</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">💰</span><span>2, 3 & 4 BHK Starting ₹90 Lakhs*</span></span>
      <span class="text-gold-500/40">•</span>
      <!-- Repeated for seamless loop -->
      <span class="flex items-center space-x-2"><span class="text-gold-400">★</span><span>Mahindra Rivenza Officially Launched</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">🏛️</span><span>Baner Annex, Mahalunge, Pune</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-emerald-400">🌿</span><span>Net Zero Waste to Landfill • IGBC Gold Pre-Certified</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-gold-400">💎</span><span>1,236 Units • ₹3,500 Cr GDV Potential</span></span>
      <span class="text-gold-500/40">•</span>
      <span class="flex items-center space-x-2"><span class="text-brand-red">⚡</span><span>MahaRERA: PR1261012602102 & PM1261012602103</span></span>
    </div>
  </div>


  <!-- 02 THE MAHINDRA DIFFERENCE (Luminous Overview) -->
  <section id="overview" class="py-24 bg-gradient-to-b from-[#0e121a] via-[#141924] to-[#0e121a] border-t border-gold-500/20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="reveal flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Pillars of Distinction</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-bold mt-2">The Mahindra Difference</h2>
        </div>
        <p class="text-xs sm:text-sm text-stone-200 max-w-md leading-relaxed">
          Grounding every development in the pioneering ethos of the Mahindra Group, crafting environments of positive energy, longevity, and generational value.
        </p>
      </div>

      <!-- 4 Pillars Grid with Staggered Scroll Reveals -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Pillar 01 -->
        <div class="reveal delay-100 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">01</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Trust & Credibility</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Backed by the 75+ year legacy of the Mahindra Group. Built on uncompromising governance, transparent dealings, and on-schedule delivery milestones.
          </p>
        </div>

        <!-- Pillar 02 -->
        <div class="reveal delay-200 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">02</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Thoughtful Design</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Homes intuitively sculpted around modern lifestyle rhythms — intelligent space utilization, abundant natural breezes, and biophilic living integration.
          </p>
        </div>

        <!-- Pillar 03 -->
        <div class="reveal delay-300 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">03</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Homes of Positive Energy</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Mahindra Lifespaces' pioneering green philosophy: Net-Zero water strategies, solar harvest micro-grids, and IGBC Platinum-certified sustainable construction.
          </p>
        </div>

        <!-- Pillar 04 -->
        <div class="reveal delay-400 glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/60 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400 group-hover:scale-110 transition-transform origin-left">04</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Future Ready Corridor</h3>
          <p class="text-xs text-stone-300 leading-relaxed">
            Strategically located at Nande–Mahalunge, seamlessly woven into the Baner–Balewadi lifestyle ecosystem and Hinjewadi’s vast economic power engine.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 PROJECT STORY: Where Pune's Future Is Taking Shape -->
  <section class="py-24 bg-[#0c1017] border-t border-white/[0.08] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="reveal lg:col-span-6 space-y-6">
          <div class="inline-block px-3 py-1 rounded-full bg-gold-500/15 border border-gold-500/40 text-gold-300 text-xs font-semibold uppercase tracking-widest shadow-[0_0_20px_rgba(212,175,102,0.15)]">
            Baner Annex • Western Pune Growth Epicenter
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-50 font-bold leading-tight">
            Where Pune's Future <br /><span class="gold-gradient-text">Unfolds at Mahindra Rivenza</span>
          </h2>
          <p class="text-xs sm:text-sm text-stone-200 leading-relaxed">
            Officially launched on October 6, 2026, Mahindra Rivenza represents Mahindra Lifespaces' landmark master development spanning 13.46 acres in Baner Annex, Mahalunge, Pune. With an estimated development potential of ₹3,500 Crore, Phase 1 introduces 1,236 residences in thoughtfully sculpted 2, 3 and 4 BHK configurations.
          </p>
          <p class="text-xs text-stone-300 leading-relaxed">
            Positioned at the dynamic intersection of Hinjewadi's IT corridor and Baner–Balewadi's vibrant high street culture, Mahindra Rivenza blends 9+ acres of landscaped open spaces, Net Zero Waste engineering, and pre-certified IGBC Gold sustainability. A fully furnished 4 BHK show residence is now open for private viewings at the on-site sales gallery.
          </p>

          <!-- 3-Column Story with Elevated Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">Baner Annex</h4>
              <p class="text-[11px] text-stone-300 mt-1">Prime micro-market merging luxury living with seamless Hinjewadi connectivity.</p>
            </div>
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">Nande–Mahalunge</h4>
              <p class="text-[11px] text-stone-300 mt-1">Master-planned growth belt benefiting from 36m DP road & PMRDA schemes.</p>
            </div>
            <div class="glass-card p-3 rounded-lg">
              <h4 class="font-serif text-gold-300 font-semibold text-sm">1,236 Phase 1 Units</h4>
              <p class="text-[11px] text-stone-300 mt-1">High-rise luxury towers with panoramic green views and cross-ventilation.</p>
            </div>
          </div>
        </div>

        <div class="reveal delay-200 lg:col-span-6 relative">
          <div class="rounded-2xl overflow-hidden border border-gold-500/30 shadow-[0_20px_60px_rgba(0,0,0,0.7)] relative group">
            <img
              src="http://cms.mahindralifespaces.com/web/sites/default/files/styles/web_banner_webp/public/2026-10/jpeg-optimizer_Elevation%20Opt%20A..webp"
              alt="Mahindra Rivenza Baner Annex Mahalunge Pune Architecture Elevation"
              class="w-full h-[460px] object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0c1017] via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-charcoal-900/90 backdrop-blur-xl border border-gold-500/30 shadow-2xl">
              <span class="text-[10px] uppercase tracking-widest text-gold-400 font-bold flex items-center space-x-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Official Launch • MahaRERA PR1261012602102 & PM1261012602103</span>
              </span>
              <p class="text-xs text-stone-100 mt-1 font-light">
                13.46-Acre Landmark Community • Net Zero Waste • IGBC Gold Pre-Certified
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- 04 PROJECT SNAPSHOT DATA STRIP (Animated Counters & Luminous) -->
  <section class="py-14 bg-gradient-to-r from-[#121722] via-[#1a2232] to-[#121722] border-y border-gold-500/30 shadow-2xl relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
