---
import Layout from '../layouts/Layout.astro';
import ResidenceSelector from '../components/ResidenceSelector.astro';
import MasterPlanViewer from '../components/MasterPlanViewer.astro';
import RoiEmiCalculator from '../components/RoiEmiCalculator.astro';
import CommuteDistanceMatrix from '../components/CommuteDistanceMatrix.astro';

const homepageFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What did Mahindra Lifespaces officially announce in Mahalunge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In October 2025, Mahindra Lifespaces Developers Ltd. publicly announced the acquisition of 13.46 acres in the Nande–Mahalunge corridor with an estimated development potential of approximately ₹3,500 Crore. The announcement highlighted its strategic location close to Hinjewadi, Baner–Balewadi, and proposed PMRDA town infrastructure."
      }
    },
    {
      "@type": "Question",
      "name": "What is the location and postal pin code of Mahindra Mahalunge?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The project is situated in the Nande-Mahalunge corridor, Mulshi Taluka, Pune, Maharashtra with Postal Pin Code 411045, offering direct connectivity via the proposed 36-meter wide PMRDA DP road to Hinjewadi and Baner."
      }
    },
    {
      "@type": "Question",
      "name": "Is Mahindra Lifespaces Mahalunge currently registered with MahaRERA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The project is in its early conceptual planning and approval phase following land acquisition. MahaRERA registration will be filed and obtained prior to any commercial launch or booking activities in full statutory compliance."
      }
    },
    {
      "@type": "Question",
      "name": "What residential configurations are anticipated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The master plan is expected to offer premium 2 BHK, 3 BHK, and 4 BHK future-ready residences designed under Mahindra’s green building and sustainable wellness standards."
      }
    },
    {
      "@type": "Question",
      "name": "How close is the location to Hinjewadi IT Park and Baner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The site is approximately 7-10 minutes from Hinjewadi Phase 1 IT Park and 8-12 minutes from Balewadi High Street and Baner, with direct access via the proposed 36-meter wide PMRDA road."
      }
    }
  ]
};
---

<Layout
  title="Mahindra Lifespaces Mahalunge, Pune | 2, 3 & 4 BHK Pre-Launch Residences"
  description="Official pre-launch overview of Mahindra Lifespaces 13.46-acre master development at Nande-Mahalunge, Pune. Explore 2, 3 & 4 BHK residences, tentative price sheets, floor plans & PMRDA infrastructure."
  canonical="https://mahindra-mahalunge.com/"
  customSchema={homepageFaqSchema}
>
  <!-- 01 CINEMATIC HERO SECTION -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20 pb-16">
    <!-- Cinematic Dark Background with Gradient Overlays -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=85"
        alt="Mahindra Lifespaces Mahalunge Aerial Architecture"
        class="w-full h-full object-cover object-center filter brightness-[0.38] contrast-[1.1] scale-105 transform animate-pulse"
        style="animation-duration: 10s;"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-charcoal-950/60 to-charcoal-950/70"></div>
      <div class="absolute inset-0 bg-radial-at-c from-transparent via-charcoal-950/40 to-charcoal-950"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center space-y-8">
      <!-- Tagline & Brand Badge -->
      <div class="inline-flex items-center space-x-3 px-4 py-1.5 rounded-full bg-white/5 border border-white/15 backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-brand-red animate-ping"></span>
        <span class="text-[11px] tracking-widest text-stone-300 uppercase font-medium">
          Mahindra Lifespaces • Landmark 13.46-Acre Acquisition
        </span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-3">
        <h2 class="text-xs sm:text-sm font-sans tracking-widest uppercase text-gold-400 font-semibold">
          MAHINDRA LIFESPACES • LANDMARK PRE-LAUNCH
        </h2>
        <h1 class="font-serif text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-tight">
          Mahindra Lifespaces <br />
          <span class="gold-gradient-text">Mahalunge, Pune</span>
        </h1>
      </div>

      <!-- Subtitle -->
      <p class="text-sm sm:text-lg text-stone-300 max-w-2xl mx-auto font-light leading-relaxed">
        A thoughtfully planned 13.46-acre residential destination in Pune's fastest emerging growth corridor — uniting Mahindra's legacy of trust with future-ready sustainable 2, 3 & 4 BHK living.
      </p>

      <!-- Clean Minimal Action CTAs -->
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#overview"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold tracking-widest uppercase hover:shadow-xl hover:shadow-gold-500/25 transition-all active:scale-95"
        >
          Explore Project
        </a>
        <button
          type="button"
          data-open-modal
          data-interest="Request Details Brochure"
          class="w-full sm:w-auto px-8 py-3.5 rounded-full border border-white/20 hover:border-gold-400 text-stone-200 hover:text-white text-xs font-semibold tracking-widest uppercase transition-all backdrop-blur-sm hover:bg-white/5"
        >
          Request Details
        </button>
      </div>

      <!-- Floating Site Visit Invitation Note -->
      <div class="pt-8">
        <button
          data-open-modal
          data-interest="Private Site Visit"
          class="inline-flex items-center space-x-2 text-xs text-stone-400 hover:text-gold-400 transition-colors group cursor-pointer"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400 group-hover:scale-150 transition-transform"></span>
          <span class="border-b border-stone-600 group-hover:border-gold-400 pb-0.5">Book Exclusive Site Visit & Corridor Walkthrough</span>
          <span>→</span>
        </button>
      </div>
    </div>

    <!-- Scroll Down Indicator -->
    <a href="#overview" class="absolute bottom-6 left-1/2 transform -translate-x-1/2 text-stone-400 hover:text-white transition-colors flex flex-col items-center space-y-1">
      <span class="text-[10px] tracking-widest uppercase">Scroll</span>
      <svg class="w-4 h-4 animate-bounce text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </section>


  <!-- 02 THE MAHINDRA DIFFERENCE (Horizontal Storytelling) -->
  <section id="overview" class="py-24 bg-charcoal-900 border-t border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Pillars of Distinction</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold mt-2">The Mahindra Difference</h2>
        </div>
        <p class="text-xs text-stone-400 max-w-md leading-relaxed">
          Grounding every development in the pioneering ethos of the Mahindra Group, crafting environments of positive energy, longevity, and generational value.
        </p>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Pillar 01 -->
        <div class="glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/40 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400/80 group-hover:text-gold-400 transition-colors">01</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Trust & Credibility</h3>
          <p class="text-xs text-stone-400 leading-relaxed">
            Backed by the 75+ year legacy of the Mahindra Group. Built on uncompromising governance, transparent dealings, and on-schedule delivery milestones.
          </p>
        </div>

        <!-- Pillar 02 -->
        <div class="glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/40 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400/80 group-hover:text-gold-400 transition-colors">02</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Thoughtful Design</h3>
          <p class="text-xs text-stone-400 leading-relaxed">
            Homes intuitively sculpted around modern lifestyle rhythms — intelligent space utilization, abundant natural breezes, and biophilic living integration.
          </p>
        </div>

        <!-- Pillar 03 -->
        <div class="glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/40 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400/80 group-hover:text-gold-400 transition-colors">03</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Homes of Positive Energy</h3>
          <p class="text-xs text-stone-400 leading-relaxed">
            Mahindra Lifespaces' pioneering green philosophy: Net-Zero water strategies, solar harvest micro-grids, and IGBC Platinum-certified sustainable construction.
          </p>
        </div>

        <!-- Pillar 04 -->
        <div class="glass-card p-8 rounded-xl space-y-4 hover:border-gold-500/40 transition-all group">
          <div class="font-serif text-3xl font-bold text-gold-400/80 group-hover:text-gold-400 transition-colors">04</div>
          <h3 class="font-serif text-xl text-stone-100 font-semibold">Future Ready Corridor</h3>
          <p class="text-xs text-stone-400 leading-relaxed">
            Strategically located at Nande–Mahalunge, seamlessly woven into the Baner–Balewadi lifestyle ecosystem and Hinjewadi’s vast economic power engine.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- 03 PROJECT STORY: Where Pune's Future Is Taking Shape -->
  <section class="py-24 bg-charcoal-950 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-block px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
            Western Pune Growth Epicenter
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold leading-tight">
            Where Pune's Future <br /><span class="gold-gradient-text">Is Taking Shape</span>
          </h2>
          <p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
            In October 2025, Mahindra Lifespaces officially announced its strategic acquisition of 13.46 acres in the Nande–Mahalunge corridor with an estimated development potential of approximately ₹3,500 Crore.
          </p>
          <p class="text-xs text-stone-400 leading-relaxed">
            Nestled between the booming IT employment capital of Hinjewadi and the upscale urban fabric of Baner–Balewadi, this upcoming landmark will create a balanced sanctuary of green tranquility and high-tech connectivity.
          </p>

          <!-- 3-Column Story -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10">
            <div>
              <h4 class="font-serif text-stone-100 font-semibold text-sm">Mahalunge</h4>
              <p class="text-[11px] text-stone-400 mt-1">An emerging residential destination primed by planned urban infrastructure.</p>
            </div>
            <div>
              <h4 class="font-serif text-stone-100 font-semibold text-sm">Nande–Maan</h4>
              <p class="text-[11px] text-stone-400 mt-1">Rapidly evolving western belt benefiting from PMRDA Ring Road access.</p>
            </div>
            <div>
              <h4 class="font-serif text-stone-100 font-semibold text-sm">Hinjewadi–Baner</h4>
              <p class="text-[11px] text-stone-400 mt-1">Minutes away from 400,000+ IT professionals & premium social life.</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 relative">
          <div class="rounded-2xl overflow-hidden border border-white/15 shadow-2xl relative">
            <img
              src="https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=80"
              alt="Mahindra Lifespaces Mahalunge Concept"
              class="w-full h-[450px] object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 p-4 rounded-lg bg-charcoal-950/80 backdrop-blur-md border border-white/10">
              <span class="text-[10px] uppercase tracking-widest text-gold-400 font-bold">Planned Master Community</span>
              <p class="text-xs text-stone-200 mt-1">
                Conceived as an integrated green township celebrating bio-diversity and modern wellness.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- 04 PROJECT SNAPSHOT DATA STRIP -->
  <section class="py-12 bg-charcoal-900 border-y border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/10">
        
        <div class="p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-3xl font-bold text-gold-400">13.46 ACRES*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-400">Acquired Land Parcel</div>
        </div>

        <div class="p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-3xl font-bold text-stone-100">₹3,500 CR*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-400">Est. Development Potential</div>
        </div>

        <div class="p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-3xl font-bold text-gold-400">2, 3 & 4 BHK*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-400">Proposed Configurations</div>
        </div>

        <div class="p-4 space-y-1">
          <div class="font-serif text-2xl lg:text-3xl font-bold text-stone-100">80%+ GREENS*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-400">Open Bio-Reserve</div>
        </div>

        <div class="col-span-2 md:col-span-1 p-4 space-y-1">
          <div class="font-serif text-xl lg:text-2xl font-bold text-emerald-400">UPCOMING*</div>
          <div class="text-[11px] uppercase tracking-widest text-stone-400">MahaRERA Registration Stage</div>
        </div>

      </div>
      
      <p class="text-[10px] text-center text-stone-500 mt-4">
        *13.46 acres reflects the land acquisition announced by Mahindra Lifespaces in Oct 2025. Configurations, area breakdowns and pricing are indicative concepts pending MahaRERA approvals.
      </p>
    </div>
  </section>


  <!-- 05 RESIDENCES SECTION (Interactive Selector) -->
  <section id="residences" class="py-24 bg-charcoal-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Unmatched Craftsmanship</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">Master-Planned Residences</h2>
        <p class="text-xs text-stone-400 leading-relaxed">
          Designed with zero dead-space corridors, optimal solar aspect ratios, and expansive panoramic viewing decks.
        </p>
      </div>

      <!-- Interactive Residence Selector -->
      <ResidenceSelector />
    </div>
  </section>


  <!-- 06 MASTER PLAN SECTION -->
  <section id="masterplan" class="py-24 bg-charcoal-900 border-t border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Township Topography</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">The Master Blueprint</h2>
        <p class="text-xs text-stone-400 leading-relaxed">
          Explore the envisioned zoning across 13.46 acres — prioritizing vehicular-free central sanctuaries and pedestrian walkways.
        </p>
      </div>

      <!-- Interactive Master Plan Island -->
      <MasterPlanViewer />
    </div>
  </section>


  <!-- 07 CURATED AMENITIES EDITORIAL -->
  <section id="amenities" class="py-24 bg-charcoal-950 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Editorial Luxury</span>
          <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold mt-2">Curated Lifestyle Enclaves</h2>
        </div>
        <p class="text-xs text-stone-400 max-w-md leading-relaxed">
          Over 40+ thoughtfully zoned amenities engineered across 5 distinct lifestyle pillars for mental rejuvenation, athletic vigor, and community warmth.
        </p>
      </div>

      <!-- 5 Categories Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Category 1: Wellness -->
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1576013551627-0cc20b96c2a7?auto=format&fit=crop&w=800&q=80" 
              alt="Wellness & Infinity Pool" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif uppercase tracking-widest text-gold-400 font-bold">01 • Wellness</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl text-stone-100 font-semibold">Sanctum of Vitality</h3>
            <p class="text-xs text-stone-400 leading-relaxed">
              Temperature-controlled indoor lap pool, open-sky yoga pavilion, herbal steam bath, aromatic reflexology walkways, and meditation deck.
            </p>
          </div>
        </div>

        <!-- Category 2: Social -->
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80" 
              alt="Clubhouse & Social" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif uppercase tracking-widest text-gold-400 font-bold">02 • Social Life</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl text-stone-100 font-semibold">35,000+ Sq.Ft. Clubhouse</h3>
            <p class="text-xs text-stone-400 leading-relaxed">
              Banquet ballroom for family celebrations, private acoustic screening room, co-working business lounge with high-speed fiber, and sunset terrace café.
            </p>
          </div>
        </div>

        <!-- Category 3: Active Life -->
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=800&q=80" 
              alt="Active Sports Complex" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif uppercase tracking-widest text-gold-400 font-bold">03 • Active Sports</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl text-stone-100 font-semibold">The Sports Complex</h3>
            <p class="text-xs text-stone-400 leading-relaxed">
              Floodlit synthetic tennis courts, squash courts, cricket bowling nets, half-court basketball, and professional cross-fit calisthenics zone.
            </p>
          </div>
        </div>

        <!-- Category 4: Children -->
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1596464716127-f2a829822301?auto=format&fit=crop&w=800&q=80" 
              alt="Children Activity Spaces" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif uppercase tracking-widest text-gold-400 font-bold">04 • Children's Realm</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl text-stone-100 font-semibold">Imagination Playground</h3>
            <p class="text-xs text-stone-400 leading-relaxed">
              Interactive water splash pad, soft-turf adventure obstacle course, outdoor treehouse learning library, and dedicated skate promenade.
            </p>
          </div>
        </div>

        <!-- Category 5: Landscape -->
        <div class="glass-card rounded-xl overflow-hidden border border-white/10 group hover:border-gold-500/40 transition-all lg:col-span-2">
          <div class="h-48 overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?auto=format&fit=crop&w=1200&q=80" 
              alt="Landscaped Forest Greens" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal-950 via-transparent to-transparent"></div>
            <span class="absolute bottom-3 left-4 text-xs font-serif uppercase tracking-widest text-gold-400 font-bold">05 • Biophilic Sanctuary</span>
          </div>
          <div class="p-6 space-y-3">
            <h3 class="font-serif text-xl text-stone-100 font-semibold">The Forest Greens & Canopy Trails</h3>
            <p class="text-xs text-stone-400 leading-relaxed">
              Over 1,000+ indigenous trees planted under the Miyawaki afforestation method, cascading water bio-ponds, organic fruit orchard, and scented flowering perimeter trails designed to restore natural biodiversity.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- 08 3D RADIAL LOCATION & CONNECTIVITY MAP -->
  <section id="location" class="py-24 bg-charcoal-900 border-t border-white/10 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Strategic Geography</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-stone-100 font-bold">Radial Connectivity Matrix</h2>
        <p class="text-xs text-stone-400 leading-relaxed">
          Positioned in the prime Nande–Mahalunge corridor with rapid arterial access across Pune's prime employment, educational, and leisure destinations.
        </p>
      </div>

      <!-- Connectivity Matrix Visualization -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Radial Map Canvas Placeholder -->
        <div class="lg:col-span-7 bg-charcoal-950 rounded-2xl border border-white/10 p-6 relative overflow-hidden shadow-2xl">
          <svg viewBox="0 0 600 480" class="w-full h-auto select-none">
