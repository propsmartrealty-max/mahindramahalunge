---
import Layout from '../../layouts/Layout.astro';
import MasterPlanViewer from '../../components/MasterPlanViewer.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const masterPlanSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/master-plan/#place",
      "name": "Mahindra Rivenza 13.46-Acre Master Township Plan",
      "description": "Master plan layout of Mahindra Rivenza by Mahindra Lifespaces across 13.46 acres in Baner Annex / Mahalunge, Pune. Features 9+ acres of landscaped greens, 6 Phase 1 high-rise towers, and ~44,000 sq.ft clubhouse with sunken bar pool.",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.5623125,
        "longitude": 73.7273125
      },
      "hasMap": "https://www.google.com/maps/place/Mahindra+Rivenza/@18.5623125,73.7273125,17z/data=!3m1!4b1!4m6!3m5!1s0x3bc2bd23899c4255:0xd1c64c7ae74e9a5!8m2!3d18.5623125!4d73.7273125!16s%2Fg%2F11ysgj1zl9",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande",
        "addressLocality": "Mahalunge, Pune",
        "postalCode": "412115",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/master-plan/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the total acreage and green area of Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza spans 13.46 acres, with over 70% (9+ acres) preserved for vehicle-free biophilic greens, nature trails, and recreational parks."
          }
        },
        {
          "@type": "Question",
          "name": "How many residential towers are planned in Mahindra Rivenza Phase 1?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phase 1 includes 6 high-rise towers comprising 1,236 residences with unobstructed views of the surrounding bio-reserves and riverfront."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Master Plan [Official 13.46-Acre Layout & Blueprint]"
  description="Download the official 13.46-acre master plan for Mahindra Rivenza Baner Annex. 9+ acres biophilic greens, ~44,000 sq.ft clubhouse with sunken pool, 6 towers & 1,236 units."
  keywords="mahindra rivenza master plan, mahindra rivenza layout, mahindra rivenza 13.46 acres, mahindra rivenza phase 1 master plan, mahindra mahalunge master layout, township blueprint baner annex"
  canonical="https://mahindralifespaceshomes.in/master-plan/"
  customSchema={masterPlanSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>13.46-Acre Master Development • IGBC Gold Pre-Certified</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza Master Plan: <br />
        <span class="gold-gradient-text">13.46-Acre Master Township Blueprint</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        A master-planned sanctuary integrating 9+ acres of vehicular-free central green reserves, 6 high-rise towers in Phase 1 (1,236 residences), and ~44,000+ sq.ft. grand clubhouse with sunken aqua bar pool.
      </p>
    </div>
  </section>

  <!-- Interactive Master Plan Island -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <MasterPlanViewer />
    </div>
  </section>

  <!-- Official Architectural Elevation & Township Perspective -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-gold-400 font-bold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Official 3D Architectural Perspective
          </span>
          <h2 class="font-serif text-2xl sm:text-4xl text-stone-100 font-bold mt-1">
            Mahindra Rivenza Grand Architectural Elevation
          </h2>
        </div>
        <a
          href="/documents/mahindra-rivenza-official-brochure.pdf"
          target="_blank"
          download="mahindra-rivenza-official-brochure.pdf"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider transition-all shadow-lg shrink-0"
        >
          <span>📥</span>
          <span>Download Master Plan Brochure (PDF)</span>
        </a>
      </div>

      <div class="glass-card rounded-2xl overflow-hidden border border-white/15 shadow-2xl relative group">
        <img
          src="/images/official/mahindra-rivenza-architectural-elevation.webp"
          alt="Mahindra Rivenza 13.46-Acre Master Township Architectural Elevation"
          class="w-full h-auto max-h-[560px] object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          loading="eager"
          width="1200"
          height="675"
        />
        <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-charcoal-950/85 backdrop-blur-md border border-white/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 text-xs">
          <div>
            <span class="font-serif text-sm font-bold text-stone-100">13.46-Acre Biophilic Township Masterplan</span>
            <span class="text-stone-400 ml-2">Phase 1 (PR1261012602102) &amp; Phase 2 (PM1261012602103)</span>
          </div>
          <span class="text-gold-400 font-mono text-[11px]">70%+ Open Vehicular-Free Greens</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 Master Plan Zones Summary -->
  <section class="py-20 bg-charcoal-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Zonal Planning</span>
        <h2 class="font-serif text-3xl text-stone-100 font-bold">5 Distinct Lifestyle & Infrastructure Pillars</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs text-stone-300">
        <div class="glass-card p-6 rounded-2xl border border-white/10 space-y-2.5">
          <div class="text-gold-400 font-bold text-sm uppercase">Zone 01: Clubhouse & Pool</div>
          <p class="leading-relaxed">~44,000 sq.ft multi-level lifestyle complex featuring resort swimming pool with sunken bar, squash, badminton, and luxury spa.</p>
        </div>
        <div class="glass-card p-6 rounded-2xl border border-white/10 space-y-2.5">
          <div class="text-gold-400 font-bold text-sm uppercase">Zone 02: Phase 1 Towers</div>
          <p class="leading-relaxed">6 high-rise towers (G+30 to 37 storeys) housing 1,236 luxury residences with 4 units per floor and 2+ high-speed lifts.</p>
        </div>
        <div class="glass-card p-6 rounded-2xl border border-white/10 space-y-2.5">
          <div class="text-gold-400 font-bold text-sm uppercase">Zone 03: 9+ Acres Greens</div>
          <p class="leading-relaxed">Vehicular-free central green meadow, Miyawaki urban forest, walking trails, and natural bio-diversity reserves.</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Topical Keyword Grid & Search Intent Matrix -->
  <MahindraKeywordMatrix />
</Layout>
