---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Page Not Found | Mahindra Lifespaces Mahalunge"
  description="The requested page could not be located. Explore the 13.46-acre Mahindra Mahalunge master development, residences, floor plans, and West Pune real estate guides."
  canonical="https://mahindralifespaceshomes.in/404.html"
>
  <section class="min-h-[85vh] flex items-center justify-center pt-32 pb-24 bg-charcoal-950 relative overflow-hidden">
    <!-- Ambient gold glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gold-500/5 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-8">
      
      <!-- Error Badge -->
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
        <span>Error 404 • Destination Moved or Unavailable</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-3">
        <h1 class="font-serif text-6xl sm:text-8xl font-bold text-stone-100 tracking-tight">
          4<span class="gold-gradient-text">0</span>4
        </h1>
        <h2 class="font-serif text-2xl sm:text-3xl text-stone-200 font-semibold">
          This Corridor Has Shifted
        </h2>
        <p class="text-stone-400 text-xs sm:text-sm max-w-lg mx-auto font-light leading-relaxed">
          The property dossier or page you were seeking may have been updated as part of our master planning release. Use the curated navigation pillars below to continue exploring.
        </p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="btn-shimmer px-7 py-3 rounded-full bg-gradient-to-r from-gold-300 via-gold-400 to-gold-500 text-charcoal-950 font-bold uppercase tracking-wider text-xs shadow-lg hover:shadow-gold-500/30 transition-all"
        >
          Return to Master Showcase
        </a>
        <button
          type="button"
          data-open-modal
          data-interest="404 Page Concierge Assistance"
          class="px-6 py-3 rounded-full border border-white/20 hover:border-gold-500/40 text-stone-300 hover:text-white font-medium uppercase tracking-wider text-xs transition-all cursor-pointer"
        >
          Request Priority Callback
        </button>
      </div>

      <!-- 5 Topical Pillar Cards -->
      <div class="pt-8 border-t border-white/10 space-y-4">
        <div class="text-[11px] uppercase tracking-widest text-stone-400 font-mono">
          Explore Core Programmatic Portals:
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 text-left">
          
          <a href="/residences/" class="group p-4 rounded-xl glass-card border border-white/10 hover:border-gold-500/40 transition-all block">
            <span class="text-[10px] text-gold-400 font-mono block">Pillar 01</span>
            <div class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-300 mt-1">Residences Hub</div>
            <p class="text-[10px] text-stone-400 mt-0.5">13 typologies &amp; layouts</p>
          </a>

          <a href="/near/flats-near-infosys-hinjewadi/" class="group p-4 rounded-xl glass-card border border-white/10 hover:border-gold-500/40 transition-all block">
            <span class="text-[10px] text-gold-400 font-mono block">Pillar 02</span>
            <div class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-300 mt-1">IT Park Commutes</div>
            <p class="text-[10px] text-stone-400 mt-0.5">17 tech employer hubs</p>
          </a>

          <a href="/compare/mahindra-mahalunge-vs-godrej-hillside/" class="group p-4 rounded-xl glass-card border border-white/10 hover:border-gold-500/40 transition-all block">
            <span class="text-[10px] text-gold-400 font-mono block">Pillar 03</span>
            <div class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-300 mt-1">Comparisons</div>
            <p class="text-[10px] text-stone-400 mt-0.5">14 project scorecards</p>
          </a>

          <a href="/connectivity/flats-near-pune-metro-line-3-hinjewadi/" class="group p-4 rounded-xl glass-card border border-white/10 hover:border-gold-500/40 transition-all block">
            <span class="text-[10px] text-gold-400 font-mono block">Pillar 04</span>
            <div class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-300 mt-1">Metro &amp; Corridors</div>
            <p class="text-[10px] text-stone-400 mt-0.5">8 transit infrastructure</p>
          </a>

          <a href="/brand/" class="group p-4 rounded-xl glass-card border border-white/10 hover:border-gold-500/40 transition-all block">
            <span class="text-[10px] text-gold-400 font-mono block">Pillar 05</span>
            <div class="font-serif text-xs font-bold text-stone-100 group-hover:text-gold-300 mt-1">Brand Portfolio</div>
            <p class="text-[10px] text-stone-400 mt-0.5">9 Pune developments</p>
          </a>

        </div>
      </div>

    </div>
  </section>
</Layout>
