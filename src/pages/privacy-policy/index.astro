---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://mahindralifespaceshomes.in/privacy-policy/#webpage",
  "url": "https://mahindralifespaceshomes.in/privacy-policy/",
  "name": "Privacy Policy | PropSmart Realty & Mahindra Rivenza Showcase",
  "description": "Comprehensive Privacy Policy for mahindralifespaceshomes.in. Compliant with Digital Personal Data Protection Act (DPDP Act), Google Web Policies, and Google Ads User Consent standards.",
  "publisher": {
    "@type": "RealEstateAgent",
    "name": "PropSmart Realty",
    "legalName": "PropSmart Realty",
    "telephone": "+91 7744009295",
    "url": "https://mahindralifespaceshomes.in/"
  }
};
---

<Layout
  title="Privacy Policy | PropSmart Realty & Mahindra Rivenza Showcase"
  description="Privacy Policy and User Consent guidelines for mahindralifespaceshomes.in. Operated by PropSmart Realty (MahaRERA: A031262401295), Authorized Strategic Channel Partner for Mahindra Lifespaces."
  canonical="https://mahindralifespaceshomes.in/privacy-policy/"
  customSchema={privacySchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4 text-center">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span>Statutory Privacy &amp; Data Protection Notice</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight leading-tight">
        Privacy Policy &amp; Data Governance
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Effective Date: October 6, 2026 • Last Reviewed: November 2026<br />
        Operated by <strong>PropSmart Realty</strong> (MahaRERA: A031262401295), Authorized Strategic Channel Partner.
      </p>
    </div>
  </section>

  <!-- Main Legal Content -->
  <section class="py-16 bg-[#0c1017]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 text-stone-300 text-sm leading-relaxed">

      <!-- Executive Overview -->
      <div class="p-6 rounded-2xl bg-charcoal-900/80 border border-gold-500/30 space-y-3">
        <h2 class="text-base font-bold text-white uppercase tracking-wider font-serif">1. Executive Overview &amp; Data Fiduciary Identity</h2>
        <p>
          This website (<strong class="text-white">mahindralifespaceshomes.in</strong>) is a specialized project marketing and customer consultation platform operated by <strong class="text-white">PropSmart Realty</strong> (<strong class="text-gold-300">MahaRERA Agent Registration No. A031262401295</strong>), an Authorized Strategic Channel Partner for marketing residential developments by <strong class="text-white">Mahindra Lifespace Developers Limited</strong>.
        </p>
        <p>
          We are committed to maintaining the highest standards of data integrity, confidentiality, and regulatory transparency in strict compliance with the <strong class="text-white">Digital Personal Data Protection Act, 2023 (DPDP Act, India)</strong>, the <strong class="text-white">Information Technology Act, 2000</strong>, Google Web Policies, and Google Ads User Consent requirements.
        </p>
      </div>

      <!-- Information We Collect -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">2. Information We Collect</h2>
        <p>
          When you interact with our website, request project brochures, schedule a site tour, or use our financial calculators, we may collect the following categories of information:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Direct Contact Details:</strong> Full Name, Mobile Telephone Number, Email Address, and Preferred Residence Configuration (2, 3, or 4 BHK).</li>
          <li><strong>Consultation Preferences:</strong> Purpose of purchase (self-use or investment), requested services (brochure download, verified cost sheet, VIP site visit booking).</li>
          <li><strong>Automated Technical Identifiers:</strong> IP Address, browser type, device operating system, referral source, pages viewed, time spent per section, and interaction timestamps.</li>
        </ul>
      </div>

      <!-- Purpose of Data Collection -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">3. Purpose and Legal Basis for Processing</h2>
        <p>We process your personal information solely for legitimate, user-initiated purposes, including:</p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Delivering requested project documentation: official brochures, sanctioned floor plans, CAD blueprints, and pricing sheets.</li>
          <li>Coordinating personalized sales consultations, VIP site visit slots, and show home appointments at the on-site gallery at Baner Annex (Mahalunge), Pune.</li>
          <li>Providing home loan eligibility assistance and construction-linked payment updates.</li>
          <li>Complying with statutory reporting requirements under MahaRERA and local real estate advisory guidelines.</li>
        </ul>
      </div>

      <!-- Consent & Do Not Call (DNC) / NCPR Compliance -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">4. User Consent &amp; Telemarketing / DNC Policy</h2>
        <p>
          By voluntarily submitting your mobile phone number on any contact form, callback request, or modal on this portal, you grant explicit consent to <strong class="text-white">PropSmart Realty</strong> and its authorized property advisors to contact you via voice call, SMS, or WhatsApp regarding Mahindra Rivenza.
        </p>
        <p>
          This explicit consent overrides any registration on the National Customer Preference Register (NCPR / Do Not Call Registry) for a period of twelve (12) months from the date of submission. You retain the right to revoke this consent at any time by sending an email with the subject "UNSUBSCRIBE" to <a href="mailto:compliance@mahindralifespaceshomes.in" class="text-gold-400 underline">compliance@mahindralifespaceshomes.in</a> or calling our advisory desk at <a href="tel:+917744009295" class="text-gold-400 underline">+91 7744009295</a>.
        </p>
      </div>

      <!-- Google Advertising, Cookies & Analytics -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">5. Cookies, Google Ads &amp; Analytics Technologies</h2>
        <p>
          We utilize essential and performance cookies to optimize site navigation and measure advertising efficacy:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Google Ads Conversion Tracking (AW-17430583486):</strong> Measures user response to verified advertising campaigns. Governed by Google Consent Mode v2 standards (<code class="text-gold-300">ad_storage</code>, <code class="text-gold-300">ad_user_data</code>, <code class="text-gold-300">ad_personalization</code>, <code class="text-gold-300">analytics_storage</code>).</li>
          <li><strong>Technical Cookies:</strong> Temporary session cookies storing UI preferences (such as modal dismissals and calculator states).</li>
          <li><strong>Third-Party Disclosures:</strong> We never sell, rent, or lease your personal information to third-party telemarketing agencies or data brokers. Data is shared exclusively with developer sales representatives for Mahindra Rivenza.</li>
        </ul>
      </div>

      <!-- Data Security & Retention -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-white font-serif border-b border-white/10 pb-2">6. Data Security &amp; Storage Protocols</h2>
        <p>
          All data transmitted across this website is secured using modern TLS 1.3 encryption (HTTPS). Form submissions are protected against malicious interception and processed through cloud endpoints hosted in enterprise-certified data centers with strict role-based access control.
        </p>
      </div>

      <!-- Grievance Officer & Contact Information -->
      <div class="p-6 rounded-2xl bg-charcoal-900 border border-white/10 space-y-3">
        <h2 class="text-base font-bold text-white uppercase tracking-wider font-serif">7. Grievance Redressal &amp; Privacy Officer Contact</h2>
        <p>
          In accordance with the Information Technology Act, 2000 and DPDP Act, 2023, the details of the designated Grievance Officer are as follows:
        </p>
        <div class="space-y-1 text-xs font-mono text-stone-300">
          <div><strong class="text-white">Entity:</strong> PropSmart Realty (Authorized Strategic Channel Partner)</div>
          <div><strong class="text-white">MahaRERA Agent No:</strong> A031262401295</div>
          <div><strong class="text-white">Designation:</strong> Data Protection &amp; Compliance Officer</div>
          <div><strong class="text-white">Office Address:</strong> Plus Code HP6G+WWF Baner Annex, off Baner-Hinjawadi Road, Nande, Pune, Maharashtra 412115</div>
          <div><strong class="text-white">Telephone Desk:</strong> +91 7744009295 (9:00 AM to 8:00 PM IST)</div>
          <div><strong class="text-white">Compliance Email:</strong> compliance@mahindralifespaceshomes.in</div>
        </div>
      </div>

    </div>
  </section>

  <MahindraKeywordMatrix />
</Layout>
