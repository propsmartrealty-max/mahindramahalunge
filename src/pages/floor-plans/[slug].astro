---
import Layout from '../../layouts/Layout.astro';
import { floorPlansData, type FloorPlanUnit } from '../../data/pSeoFloorPlans';

export async function getStaticPaths() {
  return floorPlansData.map((unit) => ({
    params: { slug: unit.slug },
    props: { unit },
  }));
}

interface Props {
  unit: FloorPlanUnit;
}

const { unit } = Astro.props;

const planSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/#product`,
      "name": unit.name,
      "description": unit.metaDescription,
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "category": `${unit.bhk} Residential Apartment`,
      "image": `https://mahindralifespaceshomes.in${unit.image}`,
      "sku": `MR-${unit.slug.toUpperCase()}`,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "INR",
        "price": unit.startingPriceInr.replace(/[^0-9.]/g, ''),
        "priceValidUntil": "2027-12-31",
        "availability": "https://schema.org/InStock",
        "url": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/`,
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "IN",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 15,
          "returnMethod": "https://schema.org/ReturnInStore",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0",
            "currency": "INR"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "IN"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 1,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 1,
              "unitCode": "DAY"
            }
          }
        }
      }
    },
    {
      "@type": "FloorPlan",
      "@id": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/#floorplan`,
      "name": `${unit.name} Architectural CAD Blueprint`,
      "description": `Sanctioned architectural CAD layout blueprint for ${unit.name} with ${unit.reraCarpetSqFt} sq.ft. MahaRERA carpet area and ${unit.balconySqFt} sq.ft. balcony deck at Mahindra Rivenza.`,
      "image": `https://mahindralifespaceshomes.in${unit.image}`,
      "numberOfRooms": unit.bhk === '2 BHK' ? 2 : unit.bhk === '3 BHK' ? 3 : 4,
      "numberOfBedrooms": unit.bhk === '2 BHK' ? 2 : unit.bhk === '3 BHK' ? 3 : 4,
      "numberOfBathroomsTotal": unit.bhk === '2 BHK' ? 2 : unit.bhk === '3 BHK' ? 3 : 4,
      "floorSize": {
        "@type": "QuantitativeValue",
        "value": unit.reraCarpetSqFt,
        "unitCode": "FTK"
      },
      "isPlanForApartment": {
        "@id": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/#apartment`
      }
    },
    {
      "@type": "Apartment",
      "@id": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/#apartment`,
      "name": unit.name,
      "image": `https://mahindralifespaceshomes.in${unit.image}`,
      "numberOfRooms": unit.bhk === '2 BHK' ? 2 : unit.bhk === '3 BHK' ? 3 : 4,
      "floorSize": {
        "@type": "QuantitativeValue",
        "value": unit.reraCarpetSqFt,
        "unitCode": "FTK"
      },
      "containedInPlace": {
        "@type": "ApartmentComplex",
        "name": "Mahindra Rivenza",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Survey No. 42/1, Nande-Mahalunge Road, Baner Annex",
          "addressLocality": "Mahalunge",
          "addressRegion": "Pune, Maharashtra",
          "postalCode": "412115",
          "addressCountry": "IN"
        }
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What is the carpet area and price of ${unit.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${unit.name} offers ${unit.reraCarpetSqFt} sq.ft. of sanctioned MahaRERA carpet area and ${unit.aggregateUsableSqFt} sq.ft. of aggregate usable space including a ${unit.balconySqFt} sq.ft. private balcony deck. Launch price starts from ${unit.startingPriceInr} with an all-inclusive estimated cost of approximately ${unit.approxTotalCostInr}.`
          }
        },
        {
          "@type": "Question",
          "name": `Is ${unit.name} Vastu compliant?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `Yes, ${unit.name} features an ${unit.vastuOrientation} with ${unit.sunlightExposure}, maximizing positive energy and natural illumination throughout the day.`
          }
        },
        {
          "@type": "Question",
          "name": `What is the estimated monthly home loan EMI for ${unit.name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `At prevailing home loan interest rates of 8.35%* for a 20-year tenure with 20% down payment, the approximate monthly EMI is ${unit.monthlyEmiApprox}. Buyers can also utilize Section 24(b) and Section 80C tax rebates.`
          }
        }
      ]
    }
  ]
};
function buildFloorPlanTitle(name: string, price: string): string {
  const shortName = name.replace('Mahindra Rivenza', 'Rivenza').trim();
  const c1 = `${shortName} [Starts ${price}] CAD Floor Plan`;
  if (c1.length <= 66) return c1;

  const c2 = `${shortName} [${price}] Layout CAD`;
  if (c2.length <= 66) return c2;

  const c3 = `${shortName} [${price}] CAD PDF`;
  if (c3.length <= 66) return c3;

  return `${shortName} Floor Plan [${price}]`.slice(0, 65);
}

const highCtrTitle = buildFloorPlanTitle(unit.name, unit.startingPriceInr);
const highCtrDescription = `Download official MahaRERA CAD floor plan for ${unit.name} (${unit.reraCarpetSqFt} sq.ft carpet / ${unit.aggregateUsableSqFt} sq.ft usable). Starting ${unit.startingPriceInr} in Baner Annex Pune. Get official cost sheet.`;
---

<Layout
  title={highCtrTitle}
  description={highCtrDescription}
  canonical={`https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/`}
  customSchema={planSchema}
>
  <main class="pt-32 pb-24 bg-charcoal-950 text-stone-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Breadcrumb & Tag -->
      <div class="space-y-4 border-b border-white/10 pb-8">
        <div class="flex items-center space-x-3 text-xs text-gold-400 uppercase tracking-widest font-semibold">
          <a href="/floor-plans/" class="hover:underline">← All Floor Plans</a>
          <span>•</span>
          <span>{unit.bhk} Luxury Collection</span>
          <span>•</span>
          <span>MahaRERA Sanctioned</span>
        </div>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div class="space-y-2">
            <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 leading-tight">
              {unit.name} <br />
              <span class="gold-gradient-text text-2xl sm:text-4xl">{unit.variant} Layout</span>
            </h1>
            <p class="text-xs sm:text-sm text-stone-400 font-light">
              MahaRERA PR1261012602102 &amp; PM1261012602103 • 13.46-Acre Landmark Community in Baner Annex, Mahalunge
            </p>
          </div>

          <div class="bg-charcoal-900/90 border border-gold-500/40 rounded-2xl p-4 sm:p-5 text-right shrink-0">
            <div class="text-[11px] text-stone-400 uppercase tracking-wider">Starting Launch Price</div>
            <div class="font-serif text-2xl sm:text-3xl font-bold text-gold-400">{unit.startingPriceInr}</div>
            <div class="text-[10px] text-emerald-400 font-medium">All-Inclusive: ~{unit.approxTotalCostInr}</div>
          </div>
        </div>
      </div>

      <!-- Key Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-charcoal-900/70 p-4 rounded-xl border border-white/10 text-center">
          <div class="text-[10px] text-stone-400 uppercase tracking-wider">RERA Carpet Area</div>
          <div class="font-serif text-xl sm:text-2xl font-bold text-stone-100 mt-1">{unit.reraCarpetSqFt} <span class="text-xs font-sans text-gold-400">Sq.Ft.</span></div>
          <div class="text-[10px] text-stone-400 font-mono mt-0.5">({(unit.reraCarpetSqFt * 0.092903).toFixed(1)} m²)</div>
        </div>
        <div class="bg-charcoal-900/70 p-4 rounded-xl border border-white/10 text-center">
          <div class="text-[10px] text-stone-400 uppercase tracking-wider">Aggregate Usable Area</div>
          <div class="font-serif text-xl sm:text-2xl font-bold text-gold-400 mt-1">{unit.aggregateUsableSqFt} <span class="text-xs font-sans text-stone-100">Sq.Ft.</span></div>
          <div class="text-[10px] text-emerald-400 mt-0.5">Includes Balcony Deck</div>
        </div>
        <div class="bg-charcoal-900/70 p-4 rounded-xl border border-white/10 text-center">
          <div class="text-[10px] text-stone-400 uppercase tracking-wider">Balcony Deck</div>
          <div class="font-serif text-xl sm:text-2xl font-bold text-stone-100 mt-1">{unit.balconySqFt} <span class="text-xs font-sans text-gold-400">Sq.Ft.</span></div>
          <div class="text-[10px] text-stone-400 mt-0.5">Private Outdoor Living</div>
        </div>
        <div class="bg-charcoal-900/70 p-4 rounded-xl border border-white/10 text-center">
          <div class="text-[10px] text-stone-400 uppercase tracking-wider">Approximate EMI</div>
          <div class="font-serif text-xl sm:text-2xl font-bold text-emerald-400 mt-1">{unit.monthlyEmiApprox}</div>
          <div class="text-[10px] text-stone-400 mt-0.5">@ 8.35%* for 20 Yrs</div>
        </div>
      </div>

      <!-- Blueprint Visual & Room Dimensions Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Architectural Schematic Card -->
        <div class="lg:col-span-7 bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-4">
            <div>
              <span class="text-[10px] text-emerald-400 font-mono uppercase tracking-wider">MahaRERA Sanctioned CAD</span>
              <h2 class="font-serif text-xl font-bold text-stone-100">Architectural Floor Plan Blueprint</h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs bg-gold-500/10 text-gold-400 px-3 py-1 rounded-full border border-gold-500/20 font-mono">
                Scale 1:50 Model
              </span>
            </div>
          </div>

          <!-- Official Sanctioned CAD Plan High-Res Viewer -->
          <div class="bg-white rounded-xl p-4 sm:p-6 border border-gold-500/30 relative overflow-hidden group shadow-2xl flex items-center justify-center min-h-[360px]">
            <img
              src={unit.image}
              alt={`${unit.name} - MahaRERA Sanctioned 2D CAD Floor Plan`}
              class="w-full h-auto max-h-[460px] object-contain transition-transform duration-500 group-hover:scale-105"
              loading="eager"
              width="800"
              height="600"
            />
            <div class="absolute bottom-3 right-3 bg-charcoal-950/85 text-stone-300 text-[10px] px-2.5 py-1 rounded-md backdrop-blur-md border border-white/10 flex items-center gap-1.5 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Official Sanctioned CAD Plate
            </div>
          </div>

          <!-- Action Buttons for Blueprint -->
          <div class="flex flex-wrap sm:flex-nowrap gap-3 pt-1">
            <button
              onclick={`window.dispatchEvent(new CustomEvent('open-lead-modal', { detail: { title: 'Download ${unit.name} High-Res Sanctioned CAD PDF', type: 'floorplan' } }))`}
              class="w-full sm:w-auto flex-1 py-3 px-5 bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-lg text-center cursor-pointer flex items-center justify-center gap-2"
            >
              <span>📥</span>
              <span>Download Sanctioned CAD Blueprint (PDF)</span>
            </button>
            <a
              href={unit.image}
              target="_blank"
              rel="noopener noreferrer"
              class="py-3 px-4 border border-white/20 hover:border-gold-400 text-stone-300 hover:text-gold-400 text-xs font-semibold rounded-xl transition-all flex items-center gap-1.5"
              title="View High-Res Image"
            >
              <span>🔍</span>
              <span>Zoom View</span>
            </a>
          </div>

          <!-- Vastu & Orientation Features -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="bg-charcoal-950/60 p-4 rounded-xl border border-white/5 space-y-1">
              <div class="text-[10px] text-gold-400 uppercase font-semibold">Vastu Orientation</div>
              <div class="font-medium text-stone-200">{unit.vastuOrientation}</div>
            </div>
            <div class="bg-charcoal-950/60 p-4 rounded-xl border border-white/5 space-y-1">
              <div class="text-[10px] text-gold-400 uppercase font-semibold">Natural Illumination</div>
              <div class="font-medium text-stone-200">{unit.sunlightExposure}</div>
            </div>
          </div>
        </div>

        <!-- Right: Room Dimensions Matrix -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 space-y-4">
            <h2 class="font-serif text-xl font-bold text-stone-100">Room-By-Room Carpet Schedule</h2>
            
            <div class="divide-y divide-white/5 text-xs">
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Grand Living &amp; Dining Salon</span>
                <span class="font-mono text-gold-400 font-semibold">{unit.dimensions.livingDining}</span>
              </div>
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Master Bedroom Sanctuary</span>
                <span class="font-mono text-gold-400 font-semibold">{unit.dimensions.masterBedroom}</span>
              </div>
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Second Bedroom Suite</span>
                <span class="font-mono text-stone-200">{unit.dimensions.secondBedroom}</span>
              </div>
              {unit.dimensions.thirdBedroom && (
                <div class="py-2.5 flex justify-between items-center">
                  <span class="text-stone-300">Third Bedroom / Study</span>
                  <span class="font-mono text-stone-200">{unit.dimensions.thirdBedroom}</span>
                </div>
              )}
              {unit.dimensions.fourthBedroom && (
                <div class="py-2.5 flex justify-between items-center">
                  <span class="text-stone-300">Fourth Bedroom Suite</span>
                  <span class="font-mono text-stone-200">{unit.dimensions.fourthBedroom}</span>
                </div>
              )}
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Gourmet Chef's Kitchen</span>
                <span class="font-mono text-stone-200">{unit.dimensions.kitchen}</span>
              </div>
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Outdoor Sundeck Terrace</span>
                <span class="font-mono text-gold-400 font-semibold">{unit.dimensions.balconyDeck}</span>
              </div>
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">En-suite Master Bath</span>
                <span class="font-mono text-stone-200">{unit.dimensions.masterBathroom}</span>
              </div>
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-stone-300">Common Guest Bathroom</span>
                <span class="font-mono text-stone-200">{unit.dimensions.commonBathroom}</span>
              </div>
            </div>

            <!-- Download CAD Plan & Instant WhatsApp CTA Buttons -->
            <div class="pt-2 space-y-2">
              <button
                onclick={`window.dispatchEvent(new CustomEvent('open-lead-modal', { detail: { title: 'Download ${unit.name} Sanctioned CAD Blueprint', type: 'floorplan' } }))`}
                class="w-full py-3.5 bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider rounded-xl transition-all cursor-pointer shadow-lg hover:shadow-gold-500/20"
              >
                Download Sanctioned CAD Floor Plan (PDF)
              </button>
              <a
                href={`https://wa.me/917744009295?text=${encodeURIComponent(`Hello Mahindra Rivenza sales desk, please share the official CAD blueprint and all-inclusive cost breakdown for ${unit.name} (${unit.aggregateUsableSqFt} sq.ft. usable).`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs uppercase tracking-wider rounded-xl transition-all flex items-center justify-center space-x-2"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                <span>Receive Blueprint on WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Cost Sheet Breakdown -->
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 space-y-4">
            <h3 class="font-serif text-lg font-bold text-stone-100">Estimated Cost &amp; Tax Structure</h3>
            <div class="divide-y divide-white/5 text-xs font-mono">
              <div class="py-2 flex justify-between">
                <span class="text-stone-400 font-sans">Agreement Base Value</span>
                <span class="text-stone-200">{unit.startingPriceInr}</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-stone-400 font-sans">Stamp Duty (5%) + Metro Cess (1%) + LBT (1%)</span>
                <span class="text-stone-200">7.0%</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-stone-400 font-sans">Goods &amp; Services Tax (GST)</span>
                <span class="text-stone-200">5.0%</span>
              </div>
              <div class="py-2 flex justify-between">
                <span class="text-stone-400 font-sans">Govt. Registration Levy</span>
                <span class="text-stone-200">₹30,000</span>
              </div>
              <div class="py-2 flex justify-between border-t border-gold-500/30 pt-3 text-gold-400 font-bold font-sans">
                <span>Estimated All-Inclusive Cost</span>
                <span>{unit.approxTotalCostInr}</span>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Key Architectural Features -->
      <div class="space-y-4">
        <h2 class="font-serif text-2xl font-bold text-stone-100">Engineering Highlights for {unit.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {unit.keyFeatures.map((feat, idx) => (
            <div class="bg-charcoal-900/60 p-4 rounded-xl border border-white/5 flex items-start space-x-3 text-xs">
              <span class="text-gold-400 font-bold font-mono text-sm">0{idx + 1}.</span>
              <span class="text-stone-300 leading-relaxed">{feat}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-4 border-t border-white/10 pt-8">
        <h2 class="font-serif text-2xl font-bold text-stone-100">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="bg-charcoal-900/60 p-5 rounded-xl border border-white/5">
            <h3 class="text-base font-semibold text-stone-200">What is the carpet area and price of {unit.name}?</h3>
            <p class="text-xs text-stone-400 mt-2 leading-relaxed">
              {unit.name} offers {unit.reraCarpetSqFt} sq.ft. of sanctioned MahaRERA carpet area and {unit.aggregateUsableSqFt} sq.ft. of aggregate usable space including a {unit.balconySqFt} sq.ft. private balcony deck. Launch price starts from {unit.startingPriceInr} with an all-inclusive estimated cost of approximately {unit.approxTotalCostInr}.
            </p>
          </div>
          <div class="bg-charcoal-900/60 p-5 rounded-xl border border-white/5">
            <h3 class="text-base font-semibold text-stone-200">Is {unit.name} Vastu compliant?</h3>
            <p class="text-xs text-stone-400 mt-2 leading-relaxed">
              Yes, {unit.name} features an {unit.vastuOrientation} with {unit.sunlightExposure}, maximizing positive energy and natural illumination throughout the day.
            </p>
          </div>
          <div class="bg-charcoal-900/60 p-5 rounded-xl border border-white/5">
            <h3 class="text-base font-semibold text-stone-200">What is the estimated monthly home loan EMI for {unit.name}?</h3>
            <p class="text-xs text-stone-400 mt-2 leading-relaxed">
              At prevailing home loan interest rates of 8.35%* for a 20-year tenure with 20% down payment, the approximate monthly EMI is {unit.monthlyEmiApprox}. Buyers can also utilize Section 24(b) and Section 80C tax rebates.
            </p>
          </div>
        </div>
      </div>

      <!-- Explore Other Sanctioned Typologies -->
      <div class="space-y-4 border-t border-white/10 pt-8">
        <h2 class="font-serif text-2xl font-bold text-stone-100">Explore Other Sanctioned Configurations</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {floorPlansData
            .filter((p) => p.slug !== unit.slug)
            .slice(0, 6)
            .map((item) => (
              <a
                href={`/floor-plans/${item.slug}/`}
                class="bg-charcoal-900/60 p-4 rounded-xl border border-white/5 hover:border-gold-500/40 transition-all block group"
              >
                <div class="text-[10px] text-gold-400 uppercase font-semibold">{item.bhk} • {item.variant}</div>
                <div class="text-sm font-serif font-bold text-stone-100 group-hover:text-gold-300 mt-1">{item.name}</div>
                <div class="text-xs text-stone-400 mt-2 flex justify-between font-mono">
                  <span>{item.aggregateUsableSqFt} Sq.Ft.</span>
                  <span class="text-gold-400 font-semibold">{item.startingPriceInr}</span>
                </div>
              </a>
            ))}
        </div>
      </div>

    </div>
  </main>
</Layout>
