---
import Layout from '../../layouts/Layout.astro';
import { floorPlansData } from '../../data/pSeoFloorPlans';

const indexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ItemList",
      "@id": "https://mahindralifespaceshomes.in/floor-plans/#itemlist",
      "name": "Mahindra Rivenza Sanctioned Floor Plans & Typology Catalog",
      "description": "Complete directory of official MahaRERA sanctioned 2, 3 & 4 BHK floor plans, carpet area breakdowns, and launch pricing at Mahindra Rivenza Baner Annex Mahalunge.",
      "itemListElement": floorPlansData.map((unit, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": unit.name,
        "url": `https://mahindralifespaceshomes.in/floor-plans/${unit.slug}/`
      }))
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/floor-plans/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What floor plan configurations are available at Mahindra Rivenza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza offers 9 MahaRERA sanctioned layouts: 2 BHK Premium (635 sq.ft carpet), 2 BHK Luxury B (668 sq.ft carpet), 2 BHK Luxury A (680 sq.ft carpet), 2 BHK Ultra Luxury E (747 sq.ft carpet), 3 BHK Deluxe C (882 sq.ft carpet), 3 BHK Deluxe B (945 sq.ft carpet), 3 BHK Ultra Luxury B (1065 sq.ft carpet), 4 BHK Luxury B (1438 sq.ft carpet), and 4 BHK Luxury A (1465 sq.ft carpet)."
          }
        },
        {
          "@type": "Question",
          "name": "Are Mahindra Rivenza floor plans Vastu compliant?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, all residences at Mahindra Rivenza are architecturally planned with East-West entry alignments, optimal cross-ventilation, and privacy-focused entry foyers compliant with Vastu Shastra principles."
          }
        },
        {
          "@type": "Question",
          "name": "Can I download the official Mahindra Rivenza floor plan PDF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, high-resolution MahaRERA sanctioned CAD layouts and floor plan PDFs are available for instant download on the official portal."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Floor Plans [Sanctioned 2, 3 & 4 BHK] Download CAD PDF"
  description="Inspect sanctioned MahaRERA architectural floor plans for Mahindra Rivenza. Exact room dimensions, carpet areas (635–1,465 sq.ft) & 3D layout blueprints. Download PDF."
  canonical="https://mahindralifespaceshomes.in/floor-plans/"
  customSchema={indexSchema}
>
  <main class="pt-32 pb-24 bg-charcoal-950 text-stone-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Top Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold flex items-center justify-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Official MahaRERA Sanctioned Catalog
        </span>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100">
          Mahindra Rivenza Floor Plans <br />
          <span class="gold-gradient-text">2, 3 &amp; 4 BHK Luxury Layouts</span>
        </h1>
        <p class="text-xs sm:text-sm text-stone-400 leading-relaxed">
          Detailed room-by-room dimensions, Vastu orientations, balcony specifications, and all-inclusive cost sheets across all 9 sanctioned configurations in Mahalunge, Baner Annex.
        </p>
      </div>

      <!-- Typology Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {floorPlansData.map((unit) => (
          <div class="bg-charcoal-900/80 border border-white/10 rounded-2xl p-6 hover:border-gold-500/50 transition-all flex flex-col justify-between group shadow-xl">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded bg-gold-500/10 text-gold-400 border border-gold-500/20 text-[11px] font-semibold uppercase tracking-wider">
                  {unit.bhk}
                </span>
                <span class="text-xs text-stone-400 font-mono">
                  {unit.reraCarpetSqFt} Sq.Ft. Carpet
                </span>
              </div>

              <div>
                <h2 class="font-serif text-xl font-bold text-stone-100 group-hover:text-gold-300 transition-colors">
                  {unit.name}
                </h2>
                <div class="text-xs text-stone-400 mt-1 font-medium">{unit.variant}</div>
              </div>

              <div class="bg-charcoal-950/60 p-4 rounded-xl border border-white/5 space-y-2 text-xs font-mono">
                <div class="flex justify-between">
                  <span class="text-stone-400 font-sans">Aggregate Usable</span>
                  <span class="text-stone-200 font-semibold">{unit.aggregateUsableSqFt} Sq.Ft.</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400 font-sans">Balcony Sundeck</span>
                  <span class="text-gold-400 font-semibold">{unit.balconySqFt} Sq.Ft.</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-stone-400 font-sans">Vastu Direction</span>
                  <span class="text-stone-300 font-sans text-[11px]">{unit.vastuOrientation.split(' ')[0]}</span>
                </div>
              </div>

              <div class="pt-1">
                <div class="text-[11px] text-stone-400 uppercase tracking-wider">Launch Price</div>
                <div class="font-serif text-2xl font-bold text-gold-400">{unit.startingPriceInr}</div>
                <div class="text-[10px] text-stone-400 mt-0.5">Approx EMI: {unit.monthlyEmiApprox}</div>
              </div>
            </div>

            <div class="pt-6 border-t border-white/5 mt-6 flex gap-3">
              <a
                href={`/floor-plans/${unit.slug}/`}
                class="flex-1 text-center py-2.5 px-4 bg-white/5 hover:bg-gold-500 hover:text-charcoal-950 text-stone-200 text-xs font-bold uppercase tracking-wider rounded-xl transition-all"
              >
                Inspect Layout
              </a>
              <button
                onclick={`window.dispatchEvent(new CustomEvent('open-lead-modal', { detail: { title: 'Download ${unit.name} Blueprint', type: 'floorplan' } }))`}
                class="px-3 py-2.5 border border-white/10 hover:border-gold-400 text-gold-400 text-xs rounded-xl transition-all cursor-pointer"
                title="Download PDF"
              >
                📥
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Conversion Callout -->
      <div class="bg-gradient-to-r from-gold-600/20 via-charcoal-900 to-gold-600/20 border border-gold-500/40 rounded-2xl p-6 sm:p-8 text-center space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
          Need a Custom Unit Comparison or Sanctioned PDF?
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 max-w-xl mx-auto">
          Our senior residential advisors provide side-by-side CAD comparisons, floor rise matrices, and all-inclusive bank approval estimates.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <button
            onclick="window.dispatchEvent(new CustomEvent('open-lead-modal', { detail: { title: 'Request Complete 9-Unit Floor Plan Dossier', type: 'brochure' } }))"
            class="px-6 py-3 bg-gold-500 hover:bg-gold-400 text-charcoal-950 font-bold text-xs uppercase tracking-wider rounded-lg shadow-lg hover:shadow-gold-500/20 transition-all cursor-pointer"
          >
            Download Complete Floor Plan Dossier (PDF)
          </button>
          <a
            href="tel:+917744009295"
            class="px-6 py-3 border border-white/20 hover:border-gold-400 text-stone-200 hover:text-gold-400 font-semibold text-xs uppercase tracking-wider rounded-lg transition-all"
          >
            Advisory Desk: +91 7744009295
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>
