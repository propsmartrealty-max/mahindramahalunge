---
import Layout from '../../layouts/Layout.astro';
import ResidenceSelector from '../../components/ResidenceSelector.astro';
import MasterPlanViewer from '../../components/MasterPlanViewer.astro';

const floorPlanSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/floor-plans/#product",
      "name": "Mahindra Rivenza Official Master Layout & Floor Plan Blueprints",
      "description": "Download official 13.46-acre master township layout and architectural floor plans for 2, 3 & 4 BHK residences at Mahindra Rivenza, Baner Annex / Mahalunge, Pune. MahaRERA PR1261012602102.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      }
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Floor Plans PDF | 2, 3 & 4 BHK Layouts, Pune"
  description="Download official floor plans & 13.46-acre master layout for Mahindra Rivenza by Mahindra Lifespaces in Baner Annex, Mahalunge, Pune. Detailed 2, 3 & 4 BHK blueprints with RERA carpet areas from 635 to 1,465 sq.ft."
  keywords="mahindra rivenza floor plans, mahindra rivenza master layout, mahindra rivenza 3 bhk floor plan, mahindra rivenza 4 bhk floor plan, mahindra rivenza 2 bhk floor plan, mahindra rivenza unit layout, floor plan pdf mahindra mahalunge"
  canonical="https://mahindralifespaceshomes.in/floor-plans/"
  customSchema={floorPlanSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full glass-pill text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Architectural Blueprints &amp; Master Layout • Phase 1 Release</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-stone-100 max-w-4xl leading-tight">
        Mahindra Rivenza Floor Plans: <br />
        <span class="gold-gradient-text">Master Layout &amp; 2, 3, 4 BHK Blueprints</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Engineered with Mahindra Lifespaces' positive energy philosophy — featuring wide cross-ventilation fins, expansive balcony decks, and zero dead-corridor circulation across 13.46 prime acres.
      </p>
    </div>
  </section>

  <!-- Interactive Unit & Master Layout Selector -->
  <section class="py-20 bg-charcoal-900 border-b border-white/10 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Interactive Explorer</span>
        <h2 class="font-serif text-3xl text-stone-100 font-bold">Inspect Typology Blueprints &amp; Master Layout</h2>
        <p class="text-xs sm:text-sm text-stone-300">
          Switch between Master Layout, 2 BHK, 3 BHK &amp; 4 BHK to inspect dimensions, room allocations, and deck placements.
        </p>
      </div>
      <ResidenceSelector />
    </div>
  </section>

  <!-- 13.46-Acre Master Township Layout Section -->
  <section class="py-20 bg-charcoal-950 border-b border-white/10 relative">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Township Master Blueprint</span>
        <h2 class="font-serif text-3xl text-stone-100 font-bold">13.46-Acre Zonal Master Layout</h2>
        <p class="text-xs sm:text-sm text-stone-300">
          Explore the five lifestyle pillars across 13.46 acres — ~44,000+ sq.ft clubhouse with sunken bar pool, 6 high-rise towers, and 9+ acres of contiguous vehicular-free greens.
        </p>
      </div>

      <MasterPlanViewer />
    </div>
  </section>

  <!-- Quick Links to BHK & Master Plan Pages -->
  <section class="py-16 bg-charcoal-900">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/master-plan/" class="glass-card p-6 rounded-2xl border border-white/10 hover:border-gold-500/50 transition-all space-y-3 block group">
          <span class="text-[10px] uppercase tracking-wider text-emerald-400 font-bold">13.46 Acres</span>
          <h3 class="font-serif text-lg font-bold text-stone-100 group-hover:text-gold-300 transition-colors">Master Layout</h3>
          <p class="text-xs text-stone-400">9+ acres greens, ~44k sq.ft clubhouse with sunken bar pool, 6 Phase 1 towers.</p>
          <span class="text-xs text-gold-400 font-semibold inline-block">Explore Master Layout →</span>
        </a>
        <a href="/residences/2-bhk/" class="glass-card p-6 rounded-2xl border border-white/10 hover:border-gold-500/50 transition-all space-y-3 block group">
          <span class="text-[10px] uppercase tracking-wider text-gold-400 font-bold">From ₹90 Lakhs*</span>
          <h3 class="font-serif text-lg font-bold text-stone-100 group-hover:text-gold-300 transition-colors">2 BHK Floor Plans</h3>
          <p class="text-xs text-stone-400">4 Typologies: Premium, Luxury B, Luxury A &amp; Ultra Luxury E (635 – 747 sq.ft. RERA).</p>
          <span class="text-xs text-gold-400 font-semibold inline-block">Explore 2 BHK →</span>
        </a>
        <a href="/residences/3-bhk/" class="glass-card p-6 rounded-2xl border border-white/10 hover:border-gold-500/50 transition-all space-y-3 block group">
          <span class="text-[10px] uppercase tracking-wider text-gold-400 font-bold">From ₹1.31 Cr*</span>
          <h3 class="font-serif text-lg font-bold text-stone-100 group-hover:text-gold-300 transition-colors">3 BHK Floor Plans</h3>
          <p class="text-xs text-stone-400">3 Typologies: Deluxe C, Deluxe B &amp; Ultra Luxury B (882 – 1,065 sq.ft. RERA).</p>
          <span class="text-xs text-gold-400 font-semibold inline-block">Explore 3 BHK →</span>
        </a>
        <a href="/residences/4-bhk/" class="glass-card p-6 rounded-2xl border border-white/10 hover:border-gold-500/50 transition-all space-y-3 block group">
          <span class="text-[10px] uppercase tracking-wider text-gold-400 font-bold">From ₹2.20 Cr*</span>
          <h3 class="font-serif text-lg font-bold text-stone-100 group-hover:text-gold-300 transition-colors">4 BHK Floor Plans</h3>
          <p class="text-xs text-stone-400">2 Typologies: Luxury B &amp; Luxury A with on-site live show home (1,438 – 1,465 sq.ft. RERA).</p>
          <span class="text-xs text-gold-400 font-semibold inline-block">Explore 4 BHK →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
