---
import Layout from '../../layouts/Layout.astro';
import MahindraKeywordMatrix from '../../components/MahindraKeywordMatrix.astro';

const banerAnnexSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Place",
      "@id": "https://mahindralifespaceshomes.in/baner-annex/#place",
      "name": "Baner Annex, Pune",
      "alternateName": ["Baner Annex Mahalunge", "Baner Extension", "West Baner Growth Corridor"],
      "description": "Baner Annex (Mahalunge) is Western Pune's fastest appreciating residential micro-market, planned under PMRDA Town Planning Scheme 1. Home to landmark developments like Mahindra Rivenza.",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 18.562536,
        "longitude": 73.727373
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Baner Annex / Mahalunge",
        "addressRegion": "Pune, Maharashtra",
        "postalCode": "412115",
        "addressCountry": "IN"
      }
    },
    {
      "@type": "Product",
      "@id": "https://mahindralifespaceshomes.in/baner-annex/#product",
      "name": "Mahindra Rivenza Baner Annex",
      "description": "13.46-acre flagship residential sanctuary in Baner Annex featuring 9+ acres landscaped greens, ~44,000 sq.ft grand clubhouse, sunken pool, and luxury 2, 3 & 4 BHK homes starting from ₹90 Lakhs*.",
      "brand": {
        "@type": "Brand",
        "name": "Mahindra Lifespaces"
      },
      "url": "https://mahindralifespaceshomes.in/mahindra-rivenza/",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "bestRating": "5",
        "worstRating": "1",
        "ratingCount": "248",
        "reviewCount": "248"
      },
      "offers": {
        "@type": "AggregateOffer",
        "lowPrice": "9000000",
        "highPrice": "25500000",
        "priceCurrency": "INR",
        "offerCount": "1236",
        "availability": "https://schema.org/InStock",
        "validFrom": "2026-10-06",
        "priceValidUntil": "2027-12-31"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://mahindralifespaceshomes.in/baner-annex/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Baner Annex in Pune real estate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Baner Annex is the prestigious high-growth extension of Baner situated along the PMRDA Town Planning Scheme 1 corridor (Mahalunge-Nande). It bridges prime Baner and Balewadi High Street with the Hinjewadi IT Park, offering planned 36-meter wide arterial roads, underground utilities, and luxury townships like Mahindra Rivenza at a 30% to 40% price advantage over core Baner."
          }
        },
        {
          "@type": "Question",
          "name": "What are current property rates in Baner Annex in 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In 2026, residential property prices in Baner Annex range between ₹7,800 and ₹9,400 per sq.ft on usable carpet area, compared to ₹12,000 to ₹15,500 per sq.ft in core Baner. A luxury 2 BHK at Mahindra Rivenza starts from ₹90 Lakhs*, with 3 BHK starting at ₹1.31 Crore*."
          }
        },
        {
          "@type": "Question",
          "name": "How does Baner Annex connect to Hinjewadi IT Park and Pune Metro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Baner Annex features direct transit across the new 4-lane Mula River Bridge, cutting commute times to Hinjewadi Phase 1 (Infosys, Wipro, TCS) down to just 4 to 7 minutes. Additionally, Pune Metro Line 3 stations at Hinjewadi Phase 1 and Balewadi Stadium are reachable within 8 minutes."
          }
        },
        {
          "@type": "Question",
          "name": "Why is Mahindra Rivenza the flagship project in Baner Annex?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Mahindra Rivenza is an expansive 13.46-acre master development by Mahindra Lifespaces with an estimated GDV of ₹3,500 Crore. It offers 9+ acres of landscaped biophilic greens, a ~44,000 sq.ft multi-level clubhouse with sunken aqua bar, Net Zero Waste engineering, and MahaRERA certifications (PR1261012602102 & PM1261012602103)."
          }
        }
      ]
    }
  ]
};
---

<Layout
  title="Baner Annex Pune [Starts ₹90L*] Mahindra Rivenza Hub"
  description="Exhaustive 2026 Baner Annex Pune real estate guide. Explore property prices, PMRDA 36m DP road, Mula River bridge, and luxury 2, 3 & 4 BHK flats at Mahindra Rivenza starting ₹90L*."
  keywords="baner annex pune, flats in baner annex, apartments in baner annex, mahindra rivenza baner annex, mahindra baner annex, new projects in baner annex, 2 bhk in baner annex, 3 bhk in baner annex, baner annex property rates 2026"
  canonical="https://mahindralifespaceshomes.in/baner-annex/"
  customSchema={banerAnnexSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 relative z-10">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>PMRDA Town Planning Scheme 1 • High-Growth Micro-Market</span>
      </div>
      
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
        Baner Annex, Pune: <br />
        <span class="gold-gradient-text">The New Epicenter of Luxury Living</span>
      </h1>
      
      <p class="text-stone-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Positioned at the golden nexus of Baner, Balewadi High Street, and Hinjewadi IT Park. Discover why Baner Annex is Western Pune's most sought-after residential destination for high-tech executives and luxury home seekers.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="/pricing/"
          class="px-6 py-3 rounded-full bg-gradient-to-r from-gold-400 to-gold-500 text-charcoal-950 font-bold text-xs uppercase tracking-wider shadow-lg hover:brightness-110 transition-all"
        >
          View Baner Annex Price List
        </a>
        <a
          href="/floor-plans/"
          class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/15 border border-white/15 text-stone-200 font-bold text-xs uppercase tracking-wider transition-all"
        >
          Download Floor Plans PDF
        </a>
        <button
          data-open-modal
          data-interest="Baner Annex Site Visit Request"
          class="px-6 py-3 rounded-full bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 font-bold text-xs uppercase tracking-wider transition-all cursor-pointer"
        >
          Book Site Visit
        </button>
      </div>
    </div>
  </section>

  <!-- Key Economic & Connectivity Metrics -->
  <section class="py-12 bg-charcoal-900 border-b border-white/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/10 space-y-1">
          <span class="text-xs uppercase text-stone-400 font-mono">Current Price Range</span>
          <div class="text-2xl font-serif font-bold text-gold-400">₹7,800 - ₹9,400</div>
          <span class="text-[11px] text-stone-400">per sq.ft carpet</span>
        </div>
        <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/10 space-y-1">
          <span class="text-xs uppercase text-stone-400 font-mono">To Hinjewadi Ph 1</span>
          <div class="text-2xl font-serif font-bold text-emerald-400">4 - 7 Mins</div>
          <span class="text-[11px] text-stone-400">via 4-lane Mula Bridge</span>
        </div>
        <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/10 space-y-1">
          <span class="text-xs uppercase text-stone-400 font-mono">Price Arbitrage</span>
          <div class="text-2xl font-serif font-bold text-gold-300">30% Savings</div>
          <span class="text-[11px] text-stone-400">compared to Core Baner</span>
        </div>
        <div class="p-5 rounded-2xl bg-white/[0.02] border border-white/10 space-y-1">
          <span class="text-xs uppercase text-stone-400 font-mono">Infrastructure</span>
          <div class="text-2xl font-serif font-bold text-white">36m DP Road</div>
          <span class="text-[11px] text-stone-400">PMRDA Ring Road Corridor</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Editorial Breakdown -->
  <section class="py-20 bg-[#0c1017]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Article 1 -->
      <article class="space-y-4">
        <h2 class="font-serif text-2xl sm:text-3xl text-white font-bold">
          1. What Makes Baner Annex the #1 Investment Corridor in West Pune?
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
          For over a decade, Baner and Balewadi established themselves as Western Pune’s premier residential addresses. However, core Baner has reached saturation with high land acquisition costs and escalating vehicular congestion along Baner Road.
        </p>
        <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
          <strong>Baner Annex (Mahalunge)</strong> represents the planned evolution. Master-zoned under PMRDA's premier Town Planning Scheme (TPS 1), Baner Annex is engineered from the ground up with 36-meter wide arterial boulevards, dedicated cycle tracks, underground utility ducts, and reserved green biophilic belts. Buyers receive modern high-rise architecture, institutional developers like Mahindra Lifespaces, and luxury clubhouses at a price point that still offers substantial capital headroom.
        </p>
      </article>

      <!-- Comparison Matrix: Baner vs Baner Annex -->
      <div class="space-y-4">
        <h3 class="font-serif text-xl sm:text-2xl text-white font-bold">
          2. Micro-Market Price &amp; Livability Comparison (2026)
        </h3>
        <div class="overflow-x-auto border border-white/10 rounded-2xl">
          <table class="w-full text-left text-xs sm:text-sm text-stone-300">
            <thead class="bg-black/60 text-stone-400 font-mono uppercase text-[11px] border-b border-white/10">
              <tr>
                <th class="py-3 px-4">Parameter</th>
                <th class="py-3 px-4 text-gold-400">Baner Annex (Mahindra Rivenza)</th>
                <th class="py-3 px-4">Core Baner</th>
                <th class="py-3 px-4">Hinjewadi Phase 1</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr>
                <td class="py-3 px-4 font-semibold text-white">Carpet Price Range</td>
                <td class="py-3 px-4 font-bold text-gold-300">₹7,800 - ₹9,400 / sq.ft</td>
                <td class="py-3 px-4">₹12,000 - ₹15,500 / sq.ft</td>
                <td class="py-3 px-4">₹7,200 - ₹8,500 / sq.ft</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-white">2 BHK Entry Ticket</td>
                <td class="py-3 px-4 font-bold text-gold-300">₹90 Lakhs* onwards</td>
                <td class="py-3 px-4">₹1.35 Cr - ₹1.70 Cr</td>
                <td class="py-3 px-4">₹75 Lakhs - ₹95 Lakhs</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-white">Commute to IT Park</td>
                <td class="py-3 px-4 font-bold text-emerald-400">4 - 7 Mins (via River Bridge)</td>
                <td class="py-3 px-4">25 - 40 Mins (via Highway)</td>
                <td class="py-3 px-4">0 - 5 Mins (Internal Traffic)</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-white">Open Green Space</td>
                <td class="py-3 px-4 font-bold text-emerald-400">9+ Acres Landscaped Greens</td>
                <td class="py-3 px-4">Compact Plot Margins</td>
                <td class="py-3 px-4">High Concrete Density</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-white">Rental Yield</td>
                <td class="py-3 px-4 font-bold text-gold-300">4.8% - 5.4% (High IT Demand)</td>
                <td class="py-3 px-4">3.2% - 3.8%</td>
                <td class="py-3 px-4">4.2% - 4.6%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Flagship Spotlight: Mahindra Rivenza -->
      <div class="bg-charcoal-900/90 border border-gold-500/30 rounded-2xl p-6 sm:p-10 shadow-2xl space-y-6">
        <div class="space-y-2">
          <span class="text-xs uppercase tracking-widest text-gold-400 font-mono font-bold">The Flagship Development</span>
          <h3 class="font-serif text-2xl sm:text-3xl text-white font-bold">
            Mahindra Rivenza: 13.46-Acre Biophilic Landmark in Baner Annex
          </h3>
          <p class="text-xs sm:text-sm text-stone-300 leading-relaxed">
            Officially announced on October 6, 2026, Mahindra Rivenza is the crown jewel of Baner Annex. With 1,236 residences in Phase 1, the project is engineered around Net Zero Waste to Landfill principles and IGBC Gold Pre-Certification.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-1">
            <span class="text-xs font-bold text-white">2 BHK Premium &amp; Luxury</span>
            <p class="text-[11px] text-stone-400">635 to 747 sq.ft RERA carpet (688 to 855 sq.ft usable). Starting from ₹90 Lakhs*.</p>
            <a href="/floor-plans/mahindra-rivenza-2-bhk-premium/" class="text-[11px] text-gold-400 hover:underline block pt-1">Explore 2 BHK Plans →</a>
          </div>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-1">
            <span class="text-xs font-bold text-white">3 BHK Deluxe &amp; Ultra</span>
            <p class="text-[11px] text-stone-400">882 to 1,065 sq.ft RERA carpet (995 to 1,206 sq.ft usable). Starting from ₹1.31 Cr*.</p>
            <a href="/floor-plans/mahindra-rivenza-3-bhk-deluxe-c/" class="text-[11px] text-gold-400 hover:underline block pt-1">Explore 3 BHK Plans →</a>
          </div>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10 space-y-1">
            <span class="text-xs font-bold text-white">4 BHK Sky Villas</span>
            <p class="text-[11px] text-stone-400">1,438 to 1,465 sq.ft RERA carpet (1,615 to 1,651 sq.ft usable). Starting from ₹2.20 Cr*.</p>
            <a href="/floor-plans/mahindra-rivenza-4-bhk-luxury-b/" class="text-[11px] text-gold-400 hover:underline block pt-1">Explore 4 BHK Plans →</a>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap gap-4">
          <a
            href="/tools/construction-linked-payment-calculator/"
            class="px-5 py-2.5 rounded-lg bg-gold-500/20 border border-gold-500/40 text-gold-300 text-xs font-semibold hover:bg-gold-500/30 transition-colors"
          >
            Calculate CLP Milestone Payments
          </a>
          <a
            href="/brochure/"
            class="px-5 py-2.5 rounded-lg bg-white/5 border border-white/10 text-stone-300 text-xs font-semibold hover:bg-white/10 transition-colors"
          >
            Download Official Brochure PDF
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-charcoal-900/60 border border-white/10 rounded-2xl p-6 sm:p-10 space-y-6">
        <h2 class="font-serif text-2xl font-bold text-white">Frequently Asked Questions: Baner Annex Real Estate</h2>
        
        <div class="space-y-4 divide-y divide-white/5">
          <div class="pt-4 space-y-2">
            <h4 class="font-semibold text-white text-sm">Is Baner Annex part of Pune Municipal Corporation (PMC) or PMRDA?</h4>
            <p class="text-stone-300 text-xs sm:text-sm leading-relaxed">
              Baner Annex falls under the Pune Metropolitan Region Development Authority (PMRDA) jurisdiction and is planned under the ambitious Town Planning Scheme (TPS 1). It benefits from 36-meter wide sector roads, standardized land pooling, and master-planned civic infrastructure.
            </p>
          </div>

          <div class="pt-4 space-y-2">
            <h4 class="font-semibold text-white text-sm">How far is Baner Annex from Balewadi High Street?</h4>
            <p class="text-stone-300 text-xs sm:text-sm leading-relaxed">
              Baner Annex is approximately 4.6 km from Balewadi High Street, equating to an easy 7 to 9 minute drive. Residents enjoy seamless access to premier fine dining, organic markets, and entertainment lounges without living amid commercial traffic congestion.
            </p>
          </div>

          <div class="pt-4 space-y-2">
            <h4 class="font-semibold text-white text-sm">What is the capital appreciation forecast for Baner Annex over the next 3 to 5 years?</h4>
            <p class="text-stone-300 text-xs sm:text-sm leading-relaxed">
              Real estate analysts project an annual capital appreciation of 12% to 15% for Baner Annex over the next 3 to 5 years, catalyzed by the completion of the 4-lane Mahalunge-Hinjewadi bridge, Pune Metro Line 3 operationalization, and the PMRDA High-Tech City development.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Topical Keyword Grid -->
  <MahindraKeywordMatrix />
</Layout>
