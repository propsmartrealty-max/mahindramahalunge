---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Mahindra Mahalunge Brochure | Mahindra Lifespaces Mahalunge PDF Dossier"
  description="Download the official project brochure for Mahindra Mahalunge by Mahindra Lifespaces. 13.46-acre master community in Mahalunge, Pune with floor plans, master layout & pricing."
  canonical="https://mahindralifespaceshomes.in/brochure"
>
  <section class="pt-32 pb-24 bg-charcoal-950 min-h-screen flex items-center justify-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full space-y-12">
      
      <div class="text-center space-y-3">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
          <span>Official Project Literature</span>
        </div>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 leading-tight">
          Mahindra Mahalunge Brochure <br />
          <span class="gold-gradient-text">by Mahindra Lifespaces Mahalunge</span>
        </h1>
        <p class="text-stone-300 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
          Access the comprehensive architectural brief covering Mahindra Mahalunge: the 13.46-acre master layout, 2, 3 & 4 BHK residence floor plans, sustainability systems, and location connectivity.
        </p>
      </div>

      <!-- Brochure Preview Box -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center bg-charcoal-900 border border-white/10 rounded-2xl p-6 sm:p-10 shadow-2xl">
        
        <!-- Document Cover Mockup -->
        <div class="md:col-span-5 relative group">
          <div class="rounded-xl overflow-hidden border border-gold-500/30 shadow-2xl bg-charcoal-950 p-6 flex flex-col justify-between h-80 relative">
            <div class="space-y-3">
              <img 
                src="/images/mahindra-lifespaces-logo.svg" 
                alt="Mahindra Lifespaces" 
                class="h-4 w-auto object-contain"
                width="200"
                height="14"
              />
              <div class="pt-6">
                <span class="text-[10px] tracking-widest uppercase text-stone-400 font-medium">Confidential Master Dossier</span>
                <h3 class="font-serif text-2xl font-bold text-white mt-1">MAHALUNGE</h3>
                <p class="text-[11px] text-gold-400 tracking-wider uppercase mt-0.5">Pune, Maharashtra</p>
              </div>
            </div>

            <div class="border-t border-white/10 pt-4 flex items-center justify-between text-[10px] text-stone-400">
              <span>13.46-Acre Development</span>
              <span class="text-emerald-400 font-medium">Pre-Launch Edition</span>
            </div>
          </div>
        </div>

        <!-- Download Action -->
        <div class="md:col-span-7 space-y-5">
          <h3 class="font-serif text-xl sm:text-2xl text-stone-100 font-bold">
            What's Included in This Dossier:
          </h3>
          <ul class="space-y-2.5 text-xs text-stone-300">
            <li class="flex items-start space-x-2.5">
              <span class="text-gold-400">✦</span>
              <span><strong>13.46-Acre Master Layout:</strong> High-resolution vector zones & perimeter roads.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-gold-400">✦</span>
              <span><strong>Architectural Blueprints:</strong> Conceptual plans for 2 BHK, 3 BHK & 4 BHK residences.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-gold-400">✦</span>
              <span><strong>40+ Amenities Spec Sheet:</strong> Breakdown across Wellness, Sports, Social, and Forest Greens.</span>
            </li>
            <li class="flex items-start space-x-2.5">
              <span class="text-gold-400">✦</span>
              <span><strong>Radial Transit & Micro-Market Map:</strong> Signal-free access to Hinjewadi Phase 1 & Baner.</span>
            </li>
          </ul>

          <div class="pt-2">
            <button
              data-open-modal
              data-interest="Instant Brochure Download"
              class="w-full sm:w-auto px-8 py-3.5 rounded bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer"
            >
              Instant Download (PDF)
            </button>
          </div>

          <p class="text-[10px] text-stone-500 italic">
            *Final RERA project brochure will be distributed upon statutory registration and sanction.
          </p>
        </div>

      </div>

    </div>
  </section>
</Layout>
