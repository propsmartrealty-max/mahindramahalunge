---
import Layout from '../../layouts/Layout.astro';

const siteVisitSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://mahindralifespaceshomes.in/site-visit/#webpage",
      "url": "https://mahindralifespaceshomes.in/site-visit/",
      "name": "Book Mahindra Rivenza Official VIP Site Visit",
      "description": "Book a guided VIP site visit to Mahindra Rivenza at Baner Annex, Mahalunge, Pune. Explore the 4 BHK show residence and meet project architects.",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://mahindralifespaceshomes.in/" },
          { "@type": "ListItem", "position": 2, "name": "Book Site Visit", "item": "https://mahindralifespaceshomes.in/site-visit/" }
        ]
      }
    }
  ]
};
---

<Layout
  title="Mahindra Rivenza Site Visit [VIP Pass Booking] 4 BHK Sample Flat"
  description="Book an official VIP site visit to Mahindra Rivenza at Baner Annex, Mahalunge, Pune. Walk through 4 BHK sample home, get free cab pickup & 2026 cost sheet."
  canonical="https://mahindralifespaceshomes.in/site-visit/"
  customSchema={siteVisitSchema}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 bg-charcoal-950 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>VIP Site Visit Concierge • 7 Days a Week</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-stone-100 max-w-4xl leading-tight">
        Experience Mahindra Rivenza In Person: <br />
        <span class="gold-gradient-text">4 BHK Show Residence Now Live</span>
      </h1>
      <p class="text-stone-300 text-sm sm:text-base max-w-2xl font-light leading-relaxed">
        Step into the fully furnished 4 BHK showcase home at the on-site sales gallery in Baner Annex, Mahalunge. Review architectural CADs, inspect construction progress, and receive customized CLP milestone payment structures.
      </p>
    </div>
  </section>

  <!-- Site Visit Highlights Grid -->
  <section class="py-16 bg-charcoal-900 border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-2">
        <span class="text-xs uppercase tracking-widest text-gold-400 font-bold">Why Visit In Person</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-100">
          What Awaits You at the Sales Gallery
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-gold-500/10 border border-gold-500/30 flex items-center justify-center text-2xl">
            🏡
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">4 BHK Show Residence</h3>
          <p class="text-xs text-stone-300 leading-relaxed font-light">
            Walk through real room dimensions, marble finishes, expansive wrap-around balconies, and cross-ventilation flow engineered by Mahindra Lifespaces.
          </p>
        </div>

        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-2xl">
            🏊
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">~44,000 Sq.Ft. Clubhouse 3D Model</h3>
          <p class="text-xs text-stone-300 leading-relaxed font-light">
            Examine the physical scale model of the multi-tier lifestyle hub, sunken aqua bar pool, FIFA-grade futsal turf, and IGBC Gold landscaped bio-parks.
          </p>
        </div>

        <div class="glass-card p-6 rounded-2xl border border-white/15 space-y-4">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-2xl">
            📊
          </div>
          <h3 class="font-serif text-xl font-bold text-stone-100">Personalized Cost Sheet</h3>
          <p class="text-xs text-stone-300 leading-relaxed font-light">
            Sit down with authorized senior advisors to review exact unit prices starting ₹90L*, stamp duty, registration, and bank home loan pre-approvals.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Booking Concierge Card -->
  <section class="py-16 bg-charcoal-950 border-b border-white/10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="glass-card rounded-2xl border border-gold-500/40 p-8 sm:p-12 space-y-8 shadow-2xl">
        
        <div class="text-center space-y-3">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded bg-gold-500/10 border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-widest">
            <span>Instant Priority Booking</span>
          </div>
          <h2 class="font-serif text-2xl sm:text-4xl font-bold text-stone-100">
            Schedule Your Visit Today
          </h2>
          <p class="text-xs sm:text-sm text-stone-300 font-light max-w-xl mx-auto">
            Select your preferred day and our site concierge team will confirm your time slot, send Google Map directions, and arrange complimentary cab pickup if required.
          </p>
        </div>

        <!-- Visit Benefits Checklist -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-y border-white/10 py-6 text-xs text-stone-300">
          <div class="flex items-center space-x-3">
            <span class="text-gold-400 font-bold text-base">✦</span>
            <span>Free Valet Parking at Sales Gallery</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-gold-400 font-bold text-base">✦</span>
            <span>Dedicated Relationship Manager</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-gold-400 font-bold text-base">✦</span>
            <span>Complimentary Cab Pickup from Pune / Hinjewadi</span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="text-gold-400 font-bold text-base">✦</span>
            <span>Printed Launch Dossier &amp; CAD Blueprints</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
          <button
            data-open-modal
            data-interest="Site Visit Appointment"
            class="w-full sm:w-auto px-10 py-4 rounded-full bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 text-charcoal-950 text-xs font-bold uppercase tracking-widest hover:shadow-xl transition-all cursor-pointer text-center"
          >
            Confirm VIP Visit Slot
          </button>
          <a
            href="https://wa.me/917744009295?text=Hi%20Mahindra%20Rivenza%20Team%2C%20I%20would%20like%20to%20book%20a%20site%20visit%20to%20see%20the%20show%20residence%20at%20Baner%20Annex."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-8 py-4 rounded-full bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 text-xs font-bold uppercase tracking-widest border border-emerald-500/40 transition-all text-center flex items-center justify-center space-x-2"
          >
            <span>Book via WhatsApp</span>
            <span>💬</span>
          </a>
        </div>

        <p class="text-center text-[10px] text-stone-400">
          Sales Gallery Timings: 9:00 AM – 8:00 PM (Monday to Sunday) • Direct Hotline: <a href="tel:+917744009295" class="text-gold-400 hover:underline">+91 7744009295</a>
        </p>

      </div>

    </div>
  </section>
</Layout>
