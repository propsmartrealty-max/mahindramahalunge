# ==============================================================================
# Cloudflare Pages Edge Headers — Mahindra Lifespaces Pune Ecosystem
# Enterprise Edge Security, Core Web Vitals & Search Engine Crawl Optimization
# ==============================================================================

# Global Rules for all routes
/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  Vary: Accept-Encoding, User-Agent

# HTML Pages - Instant Edge delivery with Stale-While-Revalidate for Googlebot
/*.html
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

# Directory index routes
/
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/near/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/compare/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/connectivity/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/articles/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/residences/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

/west-pune/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800

# Immutable hashed JS & CSS generated by Astro Vite build
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static Public Assets (Images, SVGs, Favicons)
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=2592000, immutable

# Search Engine Crawlers & Discovery
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=3600

# AI Search Engine & LLM Manifests
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

