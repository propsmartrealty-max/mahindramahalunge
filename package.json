{
  "name": "mahalunge_site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 3002 --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 3002 --host 0.0.0.0",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro"
  },
  "dependencies": {
    "astro": "3.5.0",
    "@astrojs/react": "2.3.0",
    "@astrojs/tailwind": "5.0.0",
    "react": "18.3.0",
    "react-dom": "18.3.0"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "tailwindcss": "3.4.1",
    "postcss": "8.4.35",
    "prettier": "3.2.5",
    "eslint": "8.57.0",
    "eslint-plugin-astro": "0.33.0"
  }
}
